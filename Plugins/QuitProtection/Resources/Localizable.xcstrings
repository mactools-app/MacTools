    "Intercept and deliver confirmed quit shortcuts.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于拦截退出快捷键，并在确认后发送。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعتراض اختصارات الإنهاء وإرسالها بعد التأكيد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastenkürzel zum Beenden abfangen und nach Bestätigung senden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intercepta y envía los atajos de salida confirmados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Intercepte les raccourcis de fermeture et les envoie après confirmation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了ショートカットを検出し、確認後に送信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종료 단축키를 가로채고 확인 후 전달합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Intercepta e envia os atalhos de saída após a confirmação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перехватывает сочетания для выхода и отправляет их после подтверждения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çıkış kısayollarını yakalar ve onaylandıktan sonra gönderir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "攔截結束快速鍵，並在確認後送出。"
          }
        },
        "en": {
