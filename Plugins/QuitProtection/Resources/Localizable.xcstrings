{
  "sourceLanguage": "en",
  "strings": {
    "Quit Protection": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出保护"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حماية من الإنهاء"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beenden-Schutz"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Protección al salir"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Protection à la fermeture"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了保護"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종료 보호"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Proteção ao sair"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Защита от выхода"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çıkış Koruması"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結束保護"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit Protection"
          }
        }
      }
    },
    "Prevent accidental quits with a confirmation shortcut.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认快捷键后再退出应用，防止误操作。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امنع إنهاء التطبيقات بالخطأ باستخدام اختصار للتأكيد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verhindere versehentliches Beenden mit einem Bestätigungskurzbefehl."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita salir por error con un atajo de confirmación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Évitez de quitter par erreur avec un raccourci de confirmation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認用ショートカットで誤ってアプリを終了するのを防ぎます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인 단축키로 앱이 실수로 종료되는 것을 방지합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Evite encerrar apps por engano com um atalho de confirmação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предотвращайте случайный выход из приложений с помощью сочетания для подтверждения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onay kısayoluyla uygulamadan yanlışlıkla çıkmayı önleyin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認快速鍵後再結束 App，避免誤操作。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevent accidental quits with a confirmation shortcut."
          }
        }
      }
    },
    "Hold ⌘Q to quit": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌘Q 退出"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مطولًا على ⌘Q للإنهاء"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Beenden ⌘Q halten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado ⌘Q para salir"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez ⌘Q pour quitter"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Q を押し続けて終了"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Q를 길게 눌러 종료"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha ⌘Q pressionado para sair"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте ⌘Q для выхода"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çıkmak için ⌘Q’yu basılı tutun"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌘Q 結束"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold ⌘Q to quit"
          }
        }
      }
    },
