    "Extra Modifier remains unavailable until shortcut conflicts can be verified.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附加修饰键需验证快捷键冲突后才能使用。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفتاح التعديل الإضافي غير متاح حتى التحقق من تعارض الاختصارات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine zusätzliche Sondertaste ist erst nach Prüfung auf Konflikte verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modificador adicional requiere verificar que no haya conflictos de atajos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La touche supplémentaire nécessite une vérification des conflits de raccourcis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットの競合を確認するまで、追加の修飾キーは利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가 보조 키를 사용하려면 단축키 충돌을 확인해야 합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O modificador adicional exige a verificação de conflitos de atalhos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дополнительный модификатор требует проверки конфликтов сочетаний."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ek değiştirici tuş için kısayol çakışmaları doğrulanmalıdır."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "附加修飾鍵需確認快速鍵衝突後才能使用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extra Modifier remains unavailable until shortcut conflicts can be verified."
          }
        }
      }
    },
    "App switchers and forwarded shortcuts keep their normal behavior.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用切换器和转发的快捷键保留原有行为。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتفظ مبدلات التطبيقات والاختصارات المُعادة توجيهها بسلوكها المعتاد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App-Wechsler und weitergeleitete Kurzbefehle verhalten sich wie gewohnt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El selector de apps y los atajos reenviados conservan su comportamiento habitual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sélecteurs d’apps et les raccourcis transférés fonctionnent comme d’habitude."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリスイッチャーと転送されたショートカットは通常どおり動作します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 전환기와 전달된 단축키는 평소처럼 작동합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O seletor de apps e os atalhos encaminhados mantêm seu comportamento normal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переключение приложений и перенаправленные сочетания работают как обычно."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama değiştiriciler ve iletilen kısayollar normal şekilde çalışır."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 切換器和轉送的快速鍵保留原有行為。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App switchers and forwarded shortcuts keep their normal behavior."
          }
        }
      }
    },
