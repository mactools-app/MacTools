          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Ayarları"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 设置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 設定"
          }
        }
      }
    }
  },
