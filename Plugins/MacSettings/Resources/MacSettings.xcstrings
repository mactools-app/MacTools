    "Unknown settings: %@. They will be preserved but never applied.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown settings: %@. They will be preserved but never applied."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilinmeyen ayarlar: %@. Bunlar korunur ancak hiçbir zaman uygulanmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包含 %@ 个未知设置；它们会保留，但不会执行。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعدادات غير معروفة: %@. سيتم الحفاظ عليها ولكن لن يتم تطبيقها أبدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unbekannte Einstellungen: %@. Sie bleiben erhalten, werden jedoch nicht angewendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes desconocidos: %@. Se conservarán, pero nunca se aplicarán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paramètres inconnus : %@. Ils seront conservés mais jamais appliqués."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不明な設定が %@ 個あります。これらは保存されますが、適用されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알 수 없는 설정 %@개가 포함되어 있습니다. 이 설정들은 유지되지만 적용되지는 않습니다."
          }
        },
        "pt": {
