    "Pin to the top and the Pinned list. The first four also appear in the Feature Panel.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pin to the top and add to the Pinned list. The first four also appear in the Feature Panel."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En üste ve Sabitlenenler listesine sabitler. İlk dört ayar ayrıca Özellik Paneli'nde görünür."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固定在首页顶部和已固定列表；前 4 项也显示在功能面板中。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التثبيت في الأعلى وفي قائمة الإعدادات المثبّتة. تظهر الإعدادات الأربعة الأولى أيضًا في لوحة الميزات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oben anheften und in die Liste „Angeheftet“ aufnehmen. Die ersten vier erscheinen auch im Funktionsbereich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fijar en la parte superior y en la lista Fijados. Los primeros cuatro también aparecen en el Panel de funciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Épingler en haut et dans la liste des réglages épinglés. Les quatre premiers apparaissent également dans le panneau de fonctionnalités."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最上部と「固定済み」リストに固定します。最初の 4 項目は機能パネルにも表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정을 상단과 고정 목록에 고정합니다. 처음 4개는 기능 패널에도 표시됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixar no topo e na lista de ajustes fixados. As primeiras quatro configurações também aparecem no Painel de Recursos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрепить вверху и в списке закрепленных. Первые четыре также отображаются на панели функций."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "固定在首頁頂部和已固定列表；前 4 項也顯示在功能面板中。"
          }
        }
      }
    },
