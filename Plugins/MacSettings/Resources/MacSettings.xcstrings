    "This removes %@ recorded changes. This cannot be undone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This clears the recorded change history (%@). This cannot be undone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem %@ kayıtlı değişikliği kaldırır ve geri alınamaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将清除全部 %@ 条更改记录。此操作无法撤销。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُحذف سجلات التغييرات (العدد: %@). لا يمكن التراجع عن هذا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies entfernt alle aufgezeichneten Änderungen. Anzahl: %@. Dieser Vorgang kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambios registrados que se eliminarán: %@. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela effacera l’historique des modifications (%@). Cette opération est irréversible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 件の変更履歴を削除します。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 내역 %@개가 삭제됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso remove o histórico de alterações. Total de alterações: %@. Isso não pode ser desfeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будут удалены записи об изменениях: %@. Это действие нельзя отменить."
          }
        },
        "zh-Hant": {
