    "The current state could not be read. The original snapshot has been retained.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current state could not be read. The original snapshot has been retained."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçerli durum okunamadı. Özgün anlık görüntü korundu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前状态无法读取；原始快照已保留。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذرت قراءة الحالة الحالية. تم الاحتفاظ بنسخة الحالة الأصلية."
