    "Verification failed. The original value was restored.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verification failed. The original value was restored."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğrulama başarısız oldu. Özgün değer geri yüklendi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证失败，已恢复原值。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل التحقق. تمت استعادة القيمة الأصلية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfung fehlgeschlagen. Der ursprüngliche Wert wurde wiederhergestellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La verificación falló. Se restableció el valor original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vérification a échoué. La valeur d'origine a été restaurée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検証に失敗しました。元の値が復元されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인에 실패했습니다. 원래 값이 복원되었습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha na verificação. O valor original foi restaurado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверка не удалась. Исходное значение было восстановлено."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "驗證失敗，已還原原值。"
          }
        }
      }
    },
