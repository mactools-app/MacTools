    "Original snapshots have been retained. Resolve these items before applying other changes.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original snapshots have been retained. Resolve these items before applying other changes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özgün anlık görüntüler korundu. Diğer değişiklikleri uygulamadan önce bu öğeleri giderin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原始快照已保留。请先处理以下项目，再应用其他更改。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الاحتفاظ بنسخ الحالة الأصلية. عالج هذه العناصر قبل تطبيق تغييرات أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ursprüngliche Momentaufnahmen wurden beibehalten. Bearbeiten Sie diese Elemente, bevor Sie weitere Änderungen vornehmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se han conservado las instantáneas originales. Resuelva estos elementos antes de aplicar otros cambios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les instantanés originaux ont été conservés. Résolvez ces éléments avant d’appliquer d’autres modifications."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のスナップショットは保持されています。他の変更を適用する前に、これらの項目を解決してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 스냅샷이 유지되었습니다. 다른 변경 사항을 적용하기 전에 이러한 항목을 해결하십시오."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os instantâneos originais foram mantidos. Resolva esses itens antes de aplicar outras alterações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исходные значения сохранены. Устраните эти проблемы, прежде чем применять другие изменения."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原始快照已保留。請先處理以下項目，再套用其他更改。"
          }
        }
      }
    },
