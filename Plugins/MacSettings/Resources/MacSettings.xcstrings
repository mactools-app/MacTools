    "Imported files are always previewed first. No settings change automatically.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imported files are always previewed first. No settings change automatically."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçe aktarılan dosyalar her zaman önce önizlenir. Hiçbir ayar otomatik olarak değişmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入文件始终先预览；不会自动更改任何设置。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم دائمًا معاينة الملفات المستوردة أولاً. لا تتغير الإعدادات تلقائيا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importierte Dateien werden immer zuerst in der Vorschau angezeigt. Einstellungen werden nicht automatisch geändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos importados siempre se muestran primero en una vista previa. Ningún ajuste cambia automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers importés sont toujours prévisualisés en premier. Aucun paramètre ne change automatiquement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インポートされたファイルは常に最初にプレビューされます。設定が自動的に変更されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져온 파일은 항상 먼저 미리보기로 표시됩니다. 설정은 자동으로 변경되지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos importados são sempre visualizados primeiro. Nenhuma configuração é alterada automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импортированные файлы всегда предварительно просматриваются. Никакие настройки не изменяются автоматически."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入檔案始終先預覽；不會自動更改任何設定。"
          }
        }
      }
    },
