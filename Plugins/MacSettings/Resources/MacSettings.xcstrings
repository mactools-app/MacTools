    "Restoration is incomplete. Retry Restoration or Keep Current Values to continue.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restoration is incomplete. Choose Retry Restoration or Keep Current Values to continue."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri yükleme tamamlanmadı. Devam etmek için geri yüklemeyi yeniden deneyin veya geçerli değerleri koruyun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复未完成，请选择重试恢复或保留当前值。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاستعادة غير مكتملة. أعد محاولة الاستعادة أو احتفظ بالقيم الحالية للمتابعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wiederherstellung ist unvollständig. Wiederholen Sie die Wiederherstellung oder behalten Sie die aktuellen Werte bei, um fortzufahren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La restauración está incompleta. Elige Reintentar restauración o Mantener valores actuales para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La restauration est incomplète. Réessayez la restauration ou conservez les valeurs actuelles pour continuer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元が完了していません。「復元を再試行」または「現在の値を保持」を選択して続行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복원이 완료되지 않았습니다. 계속하려면 복원을 다시 시도하거나 현재 값을 유지하세요."
