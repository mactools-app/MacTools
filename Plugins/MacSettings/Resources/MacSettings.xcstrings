    "MacTools will open a profile preview. Settings change only after you confirm your selection.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools will open a profile preview. Settings change only after you confirm your selection."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools bir profil önizlemesi açar. Ayarlar yalnızca seçiminizi onayladıktan sonra değişir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools 将打开配置预览。确认选择后，所选设置才会更改。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيفتح MacTools معاينة لملف التعريف. تتغير الإعدادات فقط بعد تأكيد اختيارك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools öffnet eine Profilvorschau. Einstellungen werden erst geändert, nachdem Sie Ihre Auswahl bestätigt haben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools abrirá una vista previa del perfil. La configuración cambia solo después de confirmar su selección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools ouvrira un aperçu du profil. Les paramètres ne changent qu’après avoir confirmé votre sélection."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools でプロファイルのプレビューが開きます。設定は、選択を確認した後にのみ変更されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools가 프로필 미리보기를 엽니다. 설정은 선택 사항을 확인한 후에만 변경됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools abrirá uma visualização do perfil. As configurações mudam somente depois que você confirma sua seleção."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools откроет предварительный просмотр профиля. Настройки изменяются только после того, как вы подтвердите свой выбор."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools 將開啟設定檔預覽。確認選擇後，所選設定才會更改。"
          }
        }
      }
    },
    "Make the onscreen pointer easier to see.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
