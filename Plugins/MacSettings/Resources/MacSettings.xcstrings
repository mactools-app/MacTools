    "Use the pin button on any setting. The first four pinned settings also appear in the Feature Panel.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the pin button on any setting. The first four pinned settings also appear in the Feature Panel."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhangi bir ayardaki sabitleme düğmesini kullanın. İlk dört sabitlenmiş ayar ayrıca Özellik Paneli'nde görünür."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用任意设置旁的固定按钮；前 4 项也会显示在功能面板中。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم زر الدبوس في أي إعداد. تظهر أيضًا الإعدادات الأربعة الأولى المثبتة في لوحة الميزات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie die Anheften-Schaltfläche bei einer beliebigen Einstellung. Die ersten vier angehefteten Einstellungen erscheinen auch im Funktionsbereich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el botón de fijar de cualquier ajuste. Los cuatro primeros ajustes fijados también aparecen en el Panel de funciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez le bouton d'épingle sur n'importe quel paramètre. Les quatre premiers paramètres épinglés apparaissent également dans le panneau de fonctionnalités."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各設定の固定ボタンを使用してください。最初の 4 つの固定した設定は機能パネルにも表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 설정에서든 핀 버튼을 사용하세요. 처음 4개의 고정된 설정도 기능 패널에 나타납니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o botão de fixar em qualquer configuração. As primeiras quatro configurações fixadas também aparecem no Painel de Recursos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте кнопку закрепления в любых настройках. Первые четыре закрепленных параметра также отображаются на панели функций."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用任意設定旁的固定按鈕；前 4 項也會顯示在功能面板中。"
          }
        }
      }
    },
