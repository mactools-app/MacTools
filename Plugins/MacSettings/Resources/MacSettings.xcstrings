        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A restauração está incompleta. Tente novamente a restauração ou mantenha os valores atuais para continuar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановление не завершено. Выберите «Повторить попытку восстановления» или «Оставить текущие значения», чтобы продолжить."
          }
        },
        "zh-Hant": {
