    },
    "Changing pointer size requires Full Disk Access. Grant access, then quit and reopen MacTools.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing pointer size requires Full Disk Access. Grant access, then quit and reopen MacTools."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşaretçi boyutunu değiştirmek Tam Disk Erişimi gerektirir. Erişim verdikten sonra MacTools'tan çıkıp yeniden açın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改指针大小需要“完全磁盘访问权限”。授权后请退出并重新打开 MacTools。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب تغيير حجم المؤشر إذن الوصول الكامل إلى القرص. امنح الإذن، ثم أنهِ MacTools وأعد فتحه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ändern der Zeigergröße erfordert Festplattenvollzugriff. Gewähren Sie den Zugriff, beenden Sie MacTools und öffnen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar el tamaño del puntero requiere Acceso total al disco. Concede acceso y después cierra y vuelve a abrir MacTools."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La modification de la taille du pointeur nécessite un accès complet au disque. Accordez l'accès, puis quittez et rouvrez MacTools."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポインタのサイズを変更するには、フルディスクアクセスの許可が必要です。許可した後、MacTools を終了して再度開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포인터 크기를 변경하려면 전체 디스크 접근 권한이 필요합니다. 권한을 허용한 후 MacTools를 종료했다가 다시 여세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A alteração do tamanho do ponteiro requer Acesso Total ao Disco. Conceda acesso, encerre e reabra o MacTools."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для изменения размера указателя требуется разрешение «Доступ к диску». Предоставьте доступ, затем закройте и снова откройте MacTools."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更改指標大小需要「完全取用磁碟」權限。授權後請結束並重新開啟 MacTools。"
          }
        }
      }
    },
    "Choose Auto, Light, or Dark. macOS manages Auto; the selected mode stays Auto as the appearance changes.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Auto, Light, or Dark. macOS manages Auto; the selected mode stays Auto as the appearance changes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik, Aydınlık veya Karanlık seçin. Otomatik'i macOS yönetir; görünüm değiştikçe seçili mod Otomatik olarak kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择自动、浅色或深色。使用“自动”时，macOS 会自动切换外观，所选模式仍为“自动”。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر تلقائي أو فاتح أو داكن. يدير macOS الوضع التلقائي؛ يظل الوضع المحدد تلقائيًا مع تغير المظهر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie „Automatisch“, „Hell“ oder „Dunkel“. macOS verwaltet die Einstellung „Automatisch“; der gewählte Modus bleibt „Automatisch“, auch wenn sich das Erscheinungsbild ändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige Automático, Claro u Oscuro. macOS gestiona el modo Automático; la selección se mantiene en Automático aunque cambie la apariencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez Auto, Clair ou Sombre. macOS gère Auto ; le mode sélectionné reste Auto à mesure que l'apparence change."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「自動」、「ライト」、「ダーク」から選択します。「自動」では macOS が外観を切り替えます。外観が変わっても、選択したモードは「自動」のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동, 라이트 또는 다크를 선택하세요. 자동 모드는 macOS가 전환하며, 현재 화면 모드가 바뀌어도 선택은 ‘자동’으로 유지됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha Automático, Claro ou Escuro. macOS gerencia Automático; o modo selecionado permanece Automático conforme a aparência muda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите «Авто», «Светлое» или «Темное». macOS управляет автоматическим режимом; при изменении оформления выбранный режим остается «Авто»."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇自動、淺色或深色。macOS 會管理自動模式；即使外觀改變，所選模式仍會維持自動。"
          }
        }
      }
    },
