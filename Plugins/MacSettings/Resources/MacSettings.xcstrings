    "Expand a setting's details and choose Pin to Top. The first four also appear in the Feature Panel.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expand a setting's details and choose Pin to Top. The first four also appear in the Feature Panel."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ayarın ayrıntılarını genişletin ve Başa Sabitle'yi seçin. İlk dört ayar ayrıca Özellik Paneli'nde görünür."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "展开设置详情并选择“固定到顶部”。前 4 项也会显示在功能面板中。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتوسيع تفاصيل الإعداد واختر تثبيت في الأعلى. تظهر الأربعة الأولى أيضًا في لوحة الميزات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erweitern Sie die Details einer Einstellung und wählen Sie „Oben anheften“. Die ersten vier erscheinen auch im Funktionsbereich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Despliega los detalles de un ajuste y elige Fijar en la parte superior. Los cuatro primeros ajustes también aparecen en el Panel de funciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Développez les détails d'un paramètre et choisissez Épingler en haut. Les quatre premiers apparaissent également dans le panneau de fonctionnalités."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定の詳細を展開し、「最上部に固定」を選択します。最初の 4 項目は機能パネルにも表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 세부정보를 확장하고 상단에 고정을 선택합니다. 처음 4개는 기능 패널에도 나타납니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Expanda os detalhes de uma configuração e escolha Fixar no topo. As primeiras quatro também aparecem no Painel de Recursos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разверните сведения о настройке и выберите «Закрепить вверху». Первые четыре также отображаются на панели функций."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "展開設定詳情並選擇「固定到頂部」。前 4 項也會顯示在功能面板中。"
          }
        }
      }
    },
    "Explicitly turn a supported Mac setting on or off.": {
      "extractionState": "manual",
