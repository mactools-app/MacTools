    "Hide the Dock and menu bar, remove recent Dock apps, and hide desktop items and widgets.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide the Dock and menu bar, remove recent Dock apps, and hide desktop items and widgets."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock'ı ve menü çubuğunu gizler, Dock'taki son kullanılan uygulamaları kaldırır, masaüstü öğelerini ve widget'ları gizler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏程序坞和菜单栏，关闭程序坞中最近使用的 App 显示，并隐藏桌面项目和小组件。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إخفاء Dock وشريط القائمة، وإيقاف عرض التطبيقات الحديثة في Dock، وإخفاء عناصر سطح المكتب والأدوات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock und Menüleiste ausblenden, kürzlich verwendete Dock-Apps entfernen sowie Desktop-Objekte und Widgets verbergen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta el Dock y la barra de menús, elimina las apps recientes del Dock y oculta los elementos y widgets del escritorio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquez le Dock et la barre de menus, retirez du Dock les apps récentes et masquez les éléments et widgets du bureau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock とメニューバーを非表示にし、最近使用したアプリの表示を Dock から取り除き、デスクトップの項目とウィジェットを非表示にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock과 메뉴 막대를 숨기고, Dock에 최근 사용한 앱을 표시하지 않으며, 데스크탑 항목 및 위젯을 숨깁니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculte o Dock e a barra de menus, remova os aplicativos recentes do Dock e oculte itens e widgets da área de trabalho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрыть Dock и строку меню, убрать из Dock значки недавних приложений и скрыть элементы и виджеты рабочего стола."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱藏 Dock 和選單列，移除 Dock 中的最近使用 App，並隱藏桌面項目和小工具。"
          }
        }
      }
    },
    "Automatically Hide and Show the Menu Bar": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically Hide and Show the Menu Bar"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Menü Çubuğunu Otomatik Gizle ve Göster"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动隐藏和显示菜单栏"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إخفاء وإظهار شريط القائمة تلقائيًا"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Menüleiste automatisch aus- und einblenden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar y mostrar automáticamente la barra de menú"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer et afficher automatiquement la barre de menus"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーを自動的に非表示にしたり表示したりする"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대 자동 숨기기 및 표시"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar e mostrar automaticamente a barra de menu"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматическое скрытие и отображение строки меню"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動隱藏和顯示選單列"
          }
        }
      }
    },
    "Choose when macOS automatically hides the menu bar.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose when macOS automatically hides the menu bar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS'un menü çubuğunu ne zaman otomatik gizleyeceğini seçin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择 macOS 何时自动隐藏菜单栏。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر متى يقوم macOS بإخفاء شريط القائمة تلقائيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Festlegen, wann macOS die Menüleiste automatisch ausblendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija cuándo macOS oculta automáticamente la barra de menú."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez quand macOS masque automatiquement la barre de menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS がメニューバーを自動的に非表示にするタイミングを選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS가 메뉴 막대를 자동으로 숨기는 시기를 선택합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha quando macOS oculta automaticamente a barra de menu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, когда macOS автоматически скрывает строку меню."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇 macOS 何時自動隱藏選單列。"
          }
        }
      }
    },
