    "Can be changed directly; takes full effect after logging out and back in": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can be changed directly; takes full effect after logging out and back in"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğrudan değiştirilebilir; oturum kapatılıp yeniden açıldığında tamamen etkili olur"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可直接更改；退出登录并重新登录后完全生效"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن تغييره مباشرة؛ يسري بالكامل بعد تسجيل الخروج ثم الدخول مجددًا"
          }
        },
        "de": {
