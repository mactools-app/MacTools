    "This does not change macOS settings, but discards the retained recovery snapshot for this item.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This does not change macOS settings, but discards the retained recovery snapshot for this item."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem macOS ayarlarını değiştirmez; yalnızca bu öğe için tutulan kurtarma anlık görüntüsünü atar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不会更改 macOS 设置，但会放弃此项目保留的恢复快照。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يؤدي هذا إلى تغيير إعدادات macOS، لكنه يتخلّص من نسخة الحالة المحفوظة لاسترداد هذا العنصر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ändert keine macOS-Einstellungen, verwirft jedoch die gespeicherte Wiederherstellungs-Momentaufnahme für dieses Element."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no cambia la configuración de macOS, pero descarta la instantánea de recuperación retenida para este elemento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
