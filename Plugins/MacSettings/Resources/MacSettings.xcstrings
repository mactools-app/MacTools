    "Choose a .mactoolsprofile or JSON file. MacTools checks it and shows every proposed setting before you can save or apply it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a .mactoolsprofile or JSON file. MacTools checks it and shows every proposed setting before you can save or apply it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir .mactoolsprofile veya JSON dosyası seçin. MacTools dosyayı denetler ve kaydedip uygulamadan önce önerilen her ayarı gösterir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择 .mactoolsprofile 或 JSON 文件。MacTools 会检查文件，并在保存或应用前显示每项建议的设置。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر ملف .mactoolsprofile أو JSON. يتحقق MacTools منه ويعرض كل الإعدادات المقترحة قبل أن تتمكن من حفظه أو تطبيقه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie eine .mactoolsprofile- oder JSON-Datei aus. MacTools prüft sie und zeigt alle vorgeschlagenen Einstellungen an, bevor Sie diese speichern oder anwenden können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un archivo .mactoolsprofile o JSON. MacTools lo verifica y muestra cada ajuste propuesto antes de que puedas guardar o aplicar el perfil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un fichier .mactoolsprofile ou JSON. MacTools le vérifie et affiche chaque paramètre proposé avant que vous puissiez l'enregistrer ou l'appliquer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": ".mactoolsprofile または JSON ファイルを選択します。 MacTools はそれをチェックし、提案されたすべての設定を保存または適用する前に表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ".mactoolsprofile 또는 JSON 파일을 선택하세요. MacTools는 이를 확인하고 저장하거나 적용하기 전에 제안된 모든 설정을 표시합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um arquivo .mactoolsprofile ou JSON. MacTools verifica e mostra todas as configurações propostas antes que você possa salvá-las ou aplicá-las."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите файл .mactoolsprofile или JSON. MacTools проверит его и покажет все предлагаемые настройки перед сохранением или применением."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇 .mactoolsprofile 或 JSON 檔案。MacTools 會檢查檔案，並在儲存或套用前顯示每項建議的設定。"
          }
        }
      }
    },
