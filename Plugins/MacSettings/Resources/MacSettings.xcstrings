    "Hide the Dock and menu bar, remove recent Dock apps, and hide desktop items and widgets.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide the Dock and menu bar, remove recent Dock apps, and hide desktop items and widgets."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock'ı ve menü çubuğunu gizler, Dock'taki son kullanılan uygulamaları kaldırır, masaüstü öğelerini ve widget'ları gizler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏程序坞和菜单栏，移除程序坞中的最近使用 App，并隐藏桌面项目和小组件。"
          }
        }
      }
    },
    "Automatically Hide and Show the Menu Bar": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
