    "Stop after the current setting finishes verification or restoration. No further changes will start.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop after verification or restoration of the current setting finishes. No further changes will start."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçerli ayarın doğrulaması veya geri yüklemesi tamamlandıktan sonra durdurur. Yeni değişiklikler başlatılmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前设置完成验证或恢复后停止，不会开始后续更改。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتوقف بعد اكتمال التحقق من الإعداد الحالي أو استعادته. لن تبدأ أي تغييرات أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anhalten, sobald die Überprüfung oder Wiederherstellung der aktuellen Einstellung abgeschlossen ist. Es werden keine weiteren Änderungen gestartet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detener después de que la configuración actual finalice la verificación o restauración. No se iniciarán más cambios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête l’opération une fois la vérification ou la restauration du paramètre actuel terminée. Aucune autre modification ne sera lancée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の設定の検証または復元が終了したら停止します。これ以上の変更は開始されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 설정에 대한 확인이나 복원이 완료된 후 정지합니다. 더 이상 변경 사항이 시작되지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para após a configuração atual concluir a verificação ou restauração. Nenhuma outra mudança será iniciada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
