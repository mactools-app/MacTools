    "Adjust display colors automatically to match ambient light.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust display colors automatically to match ambient light."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran renklerini ortam ışığına uyacak şekilde otomatik olarak ayarlar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据环境光自动调节显示器颜色。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضبط ألوان الشاشة تلقائيًا لتتناسب مع الإضاءة المحيطة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildschirmfarben automatisch an das Umgebungslicht anpassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta los colores de la pantalla automáticamente para que coincidan con la luz ambiental."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustez automatiquement les couleurs de l'affichage en fonction de la lumière ambiante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "周囲の光に合わせて表示色を自動的に調整します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주변 조명에 맞게 디스플레이 색상을 자동으로 조정합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste as cores da tela automaticamente para corresponder à luz ambiente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматическая настройка цветов дисплея в соответствии с окружающим освещением."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "根據環境光自動調節顯示器顏色。"
          }
        }
      }
    },
    "Adjust how long a key must be held before it is accepted.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust how long a key must be held before it is accepted."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir tuşun kabul edilmesi için ne kadar basılı tutulacağını ayarlar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整按键被接受前需要按住的时间。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضبط مدة الضغط على المفتاح قبل قبوله."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anpassen, wie lange eine Taste gedrückt gehalten werden muss, bevor sie erkannt wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta cuánto tiempo se debe mantener presionada una tecla antes de que se acepte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustez la durée pendant laquelle une touche doit rester enfoncée avant que la frappe soit prise en compte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キー入力が認識されるまでにキーを押し続ける必要がある時間を調整します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 입력이 인식될 때까지 키를 누르고 있어야 하는 시간을 조절합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste por quanto tempo uma tecla deve ser pressionada antes de ser aceita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте время удержания клавиши до регистрации нажатия."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調整按住按鍵多久後才會生效。"
          }
        }
      }
    },
