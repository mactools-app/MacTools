    "Could not read the menu bar visibility mode. Enable or update the Auto-hide Menu Bar plugin.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not read the menu bar visibility mode. Enable or update the Auto-hide Menu Bar plugin."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Menü çubuğu görünürlük modu okunamadı. Otomatik Gizlenen Menü Çubuğu eklentisini etkinleştirin veya güncelleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取菜单栏显示模式。请启用或更新“自动隐藏菜单栏”插件。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر قراءة وضع إظهار شريط القوائم. فعّل إضافة الإخفاء التلقائي لشريط القوائم أو حدّثها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Sichtbarkeitsmodus der Menüleiste konnte nicht gelesen werden. Aktivieren oder aktualisieren Sie das Plugin zum automatischen Ausblenden der Menüleiste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el modo de visibilidad de la barra de menús. Activa o actualiza el plugin Ocultar barra de menús automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire le mode de visibilité de la barre de menu. Activez ou mettez à jour le plugin Masquer automatiquement la barre de menus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーの表示モードを読み取れませんでした。「メニューバーの自動非表示」プラグインを有効にするか、更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대 표시 모드를 읽을 수 없습니다. ‘메뉴 막대 자동 숨기기’ 플러그인을 활성화하거나 업데이트하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o modo de visibilidade da barra de menus. Habilite ou atualize o plugin Ocultar barra de menus automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать режим видимости строки меню. Включите или обновите плагин автоматического скрытия строки меню."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取選單列顯示模式。請啟用或更新「自動隱藏選單列」外掛。"
          }
        }
      }
    },
