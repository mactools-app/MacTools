    "Show files, folders, and other items on the desktop.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show files, folders, and other items on the desktop."
          }
        },
        "tr": {
