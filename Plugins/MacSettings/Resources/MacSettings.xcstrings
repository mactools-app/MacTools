    "Only local changes made through MacTools are recorded.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only local changes made through MacTools are recorded."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca MacTools üzerinden yapılan yerel değişiklikler kaydedilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅记录通过 MacTools 完成的本地更改。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تسجيل التغييرات المحلية التي تم إجراؤها من خلال MacTools فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden nur lokale Änderungen erfasst, die über MacTools vorgenommen wurden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se registran los cambios locales realizados a través de MacTools."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les modifications locales effectuées via MacTools sont enregistrées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools を通じて行われたローカルな変更のみが記録されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools를 통해 수행된 로컬 변경 사항만 기록됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente alterações locais feitas por meio de MacTools são registradas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записываются только локальные изменения, внесенные с помощью MacTools."
          }
