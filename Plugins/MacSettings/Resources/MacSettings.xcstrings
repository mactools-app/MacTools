    "Recovery records have not been saved. Do not quit the app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery records have not been saved. Do not quit the app."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurtarma kayıtları kaydedilmedi. Uygulamadan çıkmayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复记录未保存，请勿退出应用。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم حفظ سجلات الاسترداد. لا تقم بإنهاء التطبيق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederherstellungsdaten wurden nicht gespeichert. Beenden Sie die App nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los registros de recuperación no se han guardado. No salgas de la aplicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données de récupération n’ont pas été enregistrées. Ne quittez pas l’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元用の記録が保存されていません。アプリを終了しないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복구 기록이 저장되지 않았습니다. 앱을 종료하지 마세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os registros de recuperação não foram salvos. Não encerre o aplicativo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи восстановления не сохранены. Не выходите из приложения."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還原記錄未儲存，請勿結束應用程式。"
          }
        }
      }
    },
    "Recovery records have not been saved. Do not quit the app. Resolve recovery, then retry saving.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery records have not been saved. Do not quit the app. Resolve the recovery issue, then retry saving."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurtarma kayıtları kaydedilmedi. Uygulamadan çıkmayın. Kurtarma sorununu giderin, ardından kaydetmeyi yeniden deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复记录未保存，请勿退出应用。处理恢复后可重试保存。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم حفظ سجلات الاسترداد. لا تقم بإنهاء التطبيق. قم بحل مشكلة الاسترداد، ثم أعد محاولة الحفظ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederherstellungsdaten wurden nicht gespeichert. Beenden Sie die App nicht. Schließen Sie die Wiederherstellung ab und versuchen Sie erneut zu speichern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los registros de recuperación no se han guardado. No salgas de la app. Resuelve la recuperación y vuelve a intentar guardarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données de récupération n’ont pas été enregistrées. Ne quittez pas l’app. Résolvez le problème de récupération, puis réessayez l’enregistrement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元用の記録が保存されていません。アプリを終了しないでください。復元の問題に対処してから、保存を再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복구 기록이 저장되지 않았습니다. 앱을 종료하지 마세요. 복구 문제를 처리한 후 다시 저장해 보세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os registros de recuperação não foram salvos. Não encerre o aplicativo. Resolva a recuperação e tente salvar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи восстановления не сохранены. Не закрывайте приложение. Устраните проблемы восстановления, затем повторите сохранение."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還原記錄未儲存，請勿結束應用程式。解決還原問題後，請重試儲存。"
          }
        }
      }
    },
