    "Select a setting to include it in this profile. Off is still an explicit desired value.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a setting to include it in this profile. Off is still an explicit desired value."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ayarı bu profile dahil etmek için seçin. Kapalı konumu da açık bir istenen değerdir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "勾选表示配置会管理该设置；关闭仍是一个明确的期望值。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدد إعدادًا لتضمينه في ملف التعريف هذا. يبقى «معطّل» قيمة مستهدفة محددة صراحةً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie eine Einstellung aus, um sie in dieses Profil aufzunehmen. „Aus“ ist ebenfalls ein expliziter Sollwert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona un ajuste para incluirlo en este perfil. Desactivado también es un valor deseado explícito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez un paramètre pour l’inclure dans ce profil. « Désactivé » reste une valeur souhaitée explicite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロファイルに含める設定を選択します。「オフ」も明示的な変更後の値として扱われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 프로필에 포함할 설정을 선택하세요. ‘끔’도 명시적인 목표 값입니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione uma configuração para incluí-la neste perfil. Desligado também é um valor desejado explícito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите настройку, чтобы включить ее в профиль. Значение «Выкл.» также сохраняется как желаемое состояние."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "勾選後，此設定檔會管理該設定；「關閉」也是明確的目標值。"
          }
        }
      }
    },
