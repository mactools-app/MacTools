    "Could not read the appearance mode. Enable or update the Dark Mode plugin.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not read the appearance mode. Enable or update the Dark Mode plugin."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görünüm modu okunamadı. Karanlık Mod eklentisini etkinleştirin veya güncelleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
