    "Enter a name or keyword to view and change settings directly.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a name or keyword to view and change settings directly."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarları doğrudan görüntülemek ve değiştirmek için bir ad veya anahtar sözcük girin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入名称或关键词，即可直接查看和更改设置。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل اسمًا أو كلمة رئيسية لعرض الإعدادات وتغييرها مباشرةً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie einen Namen oder ein Schlagwort ein, um Einstellungen direkt anzuzeigen und zu ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingrese un nombre o palabra clave para ver y cambiar la configuración directamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un nom ou un mot-clé pour afficher et modifier directement les paramètres."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前またはキーワードを入力して、設定を直接表示および変更します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름이나 키워드를 입력하면 바로 설정을 확인하고 변경할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira um nome ou palavra-chave para visualizar e alterar as configurações diretamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите имя или ключевое слово, чтобы просмотреть и изменить настройки напрямую."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入名稱或關鍵字，即可直接查看和更改設定。"
