        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动隐藏和显示菜单栏"
          }
        }
      }
    },
    "Choose when macOS automatically hides the menu bar.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
