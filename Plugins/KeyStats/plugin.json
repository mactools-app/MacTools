{
  "id": "key-stats",
  "displayName": "按键统计",
  "summary": "统计每个按键与触控板的使用次数，保留近七天数据",
  "localizedMetadata": {
    "ar": {
      "displayName": "إحصاءات المفاتيح",
      "summary": "تتبع استخدام كل مفتاح ولوحة التتبع مع الاحتفاظ ببيانات سبعة أيام."
    },
    "de": {
      "displayName": "Tastenstatistik",
      "summary": "Verfolgen Sie die Nutzung jeder Taste und des Trackpads über sieben Tage."
    },
    "en": {
      "displayName": "Key Stats",
      "summary": "Track usage for every key and your trackpad, keeping the last seven days."
    },
    "es": {
      "displayName": "Estadísticas de teclas",
      "summary": "Registra el uso de cada tecla y del panel táctil durante los últimos siete días."
    },
    "fr": {
      "displayName": "Statistiques de touches",
      "summary": "Suivez l’utilisation de chaque touche et du pavé tactile sur les sept derniers jours."
    },
    "ja": {
      "displayName": "キー統計",
      "summary": "各キーとトラックパッドの使用回数を記録し、直近 7 日分を保存します。"
    },
    "ko": {
      "displayName": "키 통계",
      "summary": "모든 키와 트랙패드 사용 횟수를 기록하고 최근 7일간 보관합니다."
    },
    "pt": {
      "displayName": "Estatísticas de teclas",
      "summary": "Acompanhe o uso de cada tecla e do trackpad nos últimos sete dias."
    },
    "ru": {
      "displayName": "Статистика клавиш",
      "summary": "Отслеживайте использование каждой клавиши и трекпада за последние семь дней."
    },
    "tr": {
      "displayName": "Tuş İstatistikleri",
      "summary": "Her tuşun ve izleme dörtgeninin kullanımını son yedi gün boyunca izleyin."
    },
    "zh-Hans": {
      "displayName": "按键统计",
      "summary": "统计每个按键与触控板的使用次数，保留近七天数据"
    },
    "zh-Hant": {
      "displayName": "按鍵統計",
      "summary": "統計每個按鍵與觸控板的使用次數，保留近七天資料"
    }
  },
