    "action.enableLight.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشغيل الوضع الفاتح"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hellen Modus aktivieren"
          }
