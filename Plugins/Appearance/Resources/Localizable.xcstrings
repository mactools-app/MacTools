{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "error.modeUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This macOS version cannot set automatic appearance directly."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu macOS sürümünde otomatik görünüm doğrudan ayarlanamıyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前 macOS 无法直接设置自动外观。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن لإصدار macOS هذا ضبط المظهر التلقائي مباشرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese macOS-Version kann das automatische Erscheinungsbild nicht direkt festlegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión de macOS no puede configurar la apariencia automática directamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version macOS ne peut pas définir directement l'apparence automatique."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この macOS バージョンでは、外観を直接「自動」に設定できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 macOS 버전에서는 화면 모드를 ‘자동’으로 직접 설정할 수 없습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versão do macOS não pode definir a aparência automática diretamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этой версии macOS нельзя напрямую включить автоматическое переключение оформления."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前 macOS 無法直接設定自動外觀。"
          }
        }
      }
    },
    "error.modeVerificationRestored": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appearance verification failed. The original mode was restored."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görünüm doğrulaması başarısız oldu. Özgün mod geri yüklendi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外观验证失败，已恢复原模式。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل التحقق من المظهر. تمت استعادة الوضع الأصلي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfung des Erscheinungsbilds fehlgeschlagen. Der ursprüngliche Modus wurde wiederhergestellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error en la verificación de apariencia. Se restauró el modo original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vérification de l'apparence a échoué. Le mode d'origine a été restauré."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外観設定の確認に失敗しました。元のモードに戻しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 모드 확인에 실패했습니다. 원래 모드가 복원되었습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha na verificação de aparência. O modo original foi restaurado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить режим оформления. Исходный режим восстановлен."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "外觀驗證失敗，已還原原本的模式。"
          }
        }
      }
    },
    "error.modeVerificationUnrestored": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appearance verification failed. The original mode could not be fully restored."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görünüm doğrulaması başarısız oldu. Özgün mod tam olarak geri yüklenemedi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外观验证失败，恢复原模式未完成。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل التحقق من المظهر. تعذرت استعادة الوضع الأصلي بالكامل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfung des Erscheinungsbilds fehlgeschlagen. Der ursprüngliche Modus konnte nicht vollständig wiederhergestellt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error en la verificación de apariencia. No se pudo restaurar completamente el modo original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vérification de l'apparence a échoué. Le mode d'origine n'a pas pu être entièrement restauré."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外観設定の確認に失敗しました。元のモードを完全に復元できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 모드 확인에 실패했습니다. 원래 모드를 완전히 복원하지 못했습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha na verificação de aparência. O modo original não pôde ser totalmente restaurado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить режим оформления. Исходный режим не удалось полностью восстановить."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "外觀驗證失敗，未能完整還原原本的模式。"
          }
        }
      }
    },
    "parameter.mode.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
