          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "外觀"
          }
        }
      }
    },
    "action.setMode.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set System Appearance"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Görünümünü Ayarla"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置系统外观"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضبط مظهر النظام"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "System-Erscheinungsbild festlegen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurar la apariencia del sistema"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définir l'apparence du système"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムの外観を設定する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 화면 모드 설정"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Definir aparência do sistema"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настроить оформление системы"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定系統外觀"
          }
        }
      }
    },
    "action.setMode.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose automatic, light, or dark system appearance."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik, aydınlık veya karanlık sistem görünümünü seçin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择自动、浅色或深色系统外观。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر المظهر التلقائي أو الفاتح أو الداكن للنظام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie das automatische, helle oder dunkle System-Erscheinungsbild."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija la apariencia del sistema automática, clara u oscura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez l'apparence du système automatique, claire ou sombre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムの外観を「自動」、「ライト」、「ダーク」から選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 화면 모드를 자동, 라이트 또는 다크 모드로 설정합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha a aparência do sistema automática, clara ou escura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите светлое или темное оформление системы либо автоматическое переключение между ними."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇自動、淺色或深色系統外觀。"
          }
        }
      }
    },
