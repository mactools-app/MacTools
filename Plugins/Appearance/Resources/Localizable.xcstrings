        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外観"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 모드"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparência"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
