    "action.confirmation.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي رابط التشغيل هذا إلى قفل الشاشة فورًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Ausführungslink sperrt den Bildschirm sofort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Run Link will lock the screen immediately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este enlace de ejecución bloqueará la pantalla inmediatamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce lien d’exécution verrouillera immédiatement l’écran."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この実行リンクは画面をすぐにロックします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 실행 링크는 화면을 즉시 잠급니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este link de execução bloqueará a tela imediatamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта ссылка запуска немедленно заблокирует экран."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Çalıştırma Bağlantısı ekranı hemen kilitleyecek."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此运行链接将立即锁定屏幕。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此執行連結會立即鎖定螢幕。"
          }
        }
      }
    },
