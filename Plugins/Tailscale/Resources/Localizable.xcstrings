{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "login.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {"stringUnit": {"state": "translated", "value": "تسجيل الدخول إلى Tailscale"}},
        "de": {"stringUnit": {"state": "translated", "value": "Bei Tailscale anmelden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Sign In to Tailscale"}},
        "es": {"stringUnit": {"state": "translated", "value": "Iniciar sesión en Tailscale"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Se connecter à Tailscale"}},
        "ja": {"stringUnit": {"state": "translated", "value": "Tailscale にサインイン"}},
        "ko": {"stringUnit": {"state": "translated", "value": "Tailscale에 로그인"}},
        "pt": {"stringUnit": {"state": "translated", "value": "Entrar no Tailscale"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Войти в Tailscale"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Tailscale’e Giriş Yap"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "登录 Tailscale"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "登入 Tailscale"}}
      }
    },
    "login.failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {"stringUnit": {"state": "translated", "value": "تعذر فتح صفحة تسجيل الدخول. تحقق من اتصالك وحاول مجددًا."}},
        "de": {"stringUnit": {"state": "translated", "value": "Die Anmeldeseite konnte nicht geöffnet werden. Prüfe die Verbindung und versuche es erneut."}},
        "en": {"stringUnit": {"state": "translated", "value": "Could not open the sign-in page. Check your connection and try again."}},
        "es": {"stringUnit": {"state": "translated", "value": "No se pudo abrir la página de inicio de sesión. Comprueba la conexión e inténtalo de nuevo."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Impossible d’ouvrir la page de connexion. Vérifiez votre connexion et réessayez."}},
        "ja": {"stringUnit": {"state": "translated", "value": "サインインページを開けませんでした。接続を確認して、もう一度お試しください。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "로그인 페이지를 열 수 없습니다. 연결을 확인하고 다시 시도하세요."}},
        "pt": {"stringUnit": {"state": "translated", "value": "Não foi possível abrir a página de login. Verifique sua conexão e tente novamente."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Не удалось открыть страницу входа. Проверьте подключение и повторите попытку."}},
        "tr": {"stringUnit": {"state": "translated", "value": "Giriş sayfası açılamadı. Bağlantınızı kontrol edip tekrar deneyin."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法打开登录页，请检查网络后重试。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "無法開啟登入頁面，請檢查網路後再試。"}}
      }
    },
    "action.openAdminConsole.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح وحدة تحكم إدارة Tailscale في المتصفح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale-Administrationskonsole im Browser öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the Tailscale admin console in your browser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la consola de administración de Tailscale en el navegador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez la console d’administration Tailscale dans le navigateur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザで Tailscale 管理コンソールを開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저에서 Tailscale 관리 콘솔을 엽니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o console de administração do Tailscale no navegador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает консоль управления Tailscale в браузере."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale yönetim konsolunu tarayıcıda açın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在浏览器中打开 Tailscale 管理控制台。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在瀏覽器中開啟 Tailscale 管理主控台。"
          }
        }
      }
    },
    "action.openAdminConsole.title": {
      "extractionState": "manual",
      "localizations": {
