          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale bağlantısını değiştir"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换 Tailscale 连接"
          }
        },
        "zh-Hant": {
