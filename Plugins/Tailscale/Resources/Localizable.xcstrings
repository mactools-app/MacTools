          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale 관리 콘솔 열기"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir console de administração do Tailscale"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть консоль управления Tailscale"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale yönetim konsolunu aç"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Tailscale 管理控制台"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟 Tailscale 管理主控台"
          }
        }
      }
    },
    "action.toggle.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاتصال بـ Tailscale أو قطع الاتصال به."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale verbinden oder trennen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch Tailscale between connected and disconnected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta o desconecta Tailscale."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez ou déconnectez Tailscale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale に接続するか、接続を解除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale을 연결하거나 연결을 끊습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte ou desconecte o Tailscale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключает или отключает Tailscale."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale bağlantısını kurun veya kesin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在已连接和已断开之间切换 Tailscale。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線或中斷 Tailscale 連線。"
          }
        }
      }
    },
