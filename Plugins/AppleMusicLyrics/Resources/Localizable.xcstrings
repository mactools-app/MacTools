    "settings.karaokeEnabled.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Highlight sung and upcoming words progressively. Lyric timing data is not always exact, so the per-word effect may drift from the actual singing."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Highlight sung and upcoming words progressively. Lyric timing data is not always exact, so the per-word effect may drift from the actual singing."
