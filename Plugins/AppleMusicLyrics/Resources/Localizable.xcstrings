    "settings.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When Apple Music is playing a song with lyrics, a frosted-glass desktop lyrics panel appears in the top-right corner."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Apple Music 播放且有歌词时，屏幕右上角会显示毛玻璃效果的桌面歌词。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Apple Music 播放且有歌詞時，螢幕右上角會顯示毛玻璃效果的桌面歌詞。"
          }
        },
