    "metadata.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلمات Apple Music"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Music Liedtexte"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Music Lyrics"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Letras de Apple Music"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paroles Apple Music"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Music 歌詞"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Music 가사"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Letras do Apple Music"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тексты Apple Music"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Music Şarkı Sözleri"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Music 歌词"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Music 歌詞"
          }
        }
      }
    },
    "metadata.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرض كلمات الأغاني من Apple Music في الزاوية العلوية اليمنى من الشاشة مع تأثير زجاجي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt Apple-Music-Liedtexte mit Glas-Effekt in der oberen rechten Bildschirmecke an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show frosted-glass Apple Music lyrics in the top-right corner of the screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra letras de Apple Music con efecto de vidrio esmerilado en la esquina superior derecha de la pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche les paroles Apple Music avec un effet verre dépoli dans le coin supérieur droit de l’écran."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Musicの歌詞をすりガラス効果付きで画面の右上に表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Music 가사를 유리 효과와 함께 화면 오른쪽 상단에 표시합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra letras do Apple Music com efeito de vidro fosco no canto superior direito da tela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывайте тексты песен Apple Music с эффектом матового стекла в правом верхнем углу экрана."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Music şarkı sözlerini buzlu cam efektli olarak ekranın sağ üst köşesinde gösterin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在屏幕右上角显示毛玻璃效果的 Apple Music 桌面歌词"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在螢幕右上角顯示毛玻璃效果的 Apple Music 桌面歌詞"
          }
        }
      }
    },
