  "strings": {
    "执行前需要确认。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يلزم التأكيد قبل التشغيل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor der Ausführung ist eine Bestätigung erforderlich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmation is required before running."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere confirmación antes de ejecutar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une confirmation est requise avant l’exécution."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行前に確認が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행 전에 확인이 필요합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "É necessária confirmação antes de executar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед запуском требуется подтверждение."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalıştırmadan önce onay gerekir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "执行前需要确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "執行前需要確認。"
          }
        }
      }
    },
