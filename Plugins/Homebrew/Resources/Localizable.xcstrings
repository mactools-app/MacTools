    "detail.confirm.untap.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führt brew untap %@ aus. Pakete aus dieser Quelle erhalten möglicherweise keine Updates mehr."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "brew untap %@을(를) 실행합니다. 이 소스의 패키지는 더 이상 업데이트를 받지 못할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполняет brew untap %@. Пакеты из этого источника могут перестать получать обновления."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشغّل brew untap %@. قد تتوقف الحزم من هذا المصدر عن تلقي التحديثات."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs brew untap %@. Packages from this source may stop receiving updates."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecuta brew untap %@. Los paquetes de esta fuente podrían dejar de actualizarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécute brew untap %@. Les paquets de cette source peuvent ne plus recevoir de mises à jour."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "brew untap %@ を実行します。このソースに依存するパッケージは更新できなくなる場合があります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
