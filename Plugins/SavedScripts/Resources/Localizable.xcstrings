    "validation.recoveryRequired": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذرت قراءة مكتبة البرامج النصية؛ استورد نسخة احتياطية لاستعادتها."
          }
        },
        "de": {
