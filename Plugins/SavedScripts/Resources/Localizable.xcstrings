    "settings.library.invalid": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة مكتبة البرامج النصية؛ تم الاحتفاظ ببياناتها الأصلية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Skriptbibliothek konnte nicht gelesen werden; die Originaldaten wurden beibehalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The script library could not be read; its original data was preserved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer la biblioteca de scripts; se conservaron sus datos originales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La bibliothèque de scripts n’a pas pu être lue ; ses données d’origine ont été conservées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリプトライブラリを読み込めませんでした。元のデータは保持されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크립트 보관함을 읽을 수 없습니다. 원본 데이터는 보존되었습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler a biblioteca de scripts; os dados originais foram preservados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать библиотеку скриптов; исходные данные сохранены."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Betik kitaplığı okunamadı; özgün veriler korundu."
