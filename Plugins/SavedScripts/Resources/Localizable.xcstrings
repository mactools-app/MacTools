    "settings.empty.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف برنامج AppleScript أو برنامج shell نصيًا، ثم شغّله هنا أو من أي واجهة إجراءات في MacTools."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge ein AppleScript- oder Shell-Skript hinzu und führe es hier oder über eine beliebige MacTools-Aktionsoberfläche aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add an AppleScript or shell script, then run it here or use it from any MacTools action surface."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un script de AppleScript o shell y ejecútalo aquí o desde cualquier superficie de acciones de MacTools."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un script AppleScript ou shell, puis exécutez-le ici ou depuis toute surface d’action MacTools."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AppleScript またはシェルスクリプトを追加し、ここや MacTools の任意のアクション画面から実行できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AppleScript 또는 셸 스크립트를 추가한 다음 여기나 MacTools의 모든 동작 화면에서 실행하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione um script AppleScript ou shell e execute-o aqui ou em qualquer superfície de ações do MacTools."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте скрипт AppleScript или shell, затем запустите его здесь или с любой поверхности действий MacTools."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir AppleScript veya Shell betiği ekleyin; ardından buradan çalıştırın ya da MacTools'un herhangi bir eylem yüzeyinden kullanın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加 AppleScript 或 Shell 脚本，然后直接运行或在 MacTools 的其他操作入口中使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入 AppleScript 或 Shell 腳本，然後直接執行或在 MacTools 的其他操作入口中使用。"
          }
        }
      }
    },
