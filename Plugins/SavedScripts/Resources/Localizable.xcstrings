    "settings.delete.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستصبح الاختصارات والإيماءات وخلايا شبكة الإجراءات ومهام سير العمل التي تستخدم هذا البرنامج النصي غير متاحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurzbefehle, Gesten, Aktionsraster-Felder und Workflows, die dieses Skript verwenden, sind anschließend nicht mehr verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shortcuts, gestures, Action Grid cells, and workflows that use this script will become unavailable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los atajos, gestos, celdas de la Cuadrícula de acciones y flujos de trabajo que usan este script dejarán de estar disponibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les raccourcis, gestes, cellules de la Grille d’actions et workflows utilisant ce script deviendront indisponibles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスクリプトを使用するショートカット、ジェスチャ、アクショングリッドのセル、ワークフローは利用できなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 스크립트를 사용하는 단축키, 제스처, 동작 그리드 셀 및 워크플로를 사용할 수 없게 됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atalhos, gestos, células da Grade de ações e fluxos de trabalho que usam este script ficarão indisponíveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сочетания клавиш, жесты, ячейки Сетки действий и процессы, использующие этот скрипт, станут недоступны."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu betiği kullanan kısayollar, hareketler, Eylem Izgarası hücreleri ve iş akışları kullanılamaz hale gelir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用此脚本的快捷键、手势、操作网格和工作流将变为不可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用此腳本的快速鍵、手勢、操作網格和工作流程將無法使用。"
          }
        }
      }
    },
