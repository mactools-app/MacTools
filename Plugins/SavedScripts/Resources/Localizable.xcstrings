    "editor.backup.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد تحتوي البرامج النصية على معلومات حساسة، ولذلك تُستبعد افتراضيًا. لا يتم تضمين مجلدات العمل مطلقًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Skripte können vertrauliche Informationen enthalten und werden daher standardmäßig ausgeschlossen. Arbeitsordner werden nie einbezogen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scripts may contain sensitive information, so they are excluded by default. Working directories are never included."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los scripts pueden contener información confidencial, por lo que se excluyen de forma predeterminada. Las carpetas de trabajo nunca se incluyen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les scripts peuvent contenir des informations sensibles et sont donc exclus par défaut. Les dossiers de travail ne sont jamais inclus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリプトには機密情報が含まれる可能性があるため、デフォルトでは除外されます。作業フォルダは含まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크립트에 민감한 정보가 포함될 수 있으므로 기본적으로 제외됩니다. 작업 폴더는 포함되지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Scripts podem conter informações confidenciais e, por isso, são excluídos por padrão. Pastas de trabalho nunca são incluídas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрипты могут содержать конфиденциальные данные, поэтому по умолчанию исключены. Рабочие папки никогда не включаются."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Betikler hassas bilgiler içerebileceği için varsayılan olarak yedeklere dahil edilmez. Çalışma dizinleri hiçbir zaman dahil edilmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "脚本可能包含敏感信息，因此默认不备份。工作目录不会写入备份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "腳本可能包含敏感資訊，因此預設不備份。工作目錄不會寫入備份。"
          }
        }
      }
    },
