{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "action.confirm.button": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشغيل"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausführen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecutar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécuter"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Executar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запустить"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalıştır"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "執行"
          }
        }
      }
    },
    "action.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل البرنامج النصي بصلاحيات المستخدم الخاصة بك وقد يصل إلى ملفاتك وتطبيقاتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Skript wird mit deinen Benutzerrechten ausgeführt und kann auf deine Dateien und Apps zugreifen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The script runs with your user permissions and may access your files and applications."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El script se ejecuta con tus permisos de usuario y puede acceder a tus archivos y aplicaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le script s’exécute avec vos autorisations utilisateur et peut accéder à vos fichiers et applications."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリプトはユーザ権限で実行され、ファイルやアプリにアクセスする場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크립트는 사용자 권한으로 실행되며 파일과 앱에 접근할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O script é executado com suas permissões de usuário e pode acessar seus arquivos e aplicativos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрипт выполняется с вашими правами пользователя и может получать доступ к файлам и приложениям."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Betik, kullanıcı izinlerinizle çalışır; dosyalarınıza ve uygulamalarınıza erişebilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "脚本将以你的用户权限运行，并可访问你的文件和应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "腳本將以你的使用者權限執行，並可存取你的檔案和 App。"
          }
        }
      }
    },
    "action.confirm.title.format": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشغيل «%@»؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ausführen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run “%@”?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Ejecutar «%@»?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécuter « %@ » ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を実行しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’을(를) 실행할까요?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Executar “%@”?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запустить «%@»?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” çalıştırılsın mı?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行“%@”？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "執行「%@」？"
          }
        }
      }
    },
    "action.description.format": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشغيل برنامج %@ النصي المحفوظ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führt das gespeicherte %@-Skript aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run the saved %@ script."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecuta el script %@ guardado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécute le script %@ enregistré."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みの %@ スクリプトを実行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 %@ 스크립트를 실행합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Executa o script %@ salvo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускает сохранённый скрипт %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı %@ betiğini çalıştırır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行已存的 %@ 脚本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "執行已儲存的 %@ 腳本。"
          }
        }
      }
    },
    "action.unavailable.interpreter": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفسّر البرنامج النصي غير متاح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Skriptinterpreter ist nicht verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The script interpreter is unavailable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El intérprete del script no está disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’interpréteur du script est indisponible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリプトのインタプリタを利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크립트 인터프리터를 사용할 수 없습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O interpretador do script não está disponível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Интерпретатор скрипта недоступен."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Betik yorumlayıcısı kullanılamıyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "脚本解释器不可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "腳本解譯器無法使用。"
          }
        }
      }
    },
