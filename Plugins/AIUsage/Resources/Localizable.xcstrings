    "pace.steady.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This week’s quota is being used at a normal pace."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu haftanın kotası normal bir tempoda kullanılıyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本周额度消耗处于正常节奏。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم استخدام حصة هذا الأسبوع بوتيرة عادية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Kontingent für diese Woche wird in normalem Tempo verbraucht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuota de esta semana se está utilizando a un ritmo normal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le quota de cette semaine est utilisé à un rythme normal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今週の利用枠は通常のペースで消費されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 주 할당량은 정상적인 속도로 사용되고 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A cota desta semana está sendo utilizada em ritmo normal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Квота этой недели используется в обычном темпе."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本週額度使用速度正常。"
          }
        }
      }
    },
    "pace.ahead.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This week’s quota is being used quickly and may run out before the reset at this pace."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu haftanın kotası hızlı kullanılıyor; bu tempoyla sıfırlanmadan önce tükenebilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本周额度消耗偏快，照此节奏可能在重置前用完。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم استخدام حصة هذا الأسبوع بسرعة وقد تنفد قبل إعادة التعيين بهذه الوتيرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Kontingent für diese Woche wird schnell verbraucht und könnte bei diesem Tempo vor der Zurücksetzung erschöpft sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuota de esta semana se está usando rápidamente y, a este ritmo, puede agotarse antes de restablecerse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le quota de cette semaine est utilisé rapidement et pourrait s'épuiser avant la réinitialisation à ce rythme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今週の利用枠の消費が速く、このペースではリセット前に使い切る可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 주 할당량은 빠르게 소진되고 있어 이 속도라면 재설정되기 전에 소진될 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A cota desta semana está sendo usada rapidamente e pode acabar antes da redefinição nesse ritmo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Квота на этой неделе используется быстро и может исчерпаться до сброса такими темпами."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本週額度使用速度偏快，照此速度可能在重設前用完。"
          }
        }
      }
    },
    "pace.fiveHour.steady.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quota usage is on pace for the current 5-hour cycle."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçerli 5 saatlik dönemde kota kullanımı normal tempoda."
          }
        },
        "zh-Hans": {
