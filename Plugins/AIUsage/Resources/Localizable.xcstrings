{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "access.allow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read local login files"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel oturum açma dosyalarını oku"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取本机登录文件"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قراءة ملفات تسجيل الدخول المحلية"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Anmeldedateien lesen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer archivos de inicio de sesión locales"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lire les fichiers de connexion locaux"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルログインファイルの読み取り"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 로그인 파일 읽기"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ler arquivos de login locais"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтение локальных файлов входа"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀取本機登入檔案"
          }
        }
      }
    },
    "access.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow access to local Codex and Claude Code login files."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex ve Claude Code'un yerel oturum açma dosyalarına erişime izin verir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许读取 Codex 和 Claude Code 的本机登录文件。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح بالوصول إلى ملفات تسجيل الدخول المحلية لـ Codex وClaude Code."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugriff auf lokale Anmeldedateien von Codex und Claude Code erlauben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir acceso a los archivos locales de inicio de sesión de Codex y Claude Code."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser l’accès aux fichiers locaux de connexion de Codex et Claude Code."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CodexとClaude Codeのローカルログインファイルへのアクセスを許可します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex 및 Claude Code의 로컬 로그인 파일에 대한 접근을 허용합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir acesso aos arquivos locais de login do Codex e Claude Code."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить доступ к локальным файлам входа Codex и Claude Code."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許讀取 Codex 和 Claude Code 的本機登入檔案。"
          }
        }
      }
    },
    "access.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only reads credentials to query the corresponding service. Conversations are never accessed and tokens are not stored. Access permissions are independent of service visibility. No Accessibility or Full Disk Access is needed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca ilgili hizmeti sorgulamak amacıyla kimlik bilgileri okunur. Konuşmalara asla erişilmez ve belirteçler depolanmaz. Erişim izinleri, hizmet görünürlüğünden bağımsızdır. Erişilebilirlik veya Tam Disk Erişimi gerekmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅读取登录凭据并向对应服务查询额度，不读取对话、不保存令牌。授权与服务展示独立，无需辅助功能或完全磁盘访问权限。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُقرأ بيانات الاعتماد فقط للاستعلام عن الخدمة المعنية. لا يتم الوصول إلى المحادثات مطلقًا ولا تُخزّن الرموز المميزة. أذونات الوصول مستقلة عن عرض الخدمة. لا يلزم إذن تسهيلات الاستخدام أو الوصول الكامل إلى القرص."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden nur Zugangsdaten gelesen, um den entsprechenden Dienst abzufragen. Auf Konversationen wird nicht zugegriffen, und Token werden nicht gespeichert. Die Zugriffsberechtigungen sind unabhängig von der Sichtbarkeit des Dienstes. Berechtigungen für Bedienungshilfen oder Festplattenvollzugriff sind nicht erforderlich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo lee las credenciales para consultar el servicio correspondiente. Nunca se accede a las conversaciones y los tokens no se almacenan. Los permisos de acceso son independientes de la visibilidad del servicio. No se necesita accesibilidad ni acceso total al disco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit uniquement les identifiants pour interroger le service correspondant. Les conversations ne sont jamais consultées et les jetons ne sont pas stockés. Les autorisations d’accès sont indépendantes de la visibilité du service. Les autorisations Accessibilité et Accès complet au disque ne sont pas nécessaires."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証情報を読み取り、対応するサービスに利用枠を問い合わせます。会話の読み取りやトークンの保存は行いません。アクセス許可とサービスの表示設定は独立しています。アクセシビリティやフルディスクアクセスの許可は不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 서비스의 할당량을 조회하기 위해 로그인 자격 증명만 읽습니다. 대화에는 접근하지 않으며 토큰은 저장하지 않습니다. 접근 권한은 서비스 표시 여부와 무관합니다. 손쉬운 사용이나 전체 디스크 접근 권한은 필요하지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê apenas credenciais para consultar o serviço correspondente. As conversas nunca são acessadas e os tokens não são armazenados. As permissões de acesso são independentes da visibilidade do serviço. Não são necessárias as permissões de Acessibilidade ou Acesso Total ao Disco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Учетные данные считываются только для запроса соответствующей службы. Доступ к беседам не осуществляется, токены не сохраняются. Разрешения на доступ не зависят от видимости службы. Разрешения «Универсальный доступ» и «Доступ к диску» не требуются."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅讀取登入憑證並向對應服務查詢額度，不讀取對話、不儲存權杖。授權與服務顯示各自獨立，無需輔助使用或完全取用磁碟權限。"
          }
        }
      }
    },
    "keychain.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enabling may request macOS authorization. Background reads never show prompts."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkinleştirildiğinde macOS yetkilendirmesi istenebilir. Arka planda yapılan okumalarda hiçbir zaman istem gösterilmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启时可能请求 macOS 授权，后台读取不会弹窗。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يطلب macOS إذنًا عند التمكين. لا تظهر طلبات الإذن أثناء القراءة في الخلفية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Aktivieren kann macOS eine Berechtigung anfordern. Lesezugriffe im Hintergrund lösen keine Rückfragen aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al activarlo, macOS puede solicitar autorización. Las lecturas en segundo plano nunca muestran solicitudes de autorización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’activation peut nécessiter une autorisation de macOS. Les lectures en arrière-plan n’affichent jamais de demandes d’autorisation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると macOS の許可を求められる場合があります。バックグラウンドでの読み取りでは確認ダイアログは表示されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성화하면 macOS 인증을 요청할 수 있습니다. 백그라운드 읽기에는 프롬프트가 표시되지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao ativar, pode ser solicitada autorização do macOS. Leituras em segundo plano nunca exibem pedidos de autorização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При включении macOS может запросить разрешение. При фоновом чтении запросы разрешения не показываются."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟時可能要求 macOS 授權；背景讀取不會顯示提示。"
          }
        }
      }
    },
    "keychain.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read Claude Code Keychain"
          }
        },
        "tr": {
