{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "access.allow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read local login files"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel oturum açma dosyalarını oku"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取本机登录文件"
          }
        }
      }
    },
    "access.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow access to local Codex and Claude Code login files."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex ve Claude Code'un yerel oturum açma dosyalarına erişime izin verir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许读取 Codex 和 Claude Code 的本机登录文件。"
          }
        }
      }
    },
    "access.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only reads credentials to query the corresponding service. Conversations are never accessed and tokens are not stored. Access permissions are independent of service visibility. No Accessibility or Full Disk Access is needed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca ilgili hizmeti sorgulamak amacıyla kimlik bilgileri okunur. Konuşmalara asla erişilmez ve belirteçler depolanmaz. Erişim izinleri, hizmet görünürlüğünden bağımsızdır. Erişilebilirlik veya Tam Disk Erişimi gerekmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅读取登录凭据并向对应服务查询额度，不读取对话、不保存令牌。授权与服务展示独立，无需辅助功能或完全磁盘访问权限。"
          }
        }
      }
    },
    "keychain.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enabling may request macOS authorization. Background reads never show prompts."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkinleştirildiğinde macOS yetkilendirmesi istenebilir. Arka planda yapılan okumalarda hiçbir zaman istem gösterilmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启时可能请求 macOS 授权，后台读取不会弹窗。"
          }
        }
      }
    },
    "keychain.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read Claude Code Keychain"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code Keychain'ini Oku"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取 Claude Code 钥匙串"
          }
        }
      }
    },
    "menuBar.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show remaining quota for every enabled service. Click for the dashboard; right-click for settings."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkinleştirilen her hizmetin kalan kotasını gösterir. Paneli açmak için tıklayın, ayarlar için sağ tıklayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示所有已启用服务的剩余额度。点击打开仪表盘，右键打开设置。"
          }
        }
      }
    },
    "menuBar.show": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show usage in menu bar"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanımı menü çubuğunda göster"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在菜单栏显示用量"
          }
        }
      }
    },
    "metadata.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View Codex and Claude Code subscription quotas and reset times"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex ve Claude Code abonelik kotalarını ve sıfırlanma zamanlarını görüntüleyin"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看 Codex 与 Claude Code 订阅额度和重置时间"
          }
        }
      }
    },
    "metadata.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
