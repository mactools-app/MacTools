    "pace.exhausted.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This week’s quota has been used up. Wait for the reset."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu haftanın kotası tükendi. Sıfırlanmayı bekleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本周额度已用完，请等待重置。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم استهلاك حصة هذا الأسبوع. انتظر إعادة التعيين."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Kontingent für diese Woche ist aufgebraucht. Warten Sie auf die Zurücksetzung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuota de esta semana se ha agotado. Espera a que se restablezca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le quota de cette semaine est épuisé. Attendez la réinitialisation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今週の利用枠を使い切りました。リセットをお待ちください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 주 할당량이 소진되었습니다. 재설정을 기다리세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A cota desta semana acabou. Aguarde a redefinição."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недельная квота исчерпана. Дождитесь сброса."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本週額度已用完，請等待重設。"
          }
        }
      }
    },
