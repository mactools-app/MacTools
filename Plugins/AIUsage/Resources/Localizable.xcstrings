    "refresh.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauses while locked or asleep. Failed requests back off automatically. Manual refreshes are at least one minute apart."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran kilitliyken veya sistem uyku modundayken duraklatılır. Başarısız istekler otomatik olarak daha sonra yeniden denenir. El ile yenilemeler arasında en az bir dakika olmalıdır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁屏和睡眠时暂停刷新。请求失败后自动延迟重试，手动刷新至少间隔 1 分钟。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتوقف مؤقتًا أثناء القفل أو السكون. تتباعد محاولات إعادة الطلب تلقائيًا عند الفشل. يفصل بين التحديثات اليدوية دقيقة واحدة على الأقل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausiert bei gesperrtem Bildschirm oder im Ruhezustand. Fehlgeschlagene Anfragen werden automatisch verzögert wiederholt. Manuelle Aktualisierungen erfolgen im Abstand von mindestens einer Minute."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La actualización se pausa cuando el Mac está bloqueado o en reposo. Tras un fallo, los reintentos se espacian automáticamente. Las actualizaciones manuales requieren al menos un minuto de intervalo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’actualisation est suspendue lorsque le Mac est verrouillé ou en veille. Les tentatives sont automatiquement espacées en cas d’échec. Les actualisations manuelles sont espacées d’au moins une minute."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック中やスリープ中は更新を一時停止します。リクエストに失敗すると、再試行までの待ち時間が自動的に長くなります。手動での更新には 1 分以上の間隔が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면이 잠겨 있거나 Mac이 잠자기 상태일 때 새로고침을 일시 중지합니다. 요청에 실패하면 재시도 간격이 자동으로 늘어납니다. 수동 새로고침은 최소 1분 간격으로 할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa quando o Mac está bloqueado ou em repouso. Após uma falha, as solicitações são repetidas automaticamente com um intervalo maior. As atualizações manuais têm pelo menos um minuto de intervalo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновление приостанавливается, когда Mac заблокирован или спит. При сбоях интервал между повторными запросами автоматически увеличивается. Обновлять вручную можно не чаще одного раза в минуту."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鎖定螢幕和睡眠時暫停重新整理。請求失敗後自動延遲重試，手動重新整理至少間隔 1 分鐘。"
          }
        }
      }
    },
