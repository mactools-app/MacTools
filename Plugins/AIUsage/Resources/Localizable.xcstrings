            "value": "请在设置中授权读取 Claude 钥匙串"
          }
        }
      }
    },
    "status.network": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection failed. Retrying automatically"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı kurulamadı. Otomatik olarak yeniden deneniyor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接失败，稍后自动重试"
          }
        }
      }
    },
    "status.rateLimited": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rate limited. Waiting before retrying"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstek sınırına ulaşıldı. Yeniden denemeden önce bekleniyor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求受限，已暂停并等待重试"
          }
        }
      }
    },
    "status.server": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Service unavailable. Retrying automatically"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hizmet kullanılamıyor. Otomatik olarak yeniden deneniyor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务暂不可用，稍后自动重试"
