{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "metadata.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See plan limits, API value, trends, models, projects and activity for Claude, Codex, OpenCode and GitHub Copilot."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude, Codex, OpenCode ve GitHub Copilot için plan sınırlarını, API değerini, eğilimleri, modelleri, projeleri ve etkinliği görün."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看 Claude、Codex、OpenCode 和 GitHub Copilot 的额度、API 价值、趋势、模型、项目与活动"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرض حدود الخطة وقيمة API والاتجاهات والنماذج والمشاريع والنشاط لـ Claude وCodex وOpenCode وGitHub Copilot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Planlimits, API-Wert, Verlauf, Modelle, Projekte und Aktivität von Claude, Codex, OpenCode und GitHub Copilot anzeigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta los límites del plan, el valor de API, las tendencias, los modelos, los proyectos y la actividad de Claude, Codex, OpenCode y GitHub Copilot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez les limites du forfait, la valeur API, les tendances, les modèles, les projets et l’activité de Claude, Codex, OpenCode et GitHub Copilot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude、Codex、OpenCode、GitHub Copilot のプラン上限、API 換算額、推移、モデル、プロジェクト、アクティビティを確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude, Codex, OpenCode, GitHub Copilot의 플랜 한도, API 가치, 추세, 모델, 프로젝트, 활동을 확인합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja os limites do plano, o valor de API, as tendências, os modelos, os projetos e a atividade do Claude, Codex, OpenCode e GitHub Copilot."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лимиты плана, стоимость API, динамика, модели, проекты и активность Claude, Codex, OpenCode и GitHub Copilot."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查看 Claude、Codex、OpenCode 和 GitHub Copilot 的額度、API 價值、趨勢、模型、專案與活動"
          }
        }
      }
    },
