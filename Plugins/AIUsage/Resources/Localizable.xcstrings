          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قراءة سلسلة مفاتيح Claude Code"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code-Schlüsselbund lesen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer el llavero de Claude Code"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lire le trousseau de Claude Code"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Codeのキーチェーンを読み取る"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code 키체인 읽기"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ler as Chaves do Claude Code"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читать данные Claude Code из связки ключей"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀取 Claude Code 鑰匙圈"
          }
        }
      }
    },
    "menuBar.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show remaining quota for every enabled service. Click for the dashboard; right-click for settings."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkinleştirilen her hizmetin kalan kotasını gösterir. Paneli açmak için tıklayın, ayarlar için sağ tıklayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示所有已启用服务的剩余额度。点击打开仪表盘，右键打开设置。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار الحصة المتبقية لكل خدمة مفعّلة. انقر لفتح لوحة التحكم، وانقر بزر الماوس الأيمن لفتح الإعدادات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbleibendes Kontingent für jeden aktivierten Dienst anzeigen. Klicken für das Dashboard; Rechtsklick für Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra la cuota restante para cada servicio habilitado. Haga clic para acceder al panel; haga clic derecho para configurar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher le quota restant pour chaque service activé. Cliquez pour le tableau de bord ; faites un clic droit pour les paramètres."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なサービスごとに残りのクォータを表示します。クリックするとダッシュボードが表示されます。右クリックして設定を行います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성화된 모든 서비스에 대해 남은 할당량을 표시합니다. 대시보드를 보려면 클릭하세요. 설정을 보려면 마우스 오른쪽 버튼을 클릭하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar cota restante para cada serviço habilitado. Clique para acessar o painel; clique com o botão direito para configurações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать оставшуюся квоту для каждой включенной службы. Нажмите, чтобы открыть панель управления; щелкните правой кнопкой мыши для настроек."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示所有已啟用服務的剩餘額度。按一下開啟儀表板，按右鍵開啟設定。"
          }
        }
      }
    },
