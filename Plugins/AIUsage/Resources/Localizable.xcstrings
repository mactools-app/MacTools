    "status.accessOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable login file or Keychain access in settings"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar'da oturum açma dosyası veya Keychain erişimini etkinleştirin"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在设置中开启登录文件或钥匙串访问"
          }
        }
      }
    },
    "status.expired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Login expired or access denied. Sign in again in the client"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturumun süresi doldu veya erişim reddedildi. İstemcide yeniden oturum açın"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录已过期或无访问权限，请在客户端重新登录"
          }
        }
      }
    },
    "status.invalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service returned no usable quota"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hizmet kullanılabilir bir kota döndürmedi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务未返回可用额度"
          }
        }
      }
    },
    "status.keychain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Claude Keychain access in settings"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
