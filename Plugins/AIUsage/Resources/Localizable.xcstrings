    },
    "metadata.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View Codex and Claude Code subscription quotas and reset times"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex ve Claude Code abonelik kotalarını ve sıfırlanma zamanlarını görüntüleyin"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看 Codex 与 Claude Code 订阅额度和重置时间"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرض حصص اشتراك Codex وClaude Code وأوقات إعادة التعيين."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnementkontingente und Rücksetzzeiten für Codex und Claude Code anzeigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta las cuotas y los tiempos de restablecimiento de Codex y Claude Code."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez les quotas et les heures de réinitialisation de Codex et Claude Code."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex と Claude Code の利用枠とリセット時刻を確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex 및 Claude Code 구독 한도와 초기화 시간을 확인합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja as cotas e os horários de redefinição de Codex e Claude Code."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просматривайте квоты подписок Codex и Claude Code и время их сброса."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查看 Codex 與 Claude Code 訂閱額度和重設時間"
          }
        }
      }
    },
