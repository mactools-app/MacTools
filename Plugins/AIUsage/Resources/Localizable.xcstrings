    "refresh.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauses while locked or asleep. Failed requests back off automatically. Manual refreshes are at least one minute apart."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran kilitliyken veya sistem uyku modundayken duraklatılır. Başarısız istekler otomatik olarak daha sonra yeniden denenir. El ile yenilemeler arasında en az bir dakika olmalıdır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁屏和睡眠时暂停刷新。请求失败后自动延迟重试，手动刷新至少间隔 1 分钟。"
          }
        }
      }
    },
    "refresh.interval": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic refresh interval"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik yenileme aralığı"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动刷新间隔"
          }
        }
      }
    },
    "refresh.minutes": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
