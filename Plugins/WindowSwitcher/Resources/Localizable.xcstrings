    "settings.mode.directCycle.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مع الاستمرار على الاختصار للتنقل عبر النوافذ، ثم حرره للتبديل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie die Tastenkombination gedrückt, um durch die Fenster zu blättern, und lassen Sie sie dann los, um zu wechseln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the shortcut to cycle through windows, then release it to switch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenga presionado el acceso directo para recorrer las ventanas, luego suéltelo para cambiar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez le raccourci pour parcourir les fenêtres, puis relâchez-le pour basculer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットを押したままウインドウを順に選び、離すと切り替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창을 순환하려면 바로가기를 누른 다음, 놓아서 전환하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure o atalho para percorrer as janelas e solte-o para alternar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте ярлык для переключения между окнами, затем отпустите его для переключения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısayolu basılı tutarak pencereler arasında sırayla geçin, bıraktığınızda geçiş yapılır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住快捷键循环选择，松开后切换窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住快速鍵循環選擇，放開後切換視窗。"
          }
        }
      }
    },
