    "shortcut.group.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتغيير الاختصار المستخدم لفتح Window Switcher."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändern Sie die Verknüpfung zum Öffnen von Window Switcher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change the shortcut used to open Window Switcher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambie el acceso directo utilizado para abrir Window Switcher."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifiez le raccourci utilisé pour ouvrir Window Switcher."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウ切り替えを開くショートカットを変更します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Window Switcher를 여는 데 사용되는 바로가기를 변경합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Altere o atalho usado para abrir o Window Switcher."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Измените ярлык, используемый для открытия переключателя окон."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencere Değiştirici'yi açmak için kullanılan kısayolu değiştirin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修改用于唤起窗口切换的快捷键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "修改用來開啟視窗切換的快速鍵。"
          }
        }
      }
    },
