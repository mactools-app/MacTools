    "settings.mode.legacy.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press a window’s assigned key to switch immediately. Click its badge to change the key."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anında geçiş yapmak için pencereye atanmış tuşa basın. Tuşu değiştirmek için rozetine tıklayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按窗口对应的按键立即切换，点击按键标记可修改。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على المفتاح المخصص للنافذة للتبديل على الفور. انقر فوق شارتها لتغيير المفتاح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücken Sie die dem Fenster zugewiesene Taste, um sofort zu wechseln. Klicken Sie auf die Tastenanzeige, um die Taste zu ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa la tecla asignada a una ventana para cambiar a ella inmediatamente. Haz clic en su indicador para cambiar la tecla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur la touche attribuée à une fenêtre pour basculer immédiatement. Cliquez sur son badge pour changer la touche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィンドウに割り当てられたキーを押すと、すぐに切り替わります。キーを変更するには、そのバッジをクリックします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창에 할당된 키를 누르면 즉시 전환됩니다. 키를 변경하려면 해당 배지를 클릭하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione a tecla atribuída a uma janela para alternar imediatamente. Clique no emblema para alterar a tecla."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите назначенную окну клавишу для немедленного переключения. Нажмите на значок, чтобы изменить клавишу."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按視窗對應的按鍵立即切換，按一下按鍵標記可修改。"
          }
        }
      }
    },
