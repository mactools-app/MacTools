    "settings.minimized.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore and switch to minimized windows."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Küçültülmüş pencereleri geri yükleyip onlara geçiş yapar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择后会还原并切换到已最小化的窗口。"
