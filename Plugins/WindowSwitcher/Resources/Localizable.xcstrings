    "settings.commandTab.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use ⌘Tab to switch between all windows without entering the shortcut manually."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem kısayolunu yeniden kaydetmenize gerek kalmadan ⌘Tab ile tüm pencereler arasında geçiş yapın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 ⌘Tab 切换全部窗口，无需录制系统快捷键。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم ⌘Tab لتبديل جميع النوافذ دون تسجيل اختصار النظام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Tab zum Wechseln zwischen allen Fenstern verwenden, ohne die System-Tastenkombination aufzeichnen zu müssen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa ⌘Tab para cambiar entre todas las ventanas sin registrar el atajo de teclado del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez ⌘Tab pour basculer entre toutes les fenêtres sans enregistrer le raccourci système."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Tab を使用して、システム ショートカットを記録せずにすべてのウィンドウを切り替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 단축키를 기록하지 않고 ⌘Tab으로 모든 윈도우를 전환합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Use ⌘Tab para alternar todas as janelas sem registrar o atalho do sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использовать ⌘Tab для переключения между всеми окнами без записи системного сочетания клавиш."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 ⌘Tab 切換所有視窗，不必手動輸入此快速鍵。"
          }
        }
      }
    },
