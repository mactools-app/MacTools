    "shortcut.switcher.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار أو التبديل بين النوافذ قيد التشغيل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigen Sie laufende Fenster an oder wechseln Sie zwischen ihnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show or switch between running windows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra o cambia entre ventanas en ejecución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher ou basculer entre les fenêtres en cours d'exécution."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中のウインドウを表示または切り替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행 중인 창을 표시하거나 전환합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostre ou alterne entre janelas em execução."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показ или переключение между запущенными окнами."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışan pencereleri gösterir veya aralarında geçiş yapar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示或切换正在运行的窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示或切換正在執行的視窗。"
          }
        }
      }
    },
