    "settings.companion.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset the all-windows shortcut to ⌥Tab and keep the system ⌘Tab switcher."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm pencereler kısayolunu ⌥Tab olarak sıfırlar ve sistem ⌘Tab geçişini korur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将全部窗口快捷键重置为 ⌥Tab，保留系统 ⌘Tab。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة تعيين اختصار جميع النوافذ إلى ⌥Tab والإبقاء على مبدّل النظام ⌘Tab."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Kurzbefehl für alle Fenster auf ⌥Tab zurücksetzen und den systemeigenen ⌘Tab-Umschalter beibehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restablecer el atajo de todas las ventanas a ⌥Tab y mantener el selector del sistema ⌘Tab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétablir ⌥Tab pour toutes les fenêtres et conserver le sélecteur système ⌘Tab."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのウィンドウのショートカットを ⌥Tab に戻し、標準の ⌘Tab によるアプリ切り替えを維持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 윈도우 단축키를 ⌥Tab으로 재설정하고 시스템 ⌘Tab 전환기를 유지합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Redefinir o atalho de todas as janelas para ⌥Tab e manter o alternador do sistema ⌘Tab."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сбросить сочетание для всех окон на ⌥Tab и сохранить системное переключение ⌘Tab."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將全部視窗快速鍵重設為 ⌥Tab，保留系統 ⌘Tab。"
          }
        }
      }
    },
