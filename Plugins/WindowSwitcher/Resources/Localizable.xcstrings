    "settings.status.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمكين تبديل النوافذ"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie die Fensterumschaltung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Window Switching"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Habilitar cambio de ventana"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activer le changement de fenêtre"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウ切り替えを有効にする"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창 전환 활성화"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Habilitar troca de janela"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включить переключение окон"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencere Geçişini Etkinleştir"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用窗口切换"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用視窗切換"
          }
        }
