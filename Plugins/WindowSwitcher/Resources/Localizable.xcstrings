        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選視窗預覽"
          }
        }
      }
    },
    "settings.preview.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview only the selected window. Allow Screen Recording in System Settings. Search and switching also work without previews."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca seçili pencereyi önizler. Sistem Ayarları'nda Ekran Kaydı'na izin verin. Arama ve geçiş, önizleme olmadan da çalışır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅预览选中窗口。需在系统设置中允许录屏，不启用预览也可搜索和切换。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معاينة النافذة المحددة فقط. امنح إذن تسجيل الشاشة في إعدادات النظام. يعمل البحث والتبديل أيضًا دون معاينات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Vorschau für das ausgewählte Fenster anzeigen. Erlauben Sie MacTools unter „Bildschirmaufnahme“ in den Systemeinstellungen den Zugriff. Suchen und Wechseln funktionieren auch ohne Vorschau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra solo la vista previa de la ventana seleccionada. Permite la Grabación de pantalla en Ajustes del Sistema. La búsqueda y el cambio de ventanas también funcionan sin vistas previas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher uniquement l’aperçu de la fenêtre sélectionnée. Autorisez MacTools pour « Enregistrement de l’écran » dans Réglages Système. La recherche et le changement de fenêtre fonctionnent également sans aperçu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したウィンドウだけをプレビューします。システム設定で画面収録を許可してください。プレビューがなくても検索と切り替えは利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 창만 미리 봅니다. 시스템 설정에서 화면 기록을 허용하세요. 검색 및 전환도 미리보기 없이 작동합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualize apenas a janela selecionada. Permita Gravação de Tela nos Ajustes do Sistema. A pesquisa e a alternância também funcionam sem visualizações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предварительный просмотр только выбранного окна. Разрешите запись экрана в Системных настройках. Поиск и переключение также работают без предварительного просмотра."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅預覽所選視窗。需在系統設定中允許螢幕錄影；即使關閉預覽，仍可搜尋和切換。"
          }
        }
      }
    },
    "error.discoveryTimeout": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No switchable windows were found. Try again shortly."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçiş yapılabilecek pencere bulunamadı. Kısa süre sonra yeniden deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未读取到可切换窗口，请稍后重试。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على نوافذ قابلة للتبديل. حاول مرة أخرى قريبا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurden keine Fenster gefunden, zu denen gewechselt werden kann. Versuchen Sie es gleich noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontraron ventanas a las que cambiar. Vuelve a intentarlo en unos instantes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune fenêtre vers laquelle basculer n’a été trouvée. Réessayez sous peu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切り替え可能なウィンドウが見つかりませんでした。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전환 가능한 창을 찾을 수 없습니다. 잠시 후 다시 시도하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma janela alternável foi encontrada. Tente novamente em breve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переключаемые окна не найдены. Повторите попытку через некоторое время."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未讀取到可切換視窗，請稍後重試。"
          }
        }
      }
    },
    "error.shortcutTap": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not listen for shortcuts. Check Accessibility permission."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısayollar dinlenemedi. Erişilebilirlik iznini denetleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法监听快捷键，请检查辅助功能权限。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر رصد الاختصارات. تحقق من إذن تسهيلات الاستخدام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastenkombinationen konnten nicht überwacht werden. Überprüfen Sie die Berechtigung für Bedienungshilfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron detectar los atajos de teclado. Comprueba el permiso de Accesibilidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'écouter les raccourcis. Vérifiez l’autorisation d’accessibilité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットを検出できませんでした。アクセシビリティの許可を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키를 감지할 수 없습니다. 손쉬운 사용 권한을 확인하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível escutar atalhos. Verifique a permissão de acessibilidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось отслеживать сочетания клавиш. Проверьте разрешение на универсальный доступ."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法監聽快速鍵，請檢查輔助使用權限。"
          }
        }
      }
    },
    "action.requested": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request sent. The app may ask you to save changes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstek gönderildi. Uygulama değişiklikleri kaydetmenizi isteyebilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已发送请求；应用可能会要求保存更改。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إرسال الطلب. قد يطلب منك التطبيق حفظ التغييرات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anfrage gesendet. Die App fordert Sie möglicherweise auf, Änderungen zu speichern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicitud enviada. Es posible que la aplicación le solicite que guarde los cambios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande envoyée. L'application peut vous demander d'enregistrer les modifications."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストが送信されました。アプリは変更を保存するように要求する場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청이 전송되었습니다. 앱에서 변경 사항을 저장하라는 메시지를 표시할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicitação enviada. O aplicativo pode solicitar que você salve as alterações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрос отправлен. Приложение может попросить вас сохранить изменения."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已傳送請求；App 可能會要求儲存更改。"
          }
        }
      }
    },
    "action.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The window closed or is temporarily unavailable. Select it again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencere kapatıldı veya geçici olarak kullanılamıyor. Yeniden seçin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口已关闭或暂时无法访问，请重新选择。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُغلقت النافذة أو أصبحت غير متاحة مؤقتًا. حددها مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Fenster wurde geschlossen oder ist vorübergehend nicht verfügbar. Wählen Sie es erneut aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ventana se ha cerrado o no está disponible temporalmente. Selecciónala de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fenêtre s’est fermée ou est temporairement indisponible. Sélectionnez-la à nouveau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィンドウが閉じられたか、一時的に利用できなくなりました。もう一度選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창이 닫혀 있거나 일시적으로 이용이 불가능합니다. 다시 선택하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A janela foi fechada ou está temporariamente indisponível. Selecione-a novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окно закрыто или временно недоступно. Выберите его еще раз."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "視窗已關閉或暫時無法存取，請重新選擇。"
          }
        }
      }
    },
    "action.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not confirm the target window. Try again or check Accessibility permission."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedef pencere onaylanamadı. Yeniden deneyin veya Erişilebilirlik iznini denetleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能确认目标窗口，请重试或检查辅助功能权限。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تأكيد النافذة المستهدفة. حاول مرة أخرى أو تحقق من إذن تسهيلات الاستخدام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Zielfenster konnte nicht bestätigt werden. Versuchen Sie es erneut oder überprüfen Sie die Berechtigung für Bedienungshilfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo confirmar la ventana de destino. Inténtalo de nuevo o comprueba el permiso de accesibilidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de confirmer la fenêtre cible. Réessayez ou vérifiez l'autorisation d'accessibilité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対象ウィンドウが確認できませんでした。もう一度試すか、アクセシビリティ権限を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대상 창을 확인할 수 없습니다. 다시 시도하거나 손쉬운 사용 권한을 확인하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível confirmar a janela de destino. Tente novamente ou verifique a permissão de acessibilidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подтвердить целевое окно. Повторите попытку или проверьте разрешение на универсальный доступ."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未能確認目標視窗，請重試或檢查輔助使用權限。"
          }
        }
      }
    },
