    "settings.shortcutPreset.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep or replace system ⌘Tab. This selection follows your configured shortcut."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem ⌘Tab'ı koruyun veya değiştirin. Bu seçim, ayarladığınız kısayola göre belirlenir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择保留或替代系统 ⌘Tab；自定义快捷键会同步显示。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإبقاء على مبدّل النظام ⌘Tab أو استبداله. يعكس هذا الخيار الاختصار الذي ضبطته."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "System-⌘Tab beibehalten oder ersetzen. Diese Auswahl richtet sich nach Ihrem konfigurierten Tastenkürzel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén o reemplaza el atajo ⌘Tab del sistema. Esta selección refleja el atajo de teclado configurado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserver ou remplacer le raccourci système ⌘Tab. Cette sélection reflète le raccourci configuré."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "標準の ⌘Tab によるアプリ切り替えを維持するか、置き換えるかを選択します。この選択は設定したショートカットに合わせて更新されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 ⌘Tab 전환을 유지하거나 대체하도록 선택합니다. 이 선택은 설정한 단축키에 맞춰 표시됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha ou substitua o atalho do sistema ⌘Tab. Esta seleção segue o atalho configurado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните системное переключение ⌘Tab или замените его. Этот вариант соответствует настроенному сочетанию клавиш."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇保留或取代系統 ⌘Tab；此選項會反映已設定的快速鍵。"
          }
        }
      }
    },
