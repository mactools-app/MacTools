{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "metadata.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبديل النافذة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fensterumschalter"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Window Switcher"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiador de ventana"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélecteur de fenêtre"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウ切り替え"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "윈도우 스위처"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternador de janela"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переключатель окон"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencere Değiştirici"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口切换"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "視窗切換"
          }
        }
      }
    },
    "metadata.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التبديل بسرعة بين النوافذ قيد التشغيل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechseln Sie schnell zwischen laufenden Fenstern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quickly switch between running windows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambie rápidamente entre ventanas en ejecución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Basculez rapidement entre les fenêtres en cours d’exécution."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中のウインドウをすばやく切り替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행 중인 창 사이를 빠르게 전환합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterne rapidamente entre janelas em execução."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстрое переключение между запущенными окнами."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışan pencereler arasında hızlıca geçiş yapın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快速切换正在运行的窗口"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快速切換正在執行的視窗"
          }
        }
      }
    },
    "permission.accessibility.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إمكانية الوصول"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Barrierefreiheit"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesibilidad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibilité"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접근성"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Acessibilidade"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступность"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişilebilirlik"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輔助使用"
          }
        }
      }
    },
    "permission.accessibility.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم اختصار التبديل لتبديل النوافذ في التطبيقات الأخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet die Umschaltverknüpfung, um Fenster in anderen Apps zu wechseln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses the switching shortcut to switch windows in other apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliza el atajo de cambio para cambiar de ventana en otras aplicaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise le raccourci de changement pour changer de fenêtre dans d'autres applications."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切り替えショートカットを制御し、ほかのアプリのウインドウを切り替えるために使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전환 단축키를 사용하여 다른 앱의 창을 전환합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa o atalho de alternância para alternar janelas em outros aplicativos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использует ярлык переключения для переключения окон в других приложениях."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçiş kısayolunu kullanarak diğer uygulamaların pencereleri arasında geçiş yapmayı sağlar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于接管切换快捷键并切换其他应用窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於接管切換快速鍵並切換其他 App 的視窗。"
          }
        }
      }
    },
    "permission.accessibility.footnote": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في إعدادات النظام ← الخصوصية والأمان ← إمكانية الوصول، اسمح بـ MacTools."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben Sie unter Systemeinstellungen → Datenschutz und Sicherheit → Barrierefreiheit MacTools."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In System Settings → Privacy & Security → Accessibility, allow MacTools."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Configuración del sistema → Privacidad y seguridad → Accesibilidad, permita MacTools."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Paramètres système → Confidentialité et sécurité → Accessibilité, autorisez MacTools."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定 → プライバシーとセキュリティ → アクセシビリティで、MacTools を許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 → 개인정보 보호 및 보안 → 접근성에서 MacTools를 허용하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em Configurações do sistema → Privacidade e segurança → Acessibilidade, permita MacTools."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В «Системных настройках» → «Конфиденциальность и безопасность» → «Доступность» разрешите MacTools."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Ayarları → Gizlilik ve Güvenlik → Erişilebilirlik bölümünde MacTools'a izin verin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统设置 → 隐私与安全性 → 辅助功能，允许 MacTools。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統設定 → 隱私權與安全性 → 輔助使用，允許 MacTools。"
          }
        }
      }
    },
