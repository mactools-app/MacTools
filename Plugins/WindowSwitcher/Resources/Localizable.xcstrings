    "preview.permission": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview requires Screen Recording permission. You can still switch by title."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önizleme, Ekran Kaydı izni gerektirir. Yine de başlığa göre geçiş yapabilirsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预览需要录屏权限；仍可按标题切换。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتطلب المعاينة إذن تسجيل الشاشة. لا يزال بإمكانك التبديل حسب العنوان."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vorschau erfordert die Berechtigung „Bildschirmaufnahme“. Sie können Fenster weiterhin anhand ihres Titels auswählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La vista previa requiere permiso de grabación de pantalla. Aún puedes cambiar por título."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’aperçu nécessite l’autorisation « Enregistrement de l’écran ». Vous pouvez toujours sélectionner une fenêtre par son titre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビューには画面収録の許可が必要です。タイトルを使った切り替えは引き続き利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리보기에는 화면 기록 권한이 필요합니다. 제목을 선택해 윈도우를 전환할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A visualização requer permissão de Gravação de Tela. Você ainda pode alternar por título."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для предварительного просмотра требуется разрешение на запись экрана. Вы по-прежнему можете переключаться по названию."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預覽需要螢幕錄影權限；仍可按標題切換。"
          }
        }
      }
    },
