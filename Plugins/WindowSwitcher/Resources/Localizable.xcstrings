    "preview.zoomHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinch to zoom. Drag or use arrows to pan; double-click to fit."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakınlaştırmak için sıkıştırın. Kaydırmak için sürükleyin veya ok tuşlarını kullanın; sığdırmak için çift tıklayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双指缩放，拖移或按方向键平移；双击自动适应窗口大小。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قرّب إصبعين أو باعد بينهما للتكبير والتصغير. اسحب أو استخدم الأسهم لتحريك المعاينة؛ انقر نقرًا مزدوجًا لملاءمتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Zoomen zwei Finger zusammen- oder auseinanderziehen. Ziehen oder Pfeiltasten zum Verschieben nutzen; Doppelklick zum Einpassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pellizca para hacer zoom. Arrastra o usa las flechas para desplazarte; haz doble clic para ajustar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pincez pour zoomer. Faites glisser ou utilisez les flèches pour effectuer un panoramique ; double-cliquez pour l'ajuster."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピンチで拡大・縮小します。ドラッグや矢印キーで表示位置を移動し、ダブルクリックでウィンドウに合わせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 손가락으로 확대/축소합니다. 드래그하거나 방향키로 이동하고, 두 번 클릭하면 미리보기 크기를 맞춥니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça o gesto de pinça para ampliar. Arraste ou use as setas para deslocar; clique duas vezes para ajustar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сведите или разведите пальцы для изменения масштаба. Перетаскивайте изображение или используйте стрелки для перемещения; двойной щелчок вписывает изображение в область просмотра."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雙指縮放。放大後可拖移或用方向鍵平移，按兩下可調整為符合視窗大小。"
          }
        }
      }
    },
