    "chooser.keyboardHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "↑↓←→ Select · Return Open · ⌘1/2 Scope · ⌘D Displays · Esc Cancel"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "↑↓←→ Seç · Return Aç · ⌘1/2 Kapsam · ⌘D Ekranlar · Esc İptal"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "方向键选择 · 回车打开 · ⌘1/2 范围 · ⌘D 显示器 · Esc 取消"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "↑↓ 選擇 · Return 開啟 · ⌘1/2 範圍 · ⌘D 顯示器 · Esc 取消"
          }
        },
        "ar": {
          "stringUnit": {
