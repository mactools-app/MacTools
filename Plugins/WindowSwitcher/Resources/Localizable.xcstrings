    "settings.shortcut.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shortcut settings are unavailable. Reopen Settings and try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısayol ayarları kullanılamıyor. Ayarlar'ı yeniden açıp tekrar deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快捷键设置暂不可用，请重新打开设置。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعدادات الاختصار غير متاحة. أعد فتح الإعدادات وحاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen für Tastenkürzel nicht verfügbar. Einstellungen erneut öffnen und erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ajustes de atajos de teclado no están disponibles. Vuelve a abrir los ajustes e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paramètres de raccourci ne sont pas disponibles. Rouvrez les paramètres et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカット設定は使用できません。設定を再度開いて、もう一度試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키 설정을 사용할 수 없습니다. 설정을 다시 열고 다시 시도해 보세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As configurações de atalho não estão disponíveis. Reabra as configurações e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки сочетаний клавиш недоступны. Снова откройте «Настройки» и повторите попытку."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快速鍵設定暫不可用，請重新開啟設定。"
          }
        }
      }
    },
