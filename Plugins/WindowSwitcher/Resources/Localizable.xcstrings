    "chooser.recordAssignedHelp": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم حرفًا أو رقمًا، مع ⌘ اختياريًا. اضغط ⌫ لاستعادة التعيين التلقائي أو Esc للإلغاء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Buchstabe oder Ziffer, optional mit ⌘. ⌫ stellt die automatische Zuweisung wieder her, Esc bricht ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a letter or number, optionally with ⌘. Press ⌫ to restore automatic assignment, or Esc to cancel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa una letra o un número, con ⌘ si lo deseas. ⌫ restaura la asignación automática y Esc cancela."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lettre ou chiffre, avec ⌘ si souhaité. ⌫ rétablit l’attribution automatique, Esc annule."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "英字または数字を使用します（⌘との組み合わせも可）。⌫で自動割り当てに戻し、Escでキャンセルします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문자 또는 숫자를 사용하세요. ⌘ 조합도 가능합니다. ⌫는 자동 할당 복원, Esc는 취소입니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Use uma letra ou um número, com ⌘ se desejar. ⌫ restaura a atribuição automática e Esc cancela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Буква или цифра, при желании с ⌘. ⌫ восстанавливает автоматическое назначение, Esc отменяет ввод."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir harf veya sayı kullanın; isterseniz ⌘ ile birlikte. Otomatik atamayı geri yüklemek için ⌫, iptal etmek için Esc tuşuna basın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用字母或数字，可组合 ⌘。按 ⌫ 恢复自动分配，Esc 取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用字母或數字，可搭配 ⌘。按 ⌫ 恢復自動指派，Esc 取消。"
          }
        }
      }
    },
