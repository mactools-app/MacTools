    "settings.sort.fixed.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الترتيب حسب اسم التطبيق، ثم عنوان النافذة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
