    "shortcut.pasteSequentially.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصق العنصر التالي أو ابدأ بلقطة من السجل الحديث."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nächsten Eintrag einsetzen oder mit einem Schnappschuss des Verlaufs beginnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste the next queued item, or start with a snapshot of recent history."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega el siguiente elemento o inicia una copia del historial reciente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez l’élément suivant ou démarrez avec un instantané de l’historique récent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の項目をペーストするか、最近の履歴から開始します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 항목을 붙여넣거나 최근 기록 스냅샷으로 시작합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole o próximo item ou inicie com o histórico recente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставить следующий элемент или начать со снимка недавней истории."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonraki kuyruğa alınmış öğeyi yapıştırır ya da yakın geçmişin anlık görüntüsüyle başlar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴下一个队列项目，或从最近历史快照开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼上下個佇列項目，或從最近記錄快照開始。"
          }
        }
      }
    },
    "shortcut.pasteSequentially.groupDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
