    "metadata.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابحث في السجل المشفر محليًا وأدر المقتطفات والعناصر المحفوظة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschlüsselten Verlauf durchsuchen und Textbausteine sowie gespeicherte Elemente verwalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search encrypted History and manage reusable snippets and Saved items"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca en el historial cifrado y gestiona fragmentos y elementos guardados"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherchez dans l’historique chiffré et gérez les extraits et éléments enregistrés"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗号化された履歴を検索し、スニペットと保存済み項目を管理します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호화된 기록을 검색하고 스니펫과 저장된 항목을 관리합니다"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesquise o histórico criptografado e gerencie trechos e itens salvos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск в зашифрованной истории и управление фрагментами и сохранёнными элементами"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şifreli Geçmişte arama yapın; yeniden kullanılabilir parçacıkları ve kayıtlı öğeleri yönetin"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索加密历史，并管理可重复使用的片段和已存项目"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搜尋加密記錄，並管理可重複使用的片段和已儲存項目"
          }
        }
      }
    },
