    "settings.snippets.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قوالب قابلة لإعادة الاستخدام مع كلمات وتوسيمات ومتغيرات وقت اللصق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederverwendbare Vorlagen mit optionalen Kürzeln, Tags und Variablen beim Einsetzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reusable editable templates with optional keywords, tags, and paste-time variables."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Plantillas editables reutilizables con palabras clave, etiquetas y variables al pegar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modèles modifiables réutilisables avec mots-clés, tags et variables au collage."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーワード、タグ、ペースト時変数に対応した再利用可能な編集用テンプレートです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키워드, 태그, 붙여넣기 시점 변수를 지원하는 재사용 가능한 편집 템플릿입니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelos editáveis reutilizáveis com palavras-chave, etiquetas e variáveis ao colar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Редактируемые шаблоны с ключевыми словами, тегами и переменными при вставке."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsteğe bağlı anahtar sözcükler, etiketler ve yapıştırma zamanı değişkenleri içeren, yeniden kullanılabilir düzenlenebilir şablonlar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可复用的可编辑模板，支持可选关键词、标签和粘贴时变量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可重複使用的可編輯範本，支援選用關鍵字、標籤與貼上時變數。"
          }
        }
      }
    },
