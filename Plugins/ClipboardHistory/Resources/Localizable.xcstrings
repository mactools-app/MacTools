        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل حالة الحفظ من القصاصات الموجودة في السجل ويحذف نهائيًا القصاصات المحفوظة غير الموجودة في السجل. يبقى السجل والمقتطفات. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt den Gespeichert-Status von Clips im Verlauf und löscht ausschließlich gespeicherte Clips dauerhaft. Verlauf und Textbausteine bleiben erhalten. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes Saved status from clips in History and permanently deletes Saved-only clips. History and snippets are kept. This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quita el estado guardado de los clips del historial y elimina permanentemente los que solo están guardados. El historial y los fragmentos se conservan. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retire le statut enregistré des clips de l’historique et supprime définitivement ceux qui n’existent que dans les éléments enregistrés. L’historique et les extraits sont conservés. Cette action est irréversible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴内のクリップの保存状態を解除し、保存済みにのみ存在するクリップを完全に削除します。履歴とスニペットは保持されます。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록에 있는 클립의 저장 상태를 해제하고 저장됨에만 있는 클립을 영구 삭제합니다. 기록과 스니펫은 유지됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove o estado salvo dos clipes no histórico e apaga permanentemente os clipes que estão apenas salvos. O histórico e os trechos são mantidos. Esta ação não pode ser desfeita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снимает статус сохранения с клипов в истории и безвозвратно удаляет клипы, которых нет в истории. История и фрагменты остаются. Это действие нельзя отменить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçmişteki öğelerin Kayıtlı durumunu kaldırır ve yalnızca “Kayıtlı”da bulunan öğeleri kalıcı olarak siler. Geçmiş ve parçacıklar korunur. Bu işlem geri alınamaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消历史中剪辑的已存状态，并永久删除仅保存在已存中的剪辑。历史和片段会保留。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取消記錄中剪輯的已儲存狀態，並永久刪除僅保存在已儲存中的剪輯。記錄和片段會保留。此操作無法復原。"
          }
        }
      }
    },
    "settings.saved.clear.title": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد مسح المكتبة المحفوظة؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bibliothek löschen?"
          }
        },
        "en": {
