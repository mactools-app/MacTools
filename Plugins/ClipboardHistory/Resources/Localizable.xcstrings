    "panel.shortcuts.share.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح ورقة المشاركة في macOS للعنصر أو التحديد الحالي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das macOS-Teilen-Menü für das aktuelle Element oder die Auswahl öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the macOS share sheet for the current item or selection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la hoja para compartir de macOS para el elemento o la selección actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir la feuille de partage macOS pour l’élément ou la sélection actuelle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の項目または選択内容をmacOSの共有シートで開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 항목 또는 선택 항목의 macOS 공유 시트를 엽니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra a folha de partilha do macOS para o item ou seleção atual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть меню «Поделиться» macOS для текущего элемента или выбора."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçerli öğe veya seçim için macOS paylaşım sayfasını açar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
