    "backup.error.invalid": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النسخة الاحتياطية غير صالحة أو تالفة أو كلمة السر غير صحيحة. لم تتغير البيانات الحالية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Backup ist ungültig oder beschädigt, oder das Passwort ist falsch. Die aktuellen Daten wurden nicht geändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backup is invalid, damaged, or the password is incorrect. Current data was not changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia no es válida, está dañada o la contraseña es incorrecta. No se han cambiado los datos actuales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sauvegarde est invalide, endommagée ou le mot de passe est incorrect. Les données actuelles n’ont pas été modifiées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップが無効、破損しているか、パスワードが違います。現在のデータは変更されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업이 유효하지 않거나 손상되었거나 암호가 틀렸습니다. 현재 데이터는 변경되지 않았습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O backup é inválido, está danificado ou a senha está incorreta. Os dados atuais não foram alterados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервная копия недействительна, повреждена или пароль неверен. Текущие данные не изменены."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedek geçersiz, bozuk ya da parola hatalı. Geçerli veriler değiştirilmedi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份无效、已损坏或密码错误。当前数据未更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備份無效、已損壞或密碼錯誤。目前資料未變更。"
          }
        }
      }
    },
