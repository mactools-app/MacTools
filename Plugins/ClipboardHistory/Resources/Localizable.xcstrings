    "settings.expansion.focusOwnershipUnverified": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم العثور على المحرر النشط، لكن تعذّر التحقق من نافذة تطبيقه. الصق المقتطف من الحافظة بدلًا من ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der fokussierte Editor wurde gefunden, aber sein App-Fenster konnte nicht bestätigt werden. Füge das Snippet stattdessen aus der Zwischenablage ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The focused editor was found, but its app window could not be verified. Paste the snippet from Clipboard instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se encontró el editor enfocado, pero no se pudo verificar su ventana. Pega el fragmento desde el Portapapeles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’éditeur actif a été trouvé, mais sa fenêtre n’a pas pu être vérifiée. Collez plutôt l’extrait depuis le Presse-papiers."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力中のエディタは見つかりましたが、アプリのウインドウを確認できませんでした。クリップボードからスニペットを貼り付けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포커스된 편집기를 찾았지만 앱 창을 확인할 수 없습니다. 클립보드에서 스니펫을 붙여넣으세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O editor em foco foi encontrado, mas não foi possível verificar a janela da aplicação. Cole o trecho pela Área de Transferência."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Редактор найден, но его окно приложения не удалось проверить. Вставьте фрагмент через Буфер обмена."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaktaki düzenleyici bulundu, ancak uygulama penceresi doğrulanamadı. Bunun yerine parçacığı Panodan yapıştırın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已找到当前编辑器，但无法确认其所属应用窗口。请改用剪贴板粘贴片段。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已找到目前的編輯器，但無法確認其所屬 App 視窗。請改用剪貼簿貼上片段。"
          }
        }
      }
    },
