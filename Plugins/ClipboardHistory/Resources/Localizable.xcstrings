    "clear.all.message": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمسح السجل. تبقى القصاصات المحفوظة والمقتطفات. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht den Verlauf. Gespeicherte Clips und Textbausteine bleiben erhalten. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clears History. Saved clips and snippets are kept. This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra el historial. Los clips guardados y los fragmentos se conservan. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Efface l’historique. Les clips enregistrés et les extraits sont conservés. Cette action est irréversible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴を消去します。保存済みクリップとスニペットは保持されます。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록을 지웁니다. 저장한 클립과 스니펫은 유지됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpa o histórico. Os clipes salvos e trechos são mantidos. Esta ação não pode ser desfeita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очищает историю. Сохранённые клипы и фрагменты остаются. Это действие нельзя отменить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçmişi temizler. Kayıtlı öğeler ve parçacıklar korunur. Bu işlem geri alınamaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除历史记录。已存剪辑和片段会保留。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除記錄。已儲存剪輯和片段會保留。此操作無法復原。"
          }
        }
      }
    },
