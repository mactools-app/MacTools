    "panel.shortcuts.save.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاحتفاظ بنسخة دائمة من عنصر السجل المحدد ضمن المحفوظات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine dauerhafte Kopie des ausgewählten Verlaufsobjekts unter Gespeichert behalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Toggle whether the focused captured item is kept in Saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva una copia permanente del elemento de historial seleccionado en Guardado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserver une copie durable de l’élément d’historique sélectionné dans Enregistré."
