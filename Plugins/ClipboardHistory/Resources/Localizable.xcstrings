          "stringUnit": {
            "state": "translated",
            "value": "마지막 교체 전의 로컬 데이터를 복구합니다. 백업 암호는 필요하지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Recupere os dados locais anteriores à última substituição. Não requer senha do backup."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановите локальные данные до последней замены. Пароль резервной копии не нужен."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son değiştirmenin öncesindeki yerel verileri kurtarır. Yedek parolası gerekmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复到上次替换前的本机数据，无需备份密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還原到上次取代前的本機資料，無需備份密碼。"
          }
        }
      }
    },
    "backup.restoreDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر نسخة احتياطية وأدخل كلمة مرورها، ثم عاينها قبل الاستعادة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup auswählen, Passwort eingeben und vor dem Wiederherstellen prüfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a backup and enter its password, then preview before restoring."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una copia e introduce su contraseña para revisarla antes de restaurar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une sauvegarde, saisissez son mot de passe, puis vérifiez avant de restaurer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップを選んでパスワードを入力し、プレビューしてから復元します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업 파일과 암호를 입력하고 미리 본 후 복원합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um backup e digite a senha para conferir antes de restaurar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите резервную копию, введите пароль и проверьте данные перед восстановлением."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir yedek seçip parolasını girin, sonra geri yüklemeden önce önizleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择备份文件并输入密码，预览后再恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇備份檔案並輸入密碼，預覽後再還原。"
          }
        }
      }
    },
    "backup.createDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ البيانات المحددة في ملف مشفر لنقلها إلى جهاز Mac آخر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgewählte Daten verschlüsselt speichern und auf einen anderen Mac übertragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save selected data in an encrypted file to move to another Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda los datos seleccionados en un archivo cifrado para transferirlos a otro Mac."
          }
        },
        "fr": {
          "stringUnit": {
