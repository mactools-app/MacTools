          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボード履歴が安全な保存上限を超えています。既存の履歴を消去してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립보드 기록이 안전한 저장 한도를 초과했습니다. 기존 기록을 지우십시오."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico da área de transferência excede o limite de armazenamento seguro. Limpe o histórico existente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "История буфера обмена превышает безопасный лимит хранения. Очистите существующую историю."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pano geçmişi güvenli depolama sınırını aşıyor. Mevcut geçmişi temizleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴板历史超过安全存储上限。请清除现有历史记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "剪貼簿記錄超過安全儲存上限。請清除現有記錄。"
          }
        }
      }
    },
    "error.insufficientDiskSpace": {
