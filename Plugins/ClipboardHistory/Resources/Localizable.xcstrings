    "settings.snippets.expandedLimit.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحد النص النهائي بعد توسيع المتغيرات، بما في ذلك المعاينات. يُرفض الناتج الذي يتجاوز الحد ولا يُقتطع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Begrenzt den Text nach dem Ersetzen von Variablen, einschließlich Vorschauen. Zu große Ausgaben werden abgelehnt, nie abgeschnitten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Limits the final text after variables expand, including previews. Oversized output is rejected, never truncated."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limita el texto final tras expandir las variables, incluidas las vistas previas. Si supera el límite, se rechaza sin truncarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite le texte après le développement des variables, aperçus compris. Un résultat trop long est refusé, jamais tronqué."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビューを含む変数展開後のテキストを制限します。上限を超えるとエラーになり、切り詰めは行いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리보기를 포함해 변수 확장 후 최종 텍스트를 제한합니다. 한도를 넘으면 거부하며 텍스트를 자르지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Limita o texto após expandir as variáveis, incluindo prévias. Resultados acima do limite são rejeitados, nunca truncados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ограничивает текст после подстановки переменных, включая предпросмотр. Превышение лимита вызывает ошибку, текст не обрезается."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişkenler genişletildikten sonraki son metni sınırlar (önizlemeler dahil). Sınırı aşan çıktı reddedilir, asla kısaltılmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "限制变量展开后的最终文本，包括预览。超限时会提示错误，不会截断文本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "限制變數展開後的最終文字，包括預覽。超限時會提示錯誤，不會截斷文字。"
          }
        }
      }
    },
    "saved.error.expandedTextTooLarge": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتجاوز النص الموسّع حد %lld م.ب. غيّره في المقتطفات ← متقدم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der erweiterte Text überschreitet das Limit von %lld MB. Ändere es unter Textbausteine → Erweitert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expanded text exceeds the %lld MB limit. Change it in Snippets → Advanced."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto expandido supera el límite de %lld MB. Cámbialo en Fragmentos → Avanzado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte développé dépasse la limite de %lld Mo. Modifiez-la dans Extraits → Avancé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "展開後のテキストが %lld MB の上限を超えています。「スニペット → 詳細設定」で変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확장된 텍스트가 %lld MB 한도를 초과합니다. 스니펫 → 고급에서 변경하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto expandido excede o limite de %lld MB. Altere em Trechos → Avançado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Развёрнутый текст превышает лимит %lld МБ. Измените его в разделе «Фрагменты → Дополнительно»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Genişletilmiş metin %lld MB sınırını aşıyor. Bunu Parçacıklar → Gelişmiş bölümünden değiştirin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "展开文本超过 %lld MB 上限。可在「片段 → 高级」中调整。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "展開文字超過 %lld MB 上限。可在「片段 → 進階」中調整。"
          }
        }
      }
    },
