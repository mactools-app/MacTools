    "panel.shortcuts.actions.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح الإجراءات أو أغلقها للعودة إلى البحث في السجل."
          }
        },
        "de": {
          "stringUnit": {
