    "settings.data.clearSnippets.summary": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف المقتطفات وكلماتها المفتاحية مع الاحتفاظ بالسجل والعناصر المحفوظة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Textbausteine und ihre Kürzel löschen; Verlauf und gespeicherte Einträge behalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete snippets and their keywords; keep history and saved clips."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina los fragmentos y sus palabras clave; conserva el historial y los elementos guardados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer les extraits et leurs mots-clés ; conserver l’historique et les éléments enregistrés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スニペットとキーワードを削除します。履歴と保存済み項目は保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스니펫과 키워드를 삭제합니다. 기록과 저장된 항목은 유지됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclua trechos e suas palavras-chave; mantenha o histórico e os itens salvos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить фрагменты и их ключевые слова, оставив историю и сохранённые элементы."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parçacıkları ve anahtar sözcüklerini siler; geçmiş ve kayıtlı öğeleri korur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除片段及其关键词，保留历史和已存项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除片段及其關鍵字，保留記錄和已儲存項目。"
          }
        }
      }
    },
