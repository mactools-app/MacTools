    "panel.preview.decodeFailed": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر فك ترميز المعاينة. أعد المحاولة أو استخدم المحتوى الأصلي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vorschau konnte nicht dekodiert werden. Versuchen Sie es erneut oder verwenden Sie den Originalinhalt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The preview could not be decoded. Retry or use the original content."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo decodificar la vista previa. Reinténtalo o usa el contenido original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’aperçu n’a pas pu être décodé. Réessayez ou utilisez le contenu original."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビューをデコードできませんでした。再試行するか、元の内容を使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리보기를 디코딩할 수 없습니다. 다시 시도하거나 원본 콘텐츠를 사용하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível decodificar a prévia. Tente novamente ou use o conteúdo original."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось декодировать предпросмотр. Повторите попытку или используйте исходное содержимое."
