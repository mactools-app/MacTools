    "itemShortcut.format.original.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحافظ على التنسيق وبيانات الحافظة الأصلية الأخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behält Formatierung und weitere ursprüngliche Zwischenablagedaten bei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preserves formatting and other original clipboard data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva el formato y otros datos originales del portapapeles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserve la mise en forme et les autres données d’origine du presse-papiers."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の書式とクリップボードのその他のデータを保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 서식과 기타 클립보드 데이터를 유지합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Preserva a formatação e outros dados originais da área de transferência."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняет форматирование и другие исходные данные буфера обмена."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biçimlendirmeyi ve diğer özgün pano verilerini korur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留原始格式及其他剪贴板数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留原始格式及其他剪貼簿資料。"
          }
        }
      }
    },
    "itemShortcut.format.plainText.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يلصق النص فقط دون تنسيق أو بيانات أخرى. تُستخدم النصوص المتعرّف عليها للصور ومسارات الملفات للملفات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt nur Text ohne Formatierung oder andere Daten ein. Bei Bildern wird erkannter Text, bei Dateien der Pfad verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastes text only, without formatting or other data. Images use recognized text; files use paths."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega solo texto, sin formato ni otros datos. Las imágenes usan el texto reconocido y los archivos, sus rutas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Colle uniquement le texte, sans mise en forme ni autres données. Les images utilisent le texte reconnu et les fichiers leur chemin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書式やその他のデータを除き、テキストのみをペーストします。画像は認識した文字、ファイルはパスを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서식이나 다른 데이터 없이 텍스트만 붙여넣습니다. 이미지는 인식된 텍스트, 파일은 경로를 사용합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cola apenas texto, sem formatação ou outros dados. Imagens usam texto reconhecido; arquivos usam caminhos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставляет только текст без форматирования и других данных. Для изображений используется распознанный текст, для файлов — пути."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca metni, biçimlendirme veya diğer veriler olmadan yapıştırır. Görseller tanınan metni, dosyalar yolları kullanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅粘贴文字，不含格式或其他数据。图片使用识别文字；文件使用路径。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅貼上文字，不含格式或其他資料。圖片使用辨識文字；檔案使用路徑。"
          }
        }
      }
    },
    "itemShortcut.textOnly.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي هذا العنصر على نص عادي فقط، لذا يكفي اختصار واحد لطريقتَي اللصق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Element enthält nur reinen Text. Ein Kurzbefehl genügt für beide Einfügearten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This item contains only plain text, so one shortcut covers both paste styles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este elemento solo contiene texto sin formato; un atajo sirve para ambos modos de pegado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet élément ne contient que du texte brut : un seul raccourci suffit pour les deux modes de collage."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この項目はプレーンテキストのみです。どちらの貼り付け方も同じなので、ショートカットは1つで十分です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목은 일반 텍스트만 포함하므로 두 붙여넣기 방식에 단축키 하나면 충분합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este item contém apenas texto simples; um atalho serve para os dois modos de colagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот элемент содержит только обычный текст, поэтому одного сочетания достаточно для обоих способов вставки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu öğe yalnızca düz metin içerdiğinden tek kısayol iki yapıştırma biçimini de kapsar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此项目只有纯文本，两种粘贴方式结果相同，只需一个快捷键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此項目只有純文字，兩種貼上方式結果相同，只需一個快捷鍵。"
          }
        }
      }
    },
    "itemShortcut.textOnly.existingPlain": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يلصق هذا الاختصار الحالي النص نفسه. يمكنك الإبقاء عليه أو إزالته."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser vorhandene Kurzbefehl fügt denselben Text ein. Sie können ihn behalten oder entfernen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This existing shortcut pastes the same text. You can keep or remove it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este atajo existente pega el mismo texto. Puedes conservarlo o eliminarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce raccourci existant colle le même texte. Vous pouvez le conserver ou le supprimer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この既存のショートカットも同じテキストをペーストします。残すか削除できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기존 단축키도 같은 텍스트를 붙여넣습니다. 유지하거나 제거할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este atalho existente cola o mesmo texto. Você pode mantê-lo ou removê-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это существующее сочетание вставляет тот же текст. Его можно оставить или удалить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu mevcut kısayol aynı metni yapıştırır. Tutabilir veya kaldırabilirsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此现有快捷键粘贴相同文本；可保留或移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此現有快捷鍵貼上相同文字；可保留或移除。"
          }
        }
      }
    },
