    "backup.error.password": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم كلمة مرور للنسخة الاحتياطية لا تقل عن 12 حرفًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Backup-Passwort muss mindestens 12 Zeichen enthalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a backup password with at least 12 characters."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa una contraseña de al menos 12 caracteres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez un mot de passe de sauvegarde d’au moins 12 caractères."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "12 文字以上のバックアップパスワードを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "12자 이상의 백업 암호를 사용하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Use uma senha de backup com pelo menos 12 caracteres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте пароль резервной копии длиной не менее 12 символов."
