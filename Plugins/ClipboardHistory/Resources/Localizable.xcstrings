    "settings.privacyOverview.summary": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحفظ المحتوى مشفرًا على هذا الـ Mac، ويُحفظ المفتاح في سلسلة المفاتيح."
          }
