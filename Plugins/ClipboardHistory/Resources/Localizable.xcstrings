    "backup.passwordWarning": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم 12 حرفًا على الأقل. يمكنك استخدام عبارة يسهل تذكرها. احتفظ بها بأمان؛ لا يستطيع MacTools استعادتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindestens 12 Zeichen. Eine einprägsame Passphrase eignet sich gut. Sicher aufbewahren; MacTools kann sie nicht wiederherstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use at least 12 characters. A memorable passphrase works well. Keep it safe; MacTools cannot recover it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa al menos 12 caracteres. Una frase fácil de recordar es una buena opción. Guárdala: MacTools no puede recuperarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez au moins 12 caractères, par exemple une phrase facile à retenir. Conservez-la : MacTools ne peut pas la récupérer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "12 文字以上で、覚えやすいフレーズも使えます。MacTools では復元できないため、大切に保管してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "12자 이상으로 입력하세요. 기억하기 쉬운 문구도 좋습니다. MacTools에서 복구할 수 없으니 안전하게 보관하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Use pelo menos 12 caracteres. Uma frase fácil de lembrar é uma boa opção. Guarde-a: o MacTools não pode recuperá-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте не менее 12 символов, например запоминающуюся фразу. Сохраните пароль: MacTools не сможет его восстановить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En az 12 karakter kullanın. Akılda kalıcı bir parola tümcesi işe yarar. Güvenli bir şekilde saklayın; MacTools bunu kurtaramaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "至少 12 个字符，可使用便于记忆的短语。请妥善保存，MacTools 无法找回密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "至少 12 個字元，可使用便於記憶的短語。請妥善保存，MacTools 無法找回密碼。"
          }
        }
      }
    },
