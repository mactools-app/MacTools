          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve os dados selecionados em um arquivo criptografado para transferir a outro Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните выбранные данные в зашифрованный файл для переноса на другой Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili verileri, başka bir Mac'e taşımak için şifreli bir dosyaya kaydeder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
