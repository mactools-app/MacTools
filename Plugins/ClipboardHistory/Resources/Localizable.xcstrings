          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 필드는 지원되는 비보안 텍스트 편집기를 제공하지 않습니다. 클립보드에서 스니펫을 붙여넣으세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este campo não disponibiliza um editor de texto não protegido compatível. Cole o trecho pela Área de Transferência."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это поле не предоставляет поддерживаемый незащищённый текстовый редактор. Вставьте шаблон через буфер обмена."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu alan, desteklenen güvenli olmayan bir metin düzenleyici sunmuyor. Bunun yerine parçacığı Panodan yapıştırın."
