    "settings.storage.encrypted.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحفظ السجل والعناصر المحفوظة في قاعدة بيانات محلية مشفّرة ويمكن مسحهما بشكل منفصل. تحفظ سلسلة المفاتيح المفتاح المحلي فقط؛ ولا تُطلب سلسلة مفاتيح iCloud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlauf und gespeicherte Elemente liegen in einer lokalen verschlüsselten Datenbank und können getrennt gelöscht werden. Der Schlüsselbund enthält nur den lokalen Schlüssel; iCloud-Schlüsselbund ist nicht erforderlich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History and Saved items are stored in a local encrypted database and can be cleared separately. Keychain holds only this Mac’s encryption key; iCloud Keychain is not required."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial y los elementos guardados se almacenan en una base de datos local cifrada y pueden borrarse por separado. El Llavero solo guarda la clave de este Mac; no se requiere el Llavero de iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’historique et les éléments enregistrés sont stockés dans une base locale chiffrée et peuvent être effacés séparément. Le trousseau ne contient que la clé de ce Mac ; le trousseau iCloud n’est pas requis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴と保存済み項目はローカルの暗号化データベースに保存され、個別に消去できます。キーチェーンにはこのMacの暗号化キーのみ保持され、iCloudキーチェーンは不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록과 저장된 항목은 로컬 암호화 데이터베이스에 저장되며 별도로 지울 수 있습니다. 키체인에는 이 Mac의 암호화 키만 보관되며 iCloud 키체인은 필요하지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico e os itens salvos ficam em um banco de dados local criptografado e podem ser apagados separadamente. As Chaves guardam apenas a chave deste Mac; as Chaves do iCloud não são necessárias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "История и сохранённые элементы находятся в локальной зашифрованной базе и могут очищаться отдельно. В Связке ключей хранится только ключ этого Mac; Связка ключей iCloud не требуется."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçmiş ve kayıtlı öğeler yerel bir şifreli veritabanında saklanır ve ayrı ayrı temizlenebilir. Keychain yalnızca bu Mac'in şifreleme anahtarını tutar; iCloud Keychain gerekmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史和已保存项目存放在本机加密数据库中；两者可分别清除。钥匙串只保存这台 Mac 的加密密钥，不需要 iCloud 钥匙串。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄和已儲存項目存放在本機加密資料庫中；兩者可分別清除。鑰匙圈只儲存這部 Mac 的加密金鑰，不需要 iCloud 鑰匙圈。"
          }
        }
      }
    },
