    "backup.unlockDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل كلمة المرور المستخدمة عند إنشاء النسخة. لا يغيّر التحقق والمعاينة البيانات المحلية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das beim Erstellen verwendete Passwort eingeben. Prüfung und Vorschau ändern keine lokalen Daten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the password used to create this backup. Validation and preview do not change local data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce la contraseña usada al crear la copia. La validación y la vista previa no modifican los datos locales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le mot de passe utilisé à la création. La vérification et l’aperçu ne modifient pas les données locales."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成時のパスワードを入力してください。検証とプレビューではローカルデータは変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업을 만들 때 설정한 암호를 입력하세요. 검증과 미리 보기는 로컬 데이터를 변경하지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite a senha usada ao criar o backup. A validação e a prévia não alteram os dados locais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите пароль, заданный при создании копии. Проверка и предпросмотр не изменяют локальные данные."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yedeği oluştururken kullanılan parolayı girin. Doğrulama ve önizleme yerel verileri değiştirmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入创建此备份时设置的密码。验证和预览不会更改本机数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入建立此備份時設定的密碼。驗證和預覽不會更改本機資料。"
          }
        }
      }
    },
