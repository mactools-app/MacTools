    "saved.editor.keywordHint": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتوسع الكلمات الفريدة أثناء الكتابة في المحررات المدعومة. إذا كانت الكلمة بادئة لأخرى، فاضغط على المسافة. يتطلب إذن تسهيلات الاستخدام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eindeutige Kürzel werden in unterstützten Editoren beim Tippen erweitert. Beginnt ein anderes Kürzel damit, warte auf die Leertaste. Bedienungshilfen-Berechtigung erforderlich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unique keywords expand as you type in supported editors. Keywords that prefix another keyword wait for Space. Requires Accessibility permission."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las palabras clave únicas se expanden al escribir en editores compatibles. Si son prefijo de otra, esperan a Espacio. Requiere permiso de Accesibilidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mots-clés uniques se développent à la saisie dans les éditeurs compatibles. Ceux qui commencent un autre mot-clé attendent Espace. Autorisation Accessibilité requise."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応エディタでは固有のキーワードを入力すると展開されます。別のキーワードの先頭と一致する場合はスペースキーで展開します。アクセシビリティ権限が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지원되는 편집기에서 고유한 키워드를 입력하면 확장됩니다. 다른 키워드의 접두사인 경우 스페이스를 기다립니다. 손쉬운 사용 권한이 필요합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As palavras-chave únicas expandem-se ao escrever em editores compatíveis. As que são prefixo de outra aguardam Espaço. Requer permissão de Acessibilidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уникальные ключевые слова раскрываются при вводе в поддерживаемых редакторах. Префиксы других слов ожидают пробела. Требуется Универсальный доступ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Benzersiz anahtar sözcükler, desteklenen düzenleyicilerde siz yazarken genişletilir. Başka bir anahtar sözcüğün başlangıcı olanlar Space tuşunu bekler. Erişilebilirlik izni gerektirir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在支持的编辑器中，唯一关键词会在输入完成时展开；若它是另一关键词的前缀，则等待空格。需要辅助功能权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在支援的編輯器中，唯一關鍵字會在輸入完成時展開；若它是另一關鍵字的前綴，則等待空白鍵。需要輔助使用權限。"
          }
        }
      }
    },
