    "backup.capacity.message": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُحتفظ بمحتوى جميع المقتطفات المستوردة. تُعطى الأولوية للكلمات المفتاحية المحلية الحالية، ثم للمستوردة حسب ترتيب النسخة الاحتياطية. ستُزال %d من ارتباطات الكلمات المفتاحية المستوردة التي تتجاوز السعة؛ ويمكن لصق مقتطفاتها يدويًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle importierten Textbausteininhalte bleiben erhalten. Lokale Schlüsselwörter haben Vorrang, danach folgen importierte Schlüsselwörter in Sicherungsreihenfolge. Die %d importierten Zuweisungen, die nicht mehr passen, werden entfernt. Ihre Textbausteine können weiterhin manuell eingefügt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All imported snippet content will be kept. Existing local keywords take priority, followed by imported keywords in backup order. The %d imported keyword bindings that do not fit will be removed; their snippets can still be pasted manually."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se conservará el contenido de todos los fragmentos importados. Las palabras clave locales tienen prioridad, seguidas de las importadas en el orden de la copia. Se eliminarán las %d asignaciones importadas que excedan la capacidad; sus fragmentos podrán pegarse manualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu de tous les extraits importés sera conservé. Les mots-clés locaux sont prioritaires, puis les mots-clés importés sont retenus dans l’ordre de la sauvegarde. Les %d associations dépassant la capacité seront supprimées ; leurs extraits pourront toujours être collés manuellement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込んだスニペットの内容はすべて保持されます。既存のローカルキーワードを優先し、残りはバックアップ内の順序で保持します。容量に収まらない %d 個のキーワード割り当ては削除されますが、スニペットは手動で貼り付けできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져온 모든 스니펫 내용은 유지됩니다. 기존 로컬 키워드를 우선 유지한 후 백업 순서대로 가져온 키워드를 유지합니다. 용량을 초과하는 키워드 연결 %d개는 제거되지만 해당 스니펫은 계속 수동으로 붙여넣을 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo o conteúdo dos trechos importados será mantido. As palavras-chave locais têm prioridade, seguidas das importadas na ordem do backup. As %d associações importadas que excederem a capacidade serão removidas; seus trechos ainda poderão ser colados manualmente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Содержимое всех импортированных фрагментов сохранится. Приоритет имеют локальные ключевые слова, затем импортированные в порядке резервной копии. Будут удалены %d привязок импортированных ключевых слов, превышающих лимит; фрагменты по-прежнему можно вставлять вручную."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm içe aktarılan parçacık içerikleri korunur. Önce mevcut yerel anahtar sözcükler, ardından yedek sırasına göre içe aktarılan anahtar sözcükler önceliklidir. Sığmayan %d içe aktarılan anahtar sözcük bağlantısı kaldırılacak; ilgili parçacıklar yine de el ile yapıştırılabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有导入片段内容都会保留。优先保留本机已有关键词，再按备份顺序保留导入关键词；超出容量的 %d 个导入关键词绑定将被移除，对应片段仍可手动粘贴。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有匯入片段內容都會保留。優先保留本機現有關鍵詞，再依備份順序保留匯入關鍵詞；超出容量的 %d 個匯入關鍵詞綁定將被移除，對應片段仍可手動貼上。"
          }
        }
      }
    },
    "backup.capacity.notice": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُزيل ارتباط الكلمة المفتاحية لتجاوز السعة؛ وحُفظ محتوى المقتطف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlüsselwortzuweisung wegen Kapazitätsüberschreitung entfernt; Textbausteininhalt erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyword binding removed because capacity was exceeded; snippet content kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asignación de palabra clave eliminada por falta de capacidad; contenido conservado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Association de mot-clé supprimée faute de capacité ; contenu de l’extrait conservé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "容量不足のためキーワード割り当てを削除しました。スニペットの内容は保持されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "용량 부족으로 키워드 연결이 제거되었습니다. 스니펫 내용은 유지됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Associação de palavra-chave removida por falta de capacidade; conteúdo mantido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Привязка ключевого слова удалена из-за превышения лимита; содержимое фрагмента сохранено."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapasite aşıldığı için anahtar sözcük bağlantısı kaldırıldı; parçacık içeriği korundu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关键词绑定因容量不足而移除；片段内容已保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關鍵詞綁定因容量不足而移除；片段內容已保留。"
          }
        }
      }
    },
    "backup.error.keywordCapacityConfirmation": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكّد إزالة ارتباطات الكلمات المفتاحية المستوردة التي تتجاوز السعة قبل المتابعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätige vor dem Fortfahren das Entfernen importierter Schlüsselwortzuweisungen, die die Kapazität überschreiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm removal of imported keyword bindings that exceed capacity before continuing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma la eliminación de las asignaciones importadas que excedan la capacidad antes de continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmez la suppression des associations de mots-clés importés dépassant la capacité avant de continuer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続行する前に、容量を超える読み込みキーワードの割り当ての削除を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속하기 전에 용량을 초과하는 가져온 키워드 연결의 제거를 확인하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirme a remoção das associações importadas que excedem a capacidade antes de continuar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед продолжением подтвердите удаление импортированных привязок ключевых слов, превышающих лимит."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devam etmeden önce, kapasiteyi aşan içe aktarılan anahtar sözcük bağlantılarının kaldırılmasını onaylayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先确认是否移除超出容量的导入关键词绑定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先確認是否移除超出容量的匯入關鍵詞綁定。"
          }
        }
      }
    },
    "backup.error.passwordTooLong": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلمة المرور طويلة جدًا. اختصرها وحاول مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Passwort ist zu lang. Kürzen und erneut versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The password is too long. Shorten it and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La contraseña es demasiado larga. Acórtala e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mot de passe est trop long. Raccourcissez-le et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードが長すぎます。短くして再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호가 너무 깁니다. 줄인 후 다시 시도하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A senha é longa demais. Reduza-a e tente novamente."
