    "backup.removed": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُحذف بيانات الفئات المحددة من %d من العناصر المحلية. ستُنشأ لقطة محلية مشفرة للتراجع قبل التطبيق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei %d lokalen Einträgen werden die Daten der ausgewählten Kategorien entfernt. Vor dem Übernehmen wird ein verschlüsselter lokaler Wiederherstellungspunkt erstellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%d local items will lose data in the selected categories. An encrypted local rollback snapshot will be created before committing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán los datos de las categorías seleccionadas de %d elementos locales. Se creará una instantánea local cifrada antes de confirmar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données des catégories choisies seront supprimées pour %d éléments locaux. Un instantané local chiffré sera créé avant la validation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 個のローカル項目で選択したカテゴリのデータが削除されます。確定前に暗号化されたローカル復元スナップショットを作成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 항목 %d개의 선택된 범주 데이터가 제거됩니다. 적용 전에 암호화된 로컬 롤백 스냅샷을 만듭니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados das categorias selecionadas serão removidos de %d itens locais. Um instantâneo local criptografado será criado antes da confirmação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные выбранных категорий будут удалены у %d локальных элементов. Перед применением будет создан зашифрованный локальный снимок для отката."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili kategorilerdeki %d yerel öğenin verileri kaybolacak. İşlem uygulanmadan önce şifreli bir yerel geri alma anlık görüntüsü oluşturulacak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将移除 %d 个本机项目的所选类别数据。提交前会创建本机加密回滚快照。"
