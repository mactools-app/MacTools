            "value": "Nenhum app excluído"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет исключённых приложений"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hariç Tutulan Uygulama Yok"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未排除任何应用"
          }
        },
        "zh-Hant": {
