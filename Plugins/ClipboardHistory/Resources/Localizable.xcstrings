    "settings.saved.expansion.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استبدال كلمة المقتطف الواضحة فورًا أثناء الكتابة. يتم تجاهل حقول النص الآمنة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eindeutige Snippet-Kürzel direkt beim Tippen ersetzen. Sichere Textfelder werden ignoriert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Immediately replace an unambiguous snippet keyword as you type. Secure text fields are ignored."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reemplaza al escribir una palabra clave de fragmento sin ambigüedad. Se omiten los campos de texto seguros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplace immédiatement les mots-clés d’extrait sans ambiguïté pendant la saisie. Les champs sécurisés sont ignorés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "曖昧さのないスニペットのキーワードを入力すると即座に置換します。セキュア入力欄は無視されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명확한 스니펫 키워드를 입력하면 즉시 바꿉니다. 보안 텍스트 필드는 무시합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Substitui imediatamente uma palavra-chave de trecho sem ambiguidade ao escrever. Os campos seguros são ignorados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сразу заменяет однозначные ключевые слова фрагментов при вводе. Защищённые поля игнорируются."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belirsiz olmayan bir parçacık anahtar sözcüğünü siz yazarken anında değiştirir. Güvenli metin alanları yok sayılır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入无歧义的完整片段关键词时立即替换。安全文本字段会被忽略。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入無歧義的完整片段關鍵字時立即替換。安全文字欄位會被忽略。"
          }
        }
      }
    },
