    "backup.historyWarning": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يتضمن السجل معلومات حساسة. أدرجه عند الحاجة فقط. تُحفظ الملفات الخارجية كمراجع للمسارات فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verlauf kann sensible Informationen enthalten. Nimm ihn nur bei Bedarf auf. Externe Dateien werden nur als Pfadverweise gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History may contain sensitive information. Include it only when needed. External files are saved as path references only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial puede contener información confidencial. Inclúyelo solo si es necesario. Los archivos externos se guardan solo como referencias de ruta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’historique peut contenir des informations sensibles. Ne l’incluez que si nécessaire. Seuls les chemins des fichiers externes sont enregistrés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴には機密情報が含まれる場合があります。必要な場合のみ含めてください。外部ファイルはパス参照のみ保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록에는 민감한 정보가 포함될 수 있습니다. 필요한 경우에만 포함하세요. 외부 파일은 경로 참조만 저장됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico pode conter informações confidenciais. Inclua-o apenas quando necessário. Arquivos externos são salvos apenas como referências de caminho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "История может содержать конфиденциальные сведения. Включайте её только при необходимости. Для внешних файлов сохраняются только пути."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçmiş hassas bilgiler içerebilir. Yalnızca gerektiğinde dahil edin. Harici dosyalar yalnızca yol referansı olarak kaydedilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史记录可能包含敏感信息。仅在明确需要时加入备份。外部文件仅保存路径。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歷史記錄可能包含敏感資訊。僅在需要時加入備份。外部檔案僅儲存路徑。"
          }
        }
      }
    },
