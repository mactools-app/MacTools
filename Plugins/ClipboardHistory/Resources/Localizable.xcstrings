    "action.queue.cancel.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلغاء قائمة اللصق المتتابع النشطة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aktive Warteschlange zum nacheinander Einsetzen abbrechen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel the active sequential paste queue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancela la cola activa de pegado secuencial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler la file active de collage séquentiel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中の連続ペーストキューをキャンセルします。"
