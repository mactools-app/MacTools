    "settings.queue.shortcuts.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عيّن «لصق التالي» أولًا؛ عناصر التحكم الأخرى اختيارية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuerst „Nächstes einsetzen“ zuweisen; weitere Steuerelemente sind optional."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assign Paste Next first; the other queue controls are optional."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asigna primero Pegar siguiente; los demás controles son opcionales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attribuez d’abord Coller le suivant ; les autres commandes sont facultatives."
          }
        },
        "ja": {
