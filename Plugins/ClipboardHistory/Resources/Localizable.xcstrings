    "panel.selection.order": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُدمج العناصر حسب ترتيب التحديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Elemente werden in Auswahlreihenfolge kombiniert."
          }
