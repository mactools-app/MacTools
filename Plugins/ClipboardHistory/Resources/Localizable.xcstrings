    "panel.shortcuts.cycleScope.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التبديل بين الكل والسجل والمقتطفات؛ أضف Shift للرجوع. استخدم Control-1 إلى Control-3 لاختيار النطاق مباشرةً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwischen Alle, Verlauf und Textbausteine wechseln; mit Umschalt rückwärts. Control-1 bis Control-3 wählt den Bereich direkt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch between All, History, and Snippets; add Shift to go backward. Control-1 through Control-3 selects a scope directly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia entre Todo, Historial y Fragmentos; añade Mayúsculas para retroceder. Control-1 a Control-3 selecciona un ámbito directamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parcourir Tout, Historique et Extraits ; ajouter Maj pour revenir en arrière. Contrôle-1 à Contrôle-3 sélectionne directement une portée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべて、履歴、スニペットを切り替えます。Shift を加えると逆方向になります。Control-1〜Control-3 で範囲を直接選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체, 기록, 스니펫을 전환합니다. Shift를 추가하면 반대 방향으로 전환합니다. Control-1부터 Control-3까지 눌러 범위를 직접 선택합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterna entre Tudo, Histórico e Trechos; adicione Shift para voltar. Control-1 a Control-3 seleciona um escopo diretamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переключение между всеми элементами, историей и фрагментами; добавьте Shift для обратного порядка. Control-1–Control-3 выбирает область напрямую."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tümü, Geçmiş ve Parçacıklar arasında geçiş yapın; geriye gitmek için Shift tuşunu ekleyin. Control-1'den Control-3'e kadar olan tuşlar doğrudan bir kapsam seçer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换全部、历史和片段；加按 Shift 可反向切换。Control-1 至 Control-3 可直接选择范围。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換全部、歷史和片段；加按 Shift 可反向切換。Control-1 至 Control-3 可直接選擇範圍。"
          }
        }
      }
    },
    "panel.shortcuts.cycleScope.shiftReserved": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift محجوز للتنقل للخلف. سجّل اختصار التنقل للأمام من دون Shift."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Umschalttaste ist für das Rückwärtswechseln reserviert. Zeichne den Vorwärtskurzbefehl ohne Umschalttaste auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift is reserved for cycling backward. Record the forward shortcut without Shift."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mayúsculas está reservado para retroceder. Graba el atajo de avance sin Mayúsculas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maj est réservé au parcours inverse. Enregistrez le raccourci suivant sans Maj."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift は逆方向の切り替え用に予約されています。順方向のショートカットは Shift なしで記録してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift는 뒤로 순환하는 데 사용됩니다. 앞으로 순환할 단축키는 Shift 없이 기록하십시오."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift é reservado para alternar para trás. Grave o atalho para avançar sem Shift."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift зарезервирован для обратного переключения. Запишите сочетание для переключения вперёд без Shift."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift, geriye geçiş için ayrılmıştır. İleri kısayolu Shift olmadan kaydedin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift 保留用于反向切换。请录制不含 Shift 的正向快捷键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift 保留用於反向切換。請錄製不含 Shift 的正向快速鍵。"
          }
        }
      }
    },
