    "panel.color.preview.help": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خلفية محايدة ثابتة؛ تُعرض الألوان الشفافة على نمط رقعة شطرنج. لا تغيّر المعاينة اللون المنسوخ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fester neutraler Hintergrund; transparente Farben zeigen ein Schachbrettmuster. Die Vorschau verändert die kopierte Farbe nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixed neutral background; transparent colors show a checkerboard. Previewing does not change the copied color."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fondo neutro fijo; los colores transparentes muestran un patrón de cuadros. La vista previa no modifica el color copiado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fond neutre fixe ; les couleurs transparentes affichent un damier. L’aperçu ne modifie pas la couleur copiée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背景は固定の中間色です。透明な色には市松模様を表示します。プレビューはコピーした色を変更しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고정된 중성 배경이며 투명한 색상에는 바둑판무늬가 표시됩니다. 미리보기는 복사한 색상을 변경하지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fundo neutro fixo; cores transparentes mostram um padrão quadriculado. A pré-visualização não altera a cor copiada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Постоянный нейтральный фон; прозрачные цвета показаны на шахматном фоне. Предпросмотр не меняет скопированный цвет."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabit nötr arka plan; saydam renkler dama deseni gösterir. Önizleme, kopyalanan rengi değiştirmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固定中性背景；透明颜色显示棋盘格。预览不会更改复制的颜色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "固定中性背景；透明顏色顯示棋盤格。預覽不會更改複製的顏色。"
          }
        }
      }
    },
