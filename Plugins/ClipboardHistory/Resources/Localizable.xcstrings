    "settings.sequentialPaste.dismiss.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر اللوحة القابلة للنقل تلقائيًا بعد اللصق المتتابع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das bewegliche HUD erscheint automatisch nach dem sequenziellen Einsetzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The movable HUD appears automatically after sequential paste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El HUD móvil aparece automáticamente tras pegar en secuencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’affichage mobile apparaît automatiquement après un collage séquentiel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移動可能なHUDは順番にペーストした後に自動的に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이동 가능한 HUD는 순차 붙여넣기 후 자동으로 나타납니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O HUD móvel aparece automaticamente após colar em sequência."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемещаемый HUD появляется автоматически после последовательной вставки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taşınabilir HUD, sıralı yapıştırmadan sonra otomatik olarak görünür."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可移动 HUD 会在连续粘贴后自动出现。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可移動 HUD 會在連續貼上後自動出現。"
          }
        }
      }
    },
