          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o histórico, cole texto simples ou itens um a um."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть историю, вставить простой текст или элементы по одному."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
