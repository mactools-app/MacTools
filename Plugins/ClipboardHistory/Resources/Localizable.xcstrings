    "backup.error.limit": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتجاوز النسخة الاحتياطية حد الأمان أو حد الحجم الحالي لكل عنصر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Backup überschreitet eine Sicherheitsgrenze oder die aktuelle Größenbegrenzung pro Eintrag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backup exceeds a safety limit or the current per-item size limit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia supera un límite de seguridad o el tamaño máximo actual por elemento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sauvegarde dépasse une limite de sécurité ou la taille maximale actuelle par élément."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップが安全上限または現在の項目サイズ上限を超えています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업이 안전 한도 또는 현재 항목별 크기 제한을 초과합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O backup excede um limite de segurança ou o limite de tamanho atual por item."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервная копия превышает предел безопасности или текущий предел размера одного элемента."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedek, güvenlik sınırını veya geçerli öğe başına boyut sınırını aşıyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份超过安全上限或当前单项大小限制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備份超過安全上限或目前單項大小限制。"
          }
        }
      }
    },
    "backup.error.changed": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيرت بيانات الحافظة المحلية. عاين النسخة الاحتياطية مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die lokalen Zwischenablagedaten wurden geändert. Zeige die Vorschau erneut an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local clipboard data changed. Preview the backup again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos locales del portapapeles han cambiado. Vuelve a previsualizar la copia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données locales du presse-papiers ont changé. Affichez à nouveau l’aperçu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacのクリップボードデータが変更されました。もう一度プレビューしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac의 클립보드 데이터가 변경되었습니다. 백업을 다시 미리 보세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados locais da área de transferência mudaram. Visualize o backup novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальные данные буфера обмена изменились. Повторите предварительный просмотр."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel pano verileri değişti. Yedeği yeniden önizleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机剪贴板数据已更改。请重新预览备份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本機剪貼簿資料已變更。請重新預覽備份。"
          }
        }
      }
    },
    "backup.error.storage": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذرت قراءة النسخة الاحتياطية أو كتابتها. تحقق من مساحة القرص وأذونات الملف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Backup kann nicht gelesen oder geschrieben werden. Prüfe Speicherplatz und Dateiberechtigungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to read or write the backup. Check available disk space and file permissions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede leer o escribir la copia. Comprueba el espacio en disco y los permisos del archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire ou d’écrire la sauvegarde. Vérifiez l’espace disque et les autorisations du fichier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップを読み書きできません。空き容量とファイルのアクセス権を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업을 읽거나 쓸 수 없습니다. 여유 디스크 공간과 파일 권한을 확인하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler ou gravar o backup. Verifique o espaço em disco e as permissões do arquivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать или записать резервную копию. Проверьте свободное место и права доступа к файлу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedek okunamıyor ya da yazılamıyor. Kullanılabilir disk alanını ve dosya izinlerini denetleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读写备份。请检查可用磁盘空间和文件权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀寫備份。請檢查可用磁碟空間和檔案權限。"
          }
        }
      }
    },
