    "setup.collection.actionDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند التفعيل، تُحفظ العناصر الجديدة في سجل محلي مشفّر. يمكنك إيقاف الجمع مؤقتًا في أي وقت لاحقًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Aktivieren werden neue Kopien im lokal verschlüsselten Verlauf gespeichert. Die Erfassung kann später jederzeit pausiert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, new copies are saved to locally encrypted history. You can pause collection at any time later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al activarlo, las nuevas copias se guardan en el historial cifrado localmente. Puedes pausar la recopilación más adelante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois activées, les nouvelles copies sont enregistrées dans l’historique chiffré localement. Vous pourrez suspendre la collecte plus tard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると、新しくコピーした項目がローカルで暗号化された履歴に保存されます。収集は後からいつでも一時停止できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성화하면 새로 복사한 항목이 로컬 암호화 기록에 저장됩니다. 나중에 언제든지 수집을 일시 정지할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ativado, as novas cópias são guardadas no histórico encriptado localmente. Pode pausar a recolha mais tarde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После включения новые копии сохраняются в локально зашифрованной истории. Сбор можно приостановить позже в любое время."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkinleştirildiğinde yeni kopyalar yerel olarak şifrelenmiş geçmişe kaydedilir. Toplamayı daha sonra dilediğiniz zaman duraklatabilirsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后，新复制的内容会保存在本机加密历史中。你以后可以随时暂停收集。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後，新複製的內容會儲存在本機加密記錄中。你之後可以隨時暫停收集。"
          }
        }
      }
    },
