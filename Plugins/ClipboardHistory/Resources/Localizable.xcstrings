          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha uma cópia permanente do item de histórico selecionado em Salvos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранить постоянную копию выбранного элемента истории."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaktaki yakalanan öğenin “Kayıtlı”da tutulup tutulmayacağını değiştirir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换当前已捕获项目是否保存在“已存”中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換目前已擷取項目是否保存在「已儲存」中。"
          }
        }
      }
    },
