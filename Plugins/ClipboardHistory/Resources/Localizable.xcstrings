    "settings.expansion.unsupported": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوفّر هذا الحقل محرر نصوص غير آمن مدعومًا. الصق المقتطف من الحافظة بدلاً من ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Feld bietet keinen unterstützten, ungeschützten Texteditor. Füge den Textbaustein aus der Zwischenablage ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This field does not expose a supported, non-secure text editor. Paste the snippet from Clipboard instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este campo no ofrece un editor de texto no protegido compatible. Pega el fragmento desde Portapapeles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce champ n’expose pas d’éditeur de texte non sécurisé compatible. Collez l’extrait depuis le presse-papiers."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
