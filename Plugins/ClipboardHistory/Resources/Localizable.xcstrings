    "settings.exclusions.empty": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد تطبيقات مستبعدة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Apps ausgeschlossen"
          }
        },
        "en": {
