    "saved.variable.formatHelp": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "yyyy = السنة، MM = الشهر، dd = اليوم؛ HH = الساعة، mm = الدقيقة. ضع النص الحرفي بين علامتي اقتباس مفردتين."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "yyyy = Jahr, MM = Monat, dd = Tag; HH = Stunde, mm = Minute. Festen Text in einfache Anführungszeichen setzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "yyyy = year, MM = month, dd = day; HH = hour, mm = minute. Quote literal text with single quotes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "yyyy = año, MM = mes, dd = día; HH = hora, mm = minuto. Usa comillas simples para texto literal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "yyyy = année, MM = mois, dd = jour ; HH = heure, mm = minute. Entourez le texte littéral d’apostrophes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "yyyy = 年、MM = 月、dd = 日、HH = 時、mm = 分。固定テキストは単一引用符で囲みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "yyyy = 연도, MM = 월, dd = 일, HH = 시, mm = 분. 고정 텍스트는 작은따옴표로 감싸세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "yyyy = ano, MM = mês, dd = dia; HH = hora, mm = minuto. Use aspas simples para texto literal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "yyyy = год, MM = месяц, dd = день; HH = час, mm = минута. Обычный текст заключайте в одинарные кавычки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "yyyy = yıl, MM = ay, dd = gün; HH = saat, mm = dakika. Sabit metinleri tek tırnak içine alın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "yyyy 年、MM 月、dd 日；HH 时、mm 分。固定文本用单引号包围。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "yyyy 年、MM 月、dd 日；HH 時、mm 分。固定文字以單引號括起。"
          }
        }
      }
    },
    "saved.variable.offsetHelp": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختياري: +1d غدًا، -1w الأسبوع الماضي. الوحدات: s، m، h، d، w، M للشهر، y. تُراعى تغييرات التوقيت الصيفي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional: +1d morgen, -1w letzte Woche. Einheiten: s, m, h, d, w, M (Monat), y. Sommerzeit wird berücksichtigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional: +1d tomorrow, -1w last week. Units: s, m, h, d, w, M (month), y. Calendar offsets respect daylight saving time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional: +1d mañana, -1w semana pasada. Unidades: s, m, h, d, w, M (mes), y. Respeta el horario de verano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif : +1d demain, -1w semaine dernière. Unités : s, m, h, d, w, M (mois), y. Tient compte de l’heure d’été."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意：+1d は明日、-1w は先週。単位：s 秒、m 分、h 時、d 日、w 週、M 月、y 年。夏時間を考慮します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항: +1d 내일, -1w 지난주. 단위: s 초, m 분, h 시, d 일, w 주, M 월, y 년. 일광 절약 시간을 반영합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional: +1d amanhã, -1w semana passada. Unidades: s, m, h, d, w, M (mês), y. Respeita o horário de verão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необязательно: +1d завтра, -1w прошлая неделя. Единицы: s, m, h, d, w, M (месяц), y. Учитывается летнее время."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsteğe bağlı: +1d yarın, -1w geçen hafta. Birimler: s, m, h, d, w, M (ay), y. Takvim farkları yaz saati uygulamasını dikkate alır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选：+1d 明天，-1w 上周。单位：s 秒、m 分、h 时、d 天、w 周、M 月、y 年。日历偏移会考虑夏令时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選填：+1d 明天，-1w 上週。單位：s 秒、m 分、h 時、d 天、w 週、M 月、y 年。日曆偏移會考慮夏令時間。"
          }
        }
      }
    },
    "saved.variable.clipboardHelp": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم نص الحافظة الحالي. تُزال الفراغات أولًا ثم يُفحص الفراغ وتُغيَّر حالة الأحرف. لا يُفسَّر النص كقالب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet den aktuellen Zwischenablagetext. Erst Leerzeichen entfernen, dann auf leeren Inhalt prüfen, zuletzt Schreibweise ändern. Text wird nicht als Vorlage ausgewertet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses current clipboard text. Trimming happens before the empty check, then letter case is applied. Clipboard text is never evaluated as a template."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el texto actual del portapapeles. Elimina espacios, comprueba si está vacío y aplica la conversión de letras. Nunca interpreta el texto como plantilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise le texte actuel du presse-papiers. Supprime les espaces, vérifie si le texte est vide, puis applique la casse. Le texte n’est jamais interprété comme modèle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のクリップボードのテキストを使用します。空白削除、空判定、大文字・小文字の変換の順に処理します。テキストをテンプレートとして評価しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 클립보드 텍스트를 사용합니다. 공백 제거, 빈 값 확인, 대소문자 변환 순으로 처리합니다. 텍스트를 템플릿으로 해석하지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa o texto atual da área de transferência. Remove espaços, verifica se está vazio e aplica a conversão de letras. Nunca interpreta o texto como modelo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использует текущий текст буфера. Сначала удаляет пробелы, затем проверяет пустоту и меняет регистр. Текст не обрабатывается как шаблон."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçerli pano metnini kullanır. Önce boşluklar kırpılır, ardından boş olup olmadığı denetlenir, en son harf büyük/küçük durumu uygulanır. Pano metni asla şablon olarak değerlendirilmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用当前剪贴板文本。先去除空白，再检查是否为空，最后转换大小写。不会将剪贴板文本解析为模板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用目前剪貼簿文字。先移除空白，再檢查是否為空，最後轉換大小寫。不會將剪貼簿文字解析為範本。"
          }
        }
      }
    },
    "saved.variable.cursorHelp": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضع المؤشر هنا بعد اللصق التلقائي. يُسمح بعلامة واحدة فقط. يعمل في المحررات المدعومة؛ النسخ لا يحفظ الموضع. يظهر موضعه في المقتطف أدناه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt den Cursor nach automatischem Einfügen hierher. Nur eine Markierung ist erlaubt. Benötigt einen unterstützten Editor; Kopieren bewahrt die Position nicht. Unten wird die Position angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Places the typing cursor here after automatic paste. Only one marker is allowed. Works in supported editors; copying text does not preserve cursor position. The line below shows its position in your snippet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca aquí el cursor tras pegar automáticamente. Solo se permite un marcador. Requiere un editor compatible; copiar no conserva la posición. Se muestra debajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Place le curseur ici après le collage automatique. Un seul marqueur est autorisé. Nécessite un éditeur compatible ; copier ne conserve pas la position. Sa position est affichée ci-dessous."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動貼り付け後にカーソルをここへ移動します。マーカーは1つだけ使用できます。対応エディタで有効です。コピーでは位置は保持されません。下に位置を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 붙여넣기 후 커서를 여기에 놓습니다. 표시는 하나만 허용됩니다. 지원하는 편집기에서 작동하며 복사 시 위치는 유지되지 않습니다. 아래에 스니펫 내 위치가 표시됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca o cursor aqui após colar automaticamente. Apenas um marcador é permitido. Requer editor compatível; copiar não preserva a posição. A posição aparece abaixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Помещает курсор сюда после автовставки. Допускается один маркер. Нужен совместимый редактор; копирование не сохраняет позицию. Ниже показана позиция в шаблоне."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik yapıştırmadan sonra yazma imlecini buraya yerleştirir. Yalnızca bir işaretçiye izin verilir. Desteklenen düzenleyicilerde çalışır; metin kopyalamak imleç konumunu korumaz. Aşağıdaki satır, parçacığınızdaki konumunu gösterir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动粘贴后将光标放在此处。每个片段仅允许一个标记。仅适用于支持的编辑器；复制文本不会保留光标位置。下方显示其在片段中的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動貼上後將游標放在此處。每個片段僅允許一個標記。僅適用於支援的編輯器；複製文字不會保留游標位置。下方顯示其在片段中的位置。"
          }
        }
      }
    },
