    "panel.shortcuts.toggleSelection.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في وضع التحديد المتعدد، حدد العنصر المميز أو ألغِ تحديده، حتى أثناء التركيز على حقل البحث."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Mehrfachauswahlmodus das hervorgehobene Objekt auswählen oder abwählen, auch wenn das Suchfeld fokussiert ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In multi-select mode, select or unselect the highlighted item, even while the search field is focused."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En selección múltiple, marca o desmarca el elemento resaltado incluso con el campo de búsqueda enfocado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En sélection multiple, cochez ou décochez l’élément en surbrillance, même lorsque le champ de recherche est actif."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数選択モードで、検索欄にフォーカスがある場合も強調表示された項目の選択を切り替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다중 선택 모드에서 검색 필드에 포커스가 있어도 강조 표시된 항목을 선택하거나 선택 해제합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No modo de seleção múltipla, marque ou desmarque o item destacado mesmo com o campo de pesquisa em foco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В режиме множественного выбора отметьте выделенный элемент или снимите отметку, даже если фокус находится в поле поиска."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çoklu seçim modunda, arama alanı odaktayken bile vurgulanan öğeyi seçer veya seçimini kaldırır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多选模式下，即使焦点在搜索框，也可勾选或取消勾选高亮项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "多選模式下，即使焦點在搜尋框，也可勾選或取消勾選反白項目。"
          }
        }
      }
    },
