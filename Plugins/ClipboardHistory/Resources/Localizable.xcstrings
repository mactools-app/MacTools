    "settings.retention.expiration.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحسب المدة من آخر استخدام، أو من وقت الإضافة للعناصر التي لم تُستخدم بعد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ab der letzten Verwendung; noch nie verwendete Einträge zählen ab dem Hinzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Count from the last use, or from when the item was added if it has never been used."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cuenta desde el último uso, o desde que se añadió el elemento si nunca se ha usado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À partir de la dernière utilisation, ou de l’ajout si l’élément n’a jamais été utilisé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後に使用した時点から計算します。未使用の項目は追加時点から計算します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 사용 시점부터 계산하며, 사용한 적이 없는 항목은 추가 시점부터 계산합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta a partir do último uso, ou da adição do item se ele nunca foi usado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсчитывается с последнего использования, а для неиспользованных элементов — с момента добавления."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Süre son kullanımdan itibaren hesaplanır; öğe hiç kullanılmadıysa eklenme zamanından itibaren hesaplanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按最后使用时间计算；未使用过的记录按添加时间计算。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按最後使用時間計算；未使用過的記錄按加入時間計算。"
          }
        }
      }
    },
