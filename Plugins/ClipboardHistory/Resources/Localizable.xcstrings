    "settings.snippets.clear.message": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحذف نهائيًا جميع المقتطفات وكلماتها المفتاحية. يبقى السجل والقصاصات المحفوظة. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht alle Textbausteine und ihre Kürzel dauerhaft. Verlauf und gespeicherte Clips bleiben erhalten. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently deletes all snippets and their keywords. History and Saved clips are kept. This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina permanentemente todos los fragmentos y sus palabras clave. El historial y los clips guardados se conservan. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime définitivement tous les extraits et leurs mots-clés. L’historique et les clips enregistrés sont conservés. Cette action est irréversible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのスニペットとキーワードを完全に削除します。履歴と保存済みクリップは保持されます。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 스니펫과 키워드를 영구 삭제합니다. 기록과 저장한 클립은 유지됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apaga permanentemente todos os trechos e suas palavras-chave. O histórico e os clipes salvos são mantidos. Esta ação não pode ser desfeita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Безвозвратно удаляет все фрагменты и их ключевые слова. История и сохранённые клипы остаются. Это действие нельзя отменить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm parçacıkları ve anahtar sözcüklerini kalıcı olarak siler. Geçmiş ve kayıtlı öğeler korunur. Bu işlem geri alınamaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "永久删除所有片段及其关键词。历史和已存剪辑会保留。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "永久刪除所有片段及其關鍵字。記錄和已儲存剪輯會保留。此操作無法復原。"
          }
        }
      }
    },
