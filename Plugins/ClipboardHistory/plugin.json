{
  "id": "clipboard",
  "displayName": "剪贴板",
  "summary": "搜索历史记录并管理可重复使用的片段和已存项目。",
  "localizedMetadata": {
    "ar": {
      "displayName": "الحافظة",
      "summary": "ابحث في السجل وأدر المقتطفات والعناصر المحفوظة القابلة لإعادة الاستخدام."
    },
    "de": {
      "displayName": "Zwischenablage",
      "summary": "Verlauf durchsuchen und wiederverwendbare Textbausteine und gespeicherte Elemente verwalten."
    },
    "en": {
      "displayName": "Clipboard",
      "summary": "Search history and manage reusable snippets and saved items."
    },
    "es": {
      "displayName": "Portapapeles",
      "summary": "Busca en el historial y gestiona fragmentos reutilizables y elementos guardados."
    },
    "fr": {
      "displayName": "Presse-papiers",
      "summary": "Recherchez dans l’historique et gérez les extraits réutilisables et les éléments enregistrés."
    },
    "ja": {
      "displayName": "クリップボード",
      "summary": "履歴を検索し、再利用できるスニペットと保存項目を管理します。"
    },
    "ko": {
      "displayName": "클립보드",
      "summary": "기록을 검색하고 재사용 가능한 스니펫과 저장된 항목을 관리합니다."
    },
    "pt": {
      "displayName": "Área de transferência",
      "summary": "Pesquise o histórico e gerencie trechos reutilizáveis e itens salvos."
    },
    "ru": {
      "displayName": "Буфер обмена",
      "summary": "Ищите в истории и управляйте повторно используемыми фрагментами и сохранёнными элементами."
    },
    "tr": {
      "displayName": "Pano",
      "summary": "Pano geçmişinde arama yapın, yeniden kullanılabilir parçacıkları ve kayıtlı öğeleri yönetin."
    },
    "zh-Hans": {
      "displayName": "剪贴板",
      "summary": "搜索历史记录并管理可重复使用的片段和已存项目。"
    },
    "zh-Hant": {
      "displayName": "剪貼簿",
      "summary": "搜尋記錄並管理可重複使用的片段和已儲存項目。"
    }
  },
  "version": "2.0.0",
  "minHostVersion": "2.0.0",
  "pluginKitVersion": 7,
  "bundleRelativePath": "ClipboardHistory.bundle",
  "factoryClass": "ClipboardHistoryPlugin.ClipboardHistoryPluginFactory",
  "build": {
    "project": "../../MacTools.xcodeproj",
    "scheme": "ClipboardHistoryPlugin"
  },
  "package": {
    "signPaths": [
      "ClipboardHistory.bundle/Contents/Resources/PasteboardReaderHelper/mactools-clipboard-pasteboard-reader-helper"
    ]
  },
  "capabilities": {
    "panelItems": [
      "row",
      "widget"
    ],
    "settings": "form"
  },
  "permissions": [
    "accessibility"
  ],
  "uninstallDataPolicy": "removePrivateData",
  "category": "productivity",
  "productStrings": {
    "display-name": "@displayName",
    "summary": "@summary",
    "setup-storage-title": "@localizable.setup.storage.title",
    "setup-storage-description": "@localizable.settings.storage.encrypted.description",
    "setup-collection-title": "@localizable.settings.collection.toggleTitle",
    "setup-collection-description": "@localizable.setup.collection.actionDescription",
    "open-history-title": "@localizable.action.open.title",
    "open-history-description": "@localizable.action.open.description",
    "pause-collection-title": "@localizable.action.pause.title",
    "pause-collection-description": "@localizable.action.pause.description",
    "resume-collection-title": "@localizable.action.resume.title",
    "resume-collection-description": "@localizable.action.resume.description",
    "toggle-collection-title": "@localizable.action.toggle.title",
    "toggle-collection-description": "@localizable.action.toggle.description",
    "clear-all-history-title": "@localizable.action.clearAll.title",
    "clear-all-history-description": "@localizable.action.clearAll.description",
    "previous-sequential-queue-item-title": "@localizable.hud.queue.previous",
    "previous-sequential-queue-item-description": "@localizable.action.queue.previous.description",
    "skip-sequential-queue-item-title": "@localizable.hud.queue.skip",
    "skip-sequential-queue-item-description": "@localizable.action.queue.skip.description",
    "restart-sequential-queue-title": "@localizable.hud.queue.restart",
    "restart-sequential-queue-description": "@localizable.action.queue.restart.description",
    "cancel-sequential-queue-title": "@localizable.hud.queue.cancel",
    "cancel-sequential-queue-description": "@localizable.action.queue.cancel.description"
  },
  "presentation": {
    "longDescription": "@productStrings.summary",
    "examples": [
      {
        "id": "primary-use",
        "text": "@productStrings.summary"
      }
    ],
    "screenshots": [],
    "documentationURL": "https://github.com/ggbond268/MacTools/blob/main/docs/superpowers/specs/2026-08-19-clipboard-history.md",
    "supportURL": "https://github.com/ggbond268/MacTools/issues",
    "publisher": "MacTools",
    "license": "GPL-3.0-only"
  },
  "discovery": {
    "keywords": [
      "clipboard",
      "history",
      "paste",
      "OCR",
      "export"
    ],
    "localizedSynonyms": {
      "ar": [
        "سجل الحافظة"
      ],
      "de": [
        "Zwischenablageverlauf"
      ],
      "en": [
        "Clipboard History"
      ],
      "es": [
        "Historial del portapapeles"
      ],
      "fr": [
        "Historique du presse-papiers"
      ],
      "ja": [
        "クリップボード履歴"
      ],
      "ko": [
        "클립보드 기록"
      ],
      "pt": [
        "Histórico da área de transferência"
      ],
      "ru": [
        "История буфера обмена"
      ],
      "tr": [
        "Pano"
      ],
      "zh-Hans": [
        "剪贴板历史"
      ],
      "zh-Hant": [
        "剪貼簿記錄"
      ]
