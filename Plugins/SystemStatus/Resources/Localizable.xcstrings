    "settings.panel.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر ما تريد إظهاره، واسحب لإعادة الترتيب، ووسّع لضبط الإعدادات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichtbare Inhalte wählen, zum Sortieren ziehen und zum Konfigurieren aufklappen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose what to show, drag to reorder, and expand to configure."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige qué mostrar, arrastra para reordenar y expande para configurar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les éléments à afficher, faites-les glisser pour les réorganiser et développez-les pour les configurer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示内容を選び、ドラッグして並べ替え、展開して設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표시할 항목을 선택하고 드래그하여 정렬한 뒤 펼쳐서 설정하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o que mostrar, arraste para reordenar e expanda para configurar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
