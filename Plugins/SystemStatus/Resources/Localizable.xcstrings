    "settings.menuBarLayout.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحافظ الأفقي على النمط الحالي؛ يرتب العمودي أحرف الاسم رأسيًا يسارًا والقيم بمحاذاة اليسار يمينًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Horizontal behält die aktuelle Darstellung bei; vertikal stehen die Buchstaben links untereinander und die Werte rechts linksbündig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Horizontal keeps the current style; vertical stacks the label letters on the left and left-aligns the values on the right."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Horizontal conserva el estilo actual; vertical apila las letras a la izquierda y alinea los valores a la izquierda a la derecha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Horizontal conserve le style actuel ; vertical empile les lettres à gauche et aligne les valeurs à gauche sur la droite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "水平は現在のスタイルを維持し、垂直は左に文字を縦並び、右に値を左揃えで上下表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수평은 현재 스타일을 유지하고, 수직은 왼쪽에 글자를 세로로 쌓고 오른쪽 값을 왼쪽 정렬합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Horizontal mantém o estilo atual; vertical empilha as letras à esquerda e alinha os valores à esquerda no lado direito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Горизонтальный вид сохраняет текущий стиль; вертикальный ставит буквы друг под другом слева, а значения выравнивает по левому краю справа."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yatay, geçerli stili korur; dikeyde etiket harfleri solda alt alta dizilir ve değerler sağda sola dayalı hizalanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "水平保持现有样式；垂直时名称逐字竖排在左，数值在右侧上下左对齐。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "水平保留現有樣式；垂直時名稱逐字直排在左，數值在右側上下靠左對齊。"
          }
        }
      }
    },
