    "topProcesses.accounting": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مجمّعة حسب التطبيق. المعالج: 100% لكل نواة. الذاكرة: البصمة الفعلية؛ تظهر — عند تعذّر القراءة الكاملة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach App gruppiert. CPU: 100% pro Kern. Speicher: physischer Footprint; — bei unvollständiger Messung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grouped by app. CPU: 100% per core. Memory: physical footprint; — when a complete reading is unavailable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrupado por aplicación. CPU: 100% por núcleo. Memoria: huella física; — si la lectura está incompleta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regroupé par application. CPU : 100% par cœur. Mémoire : empreinte physique ; — si la mesure est incomplète."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリごとに集計。CPU はコアあたり 100%。メモリは物理フットプリントで、完全に取得できない場合は — を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱별로 합산합니다. CPU는 코어당 100%입니다. 메모리는 실제 메모리 점유량이며 전체 값을 읽을 수 없으면 —로 표시합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrupado por aplicativo. CPU: 100% por núcleo. Memória: ocupação física; — quando a leitura está incompleta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По приложениям. CPU: 100% на ядро. Память: физический объём; — если полные данные недоступны."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamaya göre gruplandırılır. CPU: Çekirdek başına %100. Bellek: Fiziksel kullanım; eksiksiz ölçüm yapılamadığında — gösterilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按应用汇总；CPU 以单核 100% 计，内存为应用内存占用。无法完整读取时显示 —。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依 App 彙總；CPU 以單核心 100% 計，記憶體為 App 記憶體用量。無法完整讀取時顯示 —。"
          }
        }
      }
    },
