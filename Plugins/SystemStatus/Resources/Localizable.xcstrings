          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressão"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нагрузка"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baskı"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
