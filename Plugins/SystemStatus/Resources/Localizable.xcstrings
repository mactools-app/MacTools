            "value": "壓力"
          }
        }
      }
    },
    "memory.pressure.estimateHelp": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التقدير: (الذاكرة المثبتة + التخزين الفعلي للذاكرة المضغوطة) ÷ الذاكرة الفعلية. تشير الألوان إلى مستوى ضغط النظام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schätzung: (fest zugewiesener Speicher + physischer Komprimierungsspeicher) ÷ physischer Speicher. Farben zeigen die Systemdruckstufe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimate: (wired memory + physical compressor storage) ÷ physical memory. Colors show the system pressure level."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimación: (memoria cableada + espacio físico del compresor) ÷ memoria física. Los colores indican el nivel de presión del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimation : (mémoire résidente + espace physique du compresseur) ÷ mémoire physique. Les couleurs indiquent le niveau de pression du système."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "（固定メモリ + 圧縮メモリの実使用量）÷ 物理メモリで推定。色はシステムのプレッシャーレベルを示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "(고정 메모리 + 압축 메모리의 실제 사용량) ÷ 물리 메모리로 추정합니다. 색상은 시스템 압력 수준을 나타냅니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimativa: (memória residente + espaço físico do compressor) ÷ memória física. As cores indicam o nível de pressão do sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оценка: (закреплённая память + физическая память компрессора) ÷ физическая память. Цвет обозначает системный уровень нагрузки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahmin: (sabit bellek + sıkıştırıcının fiziksel depolaması) ÷ fiziksel bellek. Renkler sistem baskı düzeyini gösterir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按（联动内存 + 压缩内存实际占用）÷ 物理内存估算；颜色表示系统压力等级。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依（聯動記憶體 + 壓縮記憶體實際用量）÷ 實體記憶體估算；顏色表示系統壓力等級。"
          }
        }
      }
    },
