    "action.confirmation.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيغيّر رابط التشغيل الخارجي هذا حالة كتم الميكروفون الافتراضي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser externe Ausführungslink ändert den Stummschaltungsstatus des Standardmikrofons."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This external Run Link will change the mute state of the default microphone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este enlace de ejecución externo cambiará el estado de silencio del micrófono predeterminado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce lien d’exécution externe modifiera l’état de silence du microphone par défaut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この外部実行リンクはデフォルトのマイクのミュート状態を変更します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 외부 실행 링크는 기본 마이크의 음소거 상태를 변경합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este link de execução externo alterará o estado de silêncio do microfone padrão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта внешняя ссылка запуска изменит состояние микрофона по умолчанию."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu harici Çalıştırma Bağlantısı, varsayılan mikrofonun sessize alma durumunu değiştirecek."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外部运行链接将更改默认麦克风的静音状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "外部執行連結會更改預設麥克風的靜音狀態。"
          }
        }
      }
    },
