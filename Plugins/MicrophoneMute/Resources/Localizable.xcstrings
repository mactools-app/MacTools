          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认更改麦克风状态"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認更改麥克風狀態"
          }
        }
      }
    },
