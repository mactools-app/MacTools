    "settings.criticalThresholdDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في الوضع المحسّن، تستخدم الأيقونة لون التحذير تحت هذا المستوى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im erweiterten Modus verwendet das Symbol unter diesem Wert die Warnfarbe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Enhanced mode, the icon uses the warning color below this level."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En modo mejorado, el icono usa el color de aviso por debajo de este nivel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En mode avancé, l’icône utilise la couleur d’alerte sous ce niveau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拡張モードでは、残量がこの値を下回ると警告色で表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "향상 모드에서 잔량이 이 값보다 낮으면 경고 색상으로 표시합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No modo avançado, o ícone usa a cor de aviso abaixo deste nível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В расширенном режиме значок ниже этого уровня использует цвет предупреждения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelişmiş modda pil bu düzeyin altındayken simge uyarı rengini kullanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增强模式下，电量低于此值时以警示颜色显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "增強模式下，電量低於此值時以警示顏色顯示。"
          }
        }
      }
    },
