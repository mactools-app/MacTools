    "settings.networkFooter": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند التفعيل، تُعرض أيقونة مخصصة للحالة المقابلة بدلًا من أيقونة Wi-Fi العادية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, zeigt der jeweilige Zustand ein eigenes Symbol statt des normalen WLAN-Symbols."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, the matching state shows a dedicated icon instead of the standard Wi-Fi icon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está activado, el estado correspondiente muestra un icono específico en lugar del icono Wi-Fi estándar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si activé, l’état correspondant affiche une icône dédiée au lieu de l’icône Wi-Fi standard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにすると、該当する状態では通常の Wi-Fi アイコンではなく専用アイコンを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜면 해당 상태에서 일반 Wi-Fi 아이콘 대신 전용 아이콘이 표시됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ativado, o estado correspondente mostra um ícone dedicado em vez do ícone Wi-Fi normal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если включено, для соответствующего состояния показывается отдельный значок вместо обычного значка Wi-Fi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açıldığında, ilgili durum standart Wi-Fi simgesi yerine özel bir simge gösterir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后，对应状态显示专用图标，而不是普通 Wi-Fi 图标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後，對應狀態顯示專用圖示，而不是一般 Wi-Fi 圖示。"
          }
        }
      }
    },
    "settings.noInternet": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
