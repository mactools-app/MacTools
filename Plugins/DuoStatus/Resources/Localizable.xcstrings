    "settings.networkErrorsFirstDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستمر في عرض حالة الشبكة بدلًا من علامة Bluetooth عند وجود مشكلة في الشبكة."
          }
