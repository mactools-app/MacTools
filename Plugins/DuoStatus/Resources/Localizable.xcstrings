    "settings.batteryColorPolicyDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتفظ الوضع القياسي بالألوان الحالية، ويضيف الوضع المحسّن اللون الأصفر في نمط الطاقة المنخفضة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard behält die vorhandenen Farben; Erweitert ergibt Gelb für den Stromsparmodus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard keeps the existing colors; Enhanced adds Low Power Mode yellow, and the threshold applies only to Enhanced."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estándar mantiene los colores actuales; Mejorado añade amarillo en modo de bajo consumo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard conserve les couleurs existantes ; le mode avancé ajoute le jaune en mode Économie d’énergie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "標準は既存の色を維持し、拡張では低電力モードに黄色を追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표준은 기존 색상을 유지하고, 향상은 저전력 모드에 노란색을 추가합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Padrão mantém as cores atuais; Avançado adiciona amarelo no modo de baixo consumo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стандарт сохраняет текущие цвета; расширенный режим добавляет желтый цвет в режиме энергосбережения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Standart, mevcut renkleri korur; Gelişmiş, Düşük Güç Modu sarısını ekler. Eşik yalnızca Gelişmiş için geçerlidir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标准保留现有颜色；增强加入低电量模式黄色，阈值仅增强模式可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標準保留現有顏色；增強加入低電量模式黃色，閾值僅增強模式可用。"
          }
        }
      }
    },
