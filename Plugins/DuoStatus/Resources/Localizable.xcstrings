    "settings.percentageWhenConnectedDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند الإيقاف، تظهر علامة الشحن فقط عند توصيل الطاقة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aus, wird am Netzteil nur die Lademarkierung angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When off, only the charging mark is shown while plugged in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está desactivado, solo se muestra la marca de carga al conectar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si désactivé, seule la marque de charge est affichée sur secteur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフの場合、電源接続時は充電マークのみ表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄면 전원 연결 시 충전 표시만 나타납니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando desativado, apenas a marca de carregamento aparece quando ligado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если выключено, при питании от сети показывается только значок зарядки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
