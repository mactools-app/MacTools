    "settings.footerVolume": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض القوس شحن البطارية، ويعرض المركز حالة الشبكة، وتعرض النقاط السفلية مستوى الصوت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bogen zeigt den Ladestand, die Mitte den Netzwerkstatus und die Punkte unten die Lautstärke."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The arc shows battery, the center shows network status, and the bottom dots show volume."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El arco muestra la batería, el centro el estado de red y los puntos inferiores el volumen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’arc indique la batterie, le centre l’état du réseau et les points du bas le volume."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "円弧はバッテリー残量、中央はネットワーク状態、下部のドットは音量を示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호는 배터리 잔량, 중앙은 네트워크 상태, 아래쪽 점은 음량을 표시합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O arco mostra a bateria, o centro o estado da rede e os pontos inferiores o volume."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дуга показывает заряд, центр — состояние сети, нижние точки — громкость."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
