    "settings.standaloneDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرض أيقونة مستقلة. مرّر المؤشر لعرض الحالة وانقر لفتح الإعدادات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Separates Symbol anzeigen. Für Status darüberfahren, für Einstellungen klicken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show a separate icon. Hover for status; click to open settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra un icono independiente. Pasa el cursor para ver el estado; haz clic para abrir los ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche une icône distincte. Survolez pour l’état, cliquez pour les réglages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "独立したアイコンを表示します。ポインタを重ねると状態、クリックすると設定を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "별도 아이콘을 표시합니다. 마우스를 올리면 상태를 보고, 클릭하면 설정을 엽니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra um ícone separado. Passe o cursor para ver o estado; clique para abrir as definições."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отдельный значок: наведите курсор для просмотра состояния, нажмите для настроек."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayrı bir simge gösterir. Durumu görmek için imleci simgenin üzerine getirin; ayarları açmak için tıklayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "独立显示，悬停查看状态，点击打开设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "獨立顯示，移至圖示查看狀態，點按開啟設定。"
          }
        }
      }
    },
    "settings.primaryDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استبدال أيقونة MacTools في شريط القوائم مع الحفاظ على سلوك النقر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersetzt das MacTools-Menüleistensymbol; die Klickaktionen bleiben unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace the MacTools menu bar icon without changing its click behavior."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sustituye el icono de MacTools sin cambiar las acciones del clic."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplace l’icône MacTools dans la barre des menus sans modifier les actions du clic."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools のメニューバーアイコンを置き換えます。クリック時の動作は変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools 메뉴 막대 아이콘을 대체하며 클릭 동작은 유지합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Substitui o ícone do MacTools sem alterar as ações de clique."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заменяет значок MacTools в строке меню, сохраняя действия при нажатии."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools menü çubuğu simgesini değiştirir; tıklama davranışı aynı kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "替换 MacTools 主图标，点击行为保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取代 MacTools 主圖示，點按行為保持不變。"
          }
        }
      }
    },
    "settings.occupiedPendingRestartFormat": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنتظر «%@» إعادة التشغيل. أعد تشغيل MacTools لتغيير إعدادات أيقونتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ wartet auf einen Neustart. Starte MacTools neu, um dessen Symboleinstellungen zu ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is awaiting restart. Restart MacTools to change its icon settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» requiere un reinicio. Reinicia MacTools para cambiar sus ajustes de icono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » attend un redémarrage. Redémarrez MacTools pour modifier ses réglages d’icône."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は再起動を待機中です。MacTools を再起動してからアイコン設定を変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’에서 재시작을 기다리고 있습니다. MacTools를 재시작한 후 해당 아이콘 설정을 변경하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» aguarda um reinício. Reinicie o MacTools para alterar as respetivas definições de ícone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» ожидает перезапуска. Перезапустите MacTools, чтобы изменить настройки его значка."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” yeniden başlatma bekliyor. Simge ayarlarını değiştirmek için MacTools'u yeniden başlatın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」正在等待重启。请重启 MacTools 后调整其图标设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」正在等待重新啟動。請重新啟動 MacTools 後調整其圖示設定。"
          }
        }
      }
    },
    "settings.occupiedFormat": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم «%@» أيقونة التطبيق. أوقف الاستبدال في إعداداتها أولًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ verwendet das App-Symbol. Deaktiviere zuerst die Ersetzung in dessen Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app icon is used by “%@”. Turn off replacement in its settings first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» usa el icono de la app. Desactiva primero el reemplazo en sus ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » utilise l’icône de l’app. Désactivez d’abord le remplacement dans ses réglages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリのアイコンは「%@」が使用しています。先にその設定で置き換えを解除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’에서 앱 아이콘을 사용 중입니다. 먼저 해당 설정에서 아이콘 대체를 해제하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» utiliza o ícone da aplicação. Desative primeiro a substituição nas respetivas definições."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» использует значок приложения. Сначала отключите замену в его настройках."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama simgesini “%@” kullanıyor. Önce onun ayarlarından simge değiştirmeyi kapatın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用图标已由「%@」使用。请先在其设置中取消替换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用程式圖示已由「%@」使用。請先在其設定中取消取代。"
          }
        }
      }
    },
    "settings.unavailable": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتعذر تغيير وضع العرض الآن. حاول لاحقاً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Darstellung kann gerade nicht geändert werden. Versuchen Sie es später erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot change the display mode right now. Try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede cambiar el modo ahora. Inténtalo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de changer le mode d’affichage pour le moment. Réessayez plus tard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、表示方法を変更できません。後でもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 표시 방식을 변경할 수 없습니다. 잠시 후 다시 시도하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível mudar o modo agora. Tente novamente mais tarde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас нельзя изменить режим отображения. Повторите попытку позже."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görüntüleme modu şu anda değiştirilemiyor. Daha sonra yeniden deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法切换显示方式，请稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫時無法切換顯示方式，請稍後再試。"
          }
        }
      }
    },
