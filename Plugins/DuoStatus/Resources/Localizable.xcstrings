    "settings.volumeStyleDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرض مستوى الصوت بمستويات عبر النقاط، أو بشكل متصل عبر شريط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lautstärke in Stufen als Punkte oder stufenlos als Balken anzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show volume in steps with dots, or continuously with a bar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra el volumen por niveles con puntos o de forma continua con una barra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche le volume par paliers avec des points, ou en continu avec une barre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドットで段階的に、またはバーで連続的に表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "점으로 단계별로 표시하거나 막대로 연속 표시합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra o volume em níveis com pontos ou de forma contínua com uma barra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать громкость ступенями точками или плавно полосой."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses düzeyini noktalarla adım adım veya çubukla sürekli gösterin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以圆点分档显示，或以进度条连续显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以圓點分段顯示，或以進度列連續顯示。"
          }
        }
      }
    },
