{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "metadata.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حالة البطارية والشبكة ومستوى الصوت في أيقونة مستقلة أو رئيسية في شريط القوائم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Batterie, Netzwerk und Ausgabelautstärke als separates oder primäres Menüleistensymbol."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Battery, network, and output volume status in a standalone or primary menu bar icon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Batería, red y volumen de salida en un icono independiente o principal de la barra de menús."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Batterie, réseau et volume de sortie dans une icône distincte ou principale de la barre des menus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "独立アイコンまたはアプリのメニューバーアイコンでバッテリー、ネットワーク、出力音量を確認"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "별도 아이콘 또는 앱 메뉴 막대 아이콘으로 배터리, 네트워크, 출력 음량 상태 확인"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bateria, rede e volume de saída num ícone separado ou principal da barra de menus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Батарея, сеть и выходная громкость в отдельном или основном значке строки меню."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pil, ağ ve çıkış sesi durumunu ayrı ya da ana menü çubuğu simgesinde görüntüleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过独立图标或应用主图标查看电量、网络与输出音量状态"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過獨立圖示或應用程式主圖示查看電量、網路與輸出音量狀態"
          }
        }
      }
    },
    "metadata.title": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حالة Duo"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Duo-Status"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Duo Status"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estado Duo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "État Duo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Duo ステータス"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Duo 상태"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estado Duo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Статус Duo"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Duo Durumu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Duo 状态"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Duo 狀態"
          }
        }
      }
    },
    "settings.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض القوس شحن البطارية، ويعرض المركز حالة الشبكة، وتعرض النقاط السفلية إشارة Wi-Fi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bogen zeigt den Ladestand, die Mitte den Netzwerkstatus und die Punkte unten das WLAN-Signal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The arc shows battery, the center shows network status, and the bottom dots show Wi-Fi signal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El arco muestra la batería, el centro el estado de red y los puntos inferiores la señal Wi-Fi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’arc indique la batterie, le centre l’état du réseau et les points du bas le signal Wi-Fi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "円弧はバッテリー残量、中央はネットワーク状態、下部のドットは Wi-Fi 信号を示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호는 배터리 잔량, 중앙은 네트워크 상태, 아래쪽 점은 Wi-Fi 신호를 표시합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O arco mostra a bateria, o centro o estado da rede e os pontos inferiores o sinal Wi-Fi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дуга показывает заряд, центр — состояние сети, нижние точки — сигнал Wi-Fi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yay pil durumunu, merkez ağ durumunu, alttaki noktalar ise Wi-Fi sinyalini gösterir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "圆弧显示电量，中心显示网络状态，底部圆点显示 Wi-Fi 信号。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圓弧顯示電量，中央顯示網路狀態，底部圓點顯示 Wi-Fi 訊號。"
          }
        }
      }
    },
