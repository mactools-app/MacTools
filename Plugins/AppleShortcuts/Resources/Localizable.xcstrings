        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此快捷指令未启用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此捷徑尚未啟用。"
          }
        },
        "ar" : {"stringUnit":{"state":"translated","value":"لم يتم تمكين هذا الاختصار."}},
        "de" : {"stringUnit":{"state":"translated","value":"Dieser Kurzbefehl ist nicht aktiviert."}},
        "es" : {"stringUnit":{"state":"translated","value":"Este atajo no está habilitado."}},
        "fr" : {"stringUnit":{"state":"translated","value":"Ce raccourci n'est pas activé."}},
        "ja" : {"stringUnit":{"state":"translated","value":"このショートカットは有効になっていません。"}},
        "ko" : {"stringUnit":{"state":"translated","value":"이 단축어는 활성화되어 있지 않습니다."}},
        "pt" : {"stringUnit":{"state":"translated","value":"Este atalho não está habilitado."}},
        "ru" : {"stringUnit":{"state":"translated","value":"Эта команда не включена."}}
      }
    },
