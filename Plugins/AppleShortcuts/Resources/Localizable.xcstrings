    "policy.runlink.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow external links to trigger this shortcut; confirmation is still required every time."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dış bağlantıların bu kısayolu tetiklemesine izin verir; her seferinde yine onay istenir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许外部链接触发；每次仍需确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許外部連結觸發；每次仍需確認。"
          }
        },
        "ar" : {"stringUnit":{"state":"translated","value":"السماح للروابط الخارجية بتشغيل هذا الاختصار؛ لا يزال التأكيد مطلوبًا في كل مرة."}},
        "de" : {"stringUnit":{"state":"translated","value":"Ausführung dieses Kurzbefehls über externe Links erlauben; eine Bestätigung ist dennoch jedes Mal erforderlich."}},
        "es" : {"stringUnit":{"state":"translated","value":"Permite que enlaces externos activen este atajo; seguirá siendo necesaria una confirmación cada vez."}},
        "fr" : {"stringUnit":{"state":"translated","value":"Autoriser les liens externes à déclencher ce raccourci ; une confirmation est toujours requise à chaque fois."}},
        "ja" : {"stringUnit":{"state":"translated","value":"外部リンクからこのショートカットを実行できるようにします。実行時には毎回確認が必要です。"}},
        "ko" : {"stringUnit":{"state":"translated","value":"외부 링크가 이 단축어를 실행하도록 허용합니다. 매번 확인이 필요합니다."}},
        "pt" : {"stringUnit":{"state":"translated","value":"Permitir que links externos acionem este atalho; a confirmação ainda é necessária sempre."}},
        "ru" : {"stringUnit":{"state":"translated","value":"Разрешить запуск этой команды по внешним ссылкам. Подтверждение требуется каждый раз."}}
      }
    },
