    "batch.enable.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These shortcuts will appear in MacTools. Run Links will not be enabled."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kısayollar MacTools'ta görünecek. Run Link'ler etkinleştirilmeyecek."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，这些快捷指令会出现在 MacTools 中。不会启用 Run Link。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用後，這些捷徑會顯示於 MacTools 中。不會啟用 Run Link。"
          }
        }
      }
    },
    "batch.enable.confirm.title.format": {
