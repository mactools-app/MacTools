    "folder.sync.disable.review": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After syncing stops, actions enabled only by this folder will no longer be available in MacTools. Affected: %lld."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşitleme durdurulduktan sonra, yalnızca bu klasör üzerinden etkinleştirilen %lld eylem artık yayınlanmayacak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止同步后，%lld 个仅由此文件夹启用的操作将不再发布。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停止同步後，%lld 個僅由此檔案夾啟用的操作將不再發佈。"
          }
        },
        "ar" : {"stringUnit":{"state":"translated","value":"بعد إيقاف المزامنة، لن تعود الإجراءات المفعّلة من خلال هذا المجلد وحده متاحة في MacTools. عدد الإجراءات المتأثرة: %lld."}},
        "de" : {"stringUnit":{"state":"translated","value":"Nach Beendigung der Synchronisierung sind die nur durch diesen Ordner aktivierten Aktionen in MacTools nicht mehr verfügbar. Betroffen: %lld."}},
        "es" : {"stringUnit":{"state":"translated","value":"Al detener la sincronización, dejarán de publicarse las acciones habilitadas solo por esta carpeta (%lld)."}},
        "fr" : {"stringUnit":{"state":"translated","value":"Après l’arrêt de la synchronisation, les actions activées uniquement par ce dossier ne seront plus publiées. Actions concernées : %lld."}},
        "ja" : {"stringUnit":{"state":"translated","value":"同期を停止すると、このフォルダーだけを有効化元とする %lld 個のアクションは公開されなくなります。"}},
        "ko" : {"stringUnit":{"state":"translated","value":"동기화가 중지되면 이 폴더에서만 활성화된 %lld개의 동작이 더 이상 제공되지 않습니다."}},
        "pt" : {"stringUnit":{"state":"translated","value":"Ao parar a sincronização, as ações habilitadas apenas por esta pasta deixarão de ser publicadas. Total: %lld."}},
        "ru" : {"stringUnit":{"state":"translated","value":"После остановки синхронизации действия, включённые только этой папкой, больше не будут публиковаться: %lld."}}
      }
    },
