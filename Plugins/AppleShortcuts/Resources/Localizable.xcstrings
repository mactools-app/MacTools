    "view.ambiguous": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More than one shortcut has this name; open it directly in Apple Shortcuts."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu adda birden fazla kısayol var; kısayolu doğrudan Apple Shortcuts'ta açın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存在同名快捷指令；请直接在 Apple“快捷指令”中打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有多個同名捷徑；請直接在 Apple「捷徑」中開啟。"
          }
        },
        "ar" : {"stringUnit":{"state":"translated","value":"أكثر من اختصار يحمل هذا الاسم؛ افتحه مباشرة في Apple Shortcuts."}},
        "de" : {"stringUnit":{"state":"translated","value":"Mehr als ein Kurzbefehl hat diesen Namen; bitte direkt in der App „Kurzbefehle“ öffnen."}},
        "es" : {"stringUnit":{"state":"translated","value":"Varios atajos tienen este nombre; ábrelo directamente en Atajos de Apple."}},
        "fr" : {"stringUnit":{"state":"translated","value":"Plusieurs raccourcis portent ce nom ; ouvrez-le directement dans Raccourcis Apple."}},
        "ja" : {"stringUnit":{"state":"translated","value":"同じ名前のショートカットが複数あります。Apple ショートカットで直接開いてください。"}},
        "ko" : {"stringUnit":{"state":"translated","value":"같은 이름의 단축어가 여러 개 있습니다. Apple 단축어에서 직접 여세요."}},
        "pt" : {"stringUnit":{"state":"translated","value":"Mais de um atalho possui este nome; abra-o diretamente no app Atalhos da Apple."}},
        "ru" : {"stringUnit":{"state":"translated","value":"Это имя используется несколькими командами. Откройте нужную непосредственно в приложении «Команды»."}}
      }
    },
