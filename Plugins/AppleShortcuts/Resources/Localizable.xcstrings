{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "action.confirm.button": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalıştır"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "執行"
          }
        },
        "ar" : {"stringUnit":{"state":"translated","value":"تشغيل"}},
        "de" : {"stringUnit":{"state":"translated","value":"Ausführen"}},
        "es" : {"stringUnit":{"state":"translated","value":"Ejecutar"}},
        "fr" : {"stringUnit":{"state":"translated","value":"Exécuter"}},
        "ja" : {"stringUnit":{"state":"translated","value":"実行"}},
        "ko" : {"stringUnit":{"state":"translated","value":"실행"}},
        "pt" : {"stringUnit":{"state":"translated","value":"Executar"}},
        "ru" : {"stringUnit":{"state":"translated","value":"Запустить"}}
      }
    },
    "action.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This shortcut will run through Apple Shortcuts and may access other apps or data."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kısayol Apple Shortcuts üzerinden çalışacak ve diğer uygulamalara veya verilere erişebilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此快捷指令将通过 Apple“快捷指令”运行，并可能访问其他应用或数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此捷徑將透過 Apple「捷徑」執行，並可能存取其他 App 或資料。"
          }
        },
        "ar" : {"stringUnit":{"state":"translated","value":"سيتم تشغيل هذا الاختصار من خلال Apple Shortcuts وقد يصل إلى تطبيقات أو بيانات أخرى."}},
        "de" : {"stringUnit":{"state":"translated","value":"Dieser Kurzbefehl wird über die App „Kurzbefehle“ ausgeführt und greift möglicherweise auf andere Apps oder Daten zu."}},
        "es" : {"stringUnit":{"state":"translated","value":"Este atajo se ejecutará mediante Atajos de Apple y puede acceder a otras apps o datos."}},
        "fr" : {"stringUnit":{"state":"translated","value":"Ce raccourci sera exécuté dans Raccourcis Apple et pourra accéder à d’autres apps ou données."}},
        "ja" : {"stringUnit":{"state":"translated","value":"このショートカットは Apple ショートカットを通じて実行され、他のアプリやデータにアクセスする可能性があります。"}},
        "ko" : {"stringUnit":{"state":"translated","value":"이 단축어는 Apple 단축어를 통해 실행되며 다른 앱이나 데이터에 접근할 수 있습니다."}},
        "pt" : {"stringUnit":{"state":"translated","value":"Este atalho será executado pelo app Atalhos da Apple e poderá acessar outros aplicativos ou dados."}},
        "ru" : {"stringUnit":{"state":"translated","value":"Эта команда будет запущена через приложение «Команды» и может обращаться к другим приложениям или данным."}}
      }
    },
    "action.confirm.title.format": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run “%@”?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” çalıştırılsın mı?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行“%@”？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "執行「%@」？"
          }
        },
        "ar" : {"stringUnit":{"state":"translated","value":"تشغيل «%@»؟"}},
        "de" : {"stringUnit":{"state":"translated","value":"„%@“ ausführen?"}},
        "es" : {"stringUnit":{"state":"translated","value":"¿Ejecutar «%@»?"}},
        "fr" : {"stringUnit":{"state":"translated","value":"Exécuter « %@ » ?"}},
        "ja" : {"stringUnit":{"state":"translated","value":"「%@」を実行しますか？"}},
        "ko" : {"stringUnit":{"state":"translated","value":"‘%@’을(를) 실행할까요?"}},
        "pt" : {"stringUnit":{"state":"translated","value":"Executar “%@”?"}},
        "ru" : {"stringUnit":{"state":"translated","value":"Запустить «%@»?"}}
      }
    },
    "action.description.format": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run the Apple Shortcut “%@”."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” Apple kısayolunu çalıştırır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行 Apple 快捷指令“%@”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "執行 Apple 捷徑「%@」。"
          }
        },
        "ar" : {"stringUnit":{"state":"translated","value":"قم بتشغيل اختصار Apple \"%@\"."}},
        "de" : {"stringUnit":{"state":"translated","value":"Apple-Kurzbefehl „%@“ ausführen."}},
        "es" : {"stringUnit":{"state":"translated","value":"Ejecuta el atajo de Apple «%@»."}},
        "fr" : {"stringUnit":{"state":"translated","value":"Exécutez le raccourci Apple « %@ »."}},
        "ja" : {"stringUnit":{"state":"translated","value":"Apple ショートカット「%@」を実行します。"}},
        "ko" : {"stringUnit":{"state":"translated","value":"Apple 단축어 ‘%@’을(를) 실행하세요."}},
        "pt" : {"stringUnit":{"state":"translated","value":"Execute o atalho da Apple “%@”."}},
        "ru" : {"stringUnit":{"state":"translated","value":"Запустить быструю команду Apple «%@»."}}
      }
    },
