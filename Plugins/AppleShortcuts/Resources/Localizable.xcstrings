        "ar" : {"stringUnit":{"state":"translated","value":"اختصارات Apple"}},
        "de" : {"stringUnit":{"state":"translated","value":"Apple-Kurzbefehle"}},
        "es" : {"stringUnit":{"state":"translated","value":"Atajos de Apple"}},
        "fr" : {"stringUnit":{"state":"translated","value":"Raccourcis Apple"}},
        "ja" : {"stringUnit":{"state":"translated","value":"Appleショートカット"}},
        "ko" : {"stringUnit":{"state":"translated","value":"Apple 단축어"}},
        "pt" : {"stringUnit":{"state":"translated","value":"Atalhos da Apple"}},
        "ru" : {"stringUnit":{"state":"translated","value":"Быстрые команды Apple"}}
      }
    },
    "action.unavailable.executable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Shortcuts command is unavailable on this system."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sistemde Shortcuts komutu kullanılamıyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统未提供“快捷指令”命令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統未提供「捷徑」指令。"
          }
        },
        "ar" : {"stringUnit":{"state":"translated","value":"أمر الاختصارات غير متوفر على هذا النظام."}},
        "de" : {"stringUnit":{"state":"translated","value":"Der Befehl „shortcuts“ ist auf diesem System nicht verfügbar."}},
        "es" : {"stringUnit":{"state":"translated","value":"El comando Atajos no está disponible en este sistema."}},
        "fr" : {"stringUnit":{"state":"translated","value":"La commande Raccourcis n'est pas disponible sur ce système."}},
        "ja" : {"stringUnit":{"state":"translated","value":"このシステムではショートカット コマンドは使用できません。"}},
        "ko" : {"stringUnit":{"state":"translated","value":"이 시스템에서는 단축어 명령을 사용할 수 없습니다."}},
        "pt" : {"stringUnit":{"state":"translated","value":"O comando Atalhos não está disponível neste sistema."}},
        "ru" : {"stringUnit":{"state":"translated","value":"Инструмент запуска быстрых команд недоступен в этой системе."}}
      }
    },
    "action.unavailable.missing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This item could not be found in Apple Shortcuts."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu öğe Apple Shortcuts'ta bulunamadı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Apple“快捷指令”中找不到此项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Apple「捷徑」中找不到此項目。"
          }
        },
        "ar" : {"stringUnit":{"state":"translated","value":"لا يمكن العثور على هذا العنصر في اختصارات Apple."}},
        "de" : {"stringUnit":{"state":"translated","value":"Dieses Element konnte in der App „Kurzbefehle“ nicht gefunden werden."}},
        "es" : {"stringUnit":{"state":"translated","value":"No se encontró este elemento en Atajos de Apple."}},
        "fr" : {"stringUnit":{"state":"translated","value":"Cet élément est introuvable dans Raccourcis Apple."}},
        "ja" : {"stringUnit":{"state":"translated","value":"この項目は Apple ショートカットで見つかりませんでした。"}},
        "ko" : {"stringUnit":{"state":"translated","value":"이 항목은 Apple 단축어에서 찾을 수 없습니다."}},
        "pt" : {"stringUnit":{"state":"translated","value":"Este item não foi encontrado no app Atalhos da Apple."}},
        "ru" : {"stringUnit":{"state":"translated","value":"Этот элемент не найден в приложении «Команды»."}}
      }
    },
    "action.unavailable.running": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This shortcut is already running."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kısayol zaten çalışıyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此快捷指令正在运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此捷徑正在執行。"
          }
        },
        "ar" : {"stringUnit":{"state":"translated","value":"هذا الاختصار قيد التشغيل بالفعل."}},
        "de" : {"stringUnit":{"state":"translated","value":"Dieser Kurzbefehl wird bereits ausgeführt."}},
        "es" : {"stringUnit":{"state":"translated","value":"Este atajo ya se está ejecutando."}},
        "fr" : {"stringUnit":{"state":"translated","value":"Ce raccourci est déjà en cours d'exécution."}},
        "ja" : {"stringUnit":{"state":"translated","value":"このショートカットはすでに実行されています。"}},
        "ko" : {"stringUnit":{"state":"translated","value":"이 단축어는 이미 실행 중입니다."}},
        "pt" : {"stringUnit":{"state":"translated","value":"Este atalho já está em execução."}},
        "ru" : {"stringUnit":{"state":"translated","value":"Эта команда уже выполняется."}}
      }
    },
    "action.unavailable.untracked": {
      "extractionState": "manual",
