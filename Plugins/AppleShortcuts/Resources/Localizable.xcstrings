    "batch.enable.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These shortcuts will appear in MacTools. Run Links will not be enabled."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kısayollar MacTools'ta görünecek. Run Link'ler etkinleştirilmeyecek."
          }
        },
        "zh-Hans": {
          "stringUnit": {
