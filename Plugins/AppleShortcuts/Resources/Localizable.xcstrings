    "batch.disable.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These shortcuts will no longer appear in MacTools, and their MacTools run settings will be removed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kısayollar artık MacTools'ta görünmeyecek ve MacTools çalıştırma ayarları kaldırılacak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停用后，这些快捷指令将不再出现在 MacTools 中，其 MacTools 运行设置也会移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停用後，這些捷徑將不再顯示於 MacTools 中，其 MacTools 執行設定也會移除。"
          }
        },
        "ar" : {"stringUnit":{"state":"translated","value":"لن تظهر هذه الاختصارات بعد الآن في MacTools، وستُزال إعدادات تشغيلها في MacTools."}},
        "de" : {"stringUnit":{"state":"translated","value":"Diese Kurzbefehle erscheinen nicht mehr in MacTools und ihre MacTools-Ausführungseinstellungen werden entfernt."}},
        "es" : {"stringUnit":{"state":"translated","value":"Estos atajos dejarán de aparecer en MacTools y se eliminarán sus ajustes de ejecución de MacTools."}},
        "fr" : {"stringUnit":{"state":"translated","value":"Ces raccourcis n'apparaîtront plus dans MacTools et leurs paramètres d'exécution MacTools seront supprimés."}},
        "ja" : {"stringUnit":{"state":"translated","value":"これらのショートカットは MacTools に表示されなくなり、MacTools の実行設定は削除されます。"}},
        "ko" : {"stringUnit":{"state":"translated","value":"이러한 단축어는 더 이상 MacTools에 표시되지 않으며 해당 MacTools 실행 설정은 제거됩니다."}},
        "pt" : {"stringUnit":{"state":"translated","value":"Esses atalhos não aparecerão mais no MacTools e suas configurações de execução do MacTools serão removidas."}},
        "ru" : {"stringUnit":{"state":"translated","value":"Эти команды больше не будут отображаться в MacTools. Их настройки запуска в MacTools будут удалены."}}
      }
    },
