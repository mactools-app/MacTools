{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "action.confirm.button": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalıştır"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "執行"
          }
        }
      }
    },
    "action.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This shortcut will run through Apple Shortcuts and may access other apps or data."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kısayol Apple Shortcuts üzerinden çalışacak ve diğer uygulamalara veya verilere erişebilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此快捷指令将通过 Apple“快捷指令”运行，并可能访问其他应用或数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此捷徑將透過 Apple「捷徑」執行，並可能存取其他 App 或資料。"
          }
        }
      }
    },
    "action.confirm.title.format": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run “%@”?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” çalıştırılsın mı?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行“%@”？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "執行「%@」？"
          }
        }
      }
    },
    "action.description.format": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run the Apple Shortcut “%@”."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” Apple kısayolunu çalıştırır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行 Apple 快捷指令“%@”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "執行 Apple 捷徑「%@」。"
          }
        }
      }
    },
    "action.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Shortcuts"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Shortcuts"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 快捷指令"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 捷徑"
          }
        }
      }
    },
    "action.unavailable.executable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Shortcuts command is unavailable on this system."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sistemde Shortcuts komutu kullanılamıyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统未提供“快捷指令”命令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統未提供「捷徑」指令。"
          }
        }
      }
    },
    "action.unavailable.missing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This item could not be found in Apple Shortcuts."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu öğe Apple Shortcuts'ta bulunamadı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Apple“快捷指令”中找不到此项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Apple「捷徑」中找不到此項目。"
          }
        }
      }
    },
    "action.unavailable.running": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This shortcut is already running."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kısayol zaten çalışıyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此快捷指令正在运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此捷徑正在執行。"
          }
        }
      }
    },
    "action.unavailable.untracked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This shortcut is not enabled."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kısayol etkin değil."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此快捷指令未启用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此捷徑尚未啟用。"
          }
        }
      }
    },
