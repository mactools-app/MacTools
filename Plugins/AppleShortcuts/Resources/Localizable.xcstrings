            "state": "translated",
            "value": "Shortcuts'ta Aç"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“快捷指令”中打开"
          }
        },
        "zh-Hant": {
          "stringUnit": {
