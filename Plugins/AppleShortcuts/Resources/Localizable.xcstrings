    "batch.clear": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear Selection"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçimi Temizle"
          }
        },
        "zh-Hans": {
          "stringUnit": {
