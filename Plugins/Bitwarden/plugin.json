{
  "id": "bitwarden",
  "displayName": "Bitwarden",
  "summary": "直接在 MacTools 中登录、搜索和管理 Bitwarden 保管库",
  "localizedMetadata": {
    "zh-Hans": {
      "displayName": "Bitwarden",
      "summary": "直接在 MacTools 中登录、搜索和管理 Bitwarden 保管库"
    },
    "en": {
      "displayName": "Bitwarden",
      "summary": "Sign in, search, and manage your Bitwarden vault in MacTools"
    }
  },
  "version": "1.0.0",
  "minHostVersion": "1.3.1",
  "pluginKitVersion": 7,
  "bundleRelativePath": "Bitwarden.bundle",
  "factoryClass": "BitwardenPlugin.BitwardenPluginFactory",
  "build": {
    "project": "../../MacTools.xcodeproj",
    "scheme": "BitwardenPlugin"
  },
  "capabilities": {
    "panelItems": [
      "row",
      "widget"
    ],
    "settings": "workspace"
  },
  "permissions": [],
  "category": "productivity",
  "preferencesBackup": {
    "status": "localOnly",
    "exclusions": ["credentials", "private-content", "external-authorization"]
  },
  "requirements": {
    "minimumMacOSVersion": "14.0",
    "architectures": [
      "arm64",
      "x86_64"
    ],
    "hardware": [],
    "applications": [],
    "executables": [
      "bw"
    ],
    "permissionIDs": [],
    "setupComplexity": "simple",
    "requiresRelaunch": false
  },
  "privacy": {
    "dataObserved": [
      "vault-items",
      "account-state"
    ],
    "dataPersisted": ["encrypted-cli-state"],
    "retention": {
      "policy": "user-controlled"
    },
    "networkUse": "required",
    "networkDomains": ["bitwarden.com", "bitwarden.eu"],
    "allowsUserConfiguredDomains": true,
    "telemetry": "none",
    "processesSensitiveUserContent": true,
    "diagnosticExportsContainUserData": false
  }
}
