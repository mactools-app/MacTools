            "value": "Bloquear caja fuerte"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouiller le coffre"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保管庫をロック"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관함 잠그기"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquear cofre"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заблокировать хранилище"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasayı Kilitle"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁定保管库？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鎖定保管庫"
          }
        }
      }
    },
    "action.lockVault.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقفل خزنة Bitwarden داخل MacTools"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sperrt den Bitwarden-Tresor in MacTools"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock the Bitwarden vault in MacTools"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquea la caja fuerte de Bitwarden en MacTools"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouille le coffre Bitwarden dans MacTools"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools 内の Bitwarden 保管庫をロックします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools에서 Bitwarden 보관함을 잠급니다"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueia o cofre do Bitwarden no MacTools"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокирует хранилище Bitwarden в MacTools"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools'taki Bitwarden kasasını kilitler"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁定本机的 Bitwarden 保管库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鎖定 MacTools 中的 Bitwarden 保管庫"
          }
        }
      }
    },
