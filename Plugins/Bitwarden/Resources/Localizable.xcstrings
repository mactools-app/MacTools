    "error.lockFailed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر قفل الخزنة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tresor konnte nicht gesperrt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not lock the vault."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo bloquear la caja fuerte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de verrouiller le coffre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保管庫をロックできませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관함을 잠글 수 없습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível bloquear o cofre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось заблокировать хранилище."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasa kilitlenemedi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法锁定 Bitwarden 保管库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法鎖定保管庫。"
          }
        }
      }
    },
