{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "action.lockVault.confirmation.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد قفل خزنة Bitwarden الآن؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitwarden-Tresor jetzt sperren?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock the Bitwarden vault now?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Bloquear la caja fuerte de Bitwarden ahora?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouiller le coffre Bitwarden maintenant ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今すぐ Bitwarden 保管庫をロックしますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 Bitwarden 보관함을 잠그시겠습니까?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquear o cofre do Bitwarden agora?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заблокировать хранилище Bitwarden сейчас?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitwarden kasası şimdi kilitleinsin mi?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作将立即锁定本机的 Bitwarden 保管库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "立即鎖定 Bitwarden 保管庫？"
          }
        }
      }
    },
    "action.lockVault.confirmation.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قفل الخزنة"
          }
        },
        "de": {
          "stringUnit": {
