    "metadata.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرض حالة خزنة Bitwarden في شريط القوائم وقفل التطبيق أو فتحه بسرعة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt den Bitwarden-Tresorstatus in der Menüleiste an und sperrt bzw. öffnet die App schnell"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View the Bitwarden vault status in the menu bar and lock or open the app quickly"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta el estado de la caja fuerte de Bitwarden en la barra de menús y bloquea o abre la aplicación rápidamente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichez l'état du coffre Bitwarden dans la barre de menus et verrouillez ou ouvrez rapidement l'app"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーで Bitwarden 保管庫の状態を表示し、すばやくロックまたはアプリを開きます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대에서 Bitwarden 보관함 상태를 확인하고 빠르게 잠그거나 앱을 엽니다"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja o status do cofre do Bitwarden na barra de menus e bloqueie ou abra o app rapidamente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Статус хранилища Bitwarden в строке меню, быстрое блокирование и открытие приложения"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitwarden kasası durumunu menü çubuğunda görüntüleyin, hızlıca kilitleyin veya uygulamayı açın"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看 Bitwarden 保管库状态并快速锁定或打开应用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在選單列查看 Bitwarden 保管庫狀態並快速鎖定或開啟應用程式"
          }
        }
      }
    },
