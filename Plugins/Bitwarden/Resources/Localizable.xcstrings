    "action.openBitwarden.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح مساحة عمل خزنة Bitwarden داخل MacTools"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet den Bitwarden-Tresor-Arbeitsbereich in MacTools"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the Bitwarden vault workspace in MacTools"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el espacio de trabajo de la caja fuerte de Bitwarden en MacTools"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre l'espace de travail du coffre Bitwarden dans MacTools"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools で Bitwarden 保管庫のワークスペースを開きます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools에서 Bitwarden 보관함 작업 공간을 엽니다"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o espaço de trabalho do cofre do Bitwarden no MacTools"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает рабочую область хранилища Bitwarden в MacTools"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools'taki Bitwarden kasa çalışma alanını açar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Bitwarden 应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 MacTools 中打開 Bitwarden 保管庫工作區"
          }
        }
      }
    },
