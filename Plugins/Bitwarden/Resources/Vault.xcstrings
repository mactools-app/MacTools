    "vault.emailHelp": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لطلب رمز عبر البريد الإلكتروني، سجّل الدخول مع ترك حقل الرمز فارغًا. ثم أدخل الرمز وسجّل الدخول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um einen E-Mail-Code anzufordern, melde dich mit leerem Codefeld an. Gib danach den Code ein und melde dich erneut an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To request an email code, sign in with the code field empty. Then enter the code and sign in again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para solicitar un código por correo, inicia sesión con el campo de código vacío. Después introduce el código e inicia sesión de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour recevoir un code par e-mail, connectez-vous en laissant le champ du code vide. Saisissez ensuite le code et reconnectez-vous."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードをメールで受け取るには、コード欄を空のままサインインしてください。その後コードを入力して再度サインインします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이메일 코드를 요청하려면 코드 필드를 비운 채 로그인하십시오. 그런 다음 코드를 입력하고 다시 로그인하십시오."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para solicitar um código por e-mail, entre com o campo do código vazio. Depois digite o código e entre novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы получить код по эл. почте, войдите с пустым полем кода. Затем введите код и войдите снова."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "E-postayla kod almak için kod alanını boş bırakarak giriş yapın. Ardından kodu girip yeniden giriş yapın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要发送验证码，请留空验证码后点击登录。收到邮件后，输入验证码并再次登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如需透過電子郵件請求驗證碼，請在驗證碼欄位留空的情況下登入。然後輸入驗證碼並再次登入。"
          }
        }
      }
    },
