        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasa yüklenemedi. Yeniden eşitlemeyi deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法载入保管库，请重试同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法載入保管庫。請嘗試重新同步。"
          }
        }
      }
    },
