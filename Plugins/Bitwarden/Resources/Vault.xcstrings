    "error.refresh": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تحميل الخزنة. حاول المزامنة مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tresor konnte nicht geladen werden. Synchronisiere erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not load the vault. Try syncing again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar la bóveda. Prueba a sincronizar de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger le coffre. Essayez de synchroniser à nouveau."
          }
