{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "error.authenticate": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تسجيل الدخول أو فتح القفل. تحقق من بيانات الاعتماد ورمز التحقق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmelden oder Entsperren nicht möglich. Prüfe Zugangsdaten und Verifizierungscode."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not sign in or unlock. Check your credentials and verification code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar sesión o desbloquear. Comprueba tus credenciales y el código de verificación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion ou déverrouillage impossible. Vérifiez vos identifiants et le code de vérification."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインまたはロック解除できませんでした。認証情報と確認コードを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인하거나 잠금 해제할 수 없습니다. 자격 증명과 인증 코드를 확인하십시오."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível entrar ou desbloquear. Verifique suas credenciais e o código de verificação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось войти или разблокировать. Проверьте учётные данные и код проверки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş yapılamadı veya kasa açılamadı. Kimlik bilgilerinizi ve doğrulama kodunuzu kontrol edin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法登录或解锁。请检查凭据和验证码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法登入或解鎖。請檢查您的憑證與驗證碼。"
          }
        }
      }
    },
    "error.folder": {
