    "metadata.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تذكّر مصادر الإدخال وبدّلها تلقائيًا لكل تطبيق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingabequellen pro App merken und automatisch wechseln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remember and automatically switch input sources for each app"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuerde y cambie automáticamente las fuentes de entrada de cada app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mémorisez et changez automatiquement la source de saisie pour chaque app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリごとに入力ソースを記憶して自動的に切り替えます。"
