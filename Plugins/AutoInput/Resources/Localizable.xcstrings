          }
        }
      }
    },
    "settings.hud.reminderInterval.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أظهر التذكير مجددًا عند التركيز المؤهل التالي بعد انقضاء هذه المدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach Ablauf dieser Zeit beim nächsten geeigneten Fokus erneut anzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show again on the next eligible focus after this much time passes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volver a mostrar en el siguiente foco válido una vez transcurrido este tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réafficher au prochain focus admissible après ce délai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この時間が経過した後、次に対象の入力領域へフォーカスしたときに再表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 시간이 지나면 다음 유효한 초점에서 다시 표시합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar novamente no próximo foco válido após este tempo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снова показать при следующем подходящем фокусе после этого времени."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu süre geçtikten sonra ilk uygun odaklanmada yeniden gösterilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "经过这段时间后，在下一次有效聚焦时再次提示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "經過這段時間後，在下一次有效聚焦時再次提示。"
          }
        }
      }
    },
