    "settings.hud.appSwitchReminder.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التذكير عند تبديل التطبيقات"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerung bei App-Wechsel"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App-Switch Reminder"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recordatorio al cambiar de app"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rappel après changement d’app"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ切り替え通知"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 전환 알림"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembrete ao trocar de app"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминание при смене приложений"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama Değiştirme Hatırlatması"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用切换提示"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用程式切換提示"
          }
        }
      }
    },
    "settings.hud.appSwitchReminder.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أظهر التذكير مجددًا بعد هذا العدد من تبديلات التطبيقات، حتى قبل انتهاء المدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dieser Anzahl von App-Wechseln erneut anzeigen, auch vor Ablauf des Zeitlimits."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show again after this many app switches, even before the time limit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volver a mostrar tras este número de cambios de app, incluso antes del límite de tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réafficher après ce nombre de changements d’app, même avant la limite de temps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間の条件に達する前でも、この回数だけアプリを切り替えると再表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간 제한 전이라도 이 횟수만큼 앱을 전환하면 다시 표시합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar novamente após este número de trocas de app, mesmo antes do limite de tempo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снова показать после этого числа переключений приложений, даже до истечения времени."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Süre sınırı dolmamış olsa bile bu sayıda uygulama değişikliğinden sonra yeniden gösterilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "达到此切换次数后，即使尚未到提示间隔，也会在输入区域聚焦时提示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "達到此切換次數後，即使尚未到提示間隔，也會在輸入區域聚焦時提示。"
          }
        }
      }
    },
