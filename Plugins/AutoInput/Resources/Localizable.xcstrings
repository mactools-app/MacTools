    "action.selectSource.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مصدر الإدخال معطّل أو غير متاح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Eingabequelle ist deaktiviert oder nicht verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The input source is disabled or unavailable."
