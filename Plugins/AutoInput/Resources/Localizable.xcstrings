    "permission.accessibility.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستخدم فقط لعرض مصدر الإدخال الحالي قرب مناطق إدخال النص والطرفيات النشطة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird nur verwendet, um die aktuelle Eingabequelle neben aktiven Texteingabebereichen und Terminals anzuzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used only to show the current input source near focused text input areas and terminals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se usa para mostrar la fuente de entrada actual junto a áreas de texto y terminales activos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé uniquement pour afficher la source de saisie actuelle près des zones de texte et terminaux actifs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーカス中のテキスト入力領域やターミナル付近に現在の入力ソースを表示するためにのみ使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포커스된 텍스트 입력 영역과 터미널 근처에 현재 입력 소스를 표시하는 데만 사용됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado apenas para mostrar a fonte de entrada atual perto de áreas de texto e terminais em foco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется только для показа текущего источника ввода рядом с активными областями ввода текста и терминалами."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca odaklanılan metin giriş alanlarının ve terminallerin yakınında geçerli giriş kaynağını göstermek için kullanılır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅用于在当前文本输入区域和终端附近显示输入法。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅用於在目前文字輸入區域和終端機附近顯示輸入法。"
          }
        }
      }
    },
    "permission.accessibility.footnote": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح لـ MacTools من إعدادات النظام ← الخصوصية والأمان ← تسهيلات الاستخدام. لا يتأثر التبديل التلقائي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools unter Systemeinstellungen → Datenschutz & Sicherheit → Bedienungshilfen erlauben. Der automatische Wechsel bleibt verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow MacTools in System Settings → Privacy & Security → Accessibility. Automatic switching remains available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite MacTools en Ajustes del Sistema → Privacidad y seguridad → Accesibilidad. El cambio automático sigue disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez MacTools dans Réglages Système → Confidentialité et sécurité → Accessibilité. Le changement automatique reste disponible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定 → プライバシーとセキュリティ → アクセシビリティでMacToolsを許可してください。自動切り替えは引き続き利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 → 개인정보 보호 및 보안 → 손쉬운 사용에서 MacTools를 허용하세요. 자동 전환은 계속 사용할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o MacTools em Ajustes do Sistema → Privacidade e Segurança → Acessibilidade. A troca automática continua disponível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите MacTools в Системных настройках → Конфиденциальность и безопасность → Универсальный доступ. Автопереключение останется доступным."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Ayarları → Gizlilik ve Güvenlik → Erişilebilirlik bölümünde MacTools'a izin verin. Otomatik geçiş kullanılabilir olmaya devam eder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统设置 → 隐私与安全性 → 辅助功能中允许 MacTools。自动切换输入法不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在系統設定 → 隱私權與安全性 → 輔助使用中允許 MacTools。自動切換輸入法不受影響。"
          }
        }
      }
    },
