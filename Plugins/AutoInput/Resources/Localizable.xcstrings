    "settings.shortcuts.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عيّن اختصارات عامة لمصادر الإدخال المستخدمة كثيرًا وانتقل إليها مباشرة بضغطة مفتاح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Globale Kurzbefehle für häufig verwendete Eingabequellen festlegen und per Tastendruck direkt wechseln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assign global shortcuts to frequently used input sources and switch directly with a key press."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asigna atajos globales a las fuentes de entrada que más usas y cambia directamente con una tecla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attribuez des raccourcis globaux aux sources de saisie fréquentes et changez directement d’une touche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よく使う入力ソースにグローバルショートカットを割り当て、キー操作ですぐに切り替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자주 사용하는 입력 소스에 전역 단축키를 지정하고 키 한 번으로 바로 전환합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atribua atalhos globais às fontes de entrada mais usadas e alterne diretamente com uma tecla."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Назначьте глобальные сочетания клавиш часто используемым источникам ввода и переключайтесь одним нажатием."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sık kullandığınız giriş kaynaklarına global kısayollar atayın ve tek tuşla doğrudan geçin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为常用输入法分配全局快捷键，按下即可直接切换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為常用輸入法指派全域快速鍵，按下即可直接切換。"
          }
        }
      }
    },
