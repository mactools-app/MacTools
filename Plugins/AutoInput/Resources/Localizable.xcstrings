          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頻繁な表示を減らす"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잦은 표시 줄이기"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduzir avisos frequentes"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Реже показывать индикатор"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gösterge Sıklığını Azalt"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "减少频繁提示"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "減少頻繁提示"
          }
        }
      }
    },
    "settings.hud.reducedFrequency.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهر فورًا عند أول تركيز وعند تغيير مصدر الإدخال. مع بقاء المصدر نفسه، يعاد التذكير عند بلوغ أحد الحدين أدناه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim ersten Fokus und bei Eingabequellenwechseln sofort anzeigen. Bei gleicher Quelle erneut erinnern, sobald einer der Grenzwerte erreicht ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show immediately on first focus and source changes. With the same source, remind again when either limit below is reached."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar de inmediato al enfocar por primera vez y al cambiar de fuente. Con la misma fuente, volver a avisar al alcanzar cualquiera de los límites."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher immédiatement au premier focus et lors d’un changement de source. Avec la même source, rappeler dès que l’une des limites est atteinte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初のフォーカス時と入力ソースの変更時はすぐに表示します。同じ入力ソースでは、下のいずれかの条件に達したときに再度表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처음 초점을 맞출 때와 입력 소스 변경 시 즉시 표시합니다. 입력 소스가 같으면 아래 조건 중 하나에 도달할 때 다시 알립니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar imediatamente no primeiro foco e ao mudar a fonte. Com a mesma fonte, lembrar novamente quando qualquer limite abaixo for atingido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сразу показывать при первом фокусе и смене источника. При том же источнике напоминать снова, когда достигнут любой из лимитов ниже."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk odaklanmada ve kaynak değişiminde hemen gösterilir. Kaynak aynı kaldığında, aşağıdaki sınırlardan birine ulaşılınca yeniden hatırlatılır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次聚焦和输入法变化时立即提示。输入法不变时，达到下方任一条件后再次提示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "首次聚焦和輸入法變化時立即提示。輸入法不變時，達到下方任一條件後再次提示。"
          }
        }
      }
    },
    "settings.hud.reminderInterval.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الفاصل الزمني للتذكير"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungsintervall"
          }
        },
        "en": {
