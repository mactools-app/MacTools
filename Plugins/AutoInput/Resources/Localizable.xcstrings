    "settings.hud.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرض مصدر الإدخال الحالي مؤقتًا قرب منطقة إدخال النص أو الطرفية النشطة. يتطلب إذن تسهيلات الاستخدام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktuelle Eingabequelle kurz neben dem aktiven Textbereich oder Terminal anzeigen. Benötigt Bedienungshilfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Briefly show the current input source near the focused text area or terminal. Requires Accessibility."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra brevemente la fuente de entrada actual junto al área de texto o terminal activo. Requiere Accesibilidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche brièvement la source de saisie près de la zone de texte ou du terminal actif. Nécessite Accessibilité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーカス中のテキスト入力領域またはターミナル付近に現在の入力ソースを一時表示します。アクセシビリティが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포커스된 텍스트 입력 영역 또는 터미널 근처에 현재 입력 소스를 잠시 표시합니다. 손쉬운 사용 권한이 필요합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostre brevemente a fonte de entrada atual perto da área de texto ou terminal em foco. Requer Acessibilidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кратко показывать текущий источник ввода рядом с активной областью текста или терминалом. Требуется Универсальный доступ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçerli giriş kaynağını, odaklanılan metin alanının veya terminalin yakınında kısa süreliğine gösterir. Erişilebilirlik izni gerektirir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "聚焦文本输入区域或终端时，在附近短暂显示当前输入法。需要辅助功能权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聚焦文字輸入區域或終端機時，在附近短暫顯示目前輸入法。需要輔助使用權限。"
          }
        }
      }
    },
