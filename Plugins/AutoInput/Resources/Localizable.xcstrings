    "settings.hud.reducedFrequency.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقليل تكرار عرض المؤشر"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Häufige HUD-Anzeigen reduzieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce Frequent HUDs"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
