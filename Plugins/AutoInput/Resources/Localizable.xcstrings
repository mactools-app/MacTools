    "settings.hud.interactive.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى ظاهرًا عند تمرير المؤشر؛ انقر عدة مرات للتنقل بين مصادر الإدخال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleibt beim Darüberfahren sichtbar; wiederholt klicken, um durch die Eingabequellen zu wechseln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stays visible while hovered; click repeatedly to cycle through input sources."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanece visible al pasar el puntero; haz clic varias veces para recorrer las fuentes de entrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reste visible au survol ; cliquez plusieurs fois pour parcourir les sources de saisie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポインタを重ねると表示を維持し、繰り返しクリックして入力ソースを切り替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포인터를 올려 두면 계속 표시되며, 반복해서 클릭해 입력 소스를 순환합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanece visível ao passar o cursor; clique repetidamente para alternar entre as fontes de entrada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаётся видимым при наведении; нажимайте, чтобы переключаться между источниками ввода."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üzerine gelindiğinde görünür kalır; giriş kaynakları arasında geçiş yapmak için art arda tıklayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "悬停时保持显示；可连续点击循环切换输入法。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停留時保持顯示；可連續按一下循環切換輸入法。"
          }
        }
      }
    },
