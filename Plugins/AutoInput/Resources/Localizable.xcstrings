    "action.selectSource.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التبديل مباشرةً إلى مصدر إدخال محدد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Direkt zu einer bestimmten Eingabequelle wechseln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch directly to a specific input source."
          }
