    "settings.hud.position.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر ظهور المؤشر قرب منطقة الإدخال أو عند مؤشر الماوس أو في وسط الشاشة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen, ob das HUD nahe am Eingabebereich, am Zeiger oder in der Mitte des Bildschirms erscheint."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose whether the HUD appears near the input area, at the pointer, or in the center of the display."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige si el indicador aparece cerca del área de entrada, en el puntero o en el centro de la pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez si l’indicateur apparaît près de la zone de saisie, au pointeur ou au centre de l’écran."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力領域の近く、ポインタの位置、または画面中央のどこに表示するかを選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력 영역 근처, 포인터 위치 또는 화면 중앙에 표시할지 선택합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha se o indicador aparece perto da área de entrada, no cursor ou no centro da tela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, показывать индикатор рядом с областью ввода, у указателя или по центру экрана."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Göstergenin metin giriş alanının yakınında mı, işaretçide mi yoksa ekranın ortasında mı görüneceğini seçin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择提示显示在当前输入区域、指针附近或所在显示器中央。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇提示顯示在目前輸入區域、指標附近或所在顯示器中央。"
          }
        }
      }
    },
