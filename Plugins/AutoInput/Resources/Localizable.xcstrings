    "settings.hud.position.at-pointer.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضع شاشة العرض أعلى المؤشر وإلى يساره، بحيث يبقى المؤشر عند الزاوية السفلية اليمنى ويظل النص ظاهرًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Platziert das HUD oberhalb und links vom Zeiger, sodass der Zeiger an der unteren rechten Ecke liegt und der Text sichtbar bleibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Places the HUD above and to the left of the pointer, with the pointer at its bottom-right corner so the text remains visible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca el indicador arriba y a la izquierda del puntero, con el puntero en la esquina inferior derecha para que el texto siga visible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Place l’indicateur au-dessus et à gauche du pointeur, avec le pointeur dans son coin inférieur droit pour que le texte reste visible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポインタの左上に表示し、ポインタが右下隅に来るようにしてテキストを見やすくします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포인터의 왼쪽 위에 표시하고 포인터가 오른쪽 아래 모서리에 오도록 하여 텍스트가 잘 보이게 합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Posiciona o indicador acima e à esquerda do cursor, com o cursor no canto inferior direito para manter o texto visível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размещает индикатор выше и левее указателя, оставляя указатель в правом нижнем углу, чтобы текст был виден."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Göstergeyi işaretçinin sol üstüne yerleştirir; işaretçi sağ alt köşede kalır, böylece metin görünür olmaya devam eder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将提示放在指针左上方，指针停在右下角，避免遮挡文字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將提示放在指標左上方，指標停在右下角，避免遮擋文字。"
          }
        }
      }
    },
    "settings.hud.position.at-pointer.selected-help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أثناء ظهور شاشة العرض، تؤدي نقرتك التالية إلى تبديل مصدر الإدخال بدلاً من النقر على المحتوى تحته."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange das HUD sichtbar ist, wechselt der nächste Klick die Eingabequelle, statt den darunterliegenden Inhalt anzuklicken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While the HUD is visible, your next click switches the input source instead of clicking the content underneath."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras el indicador esté visible, el siguiente clic cambiará la fuente de entrada en lugar de pulsar el contenido que hay debajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant que l’indicateur est visible, votre prochain clic change la source de saisie au lieu de cliquer sur le contenu dessous."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示中は、次のクリックで下のコンテンツを操作せずに入力ソースを切り替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표시가 보이는 동안 다음 클릭은 아래 콘텐츠를 클릭하는 대신 입력 소스를 전환합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Enquanto o indicador estiver visível, o próximo clique alternará a fonte de entrada em vez de clicar no conteúdo abaixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока индикатор виден, следующее нажатие переключит источник ввода вместо нажатия на содержимое под ним."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gösterge görünürken bir sonraki tıklamanız, alttaki içeriği tıklamak yerine giriş kaynağını değiştirir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示显示时，下次点击会切换输入法，而不会点击下方内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提示顯示時，下次按一下會切換輸入法，而不會按一下下方內容。"
          }
        }
      }
    },
    "settings.hud.position.at-pointer.requires-interactive": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شغّل شاشة العرض التفاعلية لاستخدام «عند مؤشر الماوس»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere das interaktive HUD, um „Am Zeiger“ zu verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Interactive HUD to use At Pointer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa el indicador interactivo para usar «En el puntero»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez l’indicateur interactif pour utiliser « Au pointeur »."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ポインタの位置」を使用するには、操作可能な表示をオンにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘포인터 위치’를 사용하려면 대화형 표시를 켜십시오."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o indicador interativo para usar “No cursor”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите интерактивный индикатор, чтобы использовать вариант «У указателя»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşaretçide seçeneğini kullanmak için Etkileşimli Gösterge'yi açın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启“交互式提示”后才能使用“指针处”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟「互動式提示」後才能使用「指標處」。"
          }
        }
      }
    },
