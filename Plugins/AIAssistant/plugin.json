  "version": "0.1.0",
  "minHostVersion": "1.3.1",
  "pluginKitVersion": 7,
  "bundleRelativePath": "AIAssistant.bundle",
  "factoryClass": "AIAssistantPlugin.AIAssistantPluginFactory",
  "build": {
    "project": "../../MacTools.xcodeproj",
