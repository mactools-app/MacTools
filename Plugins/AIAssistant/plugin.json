{
  "id": "ai-assistant",
  "displayName": "AI 助手",
  "summary": "划词调用 AI 翻译、总结、润色等",
  "localizedMetadata": {
    "ar": {
      "displayName": "مساعد الذكاء الاصطناعي",
      "summary": "عالج النص المحدد بالذكاء الاصطناعي: ترجمة وتلخيص وتحسين وغير ذلك."
    },
    "de": {
      "displayName": "KI-Assistent",
      "summary": "Verarbeite ausgewählten Text mit KI: Übersetzen, Zusammenfassen, Überarbeiten und mehr."
    },
    "en": {
      "displayName": "AI Assistant",
      "summary": "Process selected text with AI: translate, summarize, polish, and more."
    },
    "es": {
      "displayName": "Asistente de IA",
      "summary": "Procesa el texto seleccionado con IA: traducir, resumir, pulir y más."
    },
    "fr": {
      "displayName": "Assistant IA",
      "summary": "Traite le texte sélectionné avec l’IA : traduire, résumer, affiner, etc."
    },
    "ja": {
      "displayName": "AIアシスタント",
      "summary": "選択したテキストをAIで処理：翻訳、要約、推敲など。"
    },
    "ko": {
      "displayName": "AI 어시스턴트",
      "summary": "선택한 텍스트를 AI로 처리: 번역, 요약, 다듬기 등."
    },
    "pt": {
      "displayName": "Assistente de IA",
      "summary": "Processa o texto selecionado com IA: traduzir, resumir, refinar e mais."
    },
    "ru": {
      "displayName": "ИИ-ассистент",
      "summary": "Обрабатывайте выделенный текст с помощью ИИ: перевод, резюме, стилистика и другое."
    },
    "tr": {
      "displayName": "Yapay Zekâ Asistanı",
      "summary": "Seçili metni yapay zekâ ile işleyin: çevirin, özetleyin, iyileştirin ve daha fazlası."
    },
    "zh-Hans": {
      "displayName": "AI 助手",
      "summary": "划词调用 AI 翻译、总结、润色等"
    },
    "zh-Hant": {
      "displayName": "AI 助手",
      "summary": "透過快速鍵呼叫 AI 翻譯、摘要、潤飾等"
    }
  },
