{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "settings.prompt.shortcutImmediateDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shortcut changes take effect immediately."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısayol değişiklikleri anında etkili olur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快捷键更改立即生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快速鍵更改立即生效。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسري تغييرات الاختصار على الفور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen an Tastaturkürzeln werden sofort wirksam."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios en los atajos de teclado se aplican inmediatamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications de raccourci prennent effet immédiatement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットの変更はすぐに有効になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키 변경사항은 즉시 적용됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações nos atalhos entram em vigor imediatamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменения сочетаний клавиш вступают в силу немедленно."
          }
        }
      }
    },
    "settings.capture.title": {
