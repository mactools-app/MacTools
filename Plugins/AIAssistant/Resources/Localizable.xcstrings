            "state": "translated",
            "value": "選取文字擷取"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التقاط التحديد"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auswahl erfassen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Captura de selección"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture de sélection"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択テキストの取得"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 캡처"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Captura de seleção"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Захват выделенного текста"
          }
        }
      }
    },
    "settings.capture.simulatedCopy.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Simulated Copy"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Simüle Edilen Kopyalamaya İzin Ver"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许模拟复制"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許模擬拷貝"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح بمحاكاة النسخ"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Simuliertes Kopieren erlauben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir copia simulada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser la copie simulée"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピー操作のシミュレーションを許可"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사 동작 시뮬레이션 허용"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir cópia simulada"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить имитацию копирования"
          }
        }
      }
    },
    "settings.capture.simulatedCopy.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulate ⌘C when direct capture fails. Copied content may enter Clipboard History."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğrudan yakalama başarısız olduğunda ⌘C simüle edilir. Kopyalanan içerik pano geçmişine girebilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接读取失败时模拟 ⌘C；复制内容可能进入剪贴板历史。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直接讀取失敗時模擬 ⌘C；拷貝內容可能進入剪貼簿歷史。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محاكاة ⌘C عند فشل الالتقاط المباشر. قد يدخل المحتوى المنسوخ إلى سجل الحافظة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘C simulieren, wenn die direkte Erfassung fehlschlägt. Kopierte Inhalte können im Zwischenablageverlauf landen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Simule ⌘C cuando falla la captura directa. El contenido copiado puede ingresar al historial del portapapeles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulez ⌘C lorsque la capture directe échoue. Le contenu copié peut entrer dans l'historique du Presse-papiers."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直接キャプチャが失敗した場合に ⌘C をシミュレートします。コピーされたコンテンツがクリップボード履歴に記録される場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 캡처 실패 시 ⌘C를 시뮬레이션합니다. 복사한 콘텐츠가 클립보드 기록에 들어갈 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Simule ⌘C quando a captura direta falhar. O conteúdo copiado pode entrar no histórico da área de transferência."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имитация ⌘C при сбое прямого захвата. Скопированный контент может попасть в историю буфера обмена."
          }
        }
      }
    },
    "action.unavailable.paused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Assistant shortcuts are paused."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapay Zekâ Asistanı kısayolları duraklatıldı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 助手快捷键已暂停。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 助手快速鍵已暫停。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إيقاف اختصارات مساعد الذكاء الاصطناعي مؤقتًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tastenkombinationen des KI-Assistenten sind pausiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los atajos de teclado del Asistente de IA están en pausa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les raccourcis de l’Assistant IA sont suspendus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI アシスタントのショートカットが一時停止されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 어시스턴트 단축키가 일시중지되었습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os atalhos do Assistente de IA estão pausados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сочетания клавиш ИИ-ассистента приостановлены."
          }
        }
      }
    },
