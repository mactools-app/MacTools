    "shortcut.prompt.descriptionFormat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Process the current selection with \"%@\"."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçerli seçimi “%@” ile işle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用「%@」处理当前选中文本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用「%@」處理目前選取的文字。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بمعالجة التحديد الحالي باستخدام \"%@\"."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktuelle Auswahl mit „%@“ verarbeiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Procese la selección actual con \"%@\"."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traiter la sélection en cours avec \"%@\"."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の選択範囲を「%@」で処理します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’을(를) 사용하여 현재 선택한 텍스트를 처리합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Processe a seleção atual com \"%@\"."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обработать выделенный текст с помощью «%@»."
          }
        }
      }
    },
    "shortcut.prompt.clipboardDescriptionFormat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Process selected text with \"%@\", or use the clipboard when no selection is found."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili metni “%@” ile işle; seçim bulunamazsa panoyu kullan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用「%@」处理选中文本，未选中时使用剪贴板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用「%@」處理選取的文字，未選取時使用剪貼簿。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بمعالجة النص المحدد باستخدام \"%@\"، أو استخدم الحافظة في حالة عدم العثور على أي تحديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgewählten Text mit „%@“ verarbeiten oder die Zwischenablage verwenden, wenn keine Auswahl vorliegt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Procese el texto seleccionado con \"%@\" o use el portapapeles cuando no se encuentre ninguna selección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traitez le texte sélectionné avec \"%@\", ou utilisez le presse-papiers lorsqu’aucune sélection n’est trouvée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したテキストを「%@」で処理するか、選択範囲が見つからない場合はクリップボードを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’ 프롬프트로 선택한 텍스트를 처리하며, 선택한 텍스트가 없으면 클립보드를 사용합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Processe o texto selecionado com \"%@\" ou use a área de transferência quando nenhuma seleção for encontrada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обработать выделенный текст с помощью «%@» или использовать буфер обмена, если выделение не найдено."
          }
        }
      }
    },
