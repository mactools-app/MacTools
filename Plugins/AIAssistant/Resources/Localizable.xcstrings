    "settings.prompt.deleteConfirm.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete “%@”? Its shortcut and related settings stop working and cannot be restored."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” silinsin mi? Kısayolu ve ilgili ayarları çalışmayı durur ve geri getirilemez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定要删除「%@」吗？删除后快捷键与相关配置将一并失效，且无法恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確定要刪除「%@」嗎？刪除後快速鍵與相關設定將一併失效，且無法恢復。"
          }
        }
      }
