    "prompt.default.translate.template": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Translate the following text into the other language: if the source is Chinese, translate it into English; otherwise translate it into Simplified Chinese. Return only the translation.\n\n{{text}}"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aşağıdaki metni diğer dile çevir: Metin Türkçeyse İngilizceye, değilse Türkçeye çevir. Yalnızca çeviriyi döndür.\n\n{{text}}"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请将下面的文本翻译为另一种语言：若原文是中文则译为英文，否则译为简体中文，只返回译文。\n\n{{text}}"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請將下面的文字翻譯為另一種語言：若原文是中文則譯為英文，否則譯為簡體中文，只回傳譯文。\n\n{{text}}"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ترجم النص التالي إلى اللغة الأخرى: إذا كان النص الأصلي بالصينية، فترجمه إلى الإنجليزية؛ وإلا فترجمه إلى الصينية المبسطة. أعد الترجمة فقط.\n\n{{text}}"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übersetze den folgenden Text in die andere Sprache: Wenn der Ausgangstext Chinesisch ist, übersetze ihn ins Englische; andernfalls ins vereinfachte Chinesisch. Gib nur die Übersetzung zurück.\n\n{{text}}"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduce el siguiente texto al otro idioma: si el original está en chino, tradúcelo al inglés; de lo contrario, tradúcelo al chino simplificado. Devuelve solo la traducción.\n\n{{text}}"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduisez le texte suivant dans l’autre langue : si le texte source est en chinois, traduisez-le en anglais ; sinon, traduisez-le en chinois simplifié. Renvoyez uniquement la traduction.\n\n{{text}}"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の文章を別の言語に翻訳してください。原文が中国語の場合は英語に、それ以外の場合は簡体字中国語に翻訳してください。翻訳結果のみを返してください。\n\n{{text}}"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 텍스트를 다른 언어로 번역하세요. 원문이 중국어이면 영어로, 그 외에는 중국어 간체로 번역하세요. 번역문만 반환하세요.\n\n{{text}}"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduza o seguinte texto para o outro idioma: se o original estiver em chinês, traduza para o inglês; caso contrário, traduza para o chinês simplificado. Retorne apenas a tradução.\n\n{{text}}"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переведите следующий текст на другой язык: если исходный текст на китайском, переведите его на английский; в остальных случаях — на упрощённый китайский. Верните только перевод.\n\n{{text}}"
          }
        }
      }
    },
