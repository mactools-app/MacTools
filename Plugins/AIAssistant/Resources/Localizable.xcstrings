        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請用簡潔的語言總結下面的文字要點。\n\n{{text}}"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لخّص النقاط الرئيسية في النص التالي بإيجاز.\n\n{{text}}"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
