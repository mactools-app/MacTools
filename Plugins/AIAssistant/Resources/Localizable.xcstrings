    "permission.automation.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading selected browser text may require allowing MacTools to control the browser."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarayıcıdaki seçimi okumak, MacTools'un geçerli tarayıcıyı denetlemesine izin verilmesini gerektirebilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览器划词可能需要允许 MacTools 控制当前浏览器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "瀏覽器劃詞可能需要允許 MacTools 控制目前瀏覽器。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يتطلب التقاط النص المحدد في المتصفح السماح لـ MacTools بالتحكم في المتصفح الحالي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für das Erfassen von Text im Browser muss MacTools möglicherweise die Steuerung des aktuellen Browsers gestattet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer el texto seleccionado en el navegador puede requerir permitir que MacTools controle el navegador actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La capture du texte sélectionné dans un navigateur peut nécessiter d’autoriser MacTools à contrôler ce navigateur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザで選択したテキストを取得するには、MacTools にそのブラウザの制御を許可する必要がある場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저에서 선택한 텍스트를 읽으려면 MacTools가 현재 브라우저를 제어하도록 허용해야 할 수도 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A captura de texto selecionado no navegador pode exigir permissão para o MacTools controlar o navegador atual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для чтения выделенного текста в браузере может потребоваться разрешить MacTools управлять этим браузером."
          }
        }
      }
    },
    "permission.automation.footnote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS will ask for Automation permission the first time MacTools controls a browser."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS, bir tarayıcıyı ilk kez denetlediğinde otomasyon izni ister."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools 首次控制浏览器时，macOS 会请求自动化授权。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 會在首次控制瀏覽器時要求自動化權限。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيطلب macOS إذن التحكم التلقائي عندما يتحكم MacTools في المتصفح للمرة الأولى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS fragt bei der ersten Steuerung eines Browsers nach der Berechtigung „Automation“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS solicitará permiso de automatización la primera vez que MacTools controle un navegador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS demandera l’autorisation d’automatisation lorsque MacTools contrôlera un navigateur pour la première fois."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS は、初めてブラウザを制御するときにオートメーションの許可を求めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS는 브라우저를 처음 제어할 때 자동화 권한을 요청합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS solicitará permissão de Automação na primeira vez que o MacTools controlar um navegador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS запросит разрешение на автоматизацию при первом управлении браузером."
          }
        }
      }
    },
