      }
    },
    "metadata.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Process selected text with AI: translate, summarize, polish, and more."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili metni yapay zekâ ile işleyin: çevirin, özetleyin, iyileştirin ve daha fazlası."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "划词调用 AI 翻译、总结、润色等"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過快速鍵呼叫 AI 翻譯、摘要、潤飾等"
          }
        }
      }
    },
    "permission.accessibility.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişilebilirlik"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能授权"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輔助使用權限"
          }
        }
      }
    },
    "permission.accessibility.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Processing selected text requires reading the current selection."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili metni işlemek, geçerli seçimin okunmasını gerektirir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "划词处理需要读取当前选中文本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "劃詞處理需要讀取目前選取的文字。"
          }
        }
      }
    },
    "permission.accessibility.footnote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open System Settings → Privacy & Security → Accessibility and allow MacTools."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Ayarları → Gizlilik ve Güvenlik → Erişilebilirlik bölümünü açın ve MacTools'a izin verin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前往系统设置 → 隐私与安全性 → 辅助功能，授权 MacTools。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "前往系統設定 → 隱私與安全性 → 輔助使用，授權 MacTools。"
          }
        }
      }
    },
    "permission.automation.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automation"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomasyon"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动化授权"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動化權限"
          }
        }
      }
    },
    "permission.automation.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browser selection may require allowing MacTools to control the current browser."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarayıcıdaki seçimi okumak, MacTools'un geçerli tarayıcıyı denetlemesine izin verilmesini gerektirebilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览器划词可能需要允许 MacTools 控制当前浏览器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "瀏覽器劃詞可能需要允許 MacTools 控制目前瀏覽器。"
          }
        }
      }
    },
    "permission.automation.footnote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS will ask for automation permission the first time it controls a browser."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS, bir tarayıcıyı ilk kez denetlediğinde otomasyon izni ister."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 会在首次控制浏览器时请求自动化授权。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 會在首次控制瀏覽器時要求自動化權限。"
          }
        }
      }
    },
    "permission.automation.status": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
