    "panel.confirm.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected text could not be read directly; the content above comes from the clipboard. Confirm before sending it to AI."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili metin doğrudan okunamadı; yukarıdaki içerik panodan geliyor. Yapay zekâya göndermeden önce onaylayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能直接读取选中文本，以上内容来自剪贴板。请确认是否将其发送给 AI 处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法直接讀取選取的文字，以上內容來自剪貼簿。請確認是否將其傳送給 AI 處理。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذرت قراءة النص المحدد مباشرة؛ المحتوى أعلاه مأخوذ من الحافظة. أكّد قبل إرساله إلى الذكاء الاصطناعي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der ausgewählte Text konnte nicht direkt gelesen werden; der obige Inhalt stammt aus der Zwischenablage. Bitte bestätigen, bevor er an die KI gesendet wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer directamente el texto seleccionado; el contenido de arriba proviene del portapapeles. Confirma antes de enviarlo a la IA."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte sélectionné n’a pas pu être lu directement ; le contenu ci-dessus provient du presse-papiers. Confirmez avant de l’envoyer à l’IA."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したテキストを直接読み取ることができませんでした。上のコンテンツはクリップボードから取得したものです。 AIに送信する前に確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 텍스트를 직접 읽을 수 없습니다. 위의 내용은 클립보드에서 가져온 것입니다. AI로 보내기 전에 확인하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto selecionado não pôde ser lido diretamente; o conteúdo acima vem da área de transferência. Confirme antes de enviá-lo à IA."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать выделенный текст напрямую; выше показано содержимое буфера обмена. Подтвердите его перед отправкой ИИ."
          }
        }
      }
    },
