    "permission.accessibility.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Processing selected text requires reading the current selection."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili metni işlemek, geçerli seçimin okunmasını gerektirir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "划词处理需要读取当前选中文本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "劃詞處理需要讀取目前選取的文字。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتطلب معالجة النص المحدد قراءة التحديد الحالي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verarbeitung von ausgewähltem Text erfordert das Auslesen der aktuellen Auswahl."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El procesamiento del texto seleccionado requiere leer la selección actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le traitement du texte sélectionné nécessite la lecture de la sélection en cours."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したテキストを処理するには、現在の選択内容を読み取る必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 텍스트를 처리하려면 현재 선택 항목을 읽어야 합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O processamento do texto selecionado requer a leitura da seleção atual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для обработки выделенного текста требуется чтение текущего выделения."
          }
        }
      }
    },
    "permission.accessibility.footnote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open System Settings → Privacy & Security → Accessibility and allow MacTools."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Ayarları → Gizlilik ve Güvenlik → Erişilebilirlik bölümünü açın ve MacTools'a izin verin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前往系统设置 → 隐私与安全性 → 辅助功能，授权 MacTools。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "前往系統設定 → 隱私與安全性 → 輔助使用，授權 MacTools。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح إعدادات النظام ← الخصوصية والأمن ← تسهيلات الاستخدام، ثم اسمح لـ MacTools."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Systemeinstellungen → Datenschutz & Sicherheit → Bedienungshilfen und erlaube MacTools den Zugriff."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Ajustes del Sistema → Privacidad y seguridad → Accesibilidad y permite MacTools."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Réglages Système → Confidentialité et sécurité → Accessibilité, puis autorisez MacTools."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定 → プライバシーとセキュリティ → アクセシビリティで MacTools を許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 → 개인정보 보호 및 보안 → 손쉬운 사용에서 MacTools를 허용하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra Ajustes do Sistema → Privacidade e Segurança → Acessibilidade e permita o MacTools."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте Системные настройки → Конфиденциальность и безопасность → Универсальный доступ и разрешите доступ для MacTools."
          }
        }
      }
    },
