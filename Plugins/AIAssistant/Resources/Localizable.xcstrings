    "metadata.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Assistant"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapay Zekâ Asistanı"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 助手"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
