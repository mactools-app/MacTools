    "settings.provider.reasoning.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Include the reasoning request field for DeepSeek / Qwen style thinking models."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepSeek / Qwen tarzı düşünür modeller için akıl yürütme isteği alanını içerir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为 DeepSeek / Qwen 等推理模型在请求中启用思考字段。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為 DeepSeek / Qwen 等推理模型在請求中啟用思考欄位。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتضمين حقل طلب الاستدلال لنماذج التفكير بأسلوب DeepSeek / Qwen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feld für die Anforderung des Denkprozesses (Reasoning) für Modelle im DeepSeek-/Qwen-Stil einbeziehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluye el campo de razonamiento en las solicitudes para modelos de razonamiento como DeepSeek y Qwen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclut le champ de demande de raisonnement pour les modèles de raisonnement de type DeepSeek / Qwen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepSeek / Qwen などの推論モデルで、リクエストに思考プロセス用のフィールドを含めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepSeek / Qwen 등 추론 모델에 맞게 요청에 추론 필드를 포함합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclua o campo de solicitação de raciocínio para modelos de raciocínio como DeepSeek e Qwen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавлять поле запроса рассуждений для моделей DeepSeek, Qwen и других моделей с режимом рассуждений."
          }
        }
      }
    },
