    "settings.shortcutInput.clipboard.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefer selected text. If no selection is found and the clipboard stays unchanged, use the text you copied earlier."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili metin önceliklidir. Bir seçim bulunamazsa ve pano değişmemişse, daha önce kopyaladığınız metin kullanılır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "优先处理选中文本；未选中且剪贴板未变化时，使用已复制的文本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "優先處理選取的文字；未選取且剪貼簿未變動時，使用已複製的文字。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُعطى الأولوية للنص المحدد. إذا لم يُعثر على تحديد وبقيت الحافظة دون تغيير، يُستخدم النص الذي نسخته سابقًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgewählten Text bevorzugen. Wenn keine Auswahl gefunden wird und die Zwischenablage unverändert bleibt, wird der zuvor kopierte Text verwendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se da prioridad al texto seleccionado. Si no se detecta ninguna selección y el portapapeles no ha cambiado, se usa el texto copiado anteriormente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Privilégie le texte sélectionné. Si aucune sélection n’est trouvée et que le presse-papiers reste inchangé, utilise le texte que vous avez copié précédemment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したテキストを優先します。選択範囲が見つからず、クリップボードが変更されない場合は、前にコピーしたテキストを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 텍스트를 우선 사용합니다. 선택한 텍스트가 없고 클립보드가 변경되지 않았다면 이전에 복사한 텍스트를 사용합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefira texto selecionado. Se nenhuma seleção for encontrada e a área de transferência permanecer inalterada, use o texto que você copiou anteriormente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предпочитать выделенный текст. Если выделение не найдено и буфер обмена не изменился, используйте текст, скопированный ранее."
          }
        }
      }
    },
    "settings.shortcut.conflict.system": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This shortcut conflicts with a common system action. Use a combination that includes ⌥ (Option) or ⌃ (Control)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kısayol, yaygın bir sistem eylemiyle çakışıyor. ⌥ (Option) veya ⌃ (Control) içeren bir tuş birleşimi kullanın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该快捷键与常用系统操作冲突，请使用包含 ⌥(Option) 或 ⌃(Control) 的组合键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此快速鍵與常用系統操作衝突，請使用包含 ⌥(Option) 或 ⌃(Control) 的組合鍵。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتعارض هذا الاختصار مع إجراء شائع في النظام. استخدم تركيبة تتضمن ⌥ (Option) أو ⌃ (Control)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Tastenkombination steht im Konflikt mit einer gängigen Systemaktion. Verwenden Sie eine Kombination, die ⌥ (Option) oder ⌃ (Control) enthält."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este atajo de teclado entra en conflicto con una acción habitual del sistema. Usa una combinación que incluya ⌥ (Option) o ⌃ (Control)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce raccourci entre en conflit avec une action système courante. Utilisez une combinaison qui inclut ⌥ (Option) ou ⌃ (Contrôle)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このショートカットは一般的なシステム操作と競合します。⌥ (Option) または ⌃ (Control) を含む組み合わせを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 단축키는 일반적인 시스템 작업과 충돌합니다. ⌥(옵션) 또는 ⌃(컨트롤)이 포함된 조합을 사용하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este atalho entra em conflito com uma ação comum do sistema. Use uma combinação que inclua ⌥ (Option) ou ⌃ (Control)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это сочетание клавиш конфликтует с системным действием. Используйте комбинацию с ⌥ (Option) или ⌃ (Control)."
          }
        }
      }
    },
    "settings.shortcut.conflict.duplicatePrompt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This shortcut is already used by the prompt “%@”. Choose a different combination."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kısayol zaten “%@” istemi tarafından kullanılıyor. Farklı bir tuş birleşimi seçin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该快捷键已被模板「%@」占用，请更换其他按键组合。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此快速鍵已被模板「%@」佔用，請更換其他按鍵組合。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم التوجيه «%@» هذا الاختصار بالفعل. اختر تركيبة مختلفة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Tastenkombination wird bereits vom Prompt „%@“ verwendet. Wählen Sie eine andere Kombination."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El prompt «%@» ya utiliza este atajo de teclado. Elige otra combinación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce raccourci est déjà utilisé par le prompt « %@ ». Choisissez une combinaison différente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このショートカットはプロンプト「%@」ですでに使用されています。別の組み合わせを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 단축키는 \"%@\" 프롬프트에서 이미 사용되었습니다. 다른 조합을 선택하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este atalho já é utilizado pelo prompt “%@”. Escolha uma combinação diferente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это сочетание клавиш уже используется промптом «%@». Выберите другую комбинацию."
          }
        }
      }
    },
