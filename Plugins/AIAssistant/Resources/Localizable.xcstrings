    "settings.prompt.temperature.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "0-2. Controls output creativity and stability; 0.7 by default."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "0-2. Çıktının yaratıcılığını ve dengesini denetler; varsayılan değer 0.7."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "0-2，控制输出创造力与稳定性，默认 0.7。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "0-2，控制輸出創造力與穩定性，預設 0.7。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "0-2. يتحكم في إبداع الإخراج واستقراره؛ 0.7 بشكل افتراضي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "0–2. Steuert die Kreativität und Stabilität der Ausgabe; Standardwert ist 0,7."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "0-2. Controla la creatividad y la estabilidad de la salida; 0,7 por defecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "0-2. Contrôle la créativité et la stabilité des résultats ; 0,7 par défaut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "0-2。出力の創造性と安定性を制御します。デフォルトでは 0.7 です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "0-2. 출력 창의성과 안정성을 제어합니다. 기본적으로 0.7입니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "0–2. Controla a criatividade e a estabilidade da resposta; 0,7 por padrão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "0–2. Определяет творческий характер и стабильность ответов; по умолчанию — 0,7."
          }
        }
      }
    },
