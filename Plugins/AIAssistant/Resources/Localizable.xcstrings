{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "settings.prompt.shortcutImmediateDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shortcut changes take effect immediately."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısayol değişiklikleri anında etkili olur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快捷键更改立即生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快速鍵更改立即生效。"
          }
        }
      }
    },
    "settings.capture.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selection Capture"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçim Yakalama"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "划词捕获"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選取文字擷取"
          }
        }
      }
    },
    "settings.capture.simulatedCopy.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Simulated Copy"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Simüle Edilen Kopyalamaya İzin Ver"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许模拟复制"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許模擬拷貝"
          }
        }
      }
    },
    "settings.capture.simulatedCopy.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulate ⌘C when direct capture fails. Copied content may enter Clipboard History."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğrudan yakalama başarısız olduğunda ⌘C simüle edilir. Kopyalanan içerik pano geçmişine girebilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接读取失败时模拟 ⌘C；复制内容可能进入剪贴板历史。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直接讀取失敗時模擬 ⌘C；拷貝內容可能進入剪貼簿歷史。"
          }
        }
      }
    },
    "action.unavailable.paused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Assistant shortcuts are paused."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapay Zekâ Asistanı kısayolları duraklatıldı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 助手快捷键已暂停。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 助手快速鍵已暫停。"
          }
        }
      }
    },
    "action.unavailable.accessibility": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility permission is required."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişilebilirlik izni gerekli."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
