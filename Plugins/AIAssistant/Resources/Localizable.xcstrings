    "settings.prompt.deleteConfirm.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete “%@”? Its shortcut and related settings stop working and cannot be restored."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” silinsin mi? Kısayolu ve ilgili ayarları çalışmayı durur ve geri getirilemez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定要删除「%@」吗？删除后快捷键与相关配置将一并失效，且无法恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確定要刪除「%@」嗎？刪除後快速鍵與相關設定將一併失效，且無法恢復。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف \"%@\"؟ يتوقف الاختصار والإعدادات ذات الصلة عن العمل ولا يمكن استعادتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ löschen? Die Tastenkombination und die zugehörigen Einstellungen funktionieren danach nicht mehr und können nicht wiederhergestellt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar «%@»? Su atajo de teclado y los ajustes relacionados dejarán de funcionar y no se podrán restaurar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer « %@ » ? Son raccourci et les paramètres associés cessent de fonctionner et ne peuvent pas être restaurés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を削除しますか？そのショートカットと関連設定は動作を停止し、復元できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’을(를) 삭제하시겠습니까? 단축키 및 관련 설정이 작동을 멈추고 복원할 수 없습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir “%@”? Seu atalho e configurações relacionadas param de funcionar e não podem ser restaurados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить «%@»? Его сочетание клавиш и связанные настройки будут безвозвратно удалены."
          }
        }
      }
    },
