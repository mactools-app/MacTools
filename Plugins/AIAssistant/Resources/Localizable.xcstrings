    "metadata.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Process selected text with AI: translate, summarize, polish, and more."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili metni yapay zekâ ile işleyin: çevirin, özetleyin, iyileştirin ve daha fazlası."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "划词调用 AI 翻译、总结、润色等"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過快速鍵呼叫 AI 翻譯、摘要、潤飾等"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عالج النص المحدد بالذكاء الاصطناعي: ترجمة وتلخيص وتحسين وغير ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verarbeite ausgewählten Text mit KI: Übersetzen, Zusammenfassen, Überarbeiten und mehr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Procesa el texto seleccionado con IA: traducir, resumir, pulir y más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traitez le texte sélectionné avec l’IA : traduisez, résumez, améliorez le style, etc."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したテキストをAIで処理：翻訳、要約、推敲など。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 텍스트를 AI로 처리: 번역, 요약, 다듬기 등."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Processe o texto selecionado com IA: traduza, resuma, aprimore e muito mais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обрабатывайте выделенный текст с помощью ИИ: переводите, кратко излагайте, редактируйте и выполняйте другие задачи."
          }
        }
      }
    },
