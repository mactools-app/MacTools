    "prompt.default.translate.template": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Translate the following text into the other language: if the source is Chinese, translate it into English; otherwise translate it into Simplified Chinese. Return only the translation.\n\n{{text}}"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aşağıdaki metni diğer dile çevir: Metin Türkçeyse İngilizceye, değilse Türkçeye çevir. Yalnızca çeviriyi döndür.\n\n{{text}}"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请将下面的文本翻译为另一种语言：若原文是中文则译为英文，否则译为简体中文，只返回译文。\n\n{{text}}"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請將下面的文字翻譯為另一種語言：若原文是中文則譯為英文，否則譯為簡體中文，只回傳譯文。\n\n{{text}}"
          }
        }
      }
    },
