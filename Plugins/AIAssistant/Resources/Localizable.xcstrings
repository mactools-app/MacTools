    "prompt.default.polish.template": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Polish the following text to make it clearer and more natural while preserving the original meaning.\n\n{{text}}"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aşağıdaki metni, özgün anlamını koruyarak daha açık ve daha doğal hale getir.\n\n{{text}}"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请润色下面的文本，使其表达更清晰、更自然，保持原意不变。\n\n{{text}}"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請潤飾下面的文字，使其表達更清晰、更自然，保持原意不變。\n\n{{text}}"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حسّن صياغة النص التالي ليصبح أوضح وأكثر سلاسة مع الحفاظ على المعنى الأصلي.\n\n{{text}}"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überarbeite den folgenden Text, damit er klarer und natürlicher klingt, ohne seine ursprüngliche Bedeutung zu verändern.\n\n{{text}}"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mejora la redacción del siguiente texto para que sea más claro y natural, conservando el significado original.\n\n{{text}}"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Améliorez le style du texte suivant pour le rendre plus clair et naturel tout en préservant le sens original.\n\n{{text}}"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の意味を保ちながら、次の文章をより明確で自然な表現に推敲してください。\n\n{{text}}"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원래 의미를 유지하면서 다음 텍스트를 더 명확하고 자연스럽게 다듬으세요.\n\n{{text}}"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprimore o seguinte texto para torná-lo mais claro e natural, preservando o significado original.\n\n{{text}}"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отредактируйте следующий текст, сделав его более ясным и естественным и сохранив исходный смысл.\n\n{{text}}"
          }
        }
      }
    },
