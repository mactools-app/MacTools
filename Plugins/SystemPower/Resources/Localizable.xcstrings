        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque o Mac em repouso imediatamente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Немедленно перевести Mac в режим сна"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'inizi hemen uyutur"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即让 Mac 进入睡眠"
          }
        },
        "zh-Hant": {
          "stringUnit": {
