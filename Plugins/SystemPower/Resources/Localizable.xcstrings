    "metadata.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضع Mac في وضع السكون أو سجّل الخروج أو أعد التشغيل أو أوقف التشغيل"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac in den Ruhezustand versetzen, abmelden, neu starten oder ausschalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep, log out, restart, or shut down your Mac"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon el Mac en reposo, cierra sesión, reinícialo o apágalo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez le Mac en veille, déconnectez-vous, redémarrez-le ou éteignez-le"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macをスリープ、ログアウト、再起動、またはシステム終了します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac을 잠자기 상태로 전환하거나 로그아웃, 재시동 또는 종료합니다"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque o Mac em repouso, termine a sessão, reinicie-o ou desligue-o"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переведите Mac в режим сна, выйдите из системы, перезагрузите или выключите его"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'inizi uyutun, oturumunu kapatın, yeniden başlatın veya kapatın"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让 Mac 睡眠、退出登录、重新启动或关机"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓 Mac 睡眠、登出、重新啟動或關機"
          }
        }
      }
    },
