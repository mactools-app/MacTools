  "strings": {
    "action.logOut.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار تأكيد تسجيل الخروج في macOS"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS-Abmeldebestätigung anzeigen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show the macOS log out confirmation"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra la confirmación de cierre de sesión de macOS"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher la confirmation de fermeture de session de macOS"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSのログアウト確認を表示します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 로그아웃 확인을 표시합니다"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar a confirmação de fim de sessão do macOS"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показать подтверждение выхода из macOS"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS oturum kapatma onayını gösterir"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示 macOS 退出登录确认"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示 macOS 登出確認"
          }
        }
      }
    },
