          "stringUnit": {
            "state": "translated",
            "value": "يلزم إذن الأتمتة. اسمح لـ MacTools بالتحكم في أحداث النظام من إعدادات النظام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Automatisierungsberechtigung ist erforderlich. Erlaube MacTools in den Systemeinstellungen, Systemereignisse zu steuern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automation permission is required. Allow MacTools to control system events in System Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesita permiso de automatización. Permite que MacTools controle los eventos del sistema en Ajustes del Sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autorisation d’automatisation est requise. Autorisez MacTools à contrôler les événements système dans Réglages Système."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オートメーションの許可が必要です。システム設定で MacTools にシステムイベントの制御を許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동화 권한이 필요합니다. 시스템 설정에서 MacTools가 시스템 이벤트를 제어하도록 허용하십시오."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "É necessária a permissão de automação. Permita que o MacTools controle eventos do sistema nas Definições do Sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуется разрешение на автоматизацию. Разрешите MacTools управлять системными событиями в Системных настройках."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomasyon izni gerekiyor. Sistem Ayarları'nda MacTools'un System Events'i denetlemesine izin verin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要自动化授权，请前往系统设置允许 MacTools 控制系统事件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要自動化授權，請前往系統設定允許 MacTools 控制系統事件。"
          }
        }
      }
    },
    "permission.automation.deniedFootnote": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتقل إلى إعدادات النظام ← الخصوصية والأمن ← الأتمتة، ثم اسمح لـ MacTools بالتحكم في أحداث النظام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Systemeinstellungen → Datenschutz & Sicherheit → Automation und erlaube MacTools, Systemereignisse zu steuern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open System Settings → Privacy & Security → Automation and allow MacTools to control system events."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve a Ajustes del Sistema → Privacidad y seguridad → Automatización y permite que MacTools controle los eventos del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Réglages Système → Confidentialité et sécurité → Automatisation, puis autorisez MacTools à contrôler les événements système."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定 → プライバシーとセキュリティ → オートメーションで、MacTools にシステムイベントの制御を許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 → 개인정보 보호 및 보안 → 자동화에서 MacTools가 시스템 이벤트를 제어하도록 허용하십시오."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra Definições do Sistema → Privacidade e Segurança → Automação e permita que o MacTools controle eventos do sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте Системные настройки → Конфиденциальность и безопасность → Автоматизация и разрешите MacTools управлять системными событиями."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Ayarları → Gizlilik ve Güvenlik → Otomasyon'u açın ve MacTools'un System Events'i denetlemesine izin verin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前往系统设置 → 隐私与安全性 → 自动化，允许 MacTools 控制系统事件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "前往系統設定 → 隱私權與安全性 → 自動化，允許 MacTools 控制系統事件。"
          }
        }
      }
    },
    "permission.automation.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستخدم لإظهار تأكيد تسجيل الخروج وإعادة التشغيل وإيقاف التشغيل في macOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird verwendet, um die macOS-Bestätigungen zum Abmelden, Neustarten und Ausschalten anzuzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to show macOS confirmations for logging out, restarting, and shutting down."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se utiliza para mostrar las confirmaciones de macOS al cerrar sesión, reiniciar y apagar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisée pour afficher les confirmations macOS de fermeture de session, de redémarrage et d’extinction."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS のログアウト、再起動、システム終了の確認を表示するために使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 로그아웃, 재시동 및 종료 확인을 표시하는 데 사용됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Usada para mostrar as confirmações do macOS de fim de sessão, reinício e encerramento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется для показа подтверждений macOS при выходе из системы, перезагрузке и выключении."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturumu kapatma, yeniden başlatma ve kapatma onaylarını göstermek için kullanılır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于显示 macOS 退出登录、重新启动和关机确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於顯示 macOS 登出、重新啟動和關機確認。"
          }
        }
      }
    },
    "permission.automation.footnote": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيطلب macOS إذن الأتمتة عند تنفيذ إجراء ذي صلة لأول مرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS fragt beim ersten Ausführen einer entsprechenden Aktion nach der Automatisierungsberechtigung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS asks for Automation permission the first time you perform a related action."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS solicita permiso de automatización la primera vez que realizas una acción relacionada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS demande l’autorisation d’automatisation lors de la première action concernée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "関連する操作を初めて実行するときに、macOS がオートメーションの許可を求めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관련 동작을 처음 수행할 때 macOS가 자동화 권한을 요청합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS solicita permissão de automação na primeira vez que efetuar uma ação relacionada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS запросит разрешение на автоматизацию при первом выполнении соответствующего действия."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS, ilgili bir eylemi ilk kez gerçekleştirdiğinizde Otomasyon izni ister."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 会在首次执行相关操作时请求自动化授权。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 會在首次執行相關操作時要求自動化授權。"
          }
        }
      }
    },
