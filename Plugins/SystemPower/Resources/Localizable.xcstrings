    "action.sleep.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضع Mac في وضع السكون فورًا"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac sofort in den Ruhezustand versetzen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put your Mac to sleep immediately"
          }
        },
