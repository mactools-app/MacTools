{
  "id": "system-power",
  "displayName": "电源操作",
  "summary": "让 Mac 睡眠、退出登录、重新启动或关机",
  "localizedMetadata": {
    "ar": {
      "displayName": "إجراءات الطاقة",
      "summary": "ضع Mac في وضع السكون أو سجّل الخروج أو أعد التشغيل أو أوقف التشغيل."
    },
    "de": {
      "displayName": "Energieaktionen",
      "summary": "Mac in den Ruhezustand versetzen, abmelden, neu starten oder ausschalten."
    },
    "en": {
      "displayName": "Power Actions",
      "summary": "Sleep, log out, restart, or shut down your Mac."
    },
    "es": {
      "displayName": "Acciones de energía",
      "summary": "Pon el Mac en reposo, cierra sesión, reinícialo o apágalo."
    },
    "fr": {
      "displayName": "Actions d’alimentation",
      "summary": "Mettez le Mac en veille, déconnectez-vous, redémarrez-le ou éteignez-le."
    },
    "ja": {
      "displayName": "電源操作",
      "summary": "Macをスリープ、ログアウト、再起動、またはシステム終了します。"
    },
    "ko": {
      "displayName": "전원 동작",
      "summary": "Mac을 잠자기 상태로 전환하거나 로그아웃, 재시동 또는 종료합니다."
    },
    "pt": {
      "displayName": "Ações de energia",
      "summary": "Coloque o Mac em repouso, termine a sessão, reinicie-o ou desligue-o."
    },
    "ru": {
      "displayName": "Действия питания",
      "summary": "Переведите Mac в режим сна, выйдите из системы, перезагрузите или выключите его."
    },
    "tr": {
      "displayName": "Güç Eylemleri",
      "summary": "Mac'inizi uyutun, oturumu kapatın, yeniden başlatın veya kapatın."
    },
    "zh-Hans": {
      "displayName": "电源操作",
      "summary": "让 Mac 睡眠、退出登录、重新启动或关机"
    },
    "zh-Hant": {
      "displayName": "電源操作",
      "summary": "讓 Mac 睡眠、登出、重新啟動或關機"
    }
  },
