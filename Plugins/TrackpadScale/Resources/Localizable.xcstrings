            "state": "translated",
            "value": "已停止采样"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Messung beendet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Medición detenida"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesure arrêtée"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Medição interrompida"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Измерение остановлено"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "測定停止"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "측정 중지됨"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已停止取樣"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقف القياس"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ölçüm durdu"
          }
        }
      }
    },
    "status.captured": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weight captured. You can lift your finger."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重量已记录，可抬起手指。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewicht erfasst. Sie können den Finger anheben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Peso capturado. Puedes levantar el dedo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poids capturé. Vous pouvez lever le doigt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Peso capturado. Você pode levantar o dedo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вес зафиксирован. Можно убрать палец."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "重量を記録しました。指を離せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무게가 기록되었습니다. 손가락을 떼어도 됩니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重量已記錄，可抬起手指。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تسجيل الوزن. يمكنك رفع إصبعك."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağırlık kaydedildi. Parmağınızı kaldırabilirsiniz."
          }
        }
      }
    },
    "status.capturing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold steady to capture the weight."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请保持平稳，正在记录重量。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Erfassen des Gewichts ruhig halten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén el dedo quieto para capturar el peso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restez immobile pour capturer le poids."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha o dedo parado para capturar o peso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не двигайтесь для фиксации веса."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "重量を記録するまで動かさずに保持してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무게가 기록될 때까지 가만히 유지하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請保持平穩，正在記錄重量。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اثبت لتسجيل الوزن."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağırlığı kaydetmek için sabit tutun."
          }
        }
      }
    },
    "capture.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The reading stays until you start again. You can switch to another task."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读数会保留至下次称重，可切换到其他任务。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Messwert bleibt bis zum nächsten Start erhalten. Sie können zu einer anderen Aufgabe wechseln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lectura se conserva hasta que vuelvas a iniciar. Puedes cambiar de tarea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mesure reste affichée jusqu’au prochain démarrage. Vous pouvez passer à une autre tâche."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A leitura permanece até você iniciar novamente. Você pode mudar de tarefa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показание сохраняется до нового запуска. Можно перейти к другой задаче."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の計量まで読数を保持します。他の作業に切り替えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 측정할 때까지 값이 유지됩니다. 다른 작업으로 전환해도 됩니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀數會保留至下次稱重，可切換到其他任務。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى القراءة حتى تبدأ مجددًا. يمكنك الانتقال إلى مهمة أخرى."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekrar başlatana kadar değer korunur. Başka bir işe geçebilirsiniz."
          }
        }
      }
    },
    "status.recovery": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you still cannot start, update or disable older Trackpad Gestures and Middle Click packages in Plugins."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若仍无法开始，请在“插件”中更新或停用旧版触控板手势和模拟鼠标中键。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا تعذر البدء، فحدّث حزم إيماءات لوحة التتبع والنقر بالزر الأوسط القديمة أو عطّلها في الإضافات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn der Start weiterhin nicht möglich ist, aktualisiere oder deaktiviere ältere Pakete für Trackpad-Gesten und Mittelklick unter Plugins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si aún no puedes iniciar, actualiza o desactiva los paquetes antiguos de Gestos del trackpad y Clic central en Plugins."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si le démarrage reste impossible, mettez à jour ou désactivez les anciens modules Gestes du trackpad et Clic du milieu dans Modules."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始できない場合は、「プラグイン」で古いトラックパッドジェスチャーとミドルクリックを更新するか無効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여전히 시작할 수 없으면 플러그인에서 이전 트랙패드 제스처와 가운데 클릭 패키지를 업데이트하거나 비활성화하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ainda não conseguir iniciar, atualize ou desative os pacotes antigos de Gestos do trackpad e Clique do meio em Plugins."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если запуск по-прежнему невозможен, обновите или отключите старые пакеты жестов трекпада и средней кнопки мыши в разделе «Плагины»."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若仍無法開始，請在「外掛」中更新或停用舊版觸控板手勢和模擬滑鼠中鍵。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hâlâ başlatamıyorsanız Eklentiler bölümünde eski İzleme Dörtgeni Hareketleri ve Orta Tıklama paketlerini güncelleyin veya devre dışı bırakın."
          }
        }
      }
    },
    "inputSharing.notice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Middle Click and Trackpad Gestures pause while weighing. After capture or stopping, lift all fingers to resume."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "称重时暂停「中键点击」和「触控板手势」。记录或停止后，抬起全部手指即可恢复。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Middle Click und Trackpad-Gesten pausieren beim Wiegen. Nach dem Erfassen oder Stoppen alle Finger anheben, um sie fortzusetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clic central y Gestos del trackpad se pausan al pesar. Tras capturar o detener, levanta todos los dedos para reanudarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clic central et Gestes du trackpad sont suspendus pendant la pesée. Après la capture ou l’arrêt, levez tous les doigts pour les réactiver."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique do meio e Gestos do trackpad pausam durante a pesagem. Após capturar ou parar, levante todos os dedos para retomá-los."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Средний щелчок и Жесты трекпада приостанавливаются при взвешивании. После фиксации или остановки уберите все пальцы, чтобы возобновить их."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "計量中は「中クリック」と「トラックパッドジェスチャ」が一時停止します。記録または停止後、すべての指を離すと再開します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "측정 중에는 중간 클릭과 트랙패드 제스처가 일시 중지됩니다. 기록하거나 중지한 후 모든 손가락을 떼면 재개됩니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "稱重時暫停「中鍵點擊」和「觸控板手勢」。記錄或停止後，抬起全部手指即可恢復。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتوقف النقر الأوسط وإيماءات لوحة التعقب مؤقتًا أثناء الوزن. بعد تسجيل القراءة أو الإيقاف، ارفع جميع أصابعك لاستئنافهما."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartım sırasında Orta Tıklama ve İzleme Dörtgeni Hareketleri duraklatılır. Kaydettikten veya durdurduktan sonra devam etmek için tüm parmaklarınızı kaldırın."
          }
        }
      }
    },
    "reading.accuracyWarning": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For reference only. Estimates may be inaccurate, even after calibration."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅供参考。即使校准后，估算仍可能不准确。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur zur Orientierung. Schätzwerte können auch nach der Kalibrierung ungenau sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo como referencia. Las estimaciones pueden ser inexactas, incluso después de calibrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À titre indicatif uniquement. Les estimations peuvent être inexactes, même après étalonnage."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas como referência. As estimativas podem ser imprecisas, mesmo após a calibração."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только для справки. Оценки могут быть неточными даже после калибровки."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参考値です。校正後でも推定値が不正確な場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "참고용입니다. 보정 후에도 추정값이 부정확할 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅供參考。即使校準後，估算仍可能不準確。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للاسترشاد فقط. قد تكون التقديرات غير دقيقة، حتى بعد المعايرة."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca referans içindir. Tahminler kalibrasyondan sonra bile hatalı olabilir."
          }
        }
      }
    }
  },
  "version": "1.0"
}
