    "state.autoTaring": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-taring. Hold your finger steady with no object on the trackpad."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在自动归零，请保持手指平稳，勿放物件。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatische Tarierung. Halten Sie den Finger ruhig und legen Sie keinen Gegenstand auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tara automática en curso. Mantén el dedo quieto y el trackpad sin objetos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tare automatique en cours. Gardez le doigt immobile, sans objet sur le trackpad."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tara automática em andamento. Mantenha o dedo parado, sem nenhum objeto no trackpad."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматическое обнуление. Держите палец неподвижно, без предмета на трекпаде."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動ゼロ設定中です。物を置かず、指を動かさずに保持してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 영점 조정 중입니다. 물체를 올리지 말고 손가락을 움직이지 마세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在自動歸零，請保持手指平穩，勿放物件。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ التصفير التلقائي. ثبّت إصبعك دون جسم على لوحة التتبع."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik sıfırlanıyor. Trackpad üzerinde nesne yokken parmağınızı sabit tutun."
          }
        }
      }
    },
    "reading.title": {
      "localizations": {
