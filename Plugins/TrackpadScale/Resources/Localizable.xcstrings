            "value": "Сбросить"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "校正をリセット"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보정 초기화"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重置校準"
          }
        },
        "ar": {
