    "state.noContact": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove the object and keep one finger lightly touching the trackpad."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请移开物件，保持一根手指轻触触控板。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernen Sie den Gegenstand und berühren Sie das Trackpad leicht mit einem Finger."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retira el objeto y mantén un dedo apoyado suavemente en el trackpad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirez l’objet et gardez un doigt légèrement posé sur le trackpad."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Remova o objeto e mantenha um dedo tocando levemente o trackpad."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уберите предмет и легко касайтесь трекпада одним пальцем."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "物を取り除き、指1本でトラックパッドに軽く触れ続けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물체를 치우고 손가락 하나로 트랙패드를 가볍게 터치하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請移開物件，保持一根手指輕觸觸控板。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أزِل الجسم وأبقِ إصبعًا واحدًا يلامس لوحة التتبع برفق."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nesneyi kaldırın ve trackpad’e bir parmağınızla hafifçe dokunmaya devam edin."
          }
        }
      }
    },
    "state.multipleContacts": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Multiple contacts detected. Keep only one finger and tare again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测到多个触点。请只保留一根手指，然后重新归零。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehrere Kontakte erkannt. Lassen Sie nur einen Finger aufliegen und tarieren Sie erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se detectaron varios contactos. Deja solo un dedo y vuelve a tarar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plusieurs contacts détectés. Gardez un seul doigt et tarez à nouveau."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vários contatos detectados. Mantenha apenas um dedo e tare novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обнаружено несколько касаний. Оставьте один палец и снова обнулите показания."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数の接触を検出しました。指を1本だけにして、再度ゼロ設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러 접촉이 감지되었습니다. 손가락 하나만 유지하고 영점을 다시 조정하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "偵測到多個觸點。請只保留一根手指，然後重新歸零。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم اكتشاف عدة نقاط لمس. أبقِ إصبعًا واحدًا فقط وصفّر مجددًا."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birden fazla temas algılandı. Yalnızca bir parmak bırakın ve yeniden sıfırlayın."
          }
        }
      }
    },
    "state.needsTare": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove the object and restart, or hold your finger steady and press ⌘T to tare."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请移开物件并重新开始，或保持手指平稳按 ⌘T 归零。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernen Sie den Gegenstand und starten Sie neu, oder halten Sie den Finger ruhig und drücken Sie ⌘T zum Tarieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retira el objeto y reinicia, o mantén el dedo quieto y pulsa ⌘T para tarar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirez l’objet et redémarrez, ou gardez le doigt immobile et appuyez sur ⌘T pour faire la tare."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Remova o objeto e reinicie, ou mantenha o dedo parado e pressione ⌘T para tarar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уберите предмет и начните заново либо держите палец неподвижно и нажмите ⌘T для обнуления."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "物を取り除いて再開するか、指を動かさずに ⌘T を押してゼロ設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물체를 치우고 다시 시작하거나, 손가락을 움직이지 않고 ⌘T를 눌러 영점을 조정하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請移開物件並重新開始，或保持手指平穩按 ⌘T 歸零。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أزِل الجسم وابدأ مجددًا، أو ثبّت إصبعك واضغط ⌘T لتصفير القراءة."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nesneyi kaldırıp yeniden başlatın ya da parmağınızı sabit tutup sıfırlamak için ⌘T’ye basın."
          }
        }
      }
    },
    "state.measuring": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready for a small object. Keep finger position and pressure unchanged; the estimate is for reference only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已就绪，可轻放小物件。保持手指位置和力度不变；读数仅供参考。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereit für einen kleinen Gegenstand. Halten Sie Fingerposition und Druck unverändert; die Schätzung dient nur als Richtwert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Listo para un objeto pequeño. Mantén la posición y presión del dedo; la estimación es solo orientativa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prêt pour un petit objet. Gardez la position et la pression du doigt constantes ; l’estimation est uniquement indicative."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pronto para um objeto pequeno. Mantenha a posição e a pressão do dedo; a estimativa é apenas uma referência."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно положить небольшой предмет. Не меняйте положение пальца и давление; оценка носит справочный характер."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小物を置けます。指の位置と力を変えずに保持してください。推定値は参考用です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작은 물체를 올려도 됩니다. 손가락의 위치와 압력을 유지하세요. 추정치는 참고용입니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已就緒，可輕放小物件。保持手指位置和力度不變；讀數僅供參考。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جاهز لجسم صغير. حافظ على موضع الإصبع والضغط؛ التقدير للاستئناس فقط."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Küçük bir nesne için hazır. Parmağınızın konumunu ve basıncını değiştirmeyin; tahmin yalnızca referans içindir."
          }
        }
      }
    },
    "state.invalidSample": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid pressure reading. Lightly touch again and tare."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "压力读数无效。请重新轻触并归零。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungültiger Druckwert. Berühren Sie das Trackpad erneut leicht und tarieren Sie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lectura de presión no válida. Vuelve a tocar suavemente y tara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesure de pression invalide. Touchez à nouveau légèrement et tarez."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitura de pressão inválida. Toque levemente novamente e tare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недопустимые показания давления. Снова легко коснитесь трекпада и обнулите показания."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "圧力値が無効です。再度軽く触れ、ゼロ設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유효하지 않은 압력 값입니다. 다시 가볍게 터치하고 영점을 조정하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "壓力讀數無效。請重新輕觸並歸零。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قراءة الضغط غير صالحة. المس برفق مجددًا وصفّر القراءة."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçersiz basınç okuması. Yeniden hafifçe dokunun ve sıfırlayın."
          }
        }
      }
    },
    "state.interrupted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Session interrupted. Remove the object and start again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话已中断。请移开物件并重新开始。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitzung unterbrochen. Entfernen Sie den Gegenstand und starten Sie erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesión interrumpida. Retira el objeto y vuelve a iniciar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Session interrompue. Retirez l’objet et recommencez."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessão interrompida. Remova o objeto e inicie novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеанс прерван. Уберите предмет и начните заново."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションが中断されました。物を取り除いて再開してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션이 중단되었습니다. 물체를 치우고 다시 시작하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作階段已中斷。請移開物件並重新開始。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقطعت الجلسة. أزِل الجسم وابدأ مجددًا."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturum kesildi. Nesneyi kaldırıp yeniden başlatın."
          }
        }
      }
    },
