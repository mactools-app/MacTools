          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При открытой калибровке автофиксация приостановлена."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "校正を開いている間は自動記録を一時停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보정이 열려 있는 동안 자동 기록이 일시 중지됩니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "展開校準時暫停自動記錄。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التسجيل التلقائي متوقف مؤقتًا أثناء فتح المعايرة."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalibrasyon açıkken otomatik kayıt duraklatılır."
          }
        }
      }
    },
