    "autoCapture.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Captures after about two seconds of stability above baseline noise (at least 2 g), then stops sampling. Paused while Calibration is open."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重量超过基线波动且至少为 2 g，稳定约两秒后自动记录并停止。展开校准时暂停自动记录。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasst nach etwa zwei Sekunden Stabilität oberhalb des Grundrauschens (mindestens 2 g) und beendet die Messung. Bei geöffneter Kalibrierung pausiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Captura tras unos dos segundos de estabilidad por encima del ruido de base (al menos 2 g) y detiene la medición. Se pausa mientras Calibración está abierta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture après environ deux secondes de stabilité au-dessus du bruit de base (au moins 2 g), puis arrête la mesure. En pause lorsque l’étalonnage est ouvert."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Captura após cerca de dois segundos de estabilidade acima do ruído de base (pelo menos 2 g) e para a medição. Pausada enquanto Calibração está aberta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фиксирует вес после примерно двух секунд стабильности выше фоновых колебаний (не менее 2 г) и останавливает измерение. При открытой калибровке приостановлена."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "基準の変動を超える重量（2 g以上）が約2秒安定すると記録し、測定を停止します。校正を開いている間は一時停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기준 변동보다 큰 무게(최소 2 g)가 약 2초 동안 안정되면 기록하고 측정을 멈춥니다. 보정이 열려 있으면 일시 중지됩니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重量超過基線波動且至少為 2 g，穩定約兩秒後自動記錄並停止。展開校準時暫停自動記錄。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسجّل بعد نحو ثانيتين من الاستقرار فوق تقلبات خط الأساس (2 g على الأقل)، ثم يوقف القياس. يتوقف مؤقتًا أثناء فتح المعايرة."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlangıç dalgalanmasının üzerindeki ağırlık (en az 2 g) yaklaşık iki saniye sabit kaldığında kaydeder ve ölçümü durdurur. Kalibrasyon açıkken duraklatılır."
          }
        }
      }
    },
    "autoCapture.paused": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto capture is paused while Calibration is open."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "展开校准时暂停自动记录。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatische Erfassung pausiert bei geöffneter Kalibrierung."
          }
        },
        "es": {
          "stringUnit": {
