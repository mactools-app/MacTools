    "settings.guide.credentials.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نظرة R2 العامة ← Account Details، ثم اختر Manage بجوار API Tokens. أنشئ Account API token أو User API token واختر صلاحية Object Read & Write. بعد الإنشاء، انسخ Access Key ID وSecret Access Key؛ فلن يظهر المفتاح السري إلا مرة واحدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "R2-Übersicht → Account Details. Wählen Sie neben API Tokens die Option Manage. Erstellen Sie ein Account API token oder User API token und wählen Sie die Berechtigung Object Read & Write. Kopieren Sie anschließend Access Key ID und Secret Access Key; der geheime Schlüssel wird nur einmal angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "R2 Overview → Account Details. Select Manage next to API Tokens. Create an Account API token or User API token and choose the Object Read & Write permission. After creating the token, copy the Access Key ID and Secret Access Key; the secret is shown only once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista general de R2 → Account Details. Selecciona Manage junto a API Tokens. Crea un Account API token o User API token y elige el permiso Object Read & Write. Después de crear el token, copia la Access Key ID y la Secret Access Key; el secreto solo se muestra una vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vue d’ensemble R2 → Account Details. Sélectionnez Manage en regard de API Tokens. Créez un Account API token ou un User API token, puis choisissez l’autorisation Object Read & Write. Après la création du jeton, copiez l’Access Key ID et la Secret Access Key ; le secret ne s’affiche qu’une seule fois."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "R2 Overview → Account Details で、API Tokens の横にある Manage を選択します。Account API token または User API token を作成し、Object Read & Write 権限を選択します。作成後、Access Key ID と Secret Access Key をコピーしてください。シークレットは一度しか表示されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "R2 Overview → Account Details에서 API Tokens 옆의 Manage를 선택합니다. Account API token 또는 User API token을 생성하고 Object Read & Write 권한을 선택합니다. 생성 후 Access Key ID와 Secret Access Key를 복사하십시오. 비밀 키는 한 번만 표시됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Visão geral do R2 → Account Details. Selecione Manage ao lado de API Tokens. Crie um Account API token ou User API token e escolha a permissão Object Read & Write. Depois de criar o token, copie a Access Key ID e a Secret Access Key; o segredo é exibido apenas uma vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обзор R2 → Account Details. Нажмите Manage рядом с API Tokens. Создайте Account API token или User API token и выберите разрешение Object Read & Write. После создания токена скопируйте Access Key ID и Secret Access Key; секретный ключ отображается только один раз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "R2 Overview → Account Details. API Tokens'un yanındaki Manage'yi seçin. Account API token veya User API token oluşturup Object Read & Write iznini seçin. Token'ı oluşturduktan sonra Access Key ID ve Secret Access Key'i kopyalayın; secret yalnızca bir kez gösterilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "R2 概览 → 账户详情，在 API Token 旁点“管理”。创建账户或用户 API Token，并选择“对象读和写”。创建后复制 Access Key ID 和 Secret Access Key；Secret 仅显示一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "R2 概覽 → 帳戶詳細資料，在 API Token 旁按一下「管理」。建立帳戶或使用者 API Token，並選擇「物件讀取和寫入」。建立後複製 Access Key ID 和 Secret Access Key；Secret 僅顯示一次。"
          }
        }
      }
    },
