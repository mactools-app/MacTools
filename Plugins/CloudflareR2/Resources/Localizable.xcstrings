        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オブジェクトパスのプレフィックスに「.」または「..」は使用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "객체 경로 접두사에는 '.' 또는 '..'을 포함할 수 없습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O prefixo do caminho do objeto não pode conter \".\" nem \"..\"."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Префикс пути объекта не может содержать «.» или «..»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nesne yolu öneki \".\" veya \"..\" içeremez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对象路径前缀不能包含“.”或“..”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "物件路徑前綴不可包含「.」或「..」。"
          }
        }
      }
    },
