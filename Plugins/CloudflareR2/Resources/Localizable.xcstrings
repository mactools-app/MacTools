    "settings.guide.bucket.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لوحة Cloudflare ← تخزين كائنات R2. يظهر اسم الـ Bucket في قائمة الحاويات، ويظهر Account ID في معلومات الحساب ضمن نظرة R2 العامة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare-Dashboard → R2 Object Storage. Den Bucket-Namen finden Sie in der Bucket-Liste und die Account ID in den Kontoinformationen der R2-Übersicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Dashboard → R2 Object Storage. Find the Bucket name in the bucket list and the Account ID in the account information on the R2 Overview page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel de Cloudflare → Almacenamiento de objetos R2. El nombre del Bucket aparece en la lista de buckets y el Account ID, en la información de la cuenta de la vista general de R2."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tableau de bord Cloudflare → Stockage d’objets R2. Le nom du Bucket figure dans la liste des buckets et l’Account ID dans les informations du compte de la vue d’ensemble R2."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare ダッシュボード → R2 Object Storage。Bucket 名はバケット一覧、Account ID は R2 Overview のアカウント情報に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare 대시보드 → R2 Object Storage. Bucket 이름은 버킷 목록에서, Account ID는 R2 Overview의 계정 정보에서 확인할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Painel da Cloudflare → Armazenamento de objetos R2. O nome do Bucket fica na lista de buckets e o Account ID, nas informações da conta na visão geral do R2."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Панель Cloudflare → Хранилище объектов R2. Имя Bucket указано в списке бакетов, а Account ID — в сведениях об учетной записи на странице обзора R2."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Dashboard → R2 Object Storage. Bucket adını bucket listesinde, Account ID'yi R2 Overview sayfasındaki hesap bilgilerinde bulabilirsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare 控制台 → R2 对象存储；Bucket 名称来自存储桶列表，Account ID 位于 R2 概览的账户信息中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare 控制台 → R2 物件儲存空間；Bucket 名稱位於儲存貯體列表，Account ID 位於 R2 概覽的帳戶資訊中。"
          }
        }
      }
    },
