    "validation.objectPrefix": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن أن تحتوي بادئة الكائن على مقطع مسار باسم «.» أو «..»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Objektpräfix darf keine Pfadsegmente namens „.“ oder „..“ enthalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The object prefix cannot contain path segments named \".\" or \"..\"."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El prefijo de objeto no puede contener segmentos de ruta llamados «.» ni «..»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le préfixe d’objet ne peut pas contenir de segments de chemin nommés « . » ou « .. »."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オブジェクトプレフィックスに「.」または「..」というパス要素は使用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "객체 접두사에는 '.' 또는 '..' 경로 세그먼트를 포함할 수 없습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O prefixo do objeto não pode conter segmentos de caminho chamados \".\" nem \"..\"."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Префикс объекта не может содержать сегменты пути «.» или «..»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nesne öneki \".\" veya \"..\" adlı yol bölümleri içeremez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对象前缀不能包含名为“.”或“..”的路径段。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "物件前綴不可包含名為「.」或「..」的路徑區段。"
          }
        }
      }
    },
