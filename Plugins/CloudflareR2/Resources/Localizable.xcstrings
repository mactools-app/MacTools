    "settings.guide.publicURL.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Bucket ← Settings ← Custom Domains، أو فعّل عنوان التطوير r2.dev. أدخل عنوان الجذر كاملاً متضمناً https://."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bucket → Settings → Custom Domains. Alternativ können Sie die r2.dev-Entwicklungs-URL aktivieren. Geben Sie die Stamm-URL einschließlich https:// ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bucket → Settings → Custom Domains, or enable the r2.dev development URL. Enter the root URL, including https://."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bucket → Settings → Custom Domains, o activa la URL de desarrollo de r2.dev. Introduce la URL raíz, incluido https://."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bucket → Settings → Custom Domains, ou activez l’URL de développement r2.dev. Saisissez l’URL racine, avec https://."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bucket → Settings → Custom Domains、または r2.dev 開発 URL を有効にします。https:// を含むルート URL を入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bucket → Settings → Custom Domains에서 설정하거나 r2.dev 개발 URL을 활성화합니다. https://를 포함한 루트 URL을 입력하십시오."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bucket → Settings → Custom Domains, ou ative a URL de desenvolvimento r2.dev. Insira a URL raiz, incluindo https://."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Bucket → Settings → Custom Domains либо включите адрес для разработки r2.dev. Укажите корневой URL, включая https://."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bucket → Settings → Custom Domains veya r2.dev geliştirme adresini etkinleştirin. https:// dahil kök adresi girin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bucket → 设置 → 自定义域，或启用 r2.dev 开发地址；填写包含 https:// 的根地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bucket → 設定 → 自訂網域，或啟用 r2.dev 開發網址；填寫包含 https:// 的根網址。"
          }
        }
      }
    },
