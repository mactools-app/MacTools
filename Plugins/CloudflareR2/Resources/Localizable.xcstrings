    "error.objectPrefix.invalid": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن أن تحتوي بادئة مسار الكائن على «.» أو «..»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Objektpfadpräfix darf weder „.“ noch „..“ enthalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The object path prefix cannot contain \".\" or \"..\"."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El prefijo de la ruta del objeto no puede contener «.» ni «..»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le préfixe du chemin d’objet ne peut pas contenir « . » ni « .. »."
