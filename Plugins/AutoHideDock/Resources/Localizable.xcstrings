{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "action.hide.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إخفاء Dock"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock ausblenden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide Dock"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar el Dock"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer le Dock"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dockを隠す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock 숨기기"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar Dock"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрыть Dock"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock'ı Gizle"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏程序坞"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱藏程式塢"
          }
        }
      }
    },
    "action.show.title": {
