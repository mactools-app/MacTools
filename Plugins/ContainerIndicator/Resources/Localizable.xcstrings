    "settings.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرض وإدارة خدمة container والحاويات والأجهزة الافتراضية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dienst, Container und virtuelle Maschinen von container überwachen und verwalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitor and manage the container service, containers, and virtual machines."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Supervisa y gestiona el servicio container, los contenedores y las máquinas virtuales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Surveillez et gérez le service container, les conteneurs et les machines virtuelles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "container サービス、コンテナ、仮想マシンを監視および管理します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "container 서비스, 컨테이너, 가상 머신을 모니터링하고 관리합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitore e gerencie o serviço container, os contêineres e as máquinas virtuais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наблюдение и управление службой container, контейнерами и виртуальными машинами."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "container hizmetini, konteynerleri ve sanal makineleri izleyin ve yönetin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "监控并管理 container 服务、容器与虚拟机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "監控並管理 container 服務、容器與虛擬機。"
          }
        }
      }
    },
