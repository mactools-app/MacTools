    "settings.terminal.footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُعرض التطبيقات المثبّتة فقط. يفتح Ghostty وiTerm علامة تبويب جديدة في النافذة الحالية؛ وتتبع الطرفيات الأخرى سلوكها الخاص."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden nur installierte Terminals angezeigt. Ghostty und iTerm öffnen einen neuen Tab im vorhandenen Fenster; andere Terminals folgen ihrem eigenen Verhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only installed terminals are listed. Ghostty and iTerm open a new tab in the existing window; other terminals follow their own behavior."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se muestran las terminales instaladas. Ghostty e iTerm abren una pestaña nueva en la ventana existente; las demás terminales siguen su propio comportamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les terminaux installés sont affichés. Ghostty et iTerm ouvrent un nouvel onglet dans la fenêtre existante ; les autres terminaux suivent leur propre comportement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール済みのターミナルのみ表示されます。Ghostty と iTerm は既存のウインドウに新しいタブを開き、その他のターミナルは各アプリの動作に従います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치된 터미널만 표시됩니다. Ghostty와 iTerm은 기존 창에 새 탭을 열고, 다른 터미널은 각자의 동작을 따릅니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas os terminais instalados são listados. Ghostty e iTerm abrem uma nova aba na janela existente; os demais terminais seguem o próprio comportamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показаны только установленные терминалы. Ghostty и iTerm открывают новую вкладку в существующем окне; остальные терминалы работают по-своему."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca yüklü terminaller listelenir. Ghostty ve iTerm mevcut pencerede yeni bir sekme açar; diğer terminaller kendi davranışlarını izler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅列出已安装的终端应用。Ghostty 和 iTerm 会在现有窗口中新建标签页，其他终端由各自行为决定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅列出已安裝的終端機應用程式。Ghostty 和 iTerm 會在現有視窗中新增標籤頁，其他終端機依各自行為開啟。"
          }
        }
      }
    },
