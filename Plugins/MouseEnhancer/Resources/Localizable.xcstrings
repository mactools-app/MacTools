    "settings.trackpad.scrollStep.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أقصر مسافة لكل تمريرة على لوحة اللمس؛ يتم رفع التمريرات الصغيرة جداً إلى هذه الخطوة. 0 يعني عدم التعديل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kürzester Abstand pro Trackpad-Bildlauf; kleinere Schritte werden auf diesen Wert angehoben. 0 belässt das Standardverhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shortest distance per trackpad scroll tick; smaller ticks are raised to this step. 0 keeps the default behavior."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Distancia mínima por pulsación de desplazamiento del trackpad; los desplazamientos demasiado pequeños se aumentan a este paso. 0 mantiene el comportamiento predeterminado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Distance minimale par crément de défilement du trackpad ; les créments trop petits sont ramenés à ce pas. 0 conserve le comportement par défaut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トラックパッドの1回の最小スクロール距離。小さすぎるスクロールはこのステップまで引き上げられます。0で調整しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트랙패드 스크롤 한 번의 최소 거리입니다. 너무 작은 스크롤은 이 단계까지 올려집니다. 0이면 조정하지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Distância mínima por toque de rolagem do trackpad; rolagens muito pequenas são elevadas a este passo. 0 mantém o comportamento padrão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Минимальное расстояние за один шаг прокрутки на трекпаде; слишком малые прокрутки увеличиваются до этого шага. 0 — не изменять."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trackpad kaydırmasında her adım için en kısa mesafe; daha küçük kaydırmalar bu adıma tamamlanır. 0 değeri varsayılan davranışı korur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触控板每次滚动的最短距离，过小的滚动会被补足到该步长，0 为不调整。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "觸控板每次滾動的最短距離，過小的滾動會被補足到該步長，0 為不調整。"
          }
        }
      }
    },
