    "panel.subtitle.needsAccessibility": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مطلوب إذن الوصول قبل التمكين"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor der Aktivierung ist eine Zugriffsberechtigung erforderlich"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility permission required before enabling"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere permiso de accesibilidad antes de habilitar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisation d'accessibilité requise avant l'activation"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にする前にアクセシビリティ権限が必要です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성화하려면 접근성 권한이 필요합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permissão de acessibilidade necessária antes de ativar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед включением требуется разрешение на доступность"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkinleştirmeden önce Erişilebilirlik izni gerekli"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用前需要辅助功能授权"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用前需要輔助使用授權"
          }
        }
      }
    },
