    "settings.trackpad.horizontal.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عكس لوحة التتبع اليسرى واليمنى وتمرير Magic Mouse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertauschen Sie das Scrollen mit dem linken und rechten Trackpad und der Magic Mouse."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reverse left and right trackpad and Magic Mouse scrolling."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invierte el desplazamiento del trackpad izquierdo y derecho y del Magic Mouse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inversez le trackpad gauche et droit et le défilement de la Magic Mouse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左右のトラックパッドと Magic Mouse のスクロールを反転します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왼쪽 및 오른쪽 트랙패드 반전 및 Magic Mouse 스크롤."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Trackpad reverso para a esquerda e para a direita e rolagem do Magic Mouse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поменяйте местами прокрутку левого и правого трекпада и прокрутку Magic Mouse."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trackpad ve Magic Mouse'un sola ve sağa kaydırma yönünü tersine çevirir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "反转触控板和 Magic Mouse 左右滚动方向。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "反轉觸控板和 Magic Mouse 左右滾動方向。"
          }
        }
      }
    },
