    "permission.inputMonitoring.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يميز تمرير عجلة الماوس عن إيماءات لوحة التتبع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterscheidet das Scrollen mit dem Mausrad von Trackpad-Gesten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Distinguishes mouse wheel scrolling from trackpad gestures."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Distingue el desplazamiento de la rueda del mouse de los gestos del trackpad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Distingue le défilement de la molette de la souris des gestes du trackpad."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マウスホイールのスクロールとトラックパッドのジェスチャを区別します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마우스 휠 스크롤과 트랙패드 동작을 구별합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Distingue a rolagem da roda do mouse dos gestos do trackpad."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отличает прокрутку колесика мыши от жестов трекпада."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fare tekerleği kaydırmaları ile Trackpad hareketlerini ayırt eder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于区分鼠标滚轮和触控板手势。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於區分滑鼠滾輪和觸控板手勢。"
          }
        }
      }
    },
