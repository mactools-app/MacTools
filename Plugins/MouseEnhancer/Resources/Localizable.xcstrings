          "stringUnit": {
            "state": "translated",
            "value": "트랙패드 탭을 중간 클릭으로 전환합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Transforme os toques do trackpad em cliques intermediários."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Превратите касания трекпада в щелчки средней кнопкой мыши."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trackpad dokunuşlarını orta tıklamaya dönüştürür."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触控板轻点模拟鼠标中键点击。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "觸控板輕點模擬滑鼠中鍵點按。"
          }
        }
      }
    },
    "settings.middleClick.fingerCount.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على لوحة التتبع بالعدد المحدد من الأصابع لإرسال نقرة متوسطة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie mit der ausgewählten Anzahl von Fingern auf das Trackpad, um einen Mittelklick zu senden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the trackpad with the selected number of fingers to send a middle-click."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque el trackpad con la cantidad seleccionada de dedos para enviar un clic central."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur le trackpad avec le nombre de doigts sélectionné pour envoyer un clic du milieu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した数の指でトラックパッドをタップして、中クリックを送信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 개수의 손가락으로 트랙패드를 탭하여 가운데 클릭을 보냅니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no trackpad com o número selecionado de dedos para enviar um clique do meio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь трекпада выбранным количеством пальцев, чтобы отправить средний щелчок."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orta tıklama göndermek için Trackpad'e seçili sayıda parmakla dokunun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用指定数量的手指在触控板上轻点，将模拟鼠标中键点击。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用指定數量的手指在觸控板上輕點，將模擬滑鼠中鍵點按。"
          }
        }
      }
    },
