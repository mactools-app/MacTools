    "settings.mouse.scrollGain.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مُعامل يُطبَّق على مسافة تمرير الفأرة. 1.0× يعني عدم التعديل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Multiplikator für die Maus-Scrollstrecke. 1.0× belässt das Standardverhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Multiplier applied to mouse scroll distance. 1.0× keeps the default behavior."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Multiplicador aplicado a la distancia de desplazamiento del ratón. 1.0× mantiene el comportamiento predeterminado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Multiplicateur appliqué à la distance de défilement de la souris. 1.0× conserve le comportement par défaut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マウスのスクロール距離に掛かる倍率です。1.0×で調整しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마우스 스크롤 거리에 적용되는 배율입니다. 1.0×이면 조정하지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Multiplicador aplicado à distância de rolagem do mouse. 1.0× mantém o comportamento padrão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Множитель расстояния прокрутки мыши. 1.0× — не изменять."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fare kaydırma mesafesine uygulanan çarpan. 1.0× değeri varsayılan davranışı korur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鼠标滚动距离的增益倍数，1.0× 为不调整。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "滑鼠滾動距離的增益倍數，1.0× 為不調整。"
          }
        }
      }
    },
