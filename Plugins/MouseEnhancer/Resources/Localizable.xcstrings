    "permission.accessibility.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستمع إلى أحداث التمرير ويعدلها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überwacht und ändert Scroll-Ereignisse."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listens for and adjusts scroll events."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escucha y ajusta los eventos de desplazamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écoute et ajuste les événements de défilement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクロールイベントを監視して調整します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크롤 이벤트를 감지하고 조정합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitora e ajusta eventos de rolagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отслеживает и корректирует события прокрутки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydırma etkinliklerini dinler ve düzenler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于监听和调整滚动事件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
