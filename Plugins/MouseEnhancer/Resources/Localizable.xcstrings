    "settings.mouse.smooth.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتحرك عجلة الفأرة بسلاسة بدلاً من القفز خطوة واحدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mausrad scrollt fließend statt ruckweise."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mouse wheel scrolling glides instead of jumping tick by tick."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La rueda del ratón desliza suavemente en lugar de avanzar a saltos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La molette de la souris fait défiler en douceur au lieu de sauter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マウスホイールのスクロールが、一段ずつのジャンプではなく滑らかに動きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마휠 스크롤이 한 칸씩 건너뛰지 않고 부드럽게 이동합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A roda do mouse desliza a rolagem em vez de avançar aos saltos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прокрутка колёсиком мыши идёт плавно, а не рывками."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fare tekerleği kaydırması kademeden kademeye atlamak yerine yumuşak bir şekilde süzülür."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鼠标滚轮滚动改为平滑过渡，而非逐格跳动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "滑鼠滾輪滾動改為平滑過渡，而非逐格跳動。"
          }
        }
      }
    },
