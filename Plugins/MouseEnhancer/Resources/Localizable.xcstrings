    "settings.mouse.scrollStep.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أقصر مسافة لكل نقرة عجلة الفأرة؛ يتم رفع التمريرات الصغيرة جداً إلى هذه الخطوة. 0 يعني عدم التعديل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kürzester Abstand pro Mausrad-Rasterung; kleinere Schritte werden auf diesen Wert angehoben. 0 belässt das Standardverhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shortest distance per mouse wheel tick; smaller ticks are raised to this step. 0 keeps the default behavior."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Distancia mínima por pulsación de la rueda del ratón; los desplazamientos demasiado pequeños se aumentan a este paso. 0 mantiene el comportamiento predeterminado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Distance minimale par crément de molette ; les créments trop petits sont ramenés à ce pas. 0 conserve le comportement par défaut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マウスの1目盛りの最小スクロール距離。小さすぎるスクロールはこのステップまで引き上げられます。0で調整しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마우스 휠 한 칸의 최소 스크롤 거리입니다. 너무 작은 스크롤은 이 단계까지 올려집니다. 0이면 조정하지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Distância mínima por clique da roda do mouse; rolagens muito pequenas são elevadas a este passo. 0 mantém o comportamento padrão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Минимальное расстояние за один шаг колеса мыши; слишком малые прокрутки увеличиваются до этого шага. 0 — не изменять."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fare tekerleğinin her kademesi için en kısa kaydırma mesafesi; daha küçük kaydırmalar bu adıma tamamlanır. 0 değeri varsayılan davranışı korur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鼠标每格滚动的最短距离，过小的滚动会被补足到该步长，0 为不调整。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "滑鼠每格滾動的最短距離，過小的滾動會被補足到該步長，0 為不調整。"
          }
        }
      }
    },
