    },
    "de": {
      "displayName": "Apps beenden",
      "summary": "Wählen Sie laufende Apps aus, die Sie beenden möchten, oder beenden Sie alle auf einmal."
    },
    "en": {
      "displayName": "Quit Apps",
      "summary": "Choose running apps to quit, or quit them all at once."
    },
    "es": {
      "displayName": "Salir de apps",
      "summary": "Elija aplicaciones en ejecución para cerrar o ciérrelas todas a la vez."
    },
    "fr": {
      "displayName": "Quitter les apps",
