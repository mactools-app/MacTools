    },
    "ko": {
      "displayName": "앱 종료",
      "summary": "실행 중인 앱을 선택하여 종료하거나 한 번에 모두 종료하세요."
    },
    "pt": {
      "displayName": "Encerrar apps",
      "summary": "Escolha os aplicativos em execução para encerrar ou feche todos de uma vez."
    },
    "ru": {
      "displayName": "Закрыть приложения",
