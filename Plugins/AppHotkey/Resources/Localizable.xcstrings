    "action.launch.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح التطبيق، أو أخفه إذا كان في المقدمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet die App oder blendet sie aus, wenn sie im Vordergrund ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the application, or hide it when it is frontmost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la aplicación o la oculta si está en primer plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez l’application ou masquez-la si elle est au premier plan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを開き、最前面にある場合は非表示にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 열거나 맨 앞에 있으면 가립니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o aplicativo ou oculte-o se estiver em primeiro plano."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает приложение или скрывает его, если оно на переднем плане."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamayı açar ya da öndeyken gizler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开应用；若应用位于最前方则隐藏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟 App；若 App 位於最前方則隱藏。"
          }
        }
      }
    },
    "action.launch.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فتح التطبيق"
          }
        },
        "de": {
          "stringUnit": {
