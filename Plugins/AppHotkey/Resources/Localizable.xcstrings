          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter „Aktionen & Kurzbefehle“ konfigurieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure in Actions & Shortcuts"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
