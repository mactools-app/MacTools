          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurer dans Actions et raccourcis"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「アクションとショートカット」で設定"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘동작 및 단축키’에서 구성"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure em Ações e Atalhos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настроить в разделе «Действия и сочетания клавиш»"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eylemler ve Kısayollar'da Yapılandır"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前往“操作与快捷键”设置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "前往「操作與快速鍵」設定"
          }
        }
      }
    },
    "metadata.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفاتيح التشغيل السريع للتطبيقات"
