            "state": "translated",
            "value": "Ouvrir l’application"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを開く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 열기"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir aplicativo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть приложение"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamayı Aç"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开应用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟 App"
          }
        }
      }
    },
    "action.unavailable.missing": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التطبيق غير متاح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App ist nicht verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The application is unavailable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La aplicación no está disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’application n’est pas disponible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 사용할 수 없습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O aplicativo não está disponível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение недоступно."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama kullanılamıyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用不可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 無法使用。"
          }
        }
      }
    },
    "action.unavailable.paused": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختصارات التطبيقات متوقفة مؤقتًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App-Kurzbefehle sind pausiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Application shortcuts are paused."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los atajos de aplicaciones están en pausa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les raccourcis d’applications sont en pause."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリのショートカットは一時停止中です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 단축키가 일시 중지되었습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os atalhos de aplicativos estão pausados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сочетания клавиш приложений приостановлены."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama kısayolları duraklatıldı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用快捷键已暂停。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 快速鍵已暫停。"
          }
        }
      }
    },
    "settings.configureInActions": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
