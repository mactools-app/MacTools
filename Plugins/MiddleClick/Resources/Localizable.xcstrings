            "state": "translated",
            "value": "عدد الأصابع"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fingeranzahl"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finger Count"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Número de dedos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombre de doigts"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指の本数"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손가락 수"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Número de dedos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Количество пальцев"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parmak Sayısı"
          }
        },
