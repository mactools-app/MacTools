{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "action.disable.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعطيل النقر بالزر الأوسط"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mittelklick deaktivieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disable Middle Click"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivar clic central"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactiver le clic du milieu"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミドルクリックをオフにする"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가운데 클릭 끄기"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativar clique do meio"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключить средний щелчок"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orta Tıklamayı Devre Dışı Bırak"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭模拟鼠标中键"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉模擬滑鼠中鍵"
          }
        }
      }
    },
    "action.enable.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمكين النقر بالزر الأوسط"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mittelklick aktivieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Middle Click"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activar clic central"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activer le clic du milieu"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミドルクリックをオンにする"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가운데 클릭 켜기"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativar clique do meio"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включить средний щелчок"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orta Tıklamayı Etkinleştir"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启模拟鼠标中键"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟模擬滑鼠中鍵"
          }
        }
      }
    },
    "metadata.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النقر بالزر الأوسط"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mittelklick"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Middle Click"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clic central"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clic du milieu"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミドルクリック"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가운데 클릭"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique do meio"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Средний щелчок"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orta Tıklama"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模拟鼠标中键"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模擬滑鼠中鍵"
          }
        }
      }
    },
    "metadata.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حوّل نقرات لوحة التعقب إلى نقرات بالزر الأوسط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trackpad-Tippen als Mittelklick verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn trackpad taps into middle clicks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierte los toques del trackpad en clics centrales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transformez les touchers du trackpad en clics du milieu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トラックパッドのタップをミドルクリックに変換します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트랙패드 탭을 가운데 클릭으로 전환합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Transforme toques no trackpad em cliques do meio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Преобразуйте касания трекпада в средние щелчки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trackpad dokunuşlarını orta tıklamaya dönüştürün."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触控板轻点 → 模拟鼠标中键"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "觸控板輕點 → 模擬滑鼠中鍵"
          }
        }
      }
    },
    "permission.accessibility.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إمكانية الوصول"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedienungshilfen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesibilidad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibilité"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손쉬운 사용"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Acessibilidade"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Универсальный доступ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişilebilirlik"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能授权"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輔助使用授權"
          }
        }
      }
    },
    "permission.accessibility.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتاج ميزة النقر بالزر الأوسط إلى إذن إمكانية الوصول لإرسال أحداث الماوس."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mittelklick benötigt Zugriff auf die Bedienungshilfen, um Mausereignisse zu senden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Middle Click needs Accessibility permission to send mouse events."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clic central necesita permiso de Accesibilidad para enviar eventos del ratón."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clic du milieu nécessite l’autorisation d’accessibilité pour envoyer des événements de souris."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミドルクリックでマウスイベントを送信するには、アクセシビリティ権限が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가운데 클릭으로 마우스 이벤트를 보내려면 손쉬운 사용 권한이 필요합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique do meio precisa da permissão de Acessibilidade para enviar eventos do mouse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для отправки событий мыши функции среднего щелчка требуется доступ к Универсальному доступу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orta Tıklama, fare olayları göndermek için Erişilebilirlik izni gerektirir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模拟鼠标中键需要辅助功能权限才能正常工作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模擬滑鼠中鍵需要輔助使用權限才能正常工作。"
          }
        }
      }
    },
    "permission.accessibility.footnote": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح إعدادات النظام ← الخصوصية والأمان ← إمكانية الوصول، ثم اسمح لـ MacTools."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Systemeinstellungen → Datenschutz & Sicherheit → Bedienungshilfen und erlaube MacTools den Zugriff."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open System Settings → Privacy & Security → Accessibility and allow MacTools."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Ajustes del Sistema → Privacidad y seguridad → Accesibilidad y permite MacTools."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Réglages Système → Confidentialité et sécurité → Accessibilité, puis autorisez MacTools."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定 → プライバシーとセキュリティ → アクセシビリティで MacTools を許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 → 개인정보 보호 및 보안 → 손쉬운 사용에서 MacTools를 허용하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra Ajustes do Sistema → Privacidade e Segurança → Acessibilidade e permita o MacTools."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте Системные настройки → Конфиденциальность и безопасность → Универсальный доступ и разрешите доступ для MacTools."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Ayarları → Gizlilik ve Güvenlik → Erişilebilirlik'i açın ve MacTools'a izin verin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前往系统设置 → 隐私与安全性 → 辅助功能，授权 MacTools。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "前往系統設定 → 隱私權與安全性 → 輔助使用，授權 MacTools。"
          }
        }
      }
    },
    "error.gestureConflict.format": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم \"%@\" إيماءة النقر هذه. عطّل التعيين المقابل أولاً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Tippgeste wird von „%@“ verwendet. Deaktiviere zuerst die entsprechende Zuordnung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This tap gesture is used by “%@”. Disable the matching mapping first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” usa este gesto de toque. Desactiva primero la asignación correspondiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce geste de toucher est utilisé par « %@ ». Désactivez d’abord l’association correspondante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタップジェスチャは「%@」で使用されています。先に対応する割り当てを無効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 탭 제스처는 “%@”에서 사용 중입니다. 먼저 해당 매핑을 비활성화하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este gesto de toque é usado por “%@”. Desative primeiro o mapeamento correspondente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот жест касания используется в «%@». Сначала отключите соответствующее назначение."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dokunma hareketi “%@” tarafından kullanılıyor. Önce eşleşen eşlemeyi devre dışı bırakın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该轻点手势正由“%@”使用。请先停用对应映射。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此輕點手勢正由「%@」使用。請先停用對應的映射。"
          }
        }
      }
    },
    "error.accessibilityRequired": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب النقر بالزر الأوسط إذن إمكانية الوصول. امنحه أولًا في الإعدادات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mittelklick benötigt Zugriff auf die Bedienungshilfen. Erlaube den Zugriff zuerst in den Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Middle Click requires Accessibility permission. Grant it in Settings first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clic central requiere permiso de Accesibilidad. Concédelo primero en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clic du milieu nécessite l’autorisation d’accessibilité. Accordez-la d’abord dans les réglages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミドルクリックにはアクセシビリティ権限が必要です。先に設定で許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가운데 클릭에는 손쉬운 사용 권한이 필요합니다. 먼저 설정에서 허용하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique do meio requer a permissão de Acessibilidade. Conceda-a primeiro nos Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для среднего щелчка требуется Универсальный доступ. Сначала предоставьте его в настройках."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orta Tıklama, Erişilebilirlik izni gerektirir. Önce Ayarlar'dan izin verin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模拟鼠标中键需要辅助功能权限，请先前往设置完成授权。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模擬滑鼠中鍵需要輔助使用權限，請先前往設定完成授權。"
          }
        }
      }
    },
