          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Comportamento de passar o ponteiro"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поведение при наведении"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üzerine gelme davranışı"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "悬浮行为"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "懸浮行為"
          }
        }
      }
    },
    "settings.footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرّر المؤشر فوق أي جانب من Dynamic Island أو حرّكه لأعلى من أسفله مباشرة لعرض اللوحة؛ ادخل إلى اللوحة لإبقائها ظاهرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fahre über eine Seite der Dynamic Island oder von direkt darunter nach oben, um das Bedienfeld anzuzeigen; bewege den Zeiger in das Bedienfeld, um es sichtbar zu halten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hover either side of the Dynamic Island, or move upward from directly below it, to show the panel; move into the panel to keep it visible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa el puntero por cualquier lado de Dynamic Island o muévelo hacia arriba desde justo debajo para mostrar el panel; entra en el panel para mantenerlo visible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Survolez un côté de Dynamic Island ou remontez depuis juste en dessous pour afficher le panneau ; entrez dans le panneau pour le maintenir visible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Island の左右にポインタを合わせるか、真下から上へ動かすとパネルが表示されます。パネル内に移動すると表示が維持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Island 양옆에 포인터를 올리거나 바로 아래에서 위로 이동하면 패널이 표시됩니다. 패널 안으로 이동하면 계속 표시됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe o ponteiro em qualquer lado do Dynamic Island ou mova-o para cima a partir de baixo dele para mostrar o painel; entre no painel para mantê-lo visível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наведите курсор на любую сторону Dynamic Island или переместите его вверх из-под неё, чтобы показать панель; переместите курсор на панель, чтобы оставить её открытой."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paneli göstermek için imleci Dynamic Island'ın her iki yanına getirin veya hemen altından yukarı doğru hareket ettirin; görünür kalması için panele girin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "悬停灵动岛两侧，或从灵动岛正下方往上移动，即可显示面板；将鼠标移入面板可保持显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "懸停靈動島兩側，或從靈動島正下方往上移動，即可顯示面板；將滑鼠移入面板可保持顯示。"
          }
        }
      }
    },
