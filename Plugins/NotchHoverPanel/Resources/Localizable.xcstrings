            "value": "Tempo de espera antes de o painel ocultar após o ponteiro sair."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время ожидания перед автоматическим скрытием панели после ухода курсора."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İmleç ayrıldıktan sonra panelin otomatik olarak gizlenmesi için beklenecek süre."
          }
        },
        "zh-Hans": {
          "stringUnit": {
