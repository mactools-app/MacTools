        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher le panneau MacTools lorsque le pointeur entre sur un côté de Dynamic Island ou remonte depuis juste en dessous."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポインタが Dynamic Island の左右に入るか、真下から上へ移動すると MacTools パネルを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포인터가 Dynamic Island 양옆으로 들어오거나 바로 아래에서 위로 이동하면 MacTools 패널을 표시합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra o painel do MacTools quando o ponteiro entra em qualquer lado do Dynamic Island ou se move para cima a partir de baixo dele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать панель MacTools, когда курсор попадает на любую сторону Dynamic Island или движется вверх из-под неё."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İmleç Dynamic Island'ın her iki yanına girdiğinde veya hemen altından yukarı doğru hareket ettiğinde MacTools panelini göster."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鼠标移入灵动岛两侧，或从灵动岛正下方往上接近灵动岛时显示 MacTools 面板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "滑鼠移入靈動島兩側，或從靈動島正下方往上接近靈動島時顯示 MacTools 面板。"
          }
        }
      }
    },
    "settings.triggerWidth.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
