    "settings.showDelay.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المدة التي يجب أن يبقى فيها المؤشر قبل ظهور اللوحة لتجنب التشغيل غير المقصود."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartezeit, bevor das Bedienfeld ausfährt, um versehentliche Auslösungen zu vermeiden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How long the pointer must rest before the panel slides out, reducing accidental triggers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiempo que el puntero debe permanecer para que aparezca el panel y evitar activaciones accidentales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durée pendant laquelle le pointeur doit rester pour afficher le panneau, afin d’éviter les déclenchements accidentels."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誤操作を防ぐため、パネルが表示されるまでポインタを置いておく時間。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실수로 실행되지 않도록 패널이 나타나기까지 포인터를 머무는 시간입니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo que o ponteiro deve permanecer antes de o painel aparecer, evitando ativações acidentais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько курсор должен задержаться перед показом панели, чтобы избежать случайных срабатываний."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanlışlıkla tetiklemeyi önlemek için panel açılmadan önce imlecin beklemesi gereken süre."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停留多久后滑出面板，避免误触。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停留多久後滑出面板，避免誤觸。"
          }
        }
      }
    },
