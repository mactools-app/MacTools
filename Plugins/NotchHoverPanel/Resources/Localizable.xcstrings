    "settings.hideDelay.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مدة الانتظار قبل إخفاء اللوحة تلقائيًا بعد مغادرة المؤشر."
          }
        },
        "de": {
