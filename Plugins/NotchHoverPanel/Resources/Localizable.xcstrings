          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait time before the panel hides after the pointer leaves."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiempo de espera antes de ocultar el panel cuando el puntero se aleja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temps d’attente avant que le panneau se masque après le départ du pointeur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポインタが離れてからパネルが自動的に隠れるまでの待ち時間。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포인터가 떠난 뒤 패널이 자동으로 숨겨지기까지 기다리는 시간입니다."
          }
        },
        "pt": {
