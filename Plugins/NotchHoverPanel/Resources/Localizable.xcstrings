            "value": "Varsayılanlara sıfırla"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复默认设置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復預設設定"
          }
        }
      }
    },
    "settings.reset.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستعيد نطاقات التشغيل والتشغيل السفلي والتأخيرات وإعداد رمز شريط القوائم إلى قيمها الأولية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellt Auslösebereiche, die untere Auslösung, Verzögerungen und die Einstellung für das Menüleistensymbol auf die Anfangswerte zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore trigger ranges, the lower trigger, delays, and the menu-bar icon setting to their initial values."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura los rangos de activación, la activación inferior, los retrasos y el ajuste del icono de la barra de menús."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétablit les zones de déclenchement, le déclenchement inférieur, les délais et le réglage de l’icône de la barre des menus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トリガー範囲、下側トリガー、遅延、メニューバーアイコンの設定を初期状態に戻します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트리거 범위, 아래쪽 트리거, 지연 시간 및 메뉴 막대 아이콘 설정을 초기 상태로 되돌립니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura os intervalos de ativação, a ativação inferior, os atrasos e o ajuste do ícone da barra de menus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возвращает диапазоны срабатывания, нижнее срабатывание, задержки и настройку значка в строке меню к исходным значениям."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetikleme aralıklarını, alt tetiklemeyi, gecikmeleri ve menü çubuğu simgesi ayarını ilk değerlerine döndürür."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将触发范围、下方触发、显示延迟和菜单栏图标恢复为初始状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將觸發範圍、下方觸發、顯示延遲和選單列圖示恢復為初始狀態。"
          }
        }
      }
    },
