{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "metadata.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لوحة تحويم Dynamic Island"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic-Island-Schwebepanel"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Island Hover Panel"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel al pasar por Dynamic Island"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Panneau de survol de Dynamic Island"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Island ホバーパネル"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Island 호버 패널"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Painel ao passar no Dynamic Island"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Панель при наведении на Dynamic Island"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Island Üzerine Gelme Paneli"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "灵动岛悬浮面板"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "靈動島懸浮面板"
          }
        }
      }
    },
    "metadata.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أظهر لوحة MacTools عند تمرير المؤشر بجانب Dynamic Island أو التحرك لأعلى من أسفله."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools-Bedienfeld einblenden, wenn der Zeiger neben der Dynamic Island schwebt oder von direkt darunter nach oben bewegt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide out the MacTools panel when the pointer hovers beside the Dynamic Island or moves up from directly below it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra el panel de MacTools al pasar el puntero junto a Dynamic Island o moverlo hacia arriba desde justo debajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichez le panneau MacTools lorsque le pointeur survole le bord de Dynamic Island ou remonte depuis juste en dessous."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポインタを Dynamic Island の横に重ねるか、真下から上へ動かすと MacTools パネルを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포인터를 Dynamic Island 옆에 올리거나 바로 아래에서 위로 이동하면 MacTools 패널을 표시합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostre o painel do MacTools ao passar o ponteiro ao lado do Dynamic Island ou movê-lo para cima a partir de baixo dele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать панель MacTools при наведении курсора рядом с Dynamic Island или движении вверх из-под него."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İmleci Dynamic Island'ın yanına getirdiğinizde veya hemen altından yukarı hareket ettirdiğinizde MacTools panelini gösterin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鼠标悬停灵动岛两侧，或从灵动岛正下方往上移动时滑出 MacTools 面板"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "滑鼠懸停靈動島兩側，或從靈動島正下方往上移動時滑出 MacTools 面板"
          }
        }
      }
    },
