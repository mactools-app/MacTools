            "value": "未偵測到靈動島"
          }
        }
      }
    },
    "settings.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُعيد اللوحة استخدام أحدث لوحة رئيسية وتُخفى تلقائيًا بعد خروج المؤشر من اللوحة ومنطقة Dynamic Island."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet das zuletzt genutzte Hauptbedienfeld und blendet sich automatisch aus, wenn der Zeiger Bedienfeld und Dynamic Island verlässt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reuses the most recent main panel and hides automatically after the pointer leaves both the panel and the Dynamic Island area."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reutiliza el panel principal más reciente y se oculta al salir el puntero del panel y del área de Dynamic Island."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réutilise le panneau principal le plus récent et se masque lorsque le pointeur quitte le panneau et la zone de Dynamic Island."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直近のメインパネルを再利用し、ポインタがパネルと Dynamic Island の領域から離れると自動的に隠れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 최근에 사용한 기본 패널을 재사용하며 포인터가 패널과 Dynamic Island 영역을 벗어나면 자동으로 숨깁니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reutiliza o painel principal mais recente e oculta-se quando o ponteiro sai do painel e da área do Dynamic Island."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использует последнюю основную панель и скрывается, когда курсор покидает панель и область Dynamic Island."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En son kullanılan ana paneli yeniden kullanır ve imleç panel ile Dynamic Island alanından ayrıldığında otomatik olarak gizlenir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "面板沿用最近使用的主面板内容，鼠标离开面板和灵动岛区域后自动收起。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "面板沿用最近使用的主面板內容，滑鼠離開面板和靈動島區域後自動收起。"
          }
        }
      }
    },
    "settings.section": {
      "extractionState": "manual",
