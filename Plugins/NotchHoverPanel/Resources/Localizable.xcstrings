          }
        }
      }
    },
    "settings.verticalTriggerReach.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ارتفاع المنطقة أسفل Dynamic Island مباشرة؛ يؤدي التحرك لأعلى نحوها إلى إظهار اللوحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höhe des Bereichs direkt unter der Dynamic Island; eine Aufwärtsbewegung zur Dynamic Island zeigt das Bedienfeld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Height of the area directly below the Dynamic Island; moving upward toward it shows the panel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Altura del área directamente debajo de Dynamic Island; mover el puntero hacia arriba hacia ella muestra el panel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hauteur de la zone située juste sous Dynamic Island ; remonter vers elle affiche le panneau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Island の真下にある領域の高さです。上へ近づくとパネルが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Island 바로 아래 영역의 높이입니다. 위로 가까이 가면 패널이 표시됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Altura da área diretamente abaixo do Dynamic Island; mover o ponteiro para cima em direção a ele mostra o painel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Высота области непосредственно под Dynamic Island; движение вверх к нему показывает панель."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Island'ın hemen altındaki alanın yüksekliği; ona doğru yukarı hareket etmek paneli gösterir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "灵动岛正下方参与触发的区域高度，向上滑动接近灵动岛时也会显示面板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "靈動島正下方參與觸發的區域高度，向上滑動接近靈動島時也會顯示面板。"
          }
        }
      }
    },
    "settings.showsMenuBarIcon.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار أيقونة شريط القوائم"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Menüleisten-Symbol anzeigen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show Menu Bar Icon"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar icono en la barra de menús"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher l’icône de la barre des menus"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーアイコンを表示"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대 아이콘 표시"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar ícone na barra de menus"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать значок в строке меню"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Menü çubuğu simgesini göster"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示菜单栏图标"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示選單列圖示"
          }
        }
      }
    },
    "settings.showsMenuBarIcon.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوقف هذا الخيار لإخفاء أيقونة MacTools في شريط القوائم؛ افتح اللوحة بتحويم مؤشر الفأرة على Dynamic Island."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deaktivieren, um das MacTools-Symbol in der Menüleiste auszublenden; das Bedienfeld erscheint beim Überfahren der Dynamic Island."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off to hide the MacTools menu bar icon; open the panel by hovering the Dynamic Island."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactívalo para ocultar el icono de MacTools en la barra de menús; abre el panel pasando el puntero por Dynamic Island."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez pour masquer l’icône MacTools de la barre des menus ; ouvrez le panneau en survolant Dynamic Island."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにすると MacTools のメニューバーアイコンを隠します。Dynamic Island にポインタを合わせるとパネルを開けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄면 MacTools 메뉴 막대 아이콘이 숨겨집니다. Dynamic Island에 포인터를 올리면 패널을 열 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative para ocultar o ícone do MacTools na barra de menus; abra o painel passando o ponteiro no Dynamic Island."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключите, чтобы скрыть значок MacTools в строке меню; панель открывается при наведении курсора на Dynamic Island."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools menü çubuğu simgesini gizlemek için kapatın; paneli Dynamic Island üzerine gelerek açabilirsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后隐藏 MacTools 菜单栏图标，可从灵动岛悬浮面板打开面板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉後隱藏 MacTools 選單列圖示，可從靈動島懸浮面板開啟面板。"
          }
        }
      }
    },
    "settings.enableBelowTrigger.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تفعيل التشغيل السفلي"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Untere Auslösung aktivieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Lower Trigger"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activar activación inferior"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activer le déclenchement inférieur"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下側トリガーを有効にする"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래쪽 트리거 사용"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativar ativação inferior"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включить срабатывание снизу"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt tetiklemeyi etkinleştir"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用下方触发"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用下方觸發"
          }
        }
      }
    },
    "settings.enableBelowTrigger.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرض اللوحة أيضًا عند تحريك المؤشر لأعلى من أسفل Dynamic Island مباشرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedienfeld auch anzeigen, wenn der Zeiger von direkt unter der Dynamic Island nach oben bewegt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also show the panel when the pointer moves upward from directly below the Dynamic Island."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También muestra el panel al mover el puntero hacia arriba desde justo debajo de Dynamic Island."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher également le panneau lorsque le pointeur remonte depuis juste sous Dynamic Island."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Island の真下からポインタを上へ動かしたときもパネルを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Island 바로 아래에서 포인터를 위로 움직여도 패널을 표시합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Também mostra o painel ao mover o ponteiro para cima a partir de baixo do Dynamic Island."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Также показывать панель при движении курсора вверх из-под Dynamic Island."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İmleci Dynamic Island'ın hemen altından yukarı hareket ettirdiğinizde de paneli göster."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从灵动岛正下方往上移动时也显示面板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從靈動島正下方往上移動時也顯示面板。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
