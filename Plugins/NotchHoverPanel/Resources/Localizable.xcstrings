          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用靈動島懸浮面板"
          }
        }
      }
    },
    "settings.enabled.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أظهر لوحة MacTools عندما يدخل المؤشر إلى أي جانب من Dynamic Island أو يتحرك لأعلى من أسفله مباشرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools-Bedienfeld anzeigen, wenn der Zeiger eine Seite der Dynamic Island erreicht oder von direkt darunter nach oben bewegt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
