  "actions": {
    "providers": [
      {
        "id": "launchpad",
        "kind": "static",
        "staticActions": [
          {
            "id": "toggleLaunchpad",
            "title": "@productStrings.display-name",
            "description": "@productStrings.summary",
            "keywords": [
              "启动台",
              "打开启动台",
              "Launchpad",
              "launchpad",
              "togglelaunchpad"
            ],
            "systemImage": "square.grid.3x3.fill",
            "parameters": [],
            "permissionIDs": [],
            "risk": "safe",
            "surfaces": [
              "unified-search",
              "global-shortcut",
              "run-link",
              "workflow",
              "action-grid",
              "trackpad-gesture",
              "manual"
            ],
            "automaticEligible": false,
            "externalInvocation": "allowed"
          }
        ],
        "dynamicTemplates": []
      }
    ]
  },
  "preferencesBackup": {
    "status": "partial",
    "exclusions": [
      "application-paths"
    ]
  }
