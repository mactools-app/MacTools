            "value": "繼續"
          }
        }
      }
    },
    "action.externalConfirmation.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيغيّر رابط التشغيل هذا اتصال شاشة Sidecar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Ausführungslink ändert die Verbindung eines Sidecar-Displays."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Run Link will change a Sidecar display connection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este enlace de ejecución cambiará la conexión de una pantalla Sidecar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce lien d’exécution modifiera la connexion d’un écran Sidecar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この実行リンクはSidecarディスプレイの接続を変更します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 실행 링크는 Sidecar 디스플레이 연결을 변경합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta hiperligação de execução irá alterar a ligação de um ecrã Sidecar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта ссылка запуска изменит подключение дисплея Sidecar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Run Link, bir Sidecar ekran bağlantısını değiştirecek."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此运行链接将更改 Sidecar 显示器连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此執行連結將更改 Sidecar 顯示器連線。"
          }
        }
      }
    },
