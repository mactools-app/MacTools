    "panel.error.switchConnectFailed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم قطع اتصال %@، لكن تعذر الاتصال بـ %@: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde getrennt, aber %@ konnte nicht verbunden werden: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ was disconnected, but %@ could not be connected: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se desconectó, pero no se pudo conectar %@: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a été déconnecté, mais %@ n’a pas pu être connecté : %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@との接続は解除されましたが、%@に接続できませんでした: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 연결은 해제되었지만 %@에 연결할 수 없습니다: %@"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ foi desligado, mas não foi possível ligar %@: %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ отключён, но не удалось подключить %@: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bağlantısı kesildi ancak %@ ile bağlantı kurulamadı: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已断开 %@，但无法连接 %@：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已中斷 %@，但無法連線 %@：%@"
          }
        }
      }
    },
    "panel.error.switchDisconnectFailed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر قطع اتصال %@، لذا لا يمكن التبديل إلى %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ konnte nicht getrennt werden; Wechsel zu %@ nicht möglich"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not disconnect %@, so %@ could not be selected"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo desconectar %@, por lo que no se puede cambiar a %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de déconnecter %@, donc le passage à %@ est impossible"
          }
        },
        "ja": {
