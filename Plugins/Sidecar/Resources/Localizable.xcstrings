    "settings.disconnectAll.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفصل فقط الشاشات التي يبلّغ Sidecar أنها متصلة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trennt nur Displays, die Sidecar als verbunden meldet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnects only displays that Sidecar explicitly reports as connected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconecta solo las pantallas que Sidecar informa como conectadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnecte uniquement les écrans que Sidecar signale comme connectés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidecarが接続済みと報告したディスプレイのみ接続解除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidecar가 연결됨으로 보고한 디스플레이만 연결 해제합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliga apenas os ecrãs que o Sidecar indica como ligados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
