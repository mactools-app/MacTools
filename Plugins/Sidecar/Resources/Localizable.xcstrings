    "settings.connectFirstAvailable.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتصل بأول جهاز حسب أولوية الشاشات المتاحة أعلاه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindet das erste Gerät gemäß der Priorität verfügbarer Displays oben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connects the first device in the available-display priority above."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta el primer dispositivo según la prioridad de pantallas disponibles anterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecte le premier appareil selon la priorité des écrans disponibles ci-dessus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上の利用可能なディスプレイの優先順位で最初のデバイスに接続します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위의 사용 가능한 디스플레이 우선순위에서 첫 번째 기기에 연결합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Liga ao primeiro dispositivo na prioridade de ecrãs disponíveis acima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключает первое устройство в заданном выше порядке доступных дисплеев."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yukarıdaki kullanılabilir ekran önceliği listesindeki ilk aygıtı bağlar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按上方的可用显示器优先级连接第一个设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依上方可用顯示器的優先順序連線第一個裝置。"
          }
        }
      }
    },
