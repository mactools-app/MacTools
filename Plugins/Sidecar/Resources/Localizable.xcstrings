    "metadata.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وصّل شاشة متوافقة مع Sidecar قريبة كشاشة ممتدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Sidecar-kompatibles Display in der Nähe als erweiterten Bildschirm verbinden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect a nearby Sidecar-compatible display as an extended display."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta una pantalla compatible con Sidecar cercana como pantalla ampliada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecter un écran compatible avec Sidecar à proximité comme écran étendu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "近くのSidecar対応ディスプレイを拡張ディスプレイとして接続します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "근처의 Sidecar 호환 디스플레이를 확장 디스플레이로 연결합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligue um ecrã compatível com Sidecar por perto como ecrã adicional."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключите ближайший совместимый с Sidecar дисплей как дополнительный экран."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakındaki Sidecar uyumlu bir ekranı genişletilmiş ekran olarak bağlar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接附近可用的 Sidecar 显示器作为扩展显示器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接附近可用的 Sidecar 顯示器作為延伸顯示器"
          }
        }
      }
    },
