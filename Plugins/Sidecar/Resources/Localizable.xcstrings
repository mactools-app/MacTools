    "panel.wired.warning": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طلب اتصال سلكي فقط؛ لا يُطلب الرجوع إلى Wi-Fi"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kabelverbindung angefordert; kein WLAN-Fallback angefordert"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wired connection requested; no Wi-Fi fallback requested"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se solicita conexión por cable; no se solicita Wi-Fi como alternativa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion filaire demandée ; aucun repli Wi‑Fi demandé"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有線接続を要求：Wi‑Fiへのフォールバックは要求しません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유선 연결 요청: Wi-Fi 대체 연결을 요청하지 않음"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligação por cabo solicitada; não é solicitado recurso a Wi-Fi"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрошено проводное подключение; переход на Wi-Fi не запрашивается"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kablolu bağlantı istendi; Wi-Fi yedeği istenmedi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求仅通过有线连接，不请求 Wi-Fi 回退"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要求僅透過有線連線，不要求 Wi-Fi 備援"
          }
        }
      }
    },
    "settings.devices.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى إعدادات الجهاز واختصاراته محفوظة أثناء عدم اتصاله."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen und Kurzbefehle bleiben erhalten, wenn ein Gerät nicht verfügbar ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device settings and shortcuts remain saved while a device is unavailable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ajustes y atajos se conservan aunque el dispositivo no esté disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages et raccourcis restent enregistrés lorsque l’appareil est indisponible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスが利用できない間も、設定とショートカットは保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기를 사용할 수 없어도 설정과 단축키는 저장됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As definições e os atalhos permanecem guardados enquanto o dispositivo não está disponível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки и сочетания клавиш сохраняются, когда устройство недоступно."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir aygıt kullanılamadığında da ayarları ve kısayolları kayıtlı kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备离线时仍会保留它的设置和快捷键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置離線時仍會保留它的設定和快速鍵。"
          }
        }
      }
    },
    "settings.devices.empty.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قرّب الجهاز وافتح قفله، ثم حدّث القائمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring das Gerät in die Nähe, entsperre es und aktualisiere die Liste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring the device nearby, unlock it, then refresh the list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acerca y desbloquea el dispositivo; luego actualiza la lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Approchez et déverrouillez l’appareil, puis actualisez la liste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスを近くに置いてロックを解除し、リストを更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기를 가까이 두고 잠금을 해제한 다음 목록을 새로 고치십시오."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aproxime e desbloqueie o dispositivo e atualize a lista."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расположите устройство рядом, разблокируйте его и обновите список."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aygıtı yakınına getirin, kilidini açın ve listeyi yenileyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请让设备靠近并解锁，然后刷新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請讓裝置靠近並解鎖，然後重新整理。"
          }
        }
      }
    },
