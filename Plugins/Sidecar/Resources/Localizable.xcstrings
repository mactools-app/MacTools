    "panel.error.timeout": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت مهلة العملية. تحقق من الجهاز الهدف والكابل والشبكة، ثم حاول مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitüberschreitung. Prüfe das Zielgerät, Kabel und Netzwerk und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operation timed out. Check the target display, cable, and network, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La operación agotó el tiempo. Comprueba la pantalla de destino, el cable y la red, e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’opération a expiré. Vérifiez l’écran cible, le câble et le réseau, puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "操作がタイムアウトしました。接続先のディスプレイ、ケーブル、ネットワークを確認してからやり直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 시간이 초과되었습니다. 대상 디스플레이, 케이블, 네트워크를 확인한 다음 다시 시도하십시오."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A operação excedeu o tempo limite. Verifique o ecrã de destino, o cabo e a rede e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время ожидания истекло. Проверьте целевой дисплей, кабель и сеть, затем повторите попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlem zaman aşımına uğradı. Hedef ekranı, kabloyu ve ağı kontrol edip yeniden deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作超时，请检查目标显示器、线缆和网络后重试"
          }
