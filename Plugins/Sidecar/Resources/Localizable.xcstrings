    "settings.priority.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب الشاشات المتاحة لتحديد الأولوية المستخدمة عند اتصال أول شاشة متاحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe verfügbare Displays, um die Priorität für „Erstes verfügbares Display verbinden“ festzulegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag available displays to choose the priority used by Connect First Available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra las pantallas disponibles para elegir la prioridad de Conectar la primera disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser les écrans disponibles pour définir la priorité de connexion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用可能なディスプレイをドラッグして、最初に接続する優先順位を設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 가능한 디스플레이를 드래그하여 첫 번째 연결 우선순위를 지정합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste os ecrãs disponíveis para definir a prioridade da primeira ligação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите доступные дисплеи, чтобы задать приоритет первого подключения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk Kullanılabilir Ekranı Bağla işlevinin kullanacağı önceliği belirlemek için kullanılabilir ekranları sürükleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动可用显示器，设置“连接第一个可用显示器”使用的优先级。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移可用顯示器，設定「連線第一個可用顯示器」使用的優先順序。"
          }
        }
      }
