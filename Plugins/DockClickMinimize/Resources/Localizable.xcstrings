    "permission.inputMonitoring.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يراقب النقرات اليسرى دون حجب سلوك Dock الأصلي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beobachtet Linksklicks, ohne das native Dock-Verhalten zu blockieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Observes left clicks without blocking native Dock behavior."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Observa clics izquierdos sin bloquear el comportamiento nativo del Dock."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Observe les clics gauches sans bloquer le comportement natif du Dock."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock本来の動作を妨げずに左クリックを監視します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock의 기본 동작을 막지 않고 왼쪽 클릭을 감지합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Observa cliques com o botão esquerdo sem bloquear o comportamento nativo do Dock."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отслеживает щелчки левой кнопкой, не блокируя стандартное поведение Dock."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel Dock davranışını engellemeden sol tıklamaları gözlemler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于在不阻止原生程序坞点击的情况下监听鼠标左键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在不阻擋 Dock 原生行為的情況下監聽滑鼠左鍵點擊。"
          }
        }
      }
    },
    "permission.inputMonitoring.footnote": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح لـ MacTools في إعدادات النظام > الخصوصية والأمن > مراقبة الإدخال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube MacTools in Systemeinstellungen > Datenschutz & Sicherheit > Eingabeüberwachung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow MacTools in System Settings > Privacy & Security > Input Monitoring."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite MacTools en Ajustes del Sistema > Privacidad y seguridad > Supervisión de entrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez MacTools dans Réglages Système > Confidentialité et sécurité > Surveillance des entrées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定 > プライバシーとセキュリティ > 入力監視でMacToolsを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 > 개인정보 보호 및 보안 > 입력 모니터링에서 MacTools를 허용하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o MacTools em Ajustes do Sistema > Privacidade e Segurança > Monitoramento de Entrada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите MacTools в Системных настройках > Конфиденциальность и безопасность > Мониторинг ввода."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Ayarları > Gizlilik ve Güvenlik > Girdi İzleme bölümünde MacTools'a izin verin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统设置的“隐私与安全性 > 输入监控”中允许 MacTools。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「系統設定」>「隱私權與安全性」>「輸入監控」中允許 MacTools。"
          }
        }
      }
    },
