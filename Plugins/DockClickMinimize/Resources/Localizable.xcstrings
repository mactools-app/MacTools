    "error.startFailed": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر بدء إخفاء التطبيق النشط بالنقر على Dock. تحقق من الأذونات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktive App per Dock-Klick ausblenden konnte nicht gestartet werden. Prüfe die Berechtigungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide Active App on Dock Click could not start. Check its permissions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar Ocultar la app activa al hacer clic en el Dock. Comprueba sus permisos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de démarrer Masquer l’app active par clic dans le Dock. Vérifiez ses autorisations."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DockクリックでアクティブなAppを隠すを開始できませんでした。許可を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock 클릭으로 활성 앱 가리기를 시작할 수 없습니다. 권한을 확인하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível iniciar Ocultar app ativa com clique no Dock. Verifique as permissões."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось запустить скрытие активного приложения щелчком по Dock. Проверьте разрешения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock'a Tıklayınca Etkin Uygulamayı Gizle başlatılamadı. İzinleri denetleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法启动点击程序坞隐藏活跃 App，请检查权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法啟動點擊 Dock 隱藏使用中 App，請檢查權限。"
          }
        }
      }
    }
