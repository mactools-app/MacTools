{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "widget.title": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إخفاء بالنقر"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klick ausblenden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click to Hide"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clic para ocultar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clic pour masquer"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリックで隠す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클릭으로 가리기"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique para ocultar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрыть по клику"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizlemek için tıklayın"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击隐藏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點按隱藏"
          }
        }
      }
    },
    "metadata.title": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إخفاء التطبيق النشط بالنقر على Dock"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktive App per Dock-Klick ausblenden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide Active App on Dock Click"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar la app activa al hacer clic en el Dock"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer l’app active par clic dans le Dock"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DockクリックでアクティブなAppを隠す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock 클릭으로 활성 앱 가리기"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar app ativa com clique no Dock"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрыть активное приложение щелчком по Dock"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock'a Tıklayınca Etkin Uygulamayı Gizle"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击程序坞隐藏活跃 App"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊 Dock 隱藏使用中 App"
          }
        }
      }
    },
    "metadata.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أخفِ التطبيق النشط بالنقر على أيقونته في Dock (كما في Windows)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blendet die aktive App durch Klick auf ihr Dock-Symbol aus (wie unter Windows)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide the active app by clicking its Dock icon (like on Windows)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta la app activa al hacer clic en su icono del Dock (como en Windows)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masque l’app active en cliquant sur son icône dans le Dock (comme sous Windows)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DockのアイコンをクリックしてアクティブなAppを隠します（Windowsと同様）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock 아이콘을 클릭해 활성 앱을 가립니다(Windows처럼)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta o app ativo ao clicar no ícone dele no Dock (como no Windows)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрывает активное приложение щелчком по его значку в Dock (как в Windows)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock simgesine tıklayarak etkin uygulamayı gizleyin (Windows'taki gibi)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击活跃 App 的程序坞图标即可将其隐藏（如 Windows）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊使用中 App 的 Dock 圖示即可將其隱藏（如 Windows）。"
          }
        }
      }
    },
    "panel.subtitle.enabled": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفعّل"
          }
        },
        "de": {
