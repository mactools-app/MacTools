        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輔助使用"
          }
        }
      }
    },
    "permission.accessibility.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحدد تطبيقات Dock ويخفي التطبيق النشط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ermittelt Dock-Apps und blendet die aktive App aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Identifies Dock applications and hides the active application."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Identifica las apps del Dock y oculta la app activa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Identifie les apps du Dock et masque l’app actuellement active."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dockのアプリを識別し、アクティブなアプリを非表示にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock 앱을 식별하고 활성 앱을 가립니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Identifica apps do Dock e oculta o app ativo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Определяет приложения в Dock и скрывает активное приложение."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock uygulamalarını tanır ve etkin uygulamayı gizler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于识别程序坞中的应用，并隐藏当前活跃的应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於辨識 Dock 中的 App，並隱藏目前使用中的 App。"
          }
        }
      }
    },
    "permission.accessibility.footnote": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح لـ MacTools في إعدادات النظام > الخصوصية والأمن > تسهيلات الاستخدام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube MacTools in Systemeinstellungen > Datenschutz & Sicherheit > Bedienungshilfe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow MacTools in System Settings > Privacy & Security > Accessibility."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite MacTools en Ajustes del Sistema > Privacidad y seguridad > Accesibilidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez MacTools dans Réglages Système > Confidentialité et sécurité > Accessibilité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定 > プライバシーとセキュリティ > アクセシビリティでMacToolsを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 > 개인정보 보호 및 보안 > 손쉬운 사용에서 MacTools를 허용하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o MacTools em Ajustes do Sistema > Privacidade e Segurança > Acessibilidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите MacTools в Системных настройках > Конфиденциальность и безопасность > Универсальный доступ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Ayarları > Gizlilik ve Güvenlik > Erişilebilirlik bölümünde MacTools'a izin verin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统设置的“隐私与安全性 > 辅助功能”中允许 MacTools。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「系統設定」>「隱私權與安全性」>「輔助使用」中允許 MacTools。"
          }
        }
      }
    },
