    "error.accessibilityRequired": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب إخفاء التطبيق النشط بالنقر على Dock إذن تسهيلات الاستخدام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktive App per Dock-Klick ausblenden benötigt die Berechtigung für Bedienungshilfe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide Active App on Dock Click needs Accessibility permission."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar la app activa al hacer clic en el Dock necesita permiso de accesibilidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer l’app active par clic dans le Dock nécessite l’autorisation Accessibilité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DockクリックでアクティブなAppを隠すにはアクセシビリティの許可が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock 클릭으로 활성 앱 가리기에는 손쉬운 사용 권한이 필요합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar app ativa com clique no Dock requer permissão de Acessibilidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для скрытия активного приложения щелчком по Dock требуется разрешение «Универсальный доступ»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock'a Tıklayınca Etkin Uygulamayı Gizle özelliği Erişilebilirlik izni gerektiriyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击程序坞隐藏活跃 App 需要辅助功能权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊 Dock 隱藏使用中 App 需要輔助使用權限。"
          }
        }
      }
    },
