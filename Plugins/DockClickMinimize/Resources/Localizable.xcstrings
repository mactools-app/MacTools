          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выкл."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapalı"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已关闭"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已關閉"
          }
        }
      }
    },
    "panel.subtitle.needsAccessibility": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب إذن تسهيلات الاستخدام"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedienungshilfe-Berechtigung erforderlich"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility permission required"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere permiso de accesibilidad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisation Accessibilité requise"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティの許可が必要です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손쉬운 사용 권한이 필요함"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permissão de Acessibilidade necessária"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуется разрешение «Универсальный доступ»"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişilebilirlik izni gerekiyor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要辅助功能授权"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要輔助使用權限"
          }
        }
      }
    },
    "panel.subtitle.needsInputMonitoring": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب إذن مراقبة الإدخال"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berechtigung zur Eingabeüberwachung erforderlich"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Input Monitoring permission required"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere permiso de supervisión de entrada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisation Surveillance des entrées requise"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力監視の許可が必要です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력 모니터링 권한이 필요함"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permissão de Monitoramento de Entrada necessária"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуется разрешение на мониторинг ввода"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Girdi İzleme izni gerekiyor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要输入监控授权"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要輸入監控權限"
          }
        }
      }
    },
    "permission.accessibility.title": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسهيلات الاستخدام"
          }
        },
        "de": {
