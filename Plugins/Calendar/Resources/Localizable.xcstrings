    "settings.weekStart.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر اليوم الأول الذي يظهر لكل أسبوع في عرض الشهر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle den ersten Tag jeder Woche in der Monatsansicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the first day shown for each week in the monthly calendar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige el primer día que se muestra cada semana en el calendario mensual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez le premier jour affiché pour chaque semaine du calendrier mensuel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月表示で各週の先頭に表示する曜日を選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "월간 캘린더에서 한 주의 첫날로 표시할 요일을 선택합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o primeiro dia exibido em cada semana no calendário mensal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите первый день каждой недели в календаре на месяц."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aylık takvimde haftaların hangi günle başlayacağını seçin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择月历每周显示的第一天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇月曆每週顯示的第一天。"
          }
        }
      }
    },
