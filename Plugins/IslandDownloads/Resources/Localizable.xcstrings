          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузки в Dynamic Island"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Island ダウンロード"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Island 다운로드"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنزيلات Dynamic Island"
          }
        },
        "tr": {
