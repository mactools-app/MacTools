          }
        }
      }
    },
    "settings.liveProgress": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在灵动岛旁显示进度"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show Progress Beside the Island"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在靈動島旁顯示進度"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار التقدم بجانب الجزيرة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortschritt neben der Insel zeigen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar el progreso junto a la isla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher la progression à côté de l’îlot"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイランドの横に進行状況を表示"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아일랜드 옆에 진행률 표시"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar o progresso junto à ilha"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать прогресс рядом с островом"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlerlemeyi adanın yanında göster"
          }
        }
      }
    },
    "settings.liveProgress.description": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载时在灵动岛两侧显示箭头和百分比，不会遮挡菜单或状态栏图标。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While a file downloads, the arrow and percentage show on either side of the island, never over a menu or status item."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載時在靈動島兩側顯示箭頭和百分比，不會遮擋選單或狀態列圖示。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أثناء تنزيل ملف، يظهر السهم والنسبة المئوية على جانبي الجزيرة، دون أن يغطيا أي قائمة أو عنصر حالة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während eine Datei geladen wird, erscheinen Pfeil und Prozentwert zu beiden Seiten der Insel, nie über einem Menü oder Statussymbol."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras se descarga un archivo, la flecha y el porcentaje aparecen a ambos lados de la isla, nunca sobre un menú o un ítem de estado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant un téléchargement, la flèche et le pourcentage s’affichent de part et d’autre de l’îlot, jamais par-dessus un menu ou une icône d’état."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルのダウンロード中、矢印と割合がアイランドの両側に表示されます。メニューやステータス項目に重なることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 다운로드하는 동안 화살표와 백분율이 아일랜드 양쪽에 표시되며, 메뉴나 상태 항목을 가리지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante uma transferência, a seta e a percentagem aparecem de cada lado da ilha, nunca sobre um menu ou ícone de estado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Во время загрузки стрелка и процент отображаются по обе стороны острова и никогда не закрывают меню или значки статуса."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir dosya inerken ok ve yüzde adanın iki yanında görünür; hiçbir menünün veya durum öğesinin üstüne gelmez."
          }
        }
      }
    },
    "settings.notify": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载完成时通知"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notify When a Download Finishes"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載完成時通知"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإشعار عند انتهاء التنزيل"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilen, wenn ein Download fertig ist"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisar al terminar una descarga"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avertir à la fin d’un téléchargement"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロード完了時に通知"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드가 끝나면 알림"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificar quando uma transferência terminar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомлять о завершении загрузки"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirme bitince bildir"
          }
        }
      }
    },
    "settings.notify.description": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示为灵动岛卡片，并保留在通知中心。点按可在访达中显示文件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows as an island card and stays in Notification Centre. Click it to show the file in Finder."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示為靈動島卡片，並保留在通知中心。點按可在 Finder 中顯示檔案。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهر كبطاقة في الجزيرة ويبقى في مركز الإشعارات. انقر عليه لإظهار الملف في Finder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erscheint als Inselkarte und bleibt in der Mitteilungszentrale. Klicke darauf, um die Datei im Finder zu zeigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece como tarjeta en la isla y se queda en el Centro de Notificaciones. Haz clic para mostrar el archivo en el Finder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’affiche comme carte dans l’îlot et reste dans le Centre de notifications. Cliquez pour afficher le fichier dans le Finder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイランドのカードとして表示され、通知センターに残ります。クリックするとFinderでファイルを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아일랜드 카드로 표시되고 알림 센터에 남습니다. 클릭하면 Finder에서 파일을 보여줍니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece como cartão na ilha e fica na Central de Notificações. Clique para mostrar o ficheiro no Finder."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Появляется карточкой на острове и остаётся в Центре уведомлений. Нажмите, чтобы показать файл в Finder."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada kartı olarak görünür ve Bildirim Merkezi’nde kalır. Dosyayı Finder’da göstermek için tıklayın."
          }
        }
      }
    },
    "permission.title": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能授权"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility Access"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輔助使用授權"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول إلى تسهيلات الاستخدام"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugriff auf Bedienungshilfen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceso de accesibilidad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accès d’accessibilité"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティへのアクセス"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손쉬운 사용 접근"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Acesso de acessibilidade"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к универсальному доступу"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişilebilirlik erişimi"
          }
        }
      }
    },
    "permission.description": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于测量菜单栏的空余位置，让进度不遮挡菜单和状态栏图标。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measures the free space in the menu bar so progress never covers a menu or status item."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於測量選單列的空餘位置，讓進度不遮擋選單和狀態列圖示。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقيس المساحة الفارغة في شريط القائمة حتى لا يغطي التقدم أي قائمة أو عنصر حالة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Misst den freien Platz in der Menüleiste, damit der Fortschritt nie ein Menü oder Statussymbol verdeckt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mide el espacio libre de la barra de menús para que el progreso nunca tape un menú o un ítem de estado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesure l’espace libre dans la barre des menus pour que la progression ne masque jamais un menu ou une icône d’état."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーの空きスペースを測り、進行状況がメニューやステータス項目に重ならないようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대의 빈 공간을 측정하여 진행률이 메뉴나 상태 항목을 가리지 않게 합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mede o espaço livre na barra de menus para que o progresso nunca tape um menu ou ícone de estado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Измеряет свободное место в строке меню, чтобы прогресс не закрывал меню и значки статуса."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlerlemenin hiçbir menüyü veya durum öğesini kapatmaması için menü çubuğundaki boş alanı ölçer."
          }
        }
      }
    }
  },
  "version": "1.0"
}