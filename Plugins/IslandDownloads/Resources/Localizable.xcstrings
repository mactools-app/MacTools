          }
        }
      }
    },
    "metadata.description": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在灵动岛旁显示下载进度，并在下载完成时通知。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show download progress beside the camera island and get notified when a download finishes."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在靈動島旁顯示下載進度，並在下載完成時通知。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloadfortschritt neben der Kamera-Insel anzeigen und bei Abschluss benachrichtigt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra el progreso de las descargas junto a la isla de la cámara y avisa cuando terminan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichez la progression des téléchargements près de l’îlot de la caméra et soyez averti à la fin."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostre o progresso dos downloads ao lado da ilha da câmera e receba um aviso ao terminar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прогресс загрузок рядом с островком камеры и уведомление о завершении."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラのアイランドの横にダウンロードの進行状況を表示し、完了時に通知します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 아일랜드 옆에 다운로드 진행률을 표시하고 완료되면 알려 줍니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرض تقدم التنزيلات بجانب جزيرة الكاميرا واحصل على إشعار عند اكتمالها."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirme ilerlemesini kamera adasının yanında gösterin ve indirme bitince bildirim alın."
          }
        }
      }
    },
