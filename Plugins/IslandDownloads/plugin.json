  "summary": "在灵动岛旁显示下载进度，并在下载完成时通知。",
  "localizedMetadata": {
    "zh-Hans": {
      "displayName": "灵动岛下载",
      "summary": "在灵动岛旁显示下载进度，并在下载完成时通知。"
    },
    "en": {
      "displayName": "Dynamic Island Downloads",
      "summary": "Show download progress beside the camera island and get notified when a download finishes."
    },
    "zh-Hant": {
      "displayName": "靈動島下載",
      "summary": "在靈動島旁顯示下載進度，並在下載完成時通知。"
    },
    "de": {
      "displayName": "Dynamic-Island-Downloads",
      "summary": "Downloadfortschritt neben der Kamera-Insel anzeigen und bei Abschluss benachrichtigt werden."
    },
    "es": {
      "displayName": "Descargas en Dynamic Island",
      "summary": "Muestra el progreso de las descargas junto a la isla de la cámara y avisa cuando terminan."
    },
    "fr": {
      "displayName": "Téléchargements Dynamic Island",
      "summary": "Affichez la progression des téléchargements près de l’îlot de la caméra et soyez averti à la fin."
    },
    "pt": {
      "displayName": "Downloads na Dynamic Island",
      "summary": "Mostre o progresso dos downloads ao lado da ilha da câmera e receba um aviso ao terminar."
    },
    "ru": {
      "displayName": "Загрузки в Dynamic Island",
      "summary": "Прогресс загрузок рядом с островком камеры и уведомление о завершении."
    },
    "ja": {
      "displayName": "Dynamic Island ダウンロード",
      "summary": "カメラのアイランドの横にダウンロードの進行状況を表示し、完了時に通知します。"
    },
    "ko": {
      "displayName": "Dynamic Island 다운로드",
      "summary": "카메라 아일랜드 옆에 다운로드 진행률을 표시하고 완료되면 알려 줍니다."
    },
    "ar": {
      "displayName": "تنزيلات Dynamic Island",
      "summary": "اعرض تقدم التنزيلات بجانب جزيرة الكاميرا واحصل على إشعار عند اكتمالها."
    },
    "tr": {
      "displayName": "Dynamic Island İndirmeleri",
      "summary": "İndirme ilerlemesini kamera adasının yanında gösterin ve indirme bitince bildirim alın."
    }
  },
