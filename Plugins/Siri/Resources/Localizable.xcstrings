    "已取消；Siri 中的草稿会保留。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelled. Any draft in Siri is preserved."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İptal edildi; Siri'deki taslak korunur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消；Siri 中的草稿会保留。"
          }
        }
      }
    },
