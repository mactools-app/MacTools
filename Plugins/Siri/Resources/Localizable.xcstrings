    "允许向 Siri 输入并发送消息": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow MacTools to enter and send messages in Siri"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools'un Siri'ye ileti girmesine ve göndermesine izin verin"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 MacTools 向 Siri 输入并发送消息"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح لـ MacTools بإدخال وإرسال الرسائل في Siri"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools erlauben, Nachrichten in Siri einzugeben und zu senden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir que MacTools ingrese y envíe mensajes en Siri"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser MacTools à saisir et envoyer des messages dans Siri"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools に Siri へのメッセージ入力と送信を許可"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools가 Siri에 메시지를 입력하고 보낼 수 있도록 허용"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir que o MacTools digite e envie mensagens na Siri"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить MacTools вводить и отправлять сообщения в Siri"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許向 Siri 輸入並傳送訊息"
          }
        }
      }
    },
