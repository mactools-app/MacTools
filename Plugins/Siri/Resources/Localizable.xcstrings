{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "从命令面板向 Siri 发送消息": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send messages to Siri from the command palette"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Komut paletinden Siri'ye ileti gönderin"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从命令面板向 Siri 发送消息"
          }
        }
      }
    },
    "辅助功能": {
      "extractionState": "manual",
      "localizations": {
