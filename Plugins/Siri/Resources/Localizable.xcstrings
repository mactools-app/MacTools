    "已取消；Siri 中的草稿会保留。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelled. Any draft in Siri is preserved."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İptal edildi; Siri'deki taslak korunur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消；Siri 中的草稿会保留。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الإلغاء. يتم الاحتفاظ بأي مسودة في Siri."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgebrochen. Ein eventueller Entwurf in Siri bleibt erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelado. Se conserva cualquier borrador en Siri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulé. Tout brouillon dans Siri est conservé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセルされました。Siri の下書きは保持されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취소되었습니다. Siri의 모든 초안은 보존됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelado. Qualquer rascunho na Siri é preservado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменено. Любой черновик в Siri сохраняется."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消；Siri 中的草稿會保留。"
          }
        }
      }
