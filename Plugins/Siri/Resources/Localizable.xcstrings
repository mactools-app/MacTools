        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예상되는 Siri 컨트롤을 찾을 수 없습니다. 다시 시도하기 전에 Siri를 확인하세요."
          }
        },
        "pt": {
          "stringUnit": {
