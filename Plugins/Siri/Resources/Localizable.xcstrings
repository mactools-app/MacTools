        }
      }
    },
    "允许向 Siri 输入并发送消息": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow MacTools to enter and send messages in Siri"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools'un Siri'ye ileti girmesine ve göndermesine izin verin"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许向 Siri 输入并发送消息"
          }
        }
      }
    },
    "询问 Siri — 新对话": {
      "extractionState": "manual",
