        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escriba su frase desencadenante seguida de su mensaje en la paleta de comandos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapez votre phrase de déclenchement suivie de votre message dans la palette de commandes"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンド パレットにトリガー フレーズを入力し、続いてメッセージを入力します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명령 팔레트에 트리거 문구와 메시지를 입력하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite sua frase de gatilho seguida de sua mensagem na paleta de comandos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите триггерную фразу, а затем свое сообщение в палитре команд."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在命令面板輸入觸發短語和訊息"
          }
        }
