          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri · 新对话"
          }
        }
      }
    },
    "发送": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
