            "value": "Type your trigger phrase followed by your message in the command palette"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Komut paletine tetikleyici ifadenizi ve ardından iletinizi yazın"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在命令面板输入触发短语和消息"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب عبارة التشغيل متبوعة برسالتك في لوحة الأوامر"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie Ihren Auslösebegriff gefolgt von Ihrer Nachricht in die Befehlspalette ein"
