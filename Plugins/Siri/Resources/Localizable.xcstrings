          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A mensagem mudou. Envio interrompido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщение изменилось. Отправка остановлена."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訊息內容已更改，已停止傳送。"
          }
        }
      }
    },
    "消息可能已发送，请在 Siri 中确认，避免重复发送。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The message may have been sent. Check Siri before trying again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İleti gönderilmiş olabilir. Yeniden denemeden önce Siri'de kontrol edin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "消息可能已发送，请在 Siri 中确认，避免重复发送。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ربما تم إرسال الرسالة. تحقق من Siri قبل المحاولة مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nachricht wurde möglicherweise bereits gesendet. Überprüfen Sie Siri, bevor Sie es erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es posible que el mensaje haya sido enviado. Verifique Siri antes de volver a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le message a peut-être été envoyé. Vérifiez Siri avant de réessayer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージが送信された可能性があります。再試行する前に Siri を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지가 전송되었을 수 있습니다. 다시 시도하기 전에 Siri를 확인하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A mensagem pode ter sido enviada. Verifique Siri antes de tentar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возможно, сообщение было отправлено. Проверьте Siri, прежде чем повторить попытку."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訊息可能已傳送，請在 Siri 中確認，避免重複傳送。"
          }
        }
      }
    },
    "等待 Siri 超时，请检查 Siri 后重试。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri did not become ready in time. Check Siri before trying again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri zamanında hazır olmadı. Yeniden denemeden önce Siri'yi kontrol edin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待 Siri 超时，请检查 Siri 后重试。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يصبح Siri جاهزًا في الوقت المناسب. تحقق من Siri قبل المحاولة مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri war nicht rechtzeitig bereit. Überprüfen Sie Siri, bevor Sie es erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri no estuvo listo a tiempo. Verifique Siri antes de volver a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri n’a pas été prêt à temps. Vérifiez Siri avant de réessayer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Siriの準備が間に合いませんでした。再試行する前に Siri を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri가 시간 내에 준비되지 않았습니다. 다시 시도하기 전에 Siri를 확인하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Siri não ficou pronta a tempo. Verifique a Siri antes de tentar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri не успела подготовиться. Проверьте Siri перед повторной попыткой."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等待 Siri 超時，請檢查 Siri 後重試。"
          }
        }
      }
    },
    "无法识别 Siri 输入界面，请检查 Siri 后重试。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not find the expected Siri controls. Check Siri before trying again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beklenen Siri denetimleri bulunamadı. Yeniden denemeden önce Siri'yi kontrol edin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
