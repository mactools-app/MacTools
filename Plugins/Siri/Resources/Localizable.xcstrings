    "从命令面板向 Siri 发送消息": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send messages to Siri from the command palette"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Komut paletinden Siri'ye ileti gönderin"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从命令面板向 Siri 发送消息"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسل رسائل إلى Siri من لوحة الأوامر"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachrichten über die Befehlspalette an Siri senden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar mensajes a Siri desde la paleta de comandos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyer des messages à Siri depuis la palette de commandes"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドパレットからSiriにメッセージを送信する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명령 팔레트에서 Siri로 메시지 보내기"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar mensagens para Siri a partir da paleta de comandos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправляйте сообщения Siri из палитры команд."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從命令面板向 Siri 傳送訊息"
          }
        }
      }
    },
