        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönder"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送"
          }
        }
      }
    },
    "需要 macOS 27 和 Siri AI": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requires macOS 27 and Siri AI"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 27 ve Siri AI gerektirir"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要 macOS 27 和 Siri AI"
          }
        }
      }
    },
    "请先授予辅助功能权限": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grant Accessibility permission first"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce Erişilebilirlik iznini verin"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先授予辅助功能权限"
          }
        }
      }
    },
    "正在向 Siri 发送消息": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending a message to Siri"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri'ye ileti gönderiliyor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在向 Siri 发送消息"
          }
        }
      }
    },
    "Siri 暂不可用": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri is unavailable"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri şu anda kullanılamıyor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri 暂不可用"
          }
        }
      }
    },
    "取消": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İptal"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "Siri": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri"
          }
        }
      }
    },
    "在命令面板输入触发短语和消息，按 Return 发送。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type your trigger phrase followed by your message in the command palette, then press Return."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Komut paletine tetikleyici ifadenizi ve ardından iletinizi yazın, göndermek için Return tuşuna basın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在命令面板输入触发短语和消息，按 Return 发送。"
          }
        }
      }
    },
    "Siri 中有未发送的草稿，请先处理。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri has an unsent draft. Finish it before trying again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri'de gönderilmemiş bir taslak var. Yeniden denemeden önce onu tamamlayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri 中有未发送的草稿，请先处理。"
          }
        }
      }
    },
    "请选择要使用的 Siri 窗口后重试。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select the Siri window you want to use, then try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanmak istediğiniz Siri penceresini seçip yeniden deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择要使用的 Siri 窗口后重试。"
          }
        }
      }
    },
    "Siri 对话已更改，已停止发送。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Siri conversation changed. Sending stopped."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri sohbeti değişti. Gönderme durduruldu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri 对话已更改，已停止发送。"
          }
        }
      }
    },
    "消息内容已更改，已停止发送。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The message changed. Sending stopped."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İleti değişti. Gönderme durduruldu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "消息内容已更改，已停止发送。"
          }
        }
      }
    },
    "消息可能已发送，请在 Siri 中确认，避免重复发送。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The message may have been sent. Check Siri before trying again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İleti gönderilmiş olabilir. Yeniden denemeden önce Siri'de kontrol edin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "消息可能已发送，请在 Siri 中确认，避免重复发送。"
          }
        }
      }
    },
    "等待 Siri 超时，请检查 Siri 后重试。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri did not become ready in time. Check Siri before trying again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri zamanında hazır olmadı. Yeniden denemeden önce Siri'yi kontrol edin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待 Siri 超时，请检查 Siri 后重试。"
          }
        }
      }
    },
    "无法识别 Siri 输入界面，请检查 Siri 后重试。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not find the expected Siri controls. Check Siri before trying again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beklenen Siri denetimleri bulunamadı. Yeniden denemeden önce Siri'yi kontrol edin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法识别 Siri 输入界面，请检查 Siri 后重试。"
          }
        }
      }
    },
    "在命令面板输入触发短语和消息": {
      "extractionState": "manual",
      "localizations": {
