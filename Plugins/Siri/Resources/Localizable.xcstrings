    "metadata.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send messages to Siri from the command palette"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Komut paletinden Siri'ye ileti gönderin"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从命令面板向 Siri 发送消息"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسل رسائل إلى Siri من لوحة الأوامر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sende Nachrichten über die Befehlspalette an Siri."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía mensajes a Siri desde la paleta de comandos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez des messages à Siri depuis la palette de commandes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドパレットから Siri にメッセージを送信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명령 팔레트에서 Siri에 메시지를 보냅니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Envie mensagens para a Siri pela paleta de comandos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправляйте сообщения Siri из палитры команд."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從命令面板向 Siri 傳送訊息"
          }
        }
      }
    },
