          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nachricht hat sich geändert. Der Sendevorgang wurde gestoppt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mensaje cambió. El envío se detuvo."
