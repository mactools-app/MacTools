          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de trouver les contrôles Siri attendus. Vérifiez Siri avant de réessayer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必要な Siri のコントロールが見つかりませんでした。再試行する前に Siri を確認してください。"
