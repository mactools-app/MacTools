    "在命令面板输入触发短语和消息，按 Return 发送。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type your trigger phrase followed by your message in the command palette, then press Return."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Komut paletine tetikleyici ifadenizi ve ardından iletinizi yazın, göndermek için Return tuşuna basın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在命令面板输入触发短语和消息，按 Return 发送。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب عبارة التشغيل الخاصة بك متبوعة برسالتك في لوحة الأوامر، ثم اضغط على Return."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie Ihren Auslösebegriff gefolgt von Ihrer Nachricht in die Befehlspalette ein und drücken Sie die Eingabetaste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escriba su frase desencadenante seguida de su mensaje en la paleta de comandos, luego presione Retorno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapez votre phrase de déclenchement suivie de votre message dans la palette de commandes, puis appuyez sur Retour."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンド パレットにトリガー フレーズとメッセージを入力し、Return キーを押します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명령 팔레트에 트리거 문구와 메시지를 입력한 다음 Return 키를 누르세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite sua frase de gatilho seguida de sua mensagem na paleta de comandos e pressione Return."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите триггерную фразу, а затем свое сообщение в палитре команд, затем нажмите Return."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在命令面板輸入觸發短語和訊息，按 Return 傳送。"
          }
        }
      }
    },
    "Siri 中有未发送的草稿，请先处理。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri has an unsent draft. Finish it before trying again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri'de gönderilmemiş bir taslak var. Yeniden denemeden önce onu tamamlayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri 中有未发送的草稿，请先处理。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي Siri على مسودة لم يتم إرسالها. قم بإنهائها قبل المحاولة مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri hat einen ungesendeten Entwurf. Stellen Sie diesen fertig, bevor Sie es erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri tiene un borrador sin enviar. Termínalo antes de volver a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri a un brouillon non envoyé. Terminez-le avant de réessayer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri に未送信の下書きがあります。その下書きを処理してから、再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri에 전송되지 않은 초안이 있습니다. 다시 시도하기 전에 완료하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Siri tem um rascunho não enviado. Conclua-o antes de tentar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Siri есть неотправленный черновик. Завершите работу с ним перед повторной попыткой."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri 中有未傳送的草稿，請先處理。"
          }
        }
      }
    },
    "请选择要使用的 Siri 窗口后重试。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select the Siri window you want to use, then try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanmak istediğiniz Siri penceresini seçip yeniden deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择要使用的 Siri 窗口后重试。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدد نافذة Siri التي تريد استخدامها، ثم حاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie das Siri-Fenster aus, das Sie verwenden möchten, und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona la ventana de Siri que quieras usar y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez la fenêtre Siri que vous souhaitez utiliser, puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用するSiriウィンドウを選択して、再度実行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용하려는 Siri 창을 선택한 후 다시 시도하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione a janela da Siri que deseja usar e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите окно Siri, которое вы хотите использовать, затем повторите попытку."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇要使用的 Siri 視窗後重試。"
          }
        }
      }
    },
    "Siri 对话已更改，已停止发送。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Siri conversation changed. Sending stopped."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri sohbeti değişti. Gönderme durduruldu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri 对话已更改，已停止发送。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيرت محادثة Siri. توقف الإرسال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Siri-Unterhaltung hat sich geändert. Der Sendevorgang wurde gestoppt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conversación de Siri ha cambiado. Se ha detenido el envío."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La conversation Siri a changé. L'envoi s'est arrêté."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri の会話が変更されました。送信が停止されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri 대화가 변경되었습니다. 전송이 중지되었습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A conversa da Siri foi alterada. Envio interrompido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диалог Siri изменился. Отправка остановлена."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri 對話已更改，已停止傳送。"
          }
        }
      }
    },
    "消息内容已更改，已停止发送。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
