          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось найти ожидаемые элементы управления Siri. Проверьте Siri, прежде чем повторить попытку."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
