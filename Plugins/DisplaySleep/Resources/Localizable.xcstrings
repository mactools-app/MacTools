{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "action.confirmation.confirm": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سكون"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruhezustand"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reposo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre en veille"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スリープ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠자기"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Repouso"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим сна"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyku"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "休眠"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠"
          }
        }
      }
    },
    "action.confirmation.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي رابط التشغيل هذا إلى إطفاء شاشات العرض فورًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Ausführungslink schaltet die Displays sofort aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Run Link will turn off the displays immediately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este enlace de ejecución apagará las pantallas inmediatamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce lien d’exécution éteindra immédiatement les écrans."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この実行リンクはディスプレイをすぐにオフにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 실행 링크는 디스플레이를 즉시 끕니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este link de execução desligará as telas imediatamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта ссылка запуска немедленно выключит дисплеи."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Çalıştırma Bağlantısı ekranları hemen kapatacak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此运行链接将立即关闭显示器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此執行連結會立即關閉顯示器。"
          }
        }
      }
    },
    "action.confirmation.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وضع شاشات العرض في السكون؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Displays in den Ruhezustand versetzen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put Displays to Sleep?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Poner las pantallas en reposo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre les écrans en veille ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスプレイをスリープしますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스플레이를 잠자기 상태로 전환할까요?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Colocar as telas em repouso?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевести дисплеи в режим сна?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekranlar uyku moduna alınsın mı?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让显示器休眠？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓顯示器進入睡眠？"
          }
        }
      }
    },
    "metadata.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرض وضع السكون"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruhezustand anzeigen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display Sleep"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar suspensión"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher la veille"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスプレイスリープ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스플레이 절전"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Exibir suspensão"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сон дисплея"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran Uykusu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示器休眠"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示器休眠"
          }
        }
      }
    },
    "metadata.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل شاشات العرض في وضع السكون على الفور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anzeigen sofort in den Ruhezustand versetzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put displays to sleep immediately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon las pantallas en modo de suspensión inmediatamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez les écrans en veille immédiatement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスプレイをすぐにスリープ状態にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스플레이를 즉시 절전 모드로 전환하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque os monitores em hibernação imediatamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Немедленно перевести дисплеи в спящий режим."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekranları hemen uyku moduna alır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即让显示器休眠"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "立即讓顯示器休眠"
          }
        }
      }
    },
    "panel.button.sleep": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
