    "permission.fullDiskAccess.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مطلوب لقياس حاويات التطبيقات المحمية مثل سجلات المحادثات؛ بدونها تظهر هذه العناصر كغير قابلة للقراءة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erforderlich, um geschützte App-Container wie Chatverläufe zu messen; ohne sie werden diese Einträge als nicht lesbar angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Required to measure protected app containers such as chat histories; without it those entries show as unreadable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesario para medir contenedores de apps protegidos como los historiales de chat; sin él, esas entradas aparecen como ilegibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessaire pour mesurer les conteneurs d'applications protégés comme les historiques de discussion ; sans cela, ces entrées s'affichent comme illisibles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャット履歴などの保護されたアプリコンテナを計測するために必要です。権限がないとこれらの項目は読み取れないと表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅 기록 등 보호된 앱 컨테이너를 측정하려면 필요합니다. 없으면 해당 항목이 읽을 수 없음으로 표시됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Necessário para medir contêineres de apps protegidos, como históricos de conversas; sem ele, essas entradas aparecem como ilegíveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуется для измерения защищённых контейнеров приложений, таких как история чатов; без него эти записи отображаются как непрочитаемые."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sohbet geçmişi gibi korumalı uygulama kapsayıcılarını ölçmek için gereklidir; olmadan bu öğeler okunamıyor olarak gösterilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "统计受保护的应用容器（如聊天记录）需要此权限；未授权时相关条目显示为无法读取。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "統計受保護的應用程式容器（如聊天記錄）需要此權限；未授權時相關條目顯示為無法讀取。"
          }
        }
      }
    },
    "permission.fullDiskAccess.footnote": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد الفحص بعد المنع حتى تشملها المواقع المحمية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Erteilen neu scannen, damit geschützte Orte einbezogen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rescan after granting so protected locations are included."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a analizar tras concederlo para incluir las ubicaciones protegidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relancez l'analyse après l'autorisation pour inclure les emplacements protégés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可後に再スキャンすると、保護された場所も含まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인 후 다시 스캔하면 보호된 위치도 포함됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique novamente após conceder para incluir os locais protegidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторите сканирование после выдачи разрешения, чтобы включить защищённые места."
