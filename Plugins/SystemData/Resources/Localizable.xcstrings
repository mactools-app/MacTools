    "metadata.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احسب ما تشغله بيانات نظام macOS فعليًا حسب الفئة وحدّده في Finder"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt nach Kategorie, wie viel macOS-Systemdaten wirklich belegen, und macht sie im Finder auffindbar"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Break down what macOS System Data really occupies by category and reveal it in Finder"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desglosa lo que ocupa realmente los Datos del sistema de macOS por categoría y los localiza en Finder"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Détaille ce que les Données système de macOS occupent réellement par catégorie et les localise dans le Finder"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS のシステムデータが実際に占める容量をカテゴリ別に示し、Finder で素早く特定できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 시스템 데이터가 실제로 차지하는 용량을 범주별로 나누어 보여주고 Finder에서 빠르게 찾습니다"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Detalha o que os Dados do Sistema do macOS realmente ocupam por categoria e os localiza no Finder"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает по категориям, сколько системные данные macOS действительно занимают, и находит их в Finder"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS Sistem Verilerinin kategoriye göre gerçekten ne kadar yer kapladığını gösterir ve Finder'da bulmanızı sağlar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分类汇总 macOS 系统数据的真实占用，在 Finder 中快速定位"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分類彙總 macOS 系統資料的真實占用，在 Finder 中快速定位"
          }
        }
      }
    },
