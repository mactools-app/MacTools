{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "action.setMode.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose when macOS automatically hides the menu bar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS'un menü çubuğunu ne zaman otomatik gizleyeceğini seçin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择 macOS 何时自动隐藏菜单栏。"
          }
        }
      }
    },
    "action.setMode.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set Menu Bar Visibility"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Menü Çubuğu Görünürlüğünü Ayarla"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置菜单栏显示方式"
          }
        }
      }
    },
    "error.modeVerificationRestored": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not verify the menu bar setting. The original mode was restored."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Menü çubuğu ayarı doğrulanamadı. Özgün mod geri yüklendi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证菜单栏设置，已恢复原来的模式。"
          }
        }
      }
    },
    "error.modeVerificationUnrestored": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not verify the menu bar setting, and the original mode could not be fully restored."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Menü çubuğu ayarı doğrulanamadı ve özgün mod tam olarak geri yüklenemedi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证菜单栏设置，也无法完整恢复原来的模式。"
          }
        }
      }
    },
    "mode.always": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her Zaman"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "始终"
          }
        }
      }
    },
    "mode.desktopOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On Desktop Only"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca Masaüstünde"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在桌面上"
          }
        }
      }
    },
    "mode.fullScreenOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Full Screen Only"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca Tam Ekranda"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在全屏幕显示时"
          }
        }
      }
    },
    "mode.never": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Asla"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "永不"
          }
        }
      }
    },
    "parameter.mode.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Visibility"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görünürlük"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示方式"
          }
        }
      }
    },
    "action.hide.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إخفاء شريط القوائم"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Menüleiste ausblenden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide Menu Bar"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar la barra de menús"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer la barre des menus"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーを隠す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대 숨기기"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar barra de menus"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрыть строку меню"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Menü Çubuğunu Gizle"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏菜单栏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱藏選單列"
          }
        }
      }
    },
    "action.show.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار شريط القوائم"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Menüleiste einblenden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show Menu Bar"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar la barra de menús"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher la barre des menus"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーを表示"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대 보기"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar barra de menus"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показать строку меню"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Menü Çubuğunu Göster"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示菜单栏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示選單列"
          }
        }
      }
    },
    "metadata.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إخفاء شريط القوائم تلقائيًا"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Menüleiste automatisch ausblenden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-Hide Menu Bar"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar barra de menú automáticamente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer automatiquement la barre de menus"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニュー バーを自動的に非表示にする"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴바 자동 숨기기"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar barra de menu automaticamente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматическое скрытие строки меню"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Menü Çubuğunu Otomatik Gizle"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动隐藏菜单栏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動隱藏選單列"
          }
        }
      }
    },
    "metadata.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إخفاء شريط القائمة تلقائيًا لتوفير مساحة أكبر على الشاشة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Menüleiste automatisch ausblenden für mehr Platz auf dem Bildschirm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-hide the menu bar for more screen space."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar automáticamente la barra de menú para obtener más espacio en la pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer automatiquement la barre de menus pour plus d'espace sur l'écran."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面スペースを増やすためにメニュー バーを自動的に非表示にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 많은 화면 공간을 위해 메뉴 표시줄을 자동으로 숨깁니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar automaticamente a barra de menu para obter mais espaço na tela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически скрыть строку меню, чтобы освободить место на экране."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha fazla ekran alanı için menü çubuğunu otomatik gizleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动隐藏菜单栏，提供更完整的屏幕显示空间"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動隱藏選單列，提供更完整的螢幕顯示空間"
          }
        }
      }
    },
    "panel.subtitle.enabled": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
