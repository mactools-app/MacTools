{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "metadata.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مستوى صوت العرض"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anzeigelautstärke"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display Volume"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumen de la pantalla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume de l'écran"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスプレイ音量"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스플레이 볼륨"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume da tela"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Громкость дисплея"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran Sesi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示器音量"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示器音量"
          }
        }
      }
    },
    "metadata.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضبط مستوى الصوت لكل شاشة بسرعة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passen Sie die Lautstärke für jedes Display schnell an"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust volume for each display quickly"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste el volumen de cada pantalla rápidamente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustez rapidement le volume de chaque écran"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ディスプレイの音量を素早く調整します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 디스플레이의 볼륨을 빠르게 조정하세요"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste o volume de cada tela rapidamente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстро отрегулируйте громкость каждого дисплея"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her ekranın sesini hızla ayarlayın"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快速调节每个显示器的音量"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快速調節每個顯示器的音量"
          }
        }
      }
    },
    "panel.subtitle.noDisplays": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم اكتشاف أي شاشات يمكن ضبط صوتها"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Displays mit einstellbarer Lautstärke erkannt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No displays with adjustable volume were detected"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se detectaron pantallas con volumen ajustable"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun écran à volume réglable n'a été détecté"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音量を調整できるディスプレイが検出されませんでした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "볼륨을 조절할 수 있는 디스플레이가 감지되지 않았습니다"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma tela com volume ajustável foi detectada"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дисплеи с регулируемой громкостью не обнаружены"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi ayarlanabilir ekran algılanmadı"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未检测到可调节音量的显示器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未偵測到可調整音量的顯示器"
          }
        }
      }
    },
