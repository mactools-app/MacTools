    "settings.shortcutTarget.allDisplaysDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضبط جميع الشاشات القابلة للتحكم بالتزامن."
