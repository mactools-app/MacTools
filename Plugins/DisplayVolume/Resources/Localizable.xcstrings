    "settings.shortcutTarget.followsMouseDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضبط فقط الشاشة الموجودة أسفل المؤشر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur den Bildschirm unter dem Cursor anpassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only adjust the display where the cursor is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo ajusta la pantalla donde está el cursor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'ajuster que l'écran où se trouve le curseur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カーソルのあるディスプレイのみ調整します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커서가 있는 화면만 조정합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta apenas a tela onde o cursor está."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отрегулировать только дисплей с курсором."
          }
        },
        "tr": {
