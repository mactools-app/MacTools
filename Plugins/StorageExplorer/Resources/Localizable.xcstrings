    "storageExplorer.trashOperationFailed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر نقل العناصر المحددة إلى سلة المهملات. راجعها وحاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ausgewählten Objekte konnten nicht in den Papierkorb bewegt werden. Prüfen Sie sie und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected items could not be moved to Trash. Review them and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron mover los elementos seleccionados a la Papelera. Revísalos e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de déplacer les éléments sélectionnés vers la corbeille. Vérifiez-les puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した項目をゴミ箱に移動できませんでした。項目を確認してからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 항목을 휴지통으로 이동할 수 없습니다. 항목을 확인한 후 다시 시도하십시오."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível mover os itens selecionados para o Lixo. Revise-os e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось переместить выбранные объекты в корзину. Проверьте их и повторите попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili öğeler çöpe taşınamadı. Bunları inceleyip yeniden deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法将所选项目移至废纸篓。请检查所选项目后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法將所選項目移至垃圾桶。請檢查所選項目後再試一次。"
          }
        }
      }
    },
