    "storageExplorer.skippedDetailsMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تخطي %d من العناصر بسبب الأذونات أو العناصر النائبة السحابية أو حدود نظام الملفات. قد يكون الإجمالي المعروض أقل من الحجم الفعلي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%d Objekte wurden wegen Berechtigungen, Cloud-Platzhaltern oder Dateisystemgrenzen übersprungen. Die angezeigte Gesamtgröße kann zu niedrig sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%d items were skipped because of permissions, cloud placeholders, or file-system boundaries. The displayed total may be low."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se omitieron %d elementos por permisos, marcadores de nube o límites del sistema de archivos. El total mostrado puede ser inferior al real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%d éléments ont été ignorés en raison des autorisations, d’emplacements réservés dans le nuage ou des limites du système de fichiers. Le total affiché peut être sous-estimé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセス権、クラウドのプレースホルダ、またはファイルシステムの境界により%d項目がスキップされました。表示される合計は実際より小さい場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "권한, 클라우드 자리 표시자 또는 파일 시스템 경계로 인해 %d개 항목을 건너뛰었습니다. 표시된 합계가 실제보다 작을 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Foram ignorados %d itens devido a permissões, marcadores da nuvem ou limites do sistema de ficheiros. O total apresentado pode ser inferior ao real."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропущено объектов: %d. Причина: разрешения, облачные заполнители или границы файловой системы. Показанный итог может быть занижен."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzinler, bulut yer tutucuları veya dosya sistemi sınırları nedeniyle %d öğe atlandı. Görüntülenen toplam düşük olabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 个项目因权限、云端占位文件或文件系统边界而被跳过。显示的总大小可能偏低。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 個項目因權限、雲端預留檔案或檔案系統邊界而被略過。顯示的總大小可能偏低。"
          }
        }
      }
    },
    "storageExplorer.folderChangedNotice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغير المجلد بعد الفحص. حدّث النتائج قبل نقل المجلدات المتغيرة إلى سلة المهملات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ordner wurde nach dem Scan geändert. Aktualisieren Sie, bevor Sie geänderte Ordner in den Papierkorb bewegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The folder changed after the scan. Refresh before moving changed folders to Trash."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta cambió después del análisis. Actualiza antes de mover carpetas modificadas a la Papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier a changé après l’analyse. Actualisez avant de placer les dossiers modifiés dans la corbeille."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャン後にフォルダが変更されました。変更されたフォルダをゴミ箱に移動する前に更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캔 후 폴더가 변경되었습니다. 변경된 폴더를 휴지통으로 이동하기 전에 새로 고치십시오."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A pasta mudou após a análise. Atualize antes de mover pastas alteradas para o Lixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папка изменилась после сканирования. Обновите данные перед перемещением изменённых папок в Корзину."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasör, taramadan sonra değişti. Değişen klasörleri çöpe taşımadan önce yenileyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描后文件夹发生了变化；移动已变化的文件夹前需要刷新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描後檔案夾發生了變更；將已變更的檔案夾移到垃圾桶前需要重新整理。"
          }
        }
      }
    },
    "storageExplorer.symlinkReviewUnsupported": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن إضافة الروابط الرمزية إلى المراجعة. أدِر الرابط نفسه في Finder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Symbolische Links können nicht zur Prüfung hinzugefügt werden. Verwalten Sie den Link im Finder."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Symbolic links cannot be added to review. Manage the link itself in Finder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los enlaces simbólicos no se pueden añadir a la revisión. Gestiona el enlace en Finder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les liens symboliques ne peuvent pas être ajoutés à la vérification. Gérez le lien dans le Finder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シンボリックリンクは確認対象に追加できません。リンク自体はFinderで管理してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "심볼릭 링크는 검토에 추가할 수 없습니다. 링크 자체는 Finder에서 관리하십시오."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível adicionar ligações simbólicas à revisão. Faça a gestão da ligação no Finder."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Символические ссылки нельзя добавить на проверку. Управляйте самой ссылкой в Finder."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembolik bağlantılar incelemeye eklenemez. Bağlantının kendisini Finder'da yönetin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "符号链接不能加入审阅；请在访达中管理链接本身。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "符號連結無法加入審閱；請在 Finder 中管理連結本身。"
          }
        }
      }
    },
