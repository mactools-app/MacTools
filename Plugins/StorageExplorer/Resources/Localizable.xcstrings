    "storageExplorer.confirmTrashMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم نقل العناصر المحددة إلى سلة المهملات بنظام macOS. يمكنك استعادتها من سلة المهملات إذا لزم الأمر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ausgewählten Elemente werden in den macOS-Papierkorb verschoben. Sie können bei Bedarf aus dem Papierkorb wiederhergestellt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected items will be moved to macOS Trash. You can restore them from Trash if needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos seleccionados se trasladarán a la Papelera de macOS. Puede restaurarlos desde la Papelera si es necesario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments sélectionnés seront placés dans la corbeille macOS. Vous pourrez les restaurer depuis la corbeille si nécessaire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した項目は macOS のゴミ箱に移動されます。必要に応じてゴミ箱から復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 항목은 macOS 휴지통으로 이동됩니다. 필요한 경우 휴지통에서 복원할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os itens selecionados serão movidos para o Lixo do macOS. Pode restaurá-los a partir do Lixo se necessário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранные элементы будут перемещены в корзину macOS. При необходимости их можно восстановить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili öğeler macOS çöp kutusuna taşınacak. Gerekirse bunları çöp kutusundan geri yükleyebilirsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选项目将被移至 macOS 废纸篓。如有需要，您可以从废纸篓中恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選項目將被移至 macOS 垃圾桶。如有需要，您可以從垃圾桶中還原。"
          }
        }
      }
    },
