            "state": "translated",
            "value": "Önceki tarama: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次扫描：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上次掃描：%@"
          }
        }
      }
    },
    "storageExplorer.reviewSelected": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت إضافته إلى المراجعة بالفعل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereits zur Prüfung hinzugefügt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already added to review."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya se ha añadido a la revisión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjà ajouté à la vérification."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでにレビューに追加されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 검토에 추가되었습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Já foi adicionado à revisão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже добавлено на проверку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaten incelemeye eklenmiş."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已加入审阅。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已加入審閱。"
          }
        }
      }
    },
    "storageExplorer.reviewIncludedByParentFormat": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مضمّن بالفعل في المراجعة ضمن «%@»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereits über „%@“ in der Prüfung enthalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already included in review with “%@”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya está incluido en la revisión con «%@»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjà inclus dans la vérification avec «%@»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」と一緒にレビューへ追加済みです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 “%@”와 함께 검토에 포함되어 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Já está incluído na revisão com “%@”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже добавлено на проверку вместе с «%@»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ile birlikte zaten incelemeye eklenmiş."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已随“%@”加入审阅。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已隨「%@」加入審閱。"
          }
        }
      }
    },
    "storageExplorer.reviewIncompleteFormat": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر فحص %d من العناصر. الحجم المعروض هو الحد الأدنى، وقد تختلف المساحة الفعلية المستردة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%d Objekte konnten nicht gescannt werden. Die angezeigte Größe ist ein Mindestwert; der tatsächlich frei werdende Speicher kann abweichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%d items could not be scanned. The shown size is a minimum; actual recovered space may differ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron analizar %d elementos. El tamaño mostrado es un mínimo; el espacio recuperado real puede variar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%d éléments n’ont pas pu être analysés. La taille affichée est un minimum ; l’espace réellement récupéré peut varier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%d項目をスキャンできませんでした。表示サイズは最小値で、実際に解放される容量は異なる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%d개 항목을 스캔할 수 없습니다. 표시된 크기는 최솟값이며 실제 확보 공간은 다를 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível analisar %d itens. O tamanho apresentado é um mínimo; o espaço efetivamente recuperado pode variar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось просканировать объектов: %d. Показанный размер является минимальным; фактически освобождённое место может отличаться."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%d öğe taranamadı. Gösterilen boyut en düşük değerdir; gerçekten kazanılacak alan farklı olabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %d 个内容未能扫描。显示大小为最低估计，实际释放空间可能不同。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %d 個內容未能掃描。顯示的大小是最低估計，實際釋放空間可能不同。"
          }
        }
      }
    },
    "storageExplorer.reviewScanRoot": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن إضافة مجلد الفحص الحالي نفسه إلى المراجعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der aktuell gescannte Ordner selbst kann nicht zur Prüfung hinzugefügt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The active scan folder itself cannot be added to review."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta que se está analizando no se puede añadir a la revisión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier actuellement analysé ne peut pas lui-même être ajouté à la vérification."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在スキャン中のフォルダ自体はレビューに追加できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 스캔 폴더 자체는 검토에 추가할 수 없습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A própria pasta em análise não pode ser adicionada à revisão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Саму сканируемую папку нельзя добавить на проверку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkin tarama klasörünün kendisi incelemeye eklenemez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前扫描文件夹本身不能加入审阅。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前掃描的檔案夾本身無法加入審閱。"
          }
        }
      }
    },
    "storageExplorer.reviewProtected": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الموقع محمي ولا يمكن نقله إلى سلة المهملات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Speicherort ist geschützt und kann nicht in den Papierkorb bewegt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This location is protected and cannot be moved to Trash."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ubicación está protegida y no se puede mover a la Papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet emplacement est protégé et ne peut pas être placé dans la corbeille."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この場所は保護されているため、ゴミ箱に移動できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 위치는 보호되어 있어 휴지통으로 이동할 수 없습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta localização está protegida e não pode ser movida para o Lixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это расположение защищено, и его нельзя переместить в Корзину."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu konum korumalıdır ve çöpe taşınamaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此位置受保护，不能移至废纸篓。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此位置受到保護，無法移到垃圾桶。"
          }
        }
      }
    },
