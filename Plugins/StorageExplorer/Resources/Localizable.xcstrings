    "storageExplorer.hardLinkNotice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لهذا الملف %d من الروابط الثابتة. لا تتحرر المساحة إلا بعد إزالة الرابط الأخير."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei hat %d feste Links. Speicherplatz wird erst nach Entfernen des letzten Links freigegeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file has %d hard links. Space is released only after the final link is removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo tiene %d enlaces físicos. El espacio se libera al eliminar el último enlace."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier possède %d liens physiques. L’espace n’est libéré qu’après la suppression du dernier lien."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルには%d個のハードリンクがあります。最後のリンクを削除した後にのみ容量が解放されます。"
          }
        },
        "ko": {
          "stringUnit": {
