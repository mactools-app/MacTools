          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Análise anterior: %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предыдущее сканирование: %@"
