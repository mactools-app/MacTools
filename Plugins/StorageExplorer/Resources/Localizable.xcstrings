{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "storageExplorer.cachedPreviewReviewUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه معاينة من الفحص السابق. انتظر اكتمال التحديث قبل إضافة عناصر للمراجعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist eine Vorschau des vorherigen Scans. Warte, bis die Aktualisierung abgeschlossen ist, bevor du Objekte zur Prüfung hinzufügst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a previous scan preview. Wait for the refresh to finish before adding items to review."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta es una vista previa del análisis anterior. Espera a que termine la actualización antes de añadir elementos a la revisión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci est un aperçu de l’analyse précédente. Attendez la fin de l’actualisation avant d’ajouter des éléments à la vérification."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは前回のスキャンのプレビューです。更新が完了してからレビューに追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 스캔 미리보기입니다. 새로 고침이 끝난 후 검토에 추가하십시오."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é uma pré-visualização da análise anterior. Aguarde a atualização terminar antes de adicionar itens à revisão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это предварительный результат предыдущего сканирования. Дождитесь завершения обновления, прежде чем добавлять объекты на проверку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, önceki taramanın önizlemesidir. Öğeleri incelemeye eklemeden önce yenilemenin tamamlanmasını bekleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是上次扫描的预览。请等待刷新完成后再加入审阅。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是上次掃描的預覽。請等待重新整理完成後再加入審閱。"
          }
        }
      }
    },
    "storageExplorer.previousScanAgeFormat": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الفحص السابق: %@"
          }
        },
        "de": {
