    "storageExplorer.dropToReviewDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك أيضًا النقر على زر الإضافة بجانب العنصر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können auch auf das Plus neben einem Objekt klicken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can also click the plus button beside an item."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También puedes hacer clic en el botón más junto a un elemento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez aussi cliquer sur le bouton plus d’un élément."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目の横にあるプラスボタンでも追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목 옆의 더하기 버튼을 클릭할 수도 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Também pode clicar no botão de mais ao lado de um item."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Также можно нажать кнопку плюса рядом с объектом."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayrıca bir öğenin yanındaki artı düğmesine tıklayabilirsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "也可以点按项目旁的加号。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "也可以按一下項目旁的加號。"
          }
        }
      }
    },
    "storageExplorer.skippedDetailsHelp": {
      "extractionState": "manual",
      "localizations": {
