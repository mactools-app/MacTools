    "storageExplorer.spaceNote": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحجم على القرص لا يساوي المساحة القابلة للاسترداد. تؤثر البيانات المشتركة وسلة المهملات في السعة المتاحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Belegter Speicher ist nicht freigebbarer Speicher. Geteilte Daten und der Papierkorb beeinflussen die verfügbare Kapazität."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Size on disk is not recoverable space. Shared data and Trash affect available capacity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tamaño en disco no equivale al espacio recuperable. Los datos compartidos y la Papelera afectan a la capacidad disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La taille sur le disque ne correspond pas à l’espace récupérable. Les données partagées et la corbeille affectent la capacité disponible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスク上のサイズは解放可能な容量ではありません。共有データやゴミ箱は空き容量に影響します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스크 사용량은 확보 가능한 공간과 다릅니다. 공유 데이터와 휴지통은 사용 가능한 용량에 영향을 줍니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O tamanho no disco não corresponde ao espaço recuperável. Os dados partilhados e o Lixo afetam a capacidade disponível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размер на диске не равен освобождаемому месту. Общие данные и корзина влияют на доступную ёмкость."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diskteki boyut kazanılacak alan anlamına gelmez. Paylaşılan veriler ve çöp kutusu, kullanılabilir kapasiteyi etkiler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "占用空间不等于可释放空间；共享数据和废纸篓会影响实际可用容量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "佔用空間不等於可釋放空間；共用資料和垃圾桶會影響實際可用容量。"
          }
        }
      }
    },
