    "storageExplorer.reviewEmptyHelp": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف عنصرًا للمراجعة أولاً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie zuerst ein Objekt zur Prüfung hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add an item for review first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade primero un elemento para revisarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez d’abord un élément à vérifier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に項目をレビューに追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
