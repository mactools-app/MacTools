    "无法保存密钥，请检查钥匙串访问权限。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存密钥，请检查钥匙串访问权限。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save the key. Check Keychain access."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ المفتاح. تحقّق من الوصول إلى سلسلة المفاتيح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlüssel konnte nicht gesichert werden. Schlüsselbundzugriff prüfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar la clave. Comprueba el acceso al Llavero."
          }
