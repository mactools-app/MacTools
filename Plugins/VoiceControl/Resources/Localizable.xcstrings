    "密钥仅保存在本机钥匙串，费用由你的 OpenAI 账户承担。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥仅保存在本机钥匙串，费用由你的 OpenAI 账户承担。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keys stay in this Mac’s Keychain. Usage is billed to your OpenAI account."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ المفاتيح في سلسلة مفاتيح هذا الـ Mac فقط. تُحتسب تكلفة الاستخدام على حسابك في OpenAI."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlüssel bleiben im Schlüsselbund dieses Mac. Die Nutzung wird über dein OpenAI-Konto abgerechnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las claves se guardan en el Llavero de este Mac. El uso se factura a tu cuenta de OpenAI."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clés restent dans le trousseau de ce Mac. L’utilisation est facturée à votre compte OpenAI."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーはこの Mac のキーチェーンにのみ保存されます。利用料金はご自身の OpenAI アカウントに請求されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키는 이 Mac의 키체인에만 저장됩니다. 사용 요금은 본인의 OpenAI 계정에 청구됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As chaves ficam no Porta-chaves deste Mac. A utilização é cobrada à sua conta OpenAI."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключи хранятся в Связке ключей этого Mac. Использование оплачивается через ваш аккаунт OpenAI."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtarlar bu Mac’in Anahtar Zinciri’nde saklanır. Kullanım kendi OpenAI hesabınıza faturalandırılır."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "金鑰僅儲存在此 Mac 的鑰匙圈，費用由你的 OpenAI 帳戶負擔。"
          }
        }
      }
    },
