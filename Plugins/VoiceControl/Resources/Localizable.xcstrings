{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "API 密钥未通过验证，请检查后重新保存。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 密钥未通过验证，请检查后重新保存。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "API key authentication failed. Check and save your key again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر التحقق من مفتاح API. تحقّق منه واحفظه مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "API-Schlüssel konnte nicht bestätigt werden. Prüfen und erneut speichern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar la clave API. Revísala y vuelve a guardarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vérifier la clé API. Vérifiez-la puis enregistrez-la à nouveau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APIキーを確認できません。確認して再保存してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "API 키를 확인할 수 없습니다. 확인 후 다시 저장하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar a chave API. Verifique e guarde novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить ключ API. Проверьте и сохраните снова."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "API anahtarı doğrulanamadı. Kontrol edip yeniden kaydedin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "API 金鑰未通過驗證，請檢查後重新儲存。"
          }
        }
      }
    },
    "仅在开始对话后录音，并发送到 OpenAI 处理。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在开始对话后录音，并发送到 OpenAI 处理。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture audio only after starting a conversation and send it to OpenAI."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ التسجيل عند بدء المحادثة فقط، ويُرسل إلى OpenAI للمعالجة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnahme nur nach Gesprächsstart; Verarbeitung durch OpenAI."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo graba al iniciar la conversación y envía el audio a OpenAI."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement commence uniquement au début de la conversation et est envoyé à OpenAI."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話を開始したときのみ録音し、OpenAIに送信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화를 시작한 후에만 녹음하여 OpenAI로 전송합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só grava após iniciar a conversa e envia o áudio ao OpenAI."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись начинается только при начале разговора и отправляется в OpenAI."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca sohbet başlayınca kayıt yapılır ve işleme için OpenAI’a gönderilir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在開始對話後錄音，並傳送到 OpenAI 處理。"
          }
        }
      }
    },
