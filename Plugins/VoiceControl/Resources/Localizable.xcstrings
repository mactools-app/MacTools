        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı kesildi. Ağı, API kotasını ve model erişimini kontrol edin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線已中斷，請檢查網路、API 額度和模型權限後重試"
          }
        }
      }
    },
