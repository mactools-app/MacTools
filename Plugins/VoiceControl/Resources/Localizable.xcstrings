        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتفظ إيقاف هذا الخيار بالاختيارات الحالية. تتطلب المكونات الإضافية الجديدة موافقة يدوية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
