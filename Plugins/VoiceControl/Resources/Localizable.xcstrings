    "密钥已保存，开始对话时将验证 API 访问权限。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥已保存，开始对话时将验证 API 访问权限。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Key saved. API access will be verified when you start a conversation."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم حفظ المفتاح. سيُتحقّق من وصول API عند بدء المحادثة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlüssel gespeichert. API-Zugriff wird beim Gesprächsstart geprüft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clave guardada. El acceso a la API se comprobará al iniciar la conversación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clé enregistrée. L’accès API sera vérifié au début de la conversation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーを保存しました。会話開始時にAPIアクセスを確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 저장했습니다. 대화를 시작할 때 API 접근을 확인합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Chave guardada. O acesso à API será verificado ao iniciar a conversa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ сохранён. Доступ к API будет проверен при начале разговора."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtar kaydedildi. API erişimi sohbet başlarken doğrulanır."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "金鑰已儲存，開始對話時將驗證 API 存取權限。"
          }
        }
      }
    },
    "密钥格式不正确，请检查后重试。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥格式不正确，请检查后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key format is invalid. Check it and try again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنسيق المفتاح غير صحيح. تحقّق منه وأعد المحاولة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungültiges Schlüsselformat. Prüfen und erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El formato de la clave no es válido. Revísala e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le format de la clé est incorrect. Vérifiez puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーの形式が正しくありません。確認して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 형식이 올바르지 않습니다. 확인 후 다시 시도하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O formato da chave é inválido. Verifique e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неверный формат ключа. Проверьте и повторите."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtar biçimi geçersiz. Kontrol edip tekrar deneyin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "金鑰格式不正確，請檢查後重試。"
          }
        }
      }
    },
    "对话已到时，请重新开始": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对话已到时，请重新开始"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversation time limit reached. Start again to continue."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
