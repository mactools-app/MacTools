    "请求过于频繁，请稍后重新开始对话。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many requests. Try starting the conversation again shortly."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طلبات كثيرة جدًا. حاول بدء المحادثة مجددًا بعد قليل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Anfragen. Das Gespräch in Kürze erneut starten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiadas solicitudes. Vuelve a iniciar la conversación dentro de poco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de requêtes. Réessayez de démarrer la conversation dans un instant."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストが多すぎます。しばらくしてから会話を再開してください。"
