          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligação interrompida. Verifique a rede, a quota API e o acesso ao modelo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Соединение прервано. Проверьте сеть, квоту API и доступ к модели."
