    "关闭后保留当前选择，新插件需手动允许。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后保留当前选择，新插件需手动允许。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current selections are kept when this is off. New plugins require manual approval."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉後保留目前選擇，新外掛需手動允許。"
