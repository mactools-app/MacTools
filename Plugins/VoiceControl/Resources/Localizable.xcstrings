        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung unterbrochen. Netzwerk, API-Kontingent und Modellzugriff prüfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conexión interrumpida. Revisa la red, la cuota API y el acceso al modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion interrompue. Vérifiez le réseau, le quota API et l’accès au modèle."
