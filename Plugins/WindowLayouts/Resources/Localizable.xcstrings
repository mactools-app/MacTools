    "settings.modifierDrag.enabled.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move the pointer to drag the window beneath it without holding a mouse button."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fare düğmesini basılı tutmadan, işaretçiyi hareket ettirerek altındaki pencereyi sürükleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移动指针即可拖移其下方窗口，不必按住鼠标按钮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移動指標即可拖移其下方視窗，不必按住滑鼠按鈕。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حرك المؤشر لسحب النافذة الموجودة أسفله دون الضغط على زر الماوس."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewegen Sie den Zeiger, um das darunterliegende Fenster zu verschieben, ohne eine Maustaste gedrückt zu halten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve el puntero para arrastrar la ventana situada debajo sin mantener pulsado un botón del ratón."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacez le pointeur pour faire glisser la fenêtre en dessous sans maintenir le bouton de la souris enfoncé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マウスボタンを押さずに、ポインタを動かすだけでポインタの下にあるウィンドウをドラッグできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마우스 버튼을 누르지 않고 포인터를 움직여 그 아래의 윈도우를 드래그할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mova o ponteiro para arrastar a janela sob ele sem manter um botão do mouse pressionado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переместите указатель, чтобы перетащить окно под ним, не удерживая кнопку мыши."
          }
        }
      }
    },
    "settings.modifierDrag.modifiers.title": {
