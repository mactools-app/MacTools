{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "settings.centeredGuides.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to enable centered window guides. Check Accessibility access and try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencere ortalama kılavuzları etkinleştirilemiyor. Erişilebilirlik iznini kontrol edip yeniden deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法启用窗口居中参考线，请检查辅助功能权限后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法啟用視窗置中參考線，請檢查輔助使用權限後再試。"
          }
        }
      }
    },
    "settings.centeredGuides.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Centered window guides"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencere Ortalama Kılavuzları"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口居中参考线"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "視窗置中參考線"
          }
        }
      }
    },
    "settings.centeredGuides.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show guides while dragging other apps’ windows; release near the center to snap. Requires Accessibility access."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer uygulamaların pencereleri sürüklenirken kılavuzlar gösterilir; merkeze yakın bıraktığınızda pencere ortalanır. Erişilebilirlik izni gerektirir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移其他应用的窗口时显示参考线，靠近中心松开即可居中。需要辅助功能权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移其他應用程式的視窗時顯示參考線，靠近中心放開即可置中。需要輔助使用權限。"
          }
        }
      }
    },
    "metadata.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Window Layouts"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencere Düzenleri"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口布局"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "視窗佈局"
          }
        }
      }
    },
    "metadata.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrange the focused window and create custom layouts"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaklı pencereyi yerleştirin ve özel düzenler oluşturun"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "排列聚焦窗口并创建自定义布局"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "排列聚焦視窗並建立自訂佈局"
          }
        }
      }
    },
    "permission.accessibility.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişilebilirlik"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輔助使用"
          }
        }
      }
    },
    "permission.accessibility.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to read and adjust application window positions, sizes, and full-screen state."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama pencerelerinin konumlarını, boyutlarını ve tam ekran durumunu okumak ve ayarlamak için kullanılır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于读取并调整应用窗口的位置、大小和全屏状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於讀取並調整應用程式視窗的位置、大小和全螢幕狀態。"
          }
        }
      }
    },
    "permission.accessibility.footnote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In System Settings → Privacy & Security → Accessibility, allow MacTools."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Ayarları → Gizlilik ve Güvenlik → Erişilebilirlik bölümünde MacTools'a izin verin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统设置 → 隐私与安全性 → 辅助功能中允许 MacTools。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在系統設定 → 隱私權與安全性 → 輔助使用中允許 MacTools。"
          }
        }
      }
    },
    "settings.layout.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Window Spacing"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencere Aralığı"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口间距"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "視窗間距"
          }
        }
      }
    },
    "settings.gap.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Window Gaps"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencere Boşlukları"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口间距"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "視窗間距"
          }
        }
      }
    },
    "settings.gap.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave space at screen edges and between adjacent tiled windows."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran kenarlarında ve bitişik döşenen pencereler arasında boşluk bırakır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在屏幕边缘和相邻平铺窗口之间保留间距。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在螢幕邊緣和相鄰平鋪視窗之間保留間距。"
          }
        }
      }
    },
    "settings.reset.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore Defaults"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılanlara Dön"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复默认设置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回復預設設定"
          }
        }
      }
    },
    "settings.reset.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore layout behavior defaults without deleting custom commands or shortcuts."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özel komutları veya kısayolları silmeden düzen davranışı varsayılanlarını geri yükler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复布局行为默认值，不会删除自定义命令或快捷键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回復佈局行為預設值，不會刪除自訂指令或快速鍵。"
          }
        }
      }
    },
    "settings.reset.button": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri Yükle"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回復"
          }
        }
      }
    },
    "settings.shortcuts.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Window Layout Shortcuts"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencere Düzeni Kısayolları"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口布局快捷键"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "視窗佈局快速鍵"
          }
        }
      }
    },
    "settings.shortcuts.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a preset, then customize any global shortcut individually."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazır bir ayar kullanın, ardından dilediğiniz genel kısayolu tek tek özelleştirin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可使用预设，也可逐项录制自己的全局快捷键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可使用預設，也可逐項錄製自己的全域快速鍵。"
          }
        }
      }
    },
    "settings.behavior.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Layout Behavior"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzen Davranışı"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "布局行为"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "佈局行為"
          }
        }
      }
    },
    "settings.cycles.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cycle Half-screen Sizes"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yarım Ekran Boyutları Arasında Geçiş"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "循环半屏尺寸"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "循環半螢幕尺寸"
          }
        }
      }
    },
    "settings.cycles.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repeat any half-screen command to cycle through one-half, two-thirds, and one-third on the same display."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı ekranda yarım, üçte iki ve üçte bir boyutları arasında geçiş yapmak için herhangi bir yarım ekran komutunu yineleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重复执行任一半屏命令时，在当前显示器上的二分之一、三分之二和三分之一之间循环。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重複執行任一半螢幕指令時，在目前顯示器上的二分之一、三分之二和三分之一之間循環。"
          }
        }
      }
    },
    "settings.stageManager.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Avoid Stage Manager"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stage Manager'dan Kaçın"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "避让台前调度"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "避讓幕前調度"
          }
        }
      }
    },
    "settings.stageManager.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep windows clear of visible Stage Manager thumbnails."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencereleri görünür Stage Manager küçük resimlerinden uzak tutar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "台前调度缩略图可见时，不把窗口放到缩略图下方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "幕前調度縮圖可見時，不將視窗放在縮圖下方。"
          }
        }
      }
    },
    "settings.feedback.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show Command Feedback"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Komut Geri Bildirimini Göster"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示命令反馈"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示指令回饋"
          }
        }
      }
    },
    "settings.feedback.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Briefly show successful global shortcuts and trackpad gestures. Failures are always shown."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başarılı genel kısayolları ve Trackpad hareketlerini kısa süreyle gösterir. Başarısız durumlar her zaman gösterilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用全局快捷键或触控板手势时，短暂显示成功提示；失败始终显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用全域快捷鍵或觸控板手勢時，短暫顯示成功提示；失敗一律顯示。"
          }
        }
      }
    },
    "settings.modifierDrag.sectionTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifier Drag"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değiştirici Tuşla Sürükleme"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修饰键拖移"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "修飾鍵拖移"
          }
        }
      }
    },
    "settings.modifierDrag.enabled.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move Windows with Modifiers"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencereleri Değiştirici Tuşlarla Taşı"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按修饰键拖移窗口"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按修飾鍵拖移視窗"
          }
        }
      }
    },
    "settings.modifierDrag.enabled.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move the pointer to drag the window beneath it without holding a mouse button."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fare düğmesini basılı tutmadan, işaretçiyi hareket ettirerek altındaki pencereyi sürükleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移动指针即可拖移其下方窗口，不必按住鼠标按钮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移動指標即可拖移其下方視窗，不必按住滑鼠按鈕。"
          }
        }
      }
    },
    "settings.modifierDrag.modifiers.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifier Combination"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değiştirici Tuş Birleşimi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修饰键组合"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "修飾鍵組合"
          }
        }
      }
    },
    "settings.modifierDrag.modifiers.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold exactly the selected keys. An extra modifier cancels the drag."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili tuşları tam olarak basılı tutun. Ek bir değiştirici tuş sürüklemeyi iptal eder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "必须精确按住所选按键；额外的修饰键会取消拖移。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "必須精確按住所選按鍵；額外的修飾鍵會取消拖移。"
          }
        }
      }
    },
    "settings.modifierDrag.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the exact combination and move the pointer to drag the topmost window beneath it. No click is needed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam birleşimi basılı tutup işaretçiyi hareket ettirerek altındaki en üstteki pencereyi sürükleyin. Tıklama gerekmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
