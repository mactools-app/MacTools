    "action.increase-width.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "زيادة عرض النافذة المركزة بمقدار 50 نقطة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergrößert die Breite des fokussierten Fensters um 50 Punkte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Increase the focused window width by 50 points."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumenta la anchura de la ventana enfocada en 50 puntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Augmente la largeur de la fenêtre active de 50 points."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーカスされたウインドウの幅を 50 ポイント拡大します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포커스된 윈도우의 너비를 50포인트 늘립니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumenta a largura da janela em foco em 50 pontos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Увеличивает ширину активного окна на 50 пунктов."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaklı pencerenin genişliğini 50 nokta artırır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将聚焦窗口宽度增加 50 点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將聚焦視窗寬度增加 50 點。"
          }
        }
