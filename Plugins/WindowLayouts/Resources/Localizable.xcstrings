    "settings.cycles.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repeat any half-screen command to cycle through one-half, two-thirds, and one-third on the same display."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı ekranda yarım, üçte iki ve üçte bir boyutları arasında geçiş yapmak için herhangi bir yarım ekran komutunu yineleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重复执行任一半屏命令时，在当前显示器上的二分之一、三分之二和三分之一之间循环。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重複執行任一半螢幕指令時，在目前顯示器上的二分之一、三分之二和三分之一之間循環。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كرر أي أمر نصف الشاشة للتنقل بين النصف والثلثين والثلث على نفس الشاشة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederholen Sie einen beliebigen Befehl für eine Bildschirmhälfte, um zwischen einer Hälfte, zwei Dritteln und einem Drittel auf demselben Bildschirm zu wechseln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Repita cualquier comando de media pantalla para recorrer la mitad, dos tercios y un tercio en la misma pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répétez n'importe quelle commande demi-écran pour parcourir la moitié, les deux tiers et un tiers sur le même écran."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "半画面コマンドを繰り返して、同じディスプレイ上で 2 分の 1、3 分の 2、および 3 分の 1 を循環させます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동일한 디스플레이에서 1/2, 2/3, 1/3을 순환하려면 절반 화면 명령을 반복하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Repita qualquer comando de meia tela para percorrer metade, dois terços e um terço na mesma tela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторяйте команду размещения на половине экрана, чтобы окно поочередно занимало половину, две трети и одну треть того же дисплея."
          }
        }
      }
    },
