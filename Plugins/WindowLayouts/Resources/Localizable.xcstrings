          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住精確組合並移動指標，即可拖移指標下方最上層視窗；無需點按。"
          }
        }
      }
    },
    "settings.modifierDrag.singleWarning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A single modifier is easy to trigger accidentally. Two or more modifiers are recommended."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek bir değiştirici tuş kolayca yanlışlıkla tetiklenebilir. İki veya daha fazla değiştirici tuş önerilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单个修饰键容易误触，建议使用两个或更多修饰键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "單個修飾鍵容易誤觸，建議使用兩個或更多修飾鍵。"
          }
        }
      }
    },
    "settings.modifierDrag.conflictFormat": {
