          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los atajos de teclado solo cambiarán cuando hagas clic en Aplicar preajuste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun raccourci ne change jusqu'à ce que vous cliquiez sur Appliquer le préréglage."
          }
