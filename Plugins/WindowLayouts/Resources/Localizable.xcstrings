    "settings.preset.resolveConflicts": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolve the marked shortcut conflicts before applying this preset."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hazır ayarı uygulamadan önce işaretli kısayol çakışmalarını çözün."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先解决标记的快捷键冲突，再应用预设。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先解決標記的快速鍵衝突，再套用預設。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بحل تعارضات الاختصارات المحددة قبل تطبيق هذا الإعداد المسبق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beheben Sie die markierten Tastenkombinationskonflikte, bevor Sie diese Voreinstellung anwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resuelve los conflictos de atajos de teclado marcados antes de aplicar este preajuste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Résolvez les conflits de raccourcis marqués avant d'appliquer ce préréglage."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプリセットを適用する前に、マークされたショートカットの競合を解決してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사전 설정을 적용하기 전에 표시된 단축키 충돌을 해결하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolva os conflitos de atalho marcados antes de aplicar esta predefinição."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устраните отмеченные конфликты сочетаний клавиш перед применением этой предустановки."
          }
        }
      }
    },
    "settings.preset.notAppliedDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No shortcuts change until you click Apply Preset."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazır Ayarı Uygula düğmesine tıklayana kadar hiçbir kısayol değişmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在点击“应用预设”前，不会修改任何快捷键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在點按「套用預設」前，不會修改任何快速鍵。"
          }
        },
        "ar": {
