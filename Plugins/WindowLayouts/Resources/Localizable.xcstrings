    "metadata.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrange the focused window and create custom layouts"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaklı pencereyi yerleştirin ve özel düzenler oluşturun"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "排列聚焦窗口并创建自定义布局"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "排列聚焦視窗並建立自訂佈局"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رتّب النافذة النشطة وأنشئ تخطيطات مخصصة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktives Fenster anordnen und benutzerdefinierte Layouts erstellen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Organiza la ventana activa y crea diseños personalizados"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Organisez la fenêtre ciblée et créez des dispositions personnalisées"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーカスされたウィンドウを配置し、カスタム レイアウトを作成します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포커스된 창을 정렬하고 맞춤 레이아웃을 만듭니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Organize a janela em foco e crie layouts personalizados"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размещайте активное окно и создавайте собственные схемы расположения"
          }
        }
      }
    },
