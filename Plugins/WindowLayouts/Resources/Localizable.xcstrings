    "error.executionQueueFull": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many window layout operations are waiting."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekleyen çok fazla pencere düzeni işlemi var."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待中的窗口布局操作过多。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等待中的視窗佈局操作過多。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هناك عدد كبير جدًا من عمليات تخطيط النافذة قيد الانتظار."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es warten zu viele Vorgänge zur Fensteranordnung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay demasiadas operaciones de diseño de ventanas en espera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop d'opérations de disposition des fenêtres sont en attente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "待機中のウィンドウ レイアウト操作が多すぎます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대기 중인 창 레이아웃 작업이 너무 많습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Muitas operações de layout de janela estão aguardando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В очереди слишком много операций размещения окон."
          }
        }
      }
