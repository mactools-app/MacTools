    "settings.feedback.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Briefly show feedback for successful global shortcuts and trackpad gestures. Failures are always shown."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başarılı genel kısayolları ve Trackpad hareketlerini kısa süreyle gösterir. Başarısız durumlar her zaman gösterilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用全局快捷键或触控板手势时，短暂显示成功提示；失败始终显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用全域快捷鍵或觸控板手勢時，短暫顯示成功提示；失敗一律顯示。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار إشعار وجيز عند نجاح الاختصارات العامة وإيماءات لوحة التعقب. تظهر حالات الفشل دائمًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfolgreiche globale Tastenkombinationen und Trackpad-Gesten kurz anzeigen. Fehler werden immer angezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra brevemente las acciones realizadas mediante atajos de teclado globales o gestos del trackpad. Los errores se muestran siempre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche brièvement une confirmation après une action réussie via un raccourci global ou un geste du trackpad. Les échecs sont toujours affichés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グローバルショートカットやトラックパッドのジェスチャが成功したときに、通知を短時間表示します。失敗は常に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전역 단축키나 트랙패드 제스처 실행에 성공하면 잠깐 알림을 표시합니다. 실패 알림은 항상 표시합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostre brevemente uma indicação de sucesso ao usar atalhos globais e gestos do trackpad. As falhas são sempre mostradas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кратко показывать результат глобальных сочетаний клавиш и жестов трекпада. Ошибки показываются всегда."
          }
        }
      }
    },
