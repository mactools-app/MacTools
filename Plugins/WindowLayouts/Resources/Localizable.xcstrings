        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم استبدال اختصارات تخطيط النافذة التي تم وضع علامة عليها على أنها تغيرت في المعاينة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als geändert markierte Tastenkombinationen für das Fensterlayout werden ersetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se sustituirán los atajos de teclado de Diseños de ventanas marcados como modificados en la vista previa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les raccourcis de disposition des fenêtres marqués comme modifiés dans l'aperçu seront remplacés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビューで変更対象としてマークされたウィンドウレイアウトのショートカットを置き換えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리보기에서 변경 대상으로 표시된 윈도우 레이아웃 단축키가 교체됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os atalhos de layout de janela marcados como alterados na visualização serão substituídos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сочетания клавиш плагина «Расположение окон», отмеченные как измененные в предварительном просмотре, будут заменены."
          }
        }
      }
    },
