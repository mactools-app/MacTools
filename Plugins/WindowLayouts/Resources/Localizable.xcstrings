        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Platz für sichtbare Miniaturansichten von Stage Manager lassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene las ventanas alejadas de las miniaturas visibles de Organizador Visual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Évitez que les fenêtres recouvrent les vignettes visibles de Stage Manager."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示中のステージマネージャのサムネイルとウィンドウが重ならないようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스테이지 매니저 축소판이 보일 때 윈도우가 축소판과 겹치지 않도록 배치합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha as janelas fora da área das miniaturas visíveis do Organizador Visual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размещать окна так, чтобы они не перекрывали видимые миниатюры Постановщика."
          }
        }
      }
    },
