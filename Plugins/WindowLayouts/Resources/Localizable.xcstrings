    "error.accessibilityRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Window Layouts requires Accessibility permission."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencere Düzenleri, Erişilebilirlik iznini gerektirir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口布局需要辅助功能权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "視窗佈局需要輔助使用權限。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتطلب تخطيطات النوافذ إذن تسهيلات الاستخدام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Fensterlayouts ist die Berechtigung für Bedienungshilfen erforderlich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Diseños de ventanas requiere permiso de Accesibilidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dispositions de fenêtres nécessitent une autorisation d'accessibilité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィンドウ レイアウトにはアクセシビリティ権限が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "윈도우 레이아웃에는 손쉬운 사용 권한이 필요합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Layouts de janelas requerem permissão de Acessibilidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для плагина «Расположение окон» требуется разрешение на универсальный доступ."
          }
        }
      }
    },
    "error.modifierDragMonitorUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to start global pointer monitoring. Turn Modifier Drag off and on to try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Genel işaretçi izleme başlatılamadı. Yeniden denemek için Değiştirici Tuşla Sürükleme özelliğini kapatıp açın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法启动全局指针监控。请关闭后重新开启修饰键拖移。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法啟動全域指標監控。請關閉後重新開啟修飾鍵拖移。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتعذر بدء مراقبة المؤشر على مستوى النظام. عطّل السحب باستخدام مفاتيح التعديل ثم فعّله للمحاولة مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die globale Zeigerüberwachung konnte nicht gestartet werden. Deaktivieren Sie „Ziehen mit Sondertasten“ und aktivieren Sie es erneut, um es noch einmal zu versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar la supervisión global del puntero. Desactiva y vuelve a activar Arrastrar con teclas modificadoras para reintentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de démarrer la surveillance globale du pointeur. Désactivez puis réactivez le glissement avec touches de modification pour réessayer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポインタのグローバル監視を開始できません。修飾キーでのドラッグをオフにしてから、再度オンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전역 포인터 모니터링을 시작할 수 없습니다. 보조 키 드래그를 껐다가 켜서 다시 시도하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível iniciar o monitoramento global do ponteiro. Desative e ative Arrastar com teclas modificadoras para tentar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось начать отслеживание указателя. Выключите и снова включите перетаскивание с клавишами-модификаторами."
          }
        }
      }
    },
    "error.noFocusedWindow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No focused window is available."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanılabilir odaklı pencere yok."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可用的聚焦窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有可用的聚焦視窗。"
          }
