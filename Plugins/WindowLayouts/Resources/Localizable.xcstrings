    "settings.preset.currentDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the preset assistant to review changes and conflicts before applying."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamadan önce değişiklikleri ve çakışmaları incelemek için hazır ayar asistanını açın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开预设助手，先查看更改和冲突，再决定是否应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟預設助理，先查看變更和衝突，再決定是否套用。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح مساعد الإعدادات المسبقة لمراجعة التغييرات والتعارضات قبل التطبيق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne den Vorgaben-Assistenten, um Änderungen und Konflikte vor dem Anwenden zu überprüfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el asistente de preajustes para revisar los cambios y conflictos antes de aplicarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez l'assistant de préréglage pour examiner les modifications et les conflits avant de les appliquer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プリセット アシスタントを開いて、適用する前に変更と競合を確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사전 설정 도우미를 열어 적용하기 전에 변경 사항과 충돌을 검토하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o assistente de predefinições para revisar alterações e conflitos antes de aplicar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте помощник по настройкам, чтобы просмотреть изменения и конфликты перед применением."
          }
        }
      }
    },
