    "settings.custom.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Combine relative or fixed dimensions, nine anchor positions, and offsets for shortcuts or Run Links."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Göreli veya sabit boyutları, dokuz çapa konumunu ve ofsetleri birleştirin; kısayol veya Run Link olarak kullanın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可组合相对或固定大小、九点定位和偏移，并作为快捷键或 Run Link 使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可組合相對或固定大小、九點定位和偏移，並作為快速鍵或 Run Link 使用。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ادمج الأبعاد النسبية أو الثابتة، وتسعة مواضع ارتكاز، وإزاحات للاختصارات أو روابط التشغيل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kombinieren Sie relative oder feste Abmessungen, neun Ankerpositionen und Versätze für Tastenkombinationen oder Ausführungslinks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Combina dimensiones relativas o fijas, nueve posiciones de anclaje y desplazamientos para atajos de teclado o enlaces de ejecución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combinez des dimensions relatives ou fixes, neuf positions d'ancrage et des décalages pour les raccourcis ou les liens d'exécution."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相対サイズまたは固定サイズ、9 つの基準位置、オフセットを組み合わせ、ショートカットや Run Link から利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키 또는 실행 링크로 사용할 수 있도록 상대 크기 또는 고정 크기, 9개의 앵커 위치 및 오프셋을 조합합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Combine dimensões relativas ou fixas, nove posições de ancoragem e deslocamentos para atalhos ou links de execução."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Комбинируйте относительные или фиксированные размеры, девять позиций привязки и смещения для сочетаний клавиш или ссылок запуска."
          }
        }
      }
    },
