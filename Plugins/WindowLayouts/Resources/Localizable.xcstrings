{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "settings.centeredGuides.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to enable centered window guides. Check Accessibility access and try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencere ortalama kılavuzları etkinleştirilemiyor. Erişilebilirlik iznini kontrol edip yeniden deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法启用窗口居中参考线，请检查辅助功能权限后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法啟用視窗置中參考線，請檢查輔助使用權限後再試。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتعذر تفعيل خطوط إرشاد توسيط النوافذ. تحقق من إذن تسهيلات الاستخدام وحاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zentrierte Fensterhilfslinien konnten nicht aktiviert werden. Überprüfen Sie den Zugriff auf die Bedienungshilfen und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pueden habilitar las guías de ventana centradas. Verifique el acceso a Accesibilidad e inténtelo nuevamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'activer les guides de fenêtre centrés. Vérifiez l'accès à l'accessibilité et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィンドウの中央配置ガイドを有効にできません。アクセシビリティの許可を確認して、再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "윈도우 가운데 정렬 안내선을 활성화할 수 없습니다. 손쉬운 사용 권한을 확인하고 다시 시도하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível ativar guias de janela centralizadas. Verifique a permissão de Acessibilidade e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось включить направляющие для центрирования окон. Проверьте разрешение на универсальный доступ и повторите попытку."
          }
        }
      }
    },
    "settings.centeredGuides.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Centered window guides"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencere Ortalama Kılavuzları"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口居中参考线"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "視窗置中參考線"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خطوط إرشاد توسيط النوافذ"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zentrierte Fensterhilfslinien"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guías de ventana centradas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Guides de fenêtre centrés"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィンドウの中央配置ガイド"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "윈도우 가운데 정렬 안내선"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Guias de janela centralizadas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Направляющие для центрирования окон"
          }
        }
      }
    },
    "settings.centeredGuides.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show guides while dragging other apps’ windows; release near the center to snap. Requires Accessibility access."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer uygulamaların pencereleri sürüklenirken kılavuzlar gösterilir; merkeze yakın bıraktığınızda pencere ortalanır. Erişilebilirlik izni gerektirir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移其他应用的窗口时显示参考线，靠近中心松开即可居中。需要辅助功能权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移其他應用程式的視窗時顯示參考線，靠近中心放開即可置中。需要輔助使用權限。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار خطوط الإرشاد أثناء سحب نوافذ التطبيقات الأخرى؛ أفلت النافذة قرب المركز لتوسيطها. يلزم إذن تسهيلات الاستخدام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilfslinien beim Verschieben von Fenstern anderer Apps anzeigen; nahe der Mitte loslassen, um das Fenster einzurasten. Erfordert die Berechtigung für Bedienungshilfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra guías al arrastrar ventanas de otras apps; suelta la ventana cerca del centro para centrarla. Requiere permiso de Accesibilidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher des guides lorsque vous faites glisser les fenêtres d’autres apps ; relâchez près du centre pour aligner la fenêtre. Nécessite l’autorisation Accessibilité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのアプリのウィンドウをドラッグ中にガイドを表示します。中央付近で放すと、ウィンドウを中央に配置します。アクセシビリティの許可が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱의 윈도우를 드래그하는 동안 안내선을 표시합니다. 중앙 근처에서 놓으면 윈도우가 중앙에 맞춰집니다. 손쉬운 사용 권한이 필요합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar guias ao arrastar janelas de outros aplicativos; solte perto do centro para encaixar. Requer permissão de Acessibilidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать направляющие при перетаскивании окон других приложений; отпустите окно около центра, чтобы расположить его по центру. Требуется разрешение на универсальный доступ."
          }
        }
      }
    },
