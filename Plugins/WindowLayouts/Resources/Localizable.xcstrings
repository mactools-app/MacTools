    "settings.preset.applyDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only replace the previewed Window Layouts shortcuts after confirmation."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önizlenen pencere düzeni kısayolları yalnızca onaydan sonra değiştirilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在确认后替换预览中列出的窗口布局快捷键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在確認後取代預覽中列出的視窗佈局快速鍵。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استبدل اختصارات تخطيط النافذة التي تمت معاينتها فقط بعد التأكيد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastenkombinationen für das Fensterlayout aus der Vorschau erst nach Bestätigung ersetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sustituye los atajos de teclado de Diseños de ventanas mostrados en la vista previa solo tras la confirmación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les raccourcis prévisualisés de Disposition des fenêtres seront remplacés après confirmation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認後に、プレビューに表示されたウィンドウレイアウトのショートカットだけを置き換えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리보기에 표시된 윈도우 레이아웃 단축키만 확인 후 교체합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Substitua apenas os atalhos de layout de janela visualizados após a confirmação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После подтверждения заменяются только сочетания клавиш плагина «Расположение окон», показанные в предварительном просмотре."
          }
