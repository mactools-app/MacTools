    "settings.modifierDrag.modifiers.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold exactly the selected keys. An extra modifier cancels the drag."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili tuşları tam olarak basılı tutun. Ek bir değiştirici tuş sürüklemeyi iptal eder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只能按住所选修饰键；按下其他修饰键将取消拖移。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "必須精確按住所選按鍵；額外的修飾鍵會取消拖移。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مع الاستمرار على المفاتيح المحددة فقط. يؤدي الضغط على مفتاح تعديل إضافي إلى إلغاء السحب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie genau die ausgewählten Tasten gedrückt. Eine zusätzliche Sondertaste bricht das Verschieben ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenga presionadas exactamente las teclas seleccionadas. Un modificador adicional cancela el arrastre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez exactement les touches sélectionnées. Un modificateur supplémentaire annule le glissement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した修飾キーだけを押し続けてください。ほかの修飾キーも押すと、ドラッグがキャンセルされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 키만 정확히 누르고 있으세요. 다른 보조 키를 추가로 누르면 드래그가 취소됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure exatamente as teclas selecionadas. Um modificador extra cancela o arrasto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте ровно выбранные клавиши. Дополнительный модификатор отменяет перетаскивание."
          }
        }
      }
    },
    "settings.modifierDrag.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the exact combination and move the pointer to drag the topmost window beneath it. No click is needed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam birleşimi basılı tutup işaretçiyi hareket ettirerek altındaki en üstteki pencereyi sürükleyin. Tıklama gerekmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅按住所选组合键并移动指针，即可拖移指针下方最上层窗口；无需点击。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住精確組合並移動指標，即可拖移指標下方最上層視窗；無需點按。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مع الاستمرار على تركيبة المفاتيح المحددة وحرك المؤشر لسحب النافذة الأمامية الواقعة تحته. لا يلزم النقر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie die genaue Kombination und bewegen Sie den Zeiger, um das oberste darunterliegende Fenster zu verschieben. Ein Klick ist nicht erforderlich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada la combinación exacta y mueve el puntero para arrastrar la ventana superior situada debajo del puntero. No hace falta hacer clic."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez la combinaison exacte et déplacez le pointeur pour faire glisser la fenêtre au premier plan sous le pointeur. Aucun clic n’est nécessaire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指定したキーの組み合わせだけを押し続けながらポインタを動かすと、ポインタの下にある最前面のウィンドウをドラッグできます。クリックは不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정확한 조합을 누른 상태에서 포인터를 이동하여 그 아래의 맨 위 창을 드래그하세요. 클릭이 필요하지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure a combinação exata e mova o ponteiro para arrastar a janela mais à frente sob ele. Nenhum clique é necessário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте точную комбинацию и перемещайте указатель, чтобы перетащить самое верхнее окно под ним. Никакого щелчка не требуется."
          }
        }
      }
    },
    "settings.modifierDrag.singleWarning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A single modifier is easy to trigger accidentally. Two or more modifiers are recommended."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek bir değiştirici tuş kolayca yanlışlıkla tetiklenebilir. İki veya daha fazla değiştirici tuş önerilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单个修饰键容易误触，建议使用两个或更多修饰键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "單個修飾鍵容易誤觸，建議使用兩個或更多修飾鍵。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسهل تفعيل السحب عن طريق الخطأ عند استخدام مفتاح تعديل واحد. يُنصح باستخدام مفتاحي تعديل أو أكثر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine einzelne Sondertaste kann leicht versehentlich ausgelöst werden. Zwei oder mehr Sondertasten werden empfohlen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es fácil activar accidentalmente un único modificador. Se recomiendan dos o más modificadores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul modificateur est facile à déclencher accidentellement. Deux modificateurs ou plus sont recommandés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "修飾キーが 1 つだけだと、誤って作動しやすくなります。2 つ以上の修飾キーの使用をお勧めします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보조 키를 하나만 사용하면 실수로 동작을 실행하기 쉽습니다. 두 개 이상의 보조 키를 권장합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um único modificador é fácil de ativar acidentalmente. Dois ou mais modificadores são recomendados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один модификатор легко активировать случайно. Рекомендуется использовать два или более модификаторов."
          }
        }
      }
    },
    "settings.modifierDrag.conflictFormat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This combination is used by “%@”. Modifier Drag is paused."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu tuş birleşimi “%@” tarafından kullanılıyor. Değiştirici Tuşla Sürükleme duraklatıldı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该组合正由“%@”使用。修饰键拖移已暂停。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此組合正由「%@」使用。修飾鍵拖移已暫停。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم «%@» هذه التركيبة. تم إيقاف السحب باستخدام مفاتيح التعديل مؤقتًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Kombination wird von „%@“ verwendet. Das Ziehen mit Sondertasten ist pausiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta combinación la utiliza «%@». Arrastrar con teclas modificadoras está en pausa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette combinaison est utilisée par « %@ ». Le glissement avec touches de modification est suspendu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この組み合わせは「%@」で使用されています。修飾キーでのドラッグは一時停止しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 조합은 ‘%@’에서 사용 중입니다. 보조 키 드래그가 일시 중지되었습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta combinação é usada por “%@”. Arrastar com teclas modificadoras está pausado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это сочетание используется плагином «%@». Перетаскивание с клавишами-модификаторами приостановлено."
          }
        }
      }
    },
