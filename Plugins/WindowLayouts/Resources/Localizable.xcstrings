    "settings.modifierDrag.showsIndicator.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show Modifier Drag Indicator"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değiştirici Tuşla Sürükleme Göstergesini Göster"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示修饰键拖移指示器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示修飾鍵拖移指示器"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار مؤشر السحب باستخدام مفاتيح التعديل"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anzeige für das Ziehen mit Sondertasten einblenden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar indicador de arrastre con teclas modificadoras"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher l’indicateur de glissement avec touches de modification"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "修飾キーによるドラッグのインジケータを表示"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보조 키 드래그 표시기 보기"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar indicador de arraste com teclas modificadoras"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать индикатор перетаскивания с клавишами-модификаторами"
          }
        }
      }
    },
    "settings.modifierDrag.showsIndicator.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show a compact indicator by the pointer when dragging is ready or active, or when no movable window is found."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürükleme hazırken, etkinken veya taşınabilir pencere bulunamadığında durum bildiren küçük bir işaretçi göstergesi gösterir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住修饰键或拖移窗口时，在指针旁显示状态提示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住修飾鍵或拖移視窗時，在指標旁顯示狀態提示。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار لوحة حالة صغيرة قرب المؤشر توضح متى يكون السحب جاهزًا أو نشطًا، أو يتعذر العثور على نافذة قابلة للنقل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompakte Anzeige am Zeiger einblenden, die zeigt, ob die Ziehfunktion bereit oder aktiv ist oder kein verschiebbares Fenster gefunden wurde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra un pequeño indicador junto al puntero para señalar si el arrastre está preparado, activo o no encuentra una ventana que se pueda mover."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher un indicateur compact près du pointeur pour signaler si le déplacement est prêt, en cours ou si aucune fenêtre déplaçable n’est trouvée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポインタのそばに小さな状態表示を出し、ドラッグ待機中、ドラッグ中、移動可能なウィンドウが見つからない状態を知らせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그할 준비가 되었는지, 드래그 중인지, 이동할 윈도우를 찾지 못했는지 포인터 옆의 작은 표시기로 알려 줍니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostre um indicador compacto junto ao ponteiro para informar se o arraste está pronto, ativo ou sem uma janela disponível para mover."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать компактный индикатор у указателя, когда перетаскивание готово, выполняется или нет окна, которое можно переместить."
          }
        }
      }
    },
    "settings.modifierDrag.hud.movePointer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move the pointer to reposition the window"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencereyi yeniden konumlandırmak için işaretçiyi hareket ettirin"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
