    "settings.preset.sheetDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a preset and review every change. No shortcuts change until you apply it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir hazır ayar seçin ve tüm değişiklikleri inceleyin. Uygulayana kadar hiçbir kısayol değişmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择预设并逐项查看更改；在点击应用前，不会修改任何快捷键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇預設並逐項查看變更；在點按套用前，不會修改任何快速鍵。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر إعدادًا مسبقًا وراجع كل تغيير. لا تتغير الاختصارات حتى تقوم بتطبيقها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine Vorgabe aus und überprüfe alle Änderungen. Es werden keine Tastenkombinationen geändert, bis du die Vorgabe anwendest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un preajuste y revisa cada cambio. Los atajos de teclado solo cambiarán cuando lo apliques."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un préréglage et examinez chaque modification. Aucun raccourci ne change jusqu'à ce que vous l'appliquiez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プリセットを選択し、すべての変更を確認します。適用するまでショートカットは変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사전 설정을 선택하고 모든 변경 사항을 검토하세요. 적용하기 전까지는 단축키가 변경되지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma predefinição e revise cada alteração. Nenhum atalho muda até que você aplique a predefinição."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите набор настроек и просмотрите каждое изменение. Никакие сочетания клавиш не меняются, пока вы их не примените."
          }
        }
      }
    },
