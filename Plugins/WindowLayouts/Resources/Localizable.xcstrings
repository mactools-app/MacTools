    "settings.reset.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore layout behavior defaults without deleting custom commands or shortcuts."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özel komutları veya kısayolları silmeden düzen davranışı varsayılanlarını geri yükler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复布局行为默认值，不会删除自定义命令或快捷键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回復佈局行為預設值，不會刪除自訂指令或快速鍵。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استعادة الإعدادات الافتراضية لسلوك التخطيط دون حذف الأوامر أو الاختصارات المخصصة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardeinstellungen für das Layoutverhalten wiederherstellen, ohne benutzerdefinierte Befehle oder Tastenkombinationen zu löschen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura el comportamiento predeterminado de los diseños sin eliminar comandos personalizados ni atajos de teclado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurez les paramètres de disposition par défaut sans supprimer les commandes ou raccourcis personnalisés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタム コマンドやショートカットを削除せずに、レイアウト動作をデフォルトに戻します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 정의 명령이나 단축키를 삭제하지 않고 레이아웃 동작 기본값을 복원합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaure os padrões de comportamento do layout sem excluir comandos ou atalhos personalizados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановить настройки размещения окон по умолчанию без удаления пользовательских команд и сочетаний клавиш."
          }
        }
      }
    },
