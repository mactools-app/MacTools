    "settings.preset.selectionDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecting a preset only updates the preview; it is not applied immediately."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazır ayar seçmek yalnızca önizlemeyi günceller; hemen uygulanmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择预设只会更新预览，不会立即应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇預設只會更新預覽，不會立即套用。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي تحديد إعداد مسبق إلى تحديث المعاينة فقط؛ لا يتم تطبيقه على الفور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Auswählen einer Vorgabe aktualisiert nur die Vorschau; sie wird nicht sofort angewendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al seleccionar un ajuste preestablecido solo se actualiza la vista previa; no se aplica inmediatamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sélection d'un préréglage met uniquement à jour l'aperçu ; il n'est pas appliqué immédiatement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プリセットを選択すると、プレビューのみが更新されます。すぐには適用されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사전 설정을 선택하면 미리보기만 업데이트됩니다. 즉시 적용되지는 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecionar uma predefinição apenas atualiza a visualização; ela não é aplicada imediatamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбор предустановки обновляет только предварительный просмотр; сама предустановка не применяется сразу."
          }
        }
      }
    },
    "settings.preset.sheetTitle": {
