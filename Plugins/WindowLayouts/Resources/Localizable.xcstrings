          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "視窗佈局操作已取消。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إلغاء عملية تخطيط النافذة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Vorgang zur Fensteranordnung wurde abgebrochen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La operación de diseño de ventana fue cancelada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'opération de disposition des fenêtres a été annulée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィンドウレイアウト操作がキャンセルされました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창 레이아웃 작업이 취소되었습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A operação de layout da janela foi cancelada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменение расположения окна отменено."
          }
        }
      }
