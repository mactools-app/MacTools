    "settings.gap.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave space at screen edges and between adjacent tiled windows."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran kenarlarında ve bitişik döşenen pencereler arasında boşluk bırakır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在屏幕边缘和相邻平铺窗口之间保留间距。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在螢幕邊緣和相鄰平鋪視窗之間保留間距。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ترك مساحة عند حواف الشاشة وبين النوافذ المرتّبة المتجاورة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abstand an Bildschirmrändern und zwischen benachbarten, gekachelten Fenstern lassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja espacio en los bordes de la pantalla y entre las ventanas adyacentes dispuestas en mosaico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez de l’espace aux bords de l’écran et entre les fenêtres juxtaposées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面の端と隣接するタイル状ウィンドウの間にスペースを残します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 가장자리와 나란히 배치된 윈도우 사이에 간격을 둡니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe espaço nas bordas da tela e entre janelas lado a lado adjacentes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставлять отступы по краям экрана и между окнами, расположенными рядом."
          }
        }
      }
    },
