    "settings.shortcuts.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a preset, then customize any global shortcut individually."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazır bir ayar kullanın, ardından dilediğiniz genel kısayolu tek tek özelleştirin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用预设后，可单独修改任意全局快捷键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可使用預設，也可逐項錄製自己的全域快速鍵。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم إعدادًا مسبقًا، ثم قم بتخصيص أي اختصار عام بشكل فردي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Voreinstellung verwenden und anschließend einzelne globale Tastenkombinationen anpassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un preajuste y personaliza cada atajo de teclado global por separado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez un préréglage, puis personnalisez n'importe quel raccourci global individuellement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プリセットを使用して、グローバル ショートカットを個別にカスタマイズします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사전 설정을 사용한 다음 전역 단축키를 개별적으로 맞춤 설정하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Use uma predefinição e personalize qualquer atalho global individualmente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите предустановку, затем настройте каждое глобальное сочетание клавиш отдельно."
          }
        }
      }
    },
