    "permission.accessibility.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to read and adjust application window positions, sizes, and full-screen state."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama pencerelerinin konumlarını, boyutlarını ve tam ekran durumunu okumak ve ayarlamak için kullanılır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于读取并调整应用窗口的位置、大小和全屏状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於讀取並調整應用程式視窗的位置、大小和全螢幕狀態。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستخدم لقراءة وضبط مواضع نوافذ التطبيقات وأحجامها وحالة ملء الشاشة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dient zum Auslesen und Anpassen von Position, Größe und Vollbildstatus von Anwendungsfenstern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se utiliza para leer y ajustar las posiciones, los tamaños y el estado de pantalla completa de las ventanas de la aplicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé pour lire et ajuster la position, la taille et l’état plein écran des fenêtres des apps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリケーション ウィンドウの位置、サイズ、全画面状態を読み取り、調整するために使用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "애플리케이션 창 위치, 크기 및 전체 화면 상태를 읽고 조정하는 데 사용됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado para ler e ajustar posições, tamanhos e estado de tela inteira das janelas do aplicativo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется для чтения и настройки положения, размера и полноэкранного режима окна приложения."
          }
        }
      }
    },
    "permission.accessibility.footnote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In System Settings → Privacy & Security → Accessibility, allow MacTools."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Ayarları → Gizlilik ve Güvenlik → Erişilebilirlik bölümünde MacTools'a izin verin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统设置 → 隐私与安全性 → 辅助功能中允许 MacTools。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在系統設定 → 隱私權與安全性 → 輔助使用中允許 MacTools。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في إعدادات النظام ← الخصوصية والأمن ← تسهيلات الاستخدام، اسمح لـ MacTools."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben Sie MacTools den Zugriff unter Systemeinstellungen → Datenschutz & Sicherheit → Bedienungshilfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Ajustes del Sistema → Privacidad y seguridad → Accesibilidad, permite MacTools."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Réglages Système → Confidentialité et sécurité → Accessibilité, autorisez MacTools."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定 → プライバシーとセキュリティ → アクセシビリティで、MacTools を許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 → 개인정보 보호 및 보안 → 손쉬운 사용에서 MacTools를 허용하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em Ajustes do Sistema → Privacidade e Segurança → Acessibilidade, permita o MacTools."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте Системные настройки → Конфиденциальность и безопасность → Универсальный доступ и разрешите доступ для MacTools."
          }
        }
      }
    },
