    "settings.mode.screenTools.warning.experimental": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الشاشة البرمجية مع الغطاء المغلق تجريبية وقد تتوقف بعد تحديثات macOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Softwarebildschirm bei geschlossenem Deckel ist experimentell und kann nach macOS-Updates ausfallen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The closed-lid software display is experimental and may stop working after macOS updates."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pantalla por software con tapa cerrada es experimental y puede dejar de funcionar tras actualizar macOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’écran logiciel couvercle fermé est expérimental et peut cesser de fonctionner après une mise à jour de macOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスプレイを閉じた状態のソフトウェアディスプレイは試験的機能で、macOSのアップデート後に動作しない場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "덮개를 닫은 상태의 소프트웨어 디스플레이는 실험적 기능이며 macOS 업데이트 후 작동하지 않을 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tela de software com a tampa fechada é experimental e pode parar após atualizações do macOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Программный дисплей при закрытой крышке — экспериментальная функция и может перестать работать после обновления macOS."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapak kapalıyken kullanılan yazılımsal ekran deneyseldir ve macOS güncellemelerinden sonra çalışmayı durdurabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合盖软件显示器为实验性功能，macOS 更新后可能失效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "闔蓋軟體顯示器為實驗性功能，macOS 更新後可能失效。"
          }
        }
      }
    },
    "settings.mode.screenTools.warning.manualLock": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى القفل اليدوي فعالًا، ولن يتم فتح جلسة مقفلة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Manuelles Sperren bleibt wirksam; eine gesperrte Sitzung wird nicht entsperrt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manual locking still works; a locked session will not be unlocked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El bloqueo manual sigue funcionando; no se desbloqueará una sesión bloqueada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le verrouillage manuel reste actif ; une session verrouillée ne sera pas déverrouillée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手動ロックは引き続き有効です。ロック済みのセッションを解除することはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수동 잠금은 계속 작동하며 잠긴 세션을 잠금 해제하지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O bloqueio manual continua funcionando; uma sessão bloqueada não será desbloqueada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ручная блокировка продолжает работать; заблокированный сеанс не будет разблокирован."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "El ile kilitleme yine çalışır; kilitli bir oturumun kilidi açılmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手动锁定仍然有效；不会解锁已锁定的会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手動鎖定仍然有效；不會解鎖已鎖定的工作階段。"
          }
        }
      }
    },
    "settings.mode.screenTools.warning.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تتضمن حزمة المكوّن الحالية مكوّن الشاشة البرمجية للغطاء المغلق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Plug-in-Paket enthält keine Softwarebildschirm-Komponente für den geschlossenen Deckel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This plugin package does not include the closed-lid software display component."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este paquete del plugin no incluye el componente de pantalla por software para tapa cerrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce paquet d’extension ne contient pas le composant d’écran logiciel pour couvercle fermé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のプラグインパッケージには、ディスプレイを閉じた状態のソフトウェアディスプレイ機能が含まれていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 플러그인 패키지에 덮개를 닫은 상태의 소프트웨어 디스플레이 구성요소가 없습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este pacote do plugin não inclui o componente de tela de software para tampa fechada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом пакете плагина нет компонента программного дисплея для закрытой крышки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu eklenti paketi, kapak kapalıyken kullanılan yazılımsal ekran bileşenini içermiyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前插件包不包含合盖软件显示器组件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前外掛套件不包含闔蓋軟體顯示器元件。"
          }
        }
      }
    },
    "settings.mode.screenTools.warning.ventilation": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حافظ على تهوية Mac جيدًا، ولا تضعه أبدًا في حقيبة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorge für gute Belüftung und lege den Mac niemals in eine Tasche."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the Mac well ventilated and never place it in a bag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén el Mac bien ventilado y no lo metas nunca en una bolsa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez le Mac bien ventilé et ne le placez jamais dans un sac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macの通気を十分に確保し、バッグには絶対に入れないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac을 충분히 환기하고 절대 가방에 넣지 마십시오."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha o Mac bem ventilado e nunca o coloque em uma bolsa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обеспечьте хорошую вентиляцию Mac и никогда не кладите его в сумку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'in iyi havalandırıldığından emin olun ve asla çantaya koymayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持 Mac 通风，切勿将其放入包中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持 Mac 通風，切勿將其放入包中。"
          }
        }
      }
    },
    "settings.automaticLock.warning.closedLidPower": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب التشغيل مع الغطاء المغلق توصيل MacBook بالطاقة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Betrieb mit geschlossenem Deckel erfordert ein MacBook am Stromnetz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closed-lid operation requires the MacBook to be connected to power."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El funcionamiento con la tapa cerrada requiere que el MacBook esté conectado a la corriente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fonctionnement couvercle fermé nécessite que le MacBook soit branché au secteur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスプレイを閉じた状態での動作には、MacBookの電源接続が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "덮개를 닫은 상태로 작동하려면 MacBook을 전원에 연결해야 합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O funcionamento com a tampa fechada exige que o MacBook esteja conectado à energia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для работы с закрытой крышкой MacBook должен быть подключён к питанию."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapak kapalıyken çalışmak için MacBook'un güç kaynağına bağlı olması gerekir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合盖运行要求 MacBook 连接电源。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "闔蓋運作要求 MacBook 連接電源。"
          }
        }
      }
    },
    "error.virtualDisplay.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الإصدار من مكوّن منع السكون لا يدعم شاشة برمجية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Version des Wach-halten-Plug-ins unterstützt keinen Softwarebildschirm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version of the Keep Awake plugin does not support a software display."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión del plugin Mantener activo no admite una pantalla por software."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version de l’extension Empêcher la suspension ne prend pas en charge l’écran logiciel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンのスリープ防止プラグインはソフトウェアディスプレイに対応していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 버전의 잠자기 방지 플러그인은 소프트웨어 디스플레이를 지원하지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versão do plugin Manter ativo não oferece uma tela de software."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта версия плагина «Не давать уснуть» не поддерживает программный дисплей."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyanık Tutma eklentisinin bu sürümü yazılımsal ekranı desteklemiyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本的阻止休眠插件不支持软件显示器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本的防止睡眠外掛不支援軟體顯示器。"
          }
        }
      }
    },
