{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "panel.behavior.screenTools.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقي الشاشة مضاءة ويمنع القفل التلقائي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält das Display eingeschaltet und verhindert die automatische Sperre."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps the display on and prevents automatic locking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene la pantalla encendida e impide el bloqueo automático."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde l’écran allumé et empêche le verrouillage automatique."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面をオンに保ち、自動ロックを防ぎます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면을 켜 두고 자동 잠금을 방지합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém a tela ligada e impede o bloqueio automático."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставляет экран включённым и предотвращает автоблокировку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekranı açık tutar ve otomatik kilitlemeyi engeller."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持屏幕常亮并防止自动锁定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持螢幕常亮並防止自動鎖定。"
          }
        }
      }
    },
    "panel.behavior.default": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الافتراضي"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por omisión"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par défaut"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "標準"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Padrão"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設"
          }
        }
      }
    },
    "error.enableFailed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر منع السكون."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Verhindern des Ruhezustands konnte nicht aktiviert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not prevent sleep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo impedir el reposo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’empêcher la mise en veille."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スリープを防止できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠자기 방지를 활성화할 수 없습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível impedir o repouso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось предотвратить переход в режим сна."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyku engellenemedi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法启用阻止休眠。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法啟用阻止睡眠。"
          }
        }
      }
    },
    "action.disable.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إيقاف منع الإسبات"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wachhalten deaktivieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn Off Keep Awake"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivar No suspender"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactiver Maintien éveillé"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スリープ防止をオフにする"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠자기 방지 끄기"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativar Impedir repouso"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключить запрет сна"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyanık Tutmayı Kapat"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停用阻止休眠"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停用防止睡眠"
          }
        }
      }
    },
    "action.enable.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "منع الإسبات إلى أجل غير مسمى"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unbegrenzt wach halten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Awake Indefinitely"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Impedir reposo indefinidamente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenir éveillé indéfiniment"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無期限にスリープを防止"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무기한 잠자기 방지"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Impedir repouso indefinidamente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запретить сон бессрочно"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Süresiz Uyanık Tut"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无限期阻止休眠"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無限期防止睡眠"
          }
        }
      }
    },
    "action.toggle.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبديل منع الإسبات"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wachhalten umschalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Toggle Keep Awake"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternar No suspender"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Basculer Maintien éveillé"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スリープ防止を切り替える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠자기 방지 전환"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternar Impedir repouso"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переключить запрет сна"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyanık Tutmayı Aç/Kapat"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换阻止休眠"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換防止睡眠"
          }
        }
      }
    },
    "panel.subtitle.closedLidWaitingForPower": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشغيل الغطاء المغلق متوقف · في انتظار الطاقة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Betrieb mit geschlossenem Deckel pausiert · Warten auf Strom"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closed-lid operation paused · Waiting for power"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Funcionamiento con tapa cerrada en pausa · Esperando alimentación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonctionnement couvercle fermé en pause · En attente d’alimentation"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスプレイを閉じた状態の動作を一時停止 · 電源接続待ち"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "덮개를 닫은 상태의 동작 일시 정지 · 전원 연결 대기 중"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Funcionamento com tampa fechada pausado · Aguardando energia"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Работа с закрытой крышкой приостановлена · Ожидание питания"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapak kapalı çalışma duraklatıldı · Güç bekleniyor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合盖运行已暂停 · 正在等待电源"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "闔蓋運作已暫停 · 正在等待電源"
          }
        }
      }
    },
    "error.automaticLock.userActivityFailedFormat": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر منع القفل التلقائي. خطأ النظام %d."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatische Sperre konnte nicht verhindert werden. Systemfehler %d."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not prevent automatic locking. System error %d."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo impedir el bloqueo automático. Error del sistema %d."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’empêcher le verrouillage automatique. Erreur système %d."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動ロックを防止できませんでした。システムエラー %d。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 잠금을 방지할 수 없습니다. 시스템 오류 %d."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível impedir o bloqueio automático. Erro do sistema %d."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось предотвратить автоматическую блокировку. Системная ошибка %d."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik kilitleme engellenemedi. Sistem hatası %d."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法阻止自动锁定，系统返回错误 %d。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法阻止自動鎖定，系統傳回錯誤 %d。"
          }
        }
      }
    },
    "error.automaticLock.userActivityReleaseFailedFormat": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت استعادة القفل التلقائي. خطأ النظام %d. ربما لا يزال القفل التلقائي ممنوعًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatische Sperre konnte nicht wiederhergestellt werden. Systemfehler %d. Die automatische Sperre wird möglicherweise weiterhin verhindert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not restore automatic locking. System error %d. Automatic locking may still be prevented."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo restaurar el bloqueo automático. Error del sistema %d. Es posible que el bloqueo automático siga impedido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de rétablir le verrouillage automatique. Erreur système %d. Le verrouillage automatique est peut-être toujours empêché."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動ロックを復元できませんでした。システムエラー %d。自動ロックが引き続き防止されている可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 잠금을 복원할 수 없습니다. 시스템 오류 %d. 자동 잠금이 계속 방지될 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível restaurar o bloqueio automático. Erro do sistema %d. O bloqueio automático pode continuar impedido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось восстановить автоматическую блокировку. Системная ошибка %d. Автоблокировка всё ещё может быть отключена."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik kilitleme geri yüklenemedi. Sistem hatası %d. Otomatik kilitleme hâlâ engellenmiş olabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法恢复自动锁定，系统返回错误 %d。自动锁定可能仍被阻止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法恢復自動鎖定，系統傳回錯誤 %d。自動鎖定可能仍被阻止。"
          }
        }
      }
    },
