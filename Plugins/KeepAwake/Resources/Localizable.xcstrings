    "settings.mode.keepMacAwake.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقي Mac مستيقظًا؛ يظل إيقاف الشاشة والقفل وفق إعدادات macOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält den Mac aktiv; Display-Ruhezustand und Sperren richten sich weiter nach den macOS-Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps the Mac awake; display sleep and locking still follow macOS settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene el Mac activo; el apagado de la pantalla y el bloqueo siguen los ajustes de macOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde le Mac actif ; l’extinction de l’écran et le verrouillage suivent toujours les réglages de macOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macをスリープさせません。画面のオフとロックは引き続きmacOSの設定に従います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac을 깨운 상태로 유지하며 화면 꺼짐과 잠금은 macOS 설정을 따릅니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém o Mac ativo; o desligamento da tela e o bloqueio seguem os ajustes do macOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не даёт Mac уснуть; выключение экрана и блокировка по-прежнему определяются настройками macOS."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'i uyanık tutar; ekran uykusu ve kilitleme macOS ayarlarını izlemeye devam eder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持 Mac 唤醒；屏幕关闭与锁定仍遵循 macOS 设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持 Mac 喚醒；螢幕關閉與鎖定仍遵循 macOS 設定。"
          }
        }
      }
    },
