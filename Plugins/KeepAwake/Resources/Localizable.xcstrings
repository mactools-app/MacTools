    "error.virtualDisplay.terminated": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقفت الشاشة البرمجية؛ تم التبديل إلى إبقاء الشاشة مضاءة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Softwarebildschirm wurde beendet; zu „Display an lassen“ gewechselt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The software display stopped; switched to Keep display on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pantalla por software se detuvo; se cambió a Mantener pantalla encendida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’écran logiciel s’est arrêté ; passage à Garder l’écran allumé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ソフトウェアディスプレイが停止したため、「ディスプレイをオンのまま」に切り替えました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소프트웨어 디스플레이가 중지되어 ‘디스플레이 켜 두기’로 전환했습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tela de software parou; alterado para Manter tela ligada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Программный дисплей остановлен; включён режим «Не гасить экран»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazılımsal ekran durdu; Ekranı Açık Tut moduna geçildi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "软件显示器已停止；已切换为保持屏幕常亮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "軟體顯示器已停止；已切換為保持螢幕常亮。"
          }
        }
      }
    },
    "error.lidCloseAssertionCreationFailedFormat": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر إبقاء Mac مستيقظًا والغطاء مغلق. خطأ النظام %d."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Betrieb mit geschlossenem Deckel konnte nicht aktiviert werden. Systemfehler %d."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not enable closed-lid operation. System error %d."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo activar el funcionamiento con la tapa cerrada. Error del sistema %d."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’activer le fonctionnement couvercle fermé. Erreur système %d."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じた状態での動作を有効にできませんでした。システムエラー%d。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "덮개를 닫은 상태로 실행할 수 없습니다. 시스템 오류 %d."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ativar o funcionamento com a tampa fechada. Erro do sistema %d."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось включить работу с закрытой крышкой. Системная ошибка %d."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapak kapalı çalışma etkinleştirilemedi. Sistem hatası %d."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法启用合盖保持唤醒，系统返回错误 %d。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法啟用闔蓋保持喚醒，系統傳回錯誤 %d。"
          }
        }
      }
    },
    "error.lidCloseAssertionReleaseFailedFormat": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر إيقاف إبقاء Mac مستيقظًا والغطاء مغلق. خطأ النظام %d."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Betrieb mit geschlossenem Deckel konnte nicht deaktiviert werden. Systemfehler %d."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not disable closed-lid operation. System error %d."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo desactivar el funcionamiento con la tapa cerrada. Error del sistema %d."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de désactiver le fonctionnement couvercle fermé. Erreur système %d."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じた状態での動作を無効にできませんでした。システムエラー%d。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "덮개를 닫은 상태로 실행을 중지할 수 없습니다. 시스템 오류 %d."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível desativar o funcionamento com a tampa fechada. Erro do sistema %d."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось отключить работу с закрытой крышкой. Системная ошибка %d."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapak kapalı çalışma devre dışı bırakılamadı. Sistem hatası %d."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法关闭合盖保持唤醒，系统返回错误 %d。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法關閉闔蓋保持喚醒，系統傳回錯誤 %d。"
          }
        }
      }
    },
    "metadata.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البقاء مستيقظًا"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wach bleiben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Awake"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenerse despierto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rester éveillé"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起きていてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깨어 있으십시오"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha-se acordado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не спать"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyanık Tutma"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止休眠"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止休眠"
          }
        }
      }
    },
    "metadata.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبقِ Mac مستيقظًا، مع خيار إبقاء الشاشة مضاءة أو إبقاء أدوات الشاشة قيد التشغيل. يتطلب تشغيل MacBook بغطاء مغلق توصيله بالطاقة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält den Mac wach; optional bleibt das Display an oder Bildschirmtools funktionieren weiter. Der Betrieb eines MacBook mit geschlossenem Deckel erfordert Netzstrom."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the Mac awake; optionally keep the display on or keep screen-based tools working. Closed-lid MacBook operation requires a power connection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén el Mac activo; opcionalmente, conserva la pantalla encendida o las herramientas de pantalla funcionando. El uso del MacBook con la tapa cerrada requiere alimentación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde le Mac actif ; permet aussi de garder l’écran allumé ou les outils liés à l’écran opérationnels. L’utilisation du MacBook couvercle fermé nécessite le secteur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macをスリープさせず、必要に応じてディスプレイをオンのままにするか画面ツールを動作させます。MacBookを閉じた状態で使用するには電源接続が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac을 깨운 상태로 두고, 선택적으로 디스플레이를 켜 두거나 화면 도구를 계속 작동시킵니다. MacBook을 덮개를 닫은 상태로 사용하려면 전원 연결이 필요합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha o Mac ativo; opcionalmente, mantenha a tela ligada ou as ferramentas de tela funcionando. O uso do MacBook com a tampa fechada requer energia conectada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не даёт Mac уснуть; при необходимости не гасит экран или сохраняет работу экранных инструментов. Для работы MacBook с закрытой крышкой требуется питание от сети."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'i uyanık tutar; isterseniz ekranı açık tutar veya ekran araçlarını çalışır tutar. MacBook'un kapak kapalı çalışması için güç bağlantısı gerekir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持 Mac 唤醒；可选保持屏幕常亮或让屏幕工具继续工作。MacBook 合盖运行要求连接电源"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持 Mac 喚醒；可選保持螢幕常亮或讓螢幕工具繼續運作。MacBook 闔蓋運作要求連接電源"
          }
        }
      }
    },
