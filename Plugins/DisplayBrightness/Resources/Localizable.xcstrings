{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "error.adjustTimedOut": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت مهلة ضبط السطوع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Helligkeitsanpassung hat das Zeitlimit überschritten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brightness adjustment timed out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se agotó el tiempo para ajustar el brillo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le réglage de la luminosité a expiré."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明るさの調整がタイムアウトしました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "밝기 조절 시간이 초과되었습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O ajuste do brilho excedeu o tempo limite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Истекло время ожидания изменения яркости."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parlaklık ayarı zaman aşımına uğradı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "亮度调节超时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "亮度調整逾時。"
          }
        }
      }
    },
    "action.unavailable.noDisplays": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم اكتشاف أي شاشات يمكن ضبط سطوعها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurden keine Displays mit einstellbarer Helligkeit erkannt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No displays with adjustable brightness were detected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se detectaron pantallas con brillo ajustable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun écran à luminosité réglable n’a été détecté."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明るさを調整できるディスプレイが検出されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "밝기를 조절할 수 있는 디스플레이가 감지되지 않았습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma tela com brilho ajustável foi detectada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дисплеи с регулируемой яркостью не обнаружены."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parlaklığı ayarlanabilir bir ekran algılanmadı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未检测到可调节亮度的显示器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未偵測到可調整亮度的顯示器。"
          }
        }
      }
    },
    "metadata.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سطوع العرض"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anzeigehelligkeit"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display Brightness"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Brillo de la pantalla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Luminosité de l'écran"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスプレイの明るさ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스플레이 밝기"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Brilho da tela"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Яркость дисплея"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran Parlaklığı"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示器亮度"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示器亮度"
          }
        }
      }
    },
    "metadata.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضبط السطوع بسرعة لكل شاشة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passen Sie die Helligkeit für jedes Display schnell an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quickly adjust brightness for each display."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta rápidamente el brillo de cada pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustez rapidement la luminosité de chaque écran."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ディスプレイの明るさをすばやく調整します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 디스플레이의 밝기를 빠르게 조정하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste rapidamente o brilho de cada tela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстрая настройка яркости для каждого дисплея."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her ekranın parlaklığını hızlıca ayarlayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快速调节每个显示器的亮度"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快速調節每個顯示器的亮度"
          }
        }
      }
    },
