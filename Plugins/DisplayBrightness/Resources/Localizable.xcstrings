    "settings.shortcutTarget.followsMouseDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضبط العرض أسفل المؤشر فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passt nur die Anzeige unter dem Zeiger an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only adjusts the display under the pointer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo ajusta la visualización debajo del puntero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste uniquement l'affichage sous le pointeur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポインタの下の表示のみを調整します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포인터 아래의 디스플레이만 조정합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta apenas a exibição sob o ponteiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настраивает только отображение под указателем."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca işaretçinin altındaki ekranı ayarlar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只调整光标所在屏幕。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只調整光標所在螢幕。"
          }
        }
      }
    },
