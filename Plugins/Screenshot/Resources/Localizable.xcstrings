{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "capture.invalidRegion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The capture region is invalid. Select it again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakalama alanı geçersiz. Yeniden seçin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "截图区域无效，请重新选择"
          }
        }
      }
    },
    "capture.preparing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazırlanıyor…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在准备…"
          }
        }
      }
    },
    "capture.stopping": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopping…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durduruluyor…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在停止…"
          }
        }
      }
    },
    "capture.stoppingSlowly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for capture to stop…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakalamanın durması bekleniyor…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待系统停止…"
          }
        }
      }
    },
    "record.saving": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydediliyor…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在保存…"
          }
        }
      }
    },
    "record.savingSlowly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still saving. Please wait…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hâlâ kaydediliyor. Lütfen bekleyin…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在保存，请稍候…"
          }
        }
      }
    },
    "record.unsupportedResolution": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This region exceeds hardware encoding limits. Select a smaller region."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu alan donanım kodlama sınırlarını aşıyor. Daha küçük bir alan seçin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前区域超出硬件编码能力，请缩小录制范围"
          }
        }
      }
    },
    "scroll.unmatched": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No matching content. Scroll more slowly or go back slightly."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşleşen içerik yok. Daha yavaş kaydırın veya biraz geri gidin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到连续内容，请放慢滚动或回滚少许"
          }
        }
      }
    },
    "scroll.finishing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finishing scrolling screenshot…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydırmalı ekran görüntüsü tamamlanıyor…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在完成长截图…"
          }
        }
      }
    },
    "capture.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to capture the screen. Check Screen Recording permission and try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran yakalanamadı. Ekran Kaydı iznini denetleyip yeniden deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法获取屏幕图像，请检查录屏权限后重试"
          }
        }
      }
    },
    "capture.timedOut": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen capture timed out. Please try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran yakalama zaman aşımına uğradı. Lütfen yeniden deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "获取屏幕图像超时，请重试"
          }
        }
      }
    },
    "capture.displayChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The display configuration changed. Start a new capture."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran yapılandırması değişti. Yeni bir yakalama başlatın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示器配置已变化，请重新截图"
          }
        }
      }
    },
    "scroll.outputTooLarge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrolling screenshot size limit reached. Capture a smaller area or split it into sections."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydırmalı ekran görüntüsünde boyut sınırına ulaşıldı. Daha küçük bir alan yakalayın veya bölümlere ayırın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长截图已达大小上限，请缩小截图范围或分段截取"
          }
        }
      }
    },
    "capture.controlsNotReady": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture controls are not ready. Please try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakalama denetimleri hazır değil. Lütfen yeniden deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "截图控制窗口尚未就绪，请重试"
          }
        }
      }
    },
    "overlay.mode.move": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
