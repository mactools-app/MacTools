    "record.unsupportedResolution": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This region exceeds hardware encoding limits. Select a smaller region."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu alan donanım kodlama sınırlarını aşıyor. Daha küçük bir alan seçin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前区域超出硬件编码能力，请缩小录制范围"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتجاوز هذه المنطقة حدود ترميز الأجهزة. حدد منطقة أصغر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Bereich überschreitet die Grenzen der Hardware-Codierung. Wählen Sie einen kleineren Bereich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta región excede los límites de codificación de hardware. Seleccione una región más pequeña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette zone dépasse les limites de l’encodage matériel. Sélectionnez une zone plus petite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この領域はハードウェア エンコード制限を超えています。より小さい領域を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 영역은 하드웨어 인코딩 제한을 초과합니다. 더 작은 영역을 선택하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta região excede os limites de codificação de hardware. Selecione uma região menor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размер области превышает ограничения аппаратного кодирования. Выберите меньшую область."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前區域超出硬體編碼能力，請縮小錄影範圍"
          }
        }
      }
    },
    "scroll.unmatched": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No matching content. Scroll more slowly or go back slightly."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşleşen içerik yok. Daha yavaş kaydırın veya biraz geri gidin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到连续内容，请放慢滚动或向上滚动少许"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد محتوى مطابق. قم بالتمرير بشكل أبطأ أو قم بالرجوع للخلف قليلاً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein passender Inhalt. Scrollen Sie langsamer oder gehen Sie ein Stück zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay contenido coincidente. Desplácese más lentamente o retroceda un poco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun contenu correspondant. Faites défiler plus lentement ou revenez légèrement en arrière."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一致するコンテンツはありません。ゆっくりスクロールするか、少し戻してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일치하는 콘텐츠가 없습니다. 더 천천히 스크롤하거나 조금 되돌려 스크롤하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum conteúdo correspondente. Role mais devagar ou volte um pouco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет соответствующего контента. Прокрутите медленнее или вернитесь немного назад."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到連續內容，請放慢捲動速度或稍微往回捲動"
          }
        }
      }
    },
    "scroll.finishing": {
      "extractionState": "manual",
      "localizations": {
