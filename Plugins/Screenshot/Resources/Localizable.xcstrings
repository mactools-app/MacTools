    "capture.displayChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The display configuration changed. Start a new capture."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran yapılandırması değişti. Yeni bir yakalama başlatın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示器配置已变化，请重新截图"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر تكوين الشاشات. ابدأ التقاطًا جديدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bildschirmkonfiguration hat sich geändert. Starten Sie eine neue Aufnahme."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración de las pantallas ha cambiado. Inicia una nueva captura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuration de l’affichage a changé. Commencez une nouvelle capture."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスプレイ構成が変わりました。新しいキャプチャを開始してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스플레이 구성이 변경되었습니다. 새로운 캡처를 시작하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A configuração das telas foi alterada. Inicie uma nova captura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Конфигурация дисплеев изменилась. Начните новый захват."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示器設定已變化，請重新截圖"
          }
        }
      }
    },
    "scroll.outputTooLarge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrolling screenshot size limit reached. Capture a smaller area or split it into sections."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydırmalı ekran görüntüsünde boyut sınırına ulaşıldı. Daha küçük bir alan yakalayın veya bölümlere ayırın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长截图已达大小上限，请缩小截图范围或分段截取"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الوصول إلى الحد الأقصى لحجم لقطة الشاشة بالتمرير. التقط مساحة أصغر أو قسّمها إلى أجزاء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Größenlimit für Scroll-Screenshots erreicht. Nehmen Sie einen kleineren Bereich auf oder teilen Sie ihn in Abschnitte auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se alcanzó el límite de tamaño de captura de pantalla con desplazamiento. Capture un área más pequeña o divídala en secciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite de taille de capture d'écran défilante atteinte. Capturez une zone plus petite ou divisez-la en sections."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクロールスクリーンショットがサイズ上限に達しました。より小さな領域をキャプチャするか、範囲を分割して撮影してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크롤 스크린샷 크기 제한에 도달했습니다. 더 작은 영역을 캡처하거나 여러 구간으로 나누어 캡처하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O limite de tamanho da captura de tela de rolagem foi atingido. Capture uma área menor ou divida-a em seções."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Достигнут предел размера снимка с прокруткой. Захватите меньшую область или разделите ее на части."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "長截圖已達大小上限，請縮小截圖範圍或分段截取"
          }
        }
      }
    },
    "capture.controlsNotReady": {
