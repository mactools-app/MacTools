    "metadata.summary": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التقط مناطق أو نوافذ وأضف تعليقات واستخرج النصوص والرموز والتقط المحتوى القابل للتمرير وسجّل الشاشة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereiche oder Fenster aufnehmen, beschriften, Text und Codes erkennen, Scrollaufnahmen und Bildschirmvideos erstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture regions or windows, annotate, recognize text and codes, take scrolling screenshots, and record the screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Captura regiones o ventanas, anota, reconoce texto y códigos, captura contenido desplazable y graba la pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturez des zones ou fenêtres, annotez, reconnaissez du texte et des codes, capturez le défilement et enregistrez l’écran."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "範囲やウインドウの撮影、注釈、文字・コード認識、スクロール撮影、画面収録を行います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영역이나 창을 캡처하고 주석, 텍스트·코드 인식, 스크롤 캡처, 화면 녹화를 사용합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture áreas ou janelas, anote, reconheça textos e códigos, faça capturas com rolagem e grave a tela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снимайте области и окна, добавляйте пометки, распознавайте текст и коды, делайте снимки с прокруткой и записывайте экран."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alan veya pencere yakalayın, açıklama ekleyin, metin ve kodları tanıyın, kaydırmalı ekran görüntüsü alın ve ekranı kaydedin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "区域和窗口截图、标注、文字与二维码识别、贴图、滚动截图和录屏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "區域和視窗截圖、標註、文字與 QR 碼辨識、釘選圖片、捲動截圖和螢幕錄製。"
          }
        }
      }
    },
    "action.capture.title": {
