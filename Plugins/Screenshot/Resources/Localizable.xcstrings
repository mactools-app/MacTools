    "settings.output.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screenshots are copied by default; use Save to export a PNG. Recordings are saved as MOV files and require macOS 15 or later."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran görüntüleri varsayılan olarak kopyalanır; PNG olarak dışa aktarmak için Kaydet'i kullanın. Kayıtlar MOV dosyası olarak saklanır ve macOS 15 veya sonrasını gerektirir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "截图完成后默认复制；使用保存按钮可保存 PNG。录屏保存为 MOV，需要 macOS 15 或更高版本。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم نسخ لقطات الشاشة بشكل افتراضي؛ استخدم حفظ لتصدير PNG. يتم حفظ التسجيلات كملفات MOV وتتطلب macOS 15 أو أحدث."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildschirmfotos werden standardmäßig kopiert; „Sichern“ verwenden, um eine PNG-Datei zu exportieren. Bildschirmaufnahmen werden als MOV-Dateien gespeichert und erfordern macOS 15 oder neuer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las capturas de pantalla se copian de forma predeterminada; use Guardar para exportar un PNG. Las grabaciones se guardan como archivos MOV y requieren macOS 15 o posterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les captures d'écran sont copiées par défaut ; utilisez Enregistrer pour exporter un PNG. Les enregistrements sont enregistrés sous forme de fichiers MOV et nécessitent macOS 15 ou version ultérieure."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリーンショットはデフォルトでコピーされます。 [保存] を使用して PNG をエクスポートします。録画は MOV ファイルとして保存され、macOS 15 以降が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크린샷은 기본적으로 복사됩니다. 저장 버튼으로 PNG를 내보낼 수 있습니다. 녹화 파일은 MOV 형식으로 저장되며 macOS 15 이상이 필요합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As capturas de tela são copiadas por padrão; use Salvar para exportar um PNG. As gravações são salvas como arquivos MOV e requerem macOS 15 ou posterior."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скриншоты копируются по умолчанию; используйте «Сохранить», чтобы экспортировать PNG. Записи сохраняются в виде файлов MOV и требуют macOS 15 или более поздней версии."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "截圖完成後預設複製；使用儲存按鈕可儲存 PNG。螢幕錄影儲存為 MOV，需要 macOS 15 或更高版本。"
          }
        }
      }
    },
