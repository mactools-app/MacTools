          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크롤 스크린샷을 마치는 중..."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Concluindo a captura de tela de rolagem…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершение снимка с прокруткой…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在完成長截圖…"
          }
        }
      }
    },
    "capture.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to capture the screen. Check Screen Recording permission and try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran yakalanamadı. Ekran Kaydı iznini denetleyip yeniden deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法获取屏幕图像，请检查录屏权限后重试"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتعذر التقاط الشاشة. تحقق من إذن تسجيل الشاشة وحاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildschirmaufnahme nicht möglich. Überprüfen Sie die Berechtigung für die Bildschirmaufnahme und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede capturar la pantalla. Verifique el permiso de grabación de pantalla e inténtelo nuevamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de capturer l’écran. Vérifiez l’autorisation « Enregistrement de l’écran » et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面をキャプチャできません。画面収録の許可を確認して、もう一度試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면을 캡처할 수 없습니다. 화면 기록 권한을 확인하고 다시 시도하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível capturar a tela. Verifique a permissão de Gravação de Tela e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Невозможно сделать снимок экрана. Проверьте разрешение на запись экрана и повторите попытку."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法取得螢幕圖像，請檢查螢幕錄影權限後重試"
          }
        }
      }
    },
    "capture.timedOut": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen capture timed out. Please try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran yakalama zaman aşımına uğradı. Lütfen yeniden deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "获取屏幕图像超时，请重试"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت مهلة التقاط الشاشة. يرجى المحاولة مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitüberschreitung bei der Bildschirmaufnahme. Bitte versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se agotó el tiempo de captura de pantalla. Por favor inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le délai de capture d’écran a été dépassé. Veuillez réessayer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面キャプチャがタイムアウトしました。もう一度試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 캡처 시간이 초과되었습니다. 다시 시도해 주세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
