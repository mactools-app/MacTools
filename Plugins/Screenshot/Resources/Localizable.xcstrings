        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran Görüntüsü ve Hızlı Yakalama için genel kısayolları ayarlayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置截图和快速截图的全局快捷键。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عيّن اختصارات عامة للقطة الشاشة والالتقاط السريع."
          }
        },
        "de": {
