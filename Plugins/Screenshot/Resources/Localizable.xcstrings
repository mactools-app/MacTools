    "action.capture.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدد منطقة أو نافذة لإضافة تعليقات أو التعرّف على النصوص والرموز أو التقاط المحتوى القابل للتمرير أو التسجيل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie einen Bereich oder ein Fenster zum Beschriften, zur Text- und Codeerkennung, für Scrollaufnahmen oder Videos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a region or window to annotate, recognize text or codes, capture scrolling content, or record."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona una región o ventana para anotar, reconocer texto o códigos, capturar contenido desplazable o grabar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez une zone ou fenêtre pour annoter, reconnaître du texte ou des codes, capturer le défilement ou enregistrer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "範囲やウインドウを選び、注釈、文字・コード認識、スクロール撮影、画面収録を行います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영역이나 창을 선택해 주석, 텍스트·코드 인식, 스크롤 캡처 또는 녹화를 사용합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione uma área ou janela para anotar, reconhecer texto ou códigos, capturar conteúdo com rolagem ou gravar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите область или окно для пометок, распознавания текста и кодов, снимка с прокруткой или записи."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açıklama eklemek, metin veya kod tanımak, kaydırmalı içerik yakalamak veya kaydetmek için bir alan veya pencere seçin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "框选区域或窗口，标注、识别文字或二维码，也可滚动截图和录屏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "框選區域或視窗，標註、辨識文字或 QR 碼，也可捲動截圖和錄製螢幕。"
          }
        }
      }
    },
