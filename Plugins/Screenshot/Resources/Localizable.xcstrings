    "panel.recording": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording; click again or use the screenshot shortcut to stop"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt sürüyor; durdurmak için yeniden tıklayın veya ekran görüntüsü kısayolunu kullanın"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在录屏，再次点击或使用截图快捷键停止"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التسجيل؛ انقر مرة أخرى أو استخدم اختصار لقطة الشاشة للتوقف"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnahme läuft; erneut klicken oder Tastaturkürzel für Screenshots verwenden, um zu stoppen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grabando; haz clic de nuevo o usa el atajo de teclado de captura de pantalla para detener la grabación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrement ; cliquez à nouveau ou utilisez le raccourci de capture d'écran pour arrêter"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録画中です。もう一度クリックするか、スクリーンショットのショートカットで停止できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹화 중 · 다시 클릭하거나 스크린샷 단축키를 사용하여 중지하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravando; clique novamente ou use o atalho da captura de tela para parar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Идет запись; нажмите еще раз или используйте сочетание клавиш снимка экрана, чтобы остановить"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在螢幕錄影，再按一下或使用截圖快速鍵停止"
          }
        }
      }
    },
    "panel.scrolling": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll the page, then click Finish or use the screenshot shortcut"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayfayı kaydırın, ardından Bitir düğmesine tıklayın veya ekran görüntüsü kısayolunu kullanın"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滚动页面后点击完成，或使用截图快捷键完成"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتمرير الصفحة، ثم انقر فوق \"إنهاء\" أو استخدم اختصار لقطة الشاشة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seite scrollen, dann auf „Fertigstellen“ klicken oder die Tastenkombination für Bildschirmfotos verwenden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desplázate por la página y haz clic en Finalizar o usa el atajo de teclado de captura de pantalla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites défiler la page, puis cliquez sur Terminer ou utilisez le raccourci de capture d'écran"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページをスクロールして、「完了」をクリックするか、スクリーンショットのショートカットを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페이지를 스크롤한 후 완료를 클릭하거나 스크린샷 단축키를 사용하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Role a página e clique em Concluir ou use o atalho da captura de tela"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прокрутите страницу, затем нажмите «Готово» или используйте сочетание клавиш снимка экрана"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "捲動頁面後按一下「完成」，或使用截圖快速鍵完成"
          }
        }
      }
    },
