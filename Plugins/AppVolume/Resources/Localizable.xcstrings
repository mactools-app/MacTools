{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "action.persistenceFailed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر حفظ إعدادات مستوى صوت التطبيق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App-Lautstärkeeinstellungen konnten nicht gesichert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to save app volume settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido guardar los ajustes de volumen de la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer les réglages de volume de l’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの音量設定を保存できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 음량 설정을 저장할 수 없습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar os ajustes de volume do app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить настройки громкости приложения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama ses ayarları kaydedilemedi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存应用音量设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存應用程式音量設定。"
          }
        }
      }
    },
    "action.persistenceRouteRollbackFailed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر حفظ إعدادات مستوى صوت التطبيق، كما تعذرت استعادة التوجيه السابق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App-Lautstärkeeinstellungen konnten nicht gesichert und das vorherige Routing nicht wiederhergestellt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to save app volume settings or restore the previous routing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido guardar los ajustes de volumen ni restaurar el enrutamiento anterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer le volume de l’app et de restaurer le routage précédent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの音量設定を保存できず、以前のルーティングも復元できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 음량 설정을 저장하거나 이전 라우팅을 복원할 수 없습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar o volume do app nem restaurar o roteamento anterior."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить громкость приложения и восстановить предыдущую маршрутизацию."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama ses ayarları kaydedilemedi veya önceki yönlendirme geri yüklenemedi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存应用音量设置，且恢复先前路由失败。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存應用程式音量設定，且無法還原先前路由。"
          }
        }
      }
    },
    "action.persistenceStorageRollbackFailed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر حفظ إعدادات مستوى صوت التطبيق، كما تعذرت استعادة القيمة المخزنة السابقة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App-Lautstärkeeinstellungen konnten nicht gesichert und der vorherige Speicherwert nicht wiederhergestellt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to save app volume settings or restore the previous stored value."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido guardar los ajustes de volumen ni restaurar el valor almacenado anterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer le volume de l’app et de restaurer la valeur précédente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの音量設定を保存できず、以前の保存値も復元できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 음량 설정을 저장하거나 이전 저장 값을 복원할 수 없습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar o volume do app nem restaurar o valor anterior."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить громкость приложения и восстановить предыдущее значение."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama ses ayarları kaydedilemedi veya önceki kayıtlı değer geri yüklenemedi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存应用音量设置，且恢复先前存储值失败。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存應用程式音量設定，且無法還原先前儲存值。"
          }
        }
      }
    },
    "action.routeFailed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تطبيق إعدادات مستوى صوت التطبيق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App-Lautstärkeeinstellungen konnten nicht angewendet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app volume settings could not be applied."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron aplicar los ajustes de volumen de la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’appliquer les réglages de volume de l’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの音量設定を適用できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 음량 설정을 적용하지 못했습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível aplicar as definições de volume da app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось применить настройки громкости приложения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama ses ayarları uygulanamadı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法应用应用音量设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法套用應用程式音量設定。"
          }
        }
      }
    },
    "action.routeRollbackFailed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تطبيق إعدادات مستوى صوت التطبيق، كما تعذرت استعادة التوجيه السابق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App-Lautstärkeeinstellungen konnten nicht angewendet und das vorherige Routing nicht wiederhergestellt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app volume settings could not be applied, and the previous routing could not be restored."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron aplicar los ajustes de volumen ni restaurar el enrutamiento anterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’appliquer les réglages de volume et de restaurer le routage précédent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの音量設定を適用できず、以前のルーティングも復元できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 음량 설정을 적용하지 못했고 이전 라우팅도 복원하지 못했습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível aplicar as definições de volume nem restaurar o encaminhamento anterior."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось применить настройки громкости приложения и восстановить прежнюю маршрутизацию."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama ses ayarları uygulanamadı ve önceki yönlendirme geri yüklenemedi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法应用应用音量设置，且恢复先前路由失败。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法套用應用程式音量設定，且無法還原先前的路由。"
          }
        }
      }
    },
    "error.permissionDenied": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مطلوب إذن تسجيل صوت النظام"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Berechtigung für Systemaudioaufnahmen ist erforderlich"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System Audio Recording permission is required"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere permiso para grabar el audio del sistema"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autorisation d’enregistrement de l’audio du système est requise"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムオーディオ録音の許可が必要です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 오디오 녹음 권한이 필요합니다"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "É necessária permissão para gravar o áudio do sistema"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуется разрешение на запись системного аудио"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Sesi Kaydı izni gerekiyor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要系统音频录制权限"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要系統音訊錄製權限"
          }
        }
      }
    },
    "error.unsupported": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب التحكم المستقل في صوت التطبيقات macOS 15 أو أحدث"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Lautstärkeregelung pro App erfordert macOS 15 oder neuer"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Per-app volume requires macOS 15 or later"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El volumen por aplicación requiere macOS 15 o posterior"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le volume par app nécessite macOS 15 ou version ultérieure"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリごとの音量調整には macOS 15 以降が必要です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱별 음량은 macOS 15 이상이 필요합니다"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O volume por app requer o macOS 15 ou posterior"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для регулировки громкости приложений требуется macOS 15 или новее"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama bazlı ses, macOS 15 veya sonrasını gerektirir"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用独立音量需要 macOS 15 或更高版本"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用程式獨立音量需要 macOS 15 或以上版本"
          }
        }
      }
    },
    "metadata.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضبط مستوى صوت كل تطبيق يشغّل الصوت على حدة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lautstärke aktiver Audio-Apps einzeln anpassen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust the volume of each app currently playing audio"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta por separado el volumen de cada aplicación con audio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglez séparément le volume de chaque app qui diffuse du son"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生中のアプリごとに音量を調整します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오를 재생 중인 앱별로 음량을 조절합니다"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste separadamente o volume de cada app que reproduz áudio"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настраивайте громкость каждого приложения с активным звуком"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu anda ses çalan her uygulamanın ses seviyesini ayarlayın"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分别调节正在播放音频的应用音量"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分別調整正在播放音訊的應用程式音量"
          }
        }
      }
    },
