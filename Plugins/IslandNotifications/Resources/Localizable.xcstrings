        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуется MacBook Pro с островом камеры (macOS 27 или новее)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラアイランド搭載の MacBook Pro（macOS 27 以降）が必要です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 아일랜드가 있는 MacBook Pro(macOS 27 이상)가 필요합니다"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب MacBook Pro مزودًا بجزيرة الكاميرا (macOS 27 أو أحدث)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera adası olan bir MacBook Pro gerektirir (macOS 27 veya üstü)"
          }
        }
      }
