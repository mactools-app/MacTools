    "settings.previewLines.description": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "展开前显示的消息行数。向下滚动卡片可查看全文。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Message lines shown before expanding. Scroll down on a card to see it all."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "展開前顯示的訊息行數。向下捲動卡片可查看全文。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachrichtenzeilen vor dem Erweitern. Auf einer Karte nach unten scrollen, um alles zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Líneas del mensaje antes de expandir. Desplázate hacia abajo en una tarjeta para verlo todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lignes du message avant développement. Faites défiler une carte vers le bas pour tout voir."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Linhas da mensagem antes de expandir. Role para baixo num cartão para ver tudo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Строки сообщения до раскрытия. Прокрутите карточку вниз, чтобы увидеть всё."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "展開前に表示するメッセージの行数。カードを下にスクロールすると全文を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "펼치기 전에 표시할 메시지 줄 수입니다. 카드를 아래로 스크롤하면 전체가 표시됩니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدد أسطر الرسالة قبل التوسيع. مرّر لأسفل على البطاقة لعرضها كاملة."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Genişletmeden önce gösterilen ileti satırları. Tamamını görmek için kartta aşağı kaydırın."
          }
        }
      }
    },
    "status.noDisplay": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要配备摄像头岛的 MacBook Pro（macOS 27 或更高版本）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requires a MacBook Pro with the camera island (macOS 27 or later)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要配備攝影機島的 MacBook Pro（macOS 27 或更新版本）"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfordert ein MacBook Pro mit Kamera-Insel (macOS 27 oder neuer)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Requiere un MacBook Pro con isla de cámara (macOS 27 o posterior)"
