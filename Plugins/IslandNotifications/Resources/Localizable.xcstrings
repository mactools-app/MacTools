{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "metadata.title": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "灵动岛通知"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Island Notifications"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "靈動島通知"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic-Island-Mitteilungen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificaciones de Dynamic Island"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications Dynamic Island"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificações da Dynamic Island"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления Dynamic Island"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Island 通知"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Island 알림"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إشعارات Dynamic Island"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Island Bildirimleri"
          }
        }
      }
    },
    "metadata.description": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在灵动岛显示通知，保留通知中心历史记录。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show notifications at the camera island while preserving Notification Centre history."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在靈動島顯示通知，保留通知中心歷史記錄。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen an der Kamera-Insel anzeigen und im Mitteilungszentrum behalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra notificaciones junto a la cámara y conserva el historial del Centro de notificaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche les notifications près de la caméra et conserve l’historique du Centre de notifications."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra notificações junto à câmara e mantém o histórico da Central de Notificações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает уведомления у камеры, сохраняя историю Центра уведомлений."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラ部分に通知を表示し、通知センターの履歴を保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 영역에 알림을 표시하고 알림 센터 기록을 유지합니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرض الإشعارات عند الكاميرا مع الاحتفاظ بسجل مركز الإشعارات."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirimleri kamera çevresinde gösterir ve Bildirim Merkezi geçmişini korur."
          }
        }
      }
    },
