    "gesture.demo.doubleTapFormat": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المس ثم حرّر مرتين متتاليتين باستخدام %d أصابع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit %d Fingern zweimal kurz hintereinander berühren und loslassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch and release twice in succession with %d fingers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca y suelta dos veces seguidas con %d dedos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez et relâchez deux fois de suite avec %d doigts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%d本の指で続けて2回タッチして放します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%d개의 손가락으로 연속 두 번 터치하고 놓습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque e solte duas vezes seguidas com %d dedos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дважды подряд коснитесь и отпустите %d пальцами."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%d parmakla art arda iki kez dokunup kaldırın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 指连续轻触并抬起两次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 指連續輕觸並抬起兩次。"
          }
        }
      }
    },
    "gesture.demo.tipTapFormat": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبقِ %d من أصابعك ثابتة، ثم انقر بشكل متكرر على المنطقة المحددة بإصبع إضافي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie %d Finger ruhig und tippen Sie dann mit einem weiteren Finger wiederholt auf den ausgewählten Bereich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep %d fingers still, then repeatedly tap the selected area with one more finger."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenga %d dedos quietos y toque repetidamente el área seleccionada con un dedo más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez %d doigts immobiles, puis touchez plusieurs fois la zone sélectionnée avec un doigt supplémentaire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 本の指を動かさず、もう 1 本の指で選択した領域を繰り返しタップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%d개의 손가락을 가만히 유지한 다음 손가락 하나를 더 사용해 선택한 영역을 반복해서 탭하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha %d dedos imóveis e toque repetidamente na área selecionada com mais um dedo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте %d пальца неподвижно, затем несколько раз коснитесь выбранной области еще одним пальцем."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%d parmağı sabit tutun, ardından bir parmak daha kullanarak seçili alana art arda dokunun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持 %d 指不动，再用一指反复轻点指定区域。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持 %d 根手指不動，再用一根手指反覆輕點所選區域。"
          }
        }
      }
    },
    "gesture.demo.tapFormat": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
