          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력 중 제스처 무시"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignorar gestos ao digitar"
          }
        },
        "ru": {
          "stringUnit": {
