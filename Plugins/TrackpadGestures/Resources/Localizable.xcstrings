    "settings.testing.contactPatternFormat": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم اكتشاف نمط اللمس لـ %@. لا يزال التعيين الفعلي يتطلب حدث نقر مطابقًا من macOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontaktmuster für %@ erkannt. Die tatsächliche Zuordnung benötigt weiterhin ein passendes macOS-Tippklick-Ereignis."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contact pattern detected for %@. A live mapping still requires a matching macOS tap-to-click event."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se detectó el patrón de contacto de %@. La asignación real aún requiere un evento de toque para hacer clic coincidente de macOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Schéma de contact détecté pour %@. Le mappage réel nécessite encore un événement Toucher pour cliquer macOS correspondant."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の接触パターンを検出しました。実際のマッピングには、対応するmacOSのタップでクリックイベントが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 접촉 패턴을 감지했습니다. 실제 매핑에는 일치하는 macOS 탭하여 클릭 이벤트가 필요합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Padrão de contato detectado para %@. O mapeamento real ainda requer um evento correspondente de tocar para clicar do macOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обнаружен контактный шаблон для %@. Для фактического сопоставления по-прежнему требуется соответствующее событие касания для нажатия macOS."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ için temas deseni algılandı. Eşlemenin çalışması için ayrıca eşleşen bir macOS dokunarak tıklama olayı gerekir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已检测到 %@ 的接触动作。实际映射仍需关联 macOS 轻点点击。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已偵測到 %@ 的接觸動作。實際映射仍需關聯 macOS 輕點按一下。"
          }
        }
      }
    },
