    "settings.testing.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وضع الاختبار نشط. لن تعمل الإجراءات المكوّنة حتى توقف الاختبار."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Testmodus ist aktiv. Konfigurierte Aktionen werden erst nach dem Stoppen des Tests ausgeführt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test mode is active. Configured actions will not run until you stop testing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo de prueba está activo. Las acciones configuradas no se ejecutarán hasta que detengas la prueba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode test est actif. Les actions configurées ne s’exécuteront pas avant l’arrêt du test."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テストモードが有効です。テストを停止するまで、設定済みのアクションは実行されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테스트 모드가 활성화되었습니다. 테스트를 중지할 때까지 설정된 동작이 실행되지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo de teste está ativo. As ações configuradas não serão executadas até você parar o teste."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим тестирования активен. Настроенные действия не выполняются, пока вы не остановите тест."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Test modu etkin. Testi durdurana kadar yapılandırılmış eylemler çalıştırılmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试模式已开启。停止测试前，已配置的操作不会执行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "測試模式已開啟。停止測試前，已設定的操作不會執行。"
          }
        }
      }
    },
