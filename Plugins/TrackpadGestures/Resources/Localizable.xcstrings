    "settings.testing.status.rejected.fixedNotSettled": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تستقر الأصابع الثابتة بعد. أبقها ثابتة ثم أضف إصبع النقر مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ruhenden Finger waren noch nicht stabil. Halten Sie sie still und setzen Sie den Tippfinger erneut auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixed fingers were not settled. Keep them still, then add the tapping finger again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los dedos fijos aún no estaban estables. Mantenlos quietos y vuelve a colocar el dedo que toca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les doigts fixes n’étaient pas encore stables. Gardez-les immobiles, puis replacez le doigt qui touche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "固定する指がまだ安定していません。動かさずに保ってから、タップする指をもう一度置いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고정 손가락이 아직 안정되지 않았습니다. 움직이지 말고 탭할 손가락을 다시 올리세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dedos fixos ainda não estavam estáveis. Mantenha-os imóveis e coloque novamente o dedo do toque."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неподвижные пальцы ещё не зафиксировались. Не двигайте их и снова положите палец для касания."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabit parmaklar yerleşmedi. Onları hareketsiz tutun, ardından dokunan parmağı yeniden ekleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固定手指尚未稳定；保持不动后再添加轻点手指。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "固定手指尚未穩定；保持不動後再加入輕點手指。"
          }
        }
      }
    },
    "settings.testing.status.rejected.fixedUnstable": {
      "localizations": {
