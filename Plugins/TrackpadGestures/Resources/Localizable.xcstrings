    "settings.testing.surface.waiting": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضع أصابعك على لوحة التتبع. تُعرض نقاط التلامس في الذاكرة فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legen Sie die Finger auf das Trackpad. Kontakte werden nur im Arbeitsspeicher angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place fingers on the trackpad. Contacts are shown only in memory."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca los dedos en el trackpad. Los contactos solo se muestran en memoria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez vos doigts sur le trackpad. Les contacts ne sont affichés qu’en mémoire."
