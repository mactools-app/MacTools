    "metadata.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عيّن إيماءات لوحة التتبع لإجراءات MacTools أو اختصارات لوحة المفاتيح أو النقرات الوسطى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordnen Sie Trackpad-Gesten MacTools-Aktionen, Tastaturkürzeln oder Mittelklicks zu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Map trackpad gestures to MacTools actions, keyboard shortcuts, or middle clicks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asigne gestos del trackpad a acciones de MacTools, atajos de teclado o clics centrales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Associez les gestes du trackpad aux actions MacTools, aux raccourcis clavier ou aux clics du milieu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トラックパッドジェスチャをMacToolsアクション、キーボードショートカット、または中クリックに割り当てます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트랙패드 제스처를 MacTools 동작, 키보드 단축키 또는 가운데 클릭에 매핑합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapeie gestos do trackpad para ações do MacTools, atalhos de teclado ou cliques do meio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Назначьте жестам трекпада действия MacTools, сочетания клавиш или средний щелчок мыши."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trackpad hareketlerini MacTools eylemlerine, klavye kısayollarına veya orta tıklamaya eşleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将触控板手势映射为 MacTools 操作、快捷键或中键点击"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將觸控板手勢對應到 MacTools 操作、鍵盤快速鍵或中鍵點選。"
          }
        }
      }
    },
