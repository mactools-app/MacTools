    },
    "settings.typing.ignore.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوقف التعرف مؤقتًا أثناء الكتابة لمنع إيماءات لوحة التعقب غير المقصودة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausiert die Erkennung beim Tippen, um versehentliche Trackpad-Gesten zu vermeiden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauses recognition while typing to prevent accidental trackpad gestures."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa el reconocimiento al escribir para evitar gestos accidentales en el trackpad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suspend la reconnaissance pendant la saisie pour éviter les gestes accidentels sur le trackpad."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力中は認識を一時停止し、トラックパッドの誤操作を防ぎます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력 중 인식을 일시 중지하여 트랙패드 오작동을 방지합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa o reconhecimento ao digitar para evitar gestos acidentais no trackpad."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приостанавливает распознавание во время ввода, предотвращая случайные жесты на трекпаде."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanlışlıkla yapılan Trackpad hareketlerini önlemek için yazarken tanıma duraklatılır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下普通按键时暂停识别，避免手掌误触触控板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按下普通按鍵時暫停辨識，避免手掌誤觸觸控板。"
          }
        }
      }
    },
    "settings.typing.grace.title": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التأخير بعد الكتابة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzögerung nach dem Tippen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delay After Typing"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retardo después de escribir"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Délai après la saisie"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力後の遅延"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력 후 지연"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atraso após digitar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задержка после ввода"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazmadan Sonraki Gecikme"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止输入后的延迟"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停止輸入後的延遲"
          }
        }
      }
    },
    "settings.typing.grace.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستمر الإيقاف بعد آخر ضغطة؛ التأخير الأقصر أسرع، والأطول يقلل اللمسات العرضية. الافتراضي 0.4 ثانية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausiert nach dem letzten Tastendruck weiter. Kürzer reagiert schneller, länger verhindert mehr Fehlberührungen. Standard: 0,4 Sekunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continues pausing after the last key event. Shorter responds sooner; longer prevents more accidental gestures. Default: 0.4 seconds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene la pausa tras la última pulsación. Un valor menor responde antes; uno mayor evita más gestos accidentales. Predeterminado: 0,4 segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prolonge la pause après la dernière frappe. Un délai court réagit plus vite ; un délai long évite davantage de gestes accidentels. Valeur par défaut : 0,4 seconde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後のキー入力後も一時停止します。短いほど素早く反応し、長いほど誤操作を防ぎます。デフォルトは 0.4 秒です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 키 입력 후에도 일시 중지합니다. 짧으면 더 빨리 반응하고, 길면 오작동을 더 줄입니다. 기본값은 0.4초입니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém a pausa após a última tecla. Um valor menor responde antes; um maior evita mais gestos acidentais. Padrão: 0,4 segundos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продлевает паузу после последнего нажатия. Меньшее значение быстрее реагирует, большее предотвращает больше случайных жестов. По умолчанию: 0,4 секунды."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son tuş işleminden sonra da tanıma duraklatılmaya devam eder. Süre kısalırsa daha çabuk yanıt verilir; uzarsa daha fazla yanlış hareket önlenir. Varsayılan: 0,4 saniye."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最后一次按键后继续暂停识别；较短更灵敏，较长可减少更多误触；默认 0.4 秒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最後一次按鍵後繼續暫停辨識；較短更靈敏，較長可減少更多誤觸；預設 0.4 秒。"
          }
        }
      }
    },
