    "permission.accessibility.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسل اختصارات لوحة المفاتيح والنقرات الوسطى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet Tastaturkürzel und Mittelklicks."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends keyboard shortcuts and middle clicks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía atajos de teclado y clics centrales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie des raccourcis clavier et des clics du milieu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボード ショートカットと中クリックを送信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드 단축키와 중간 클릭을 보냅니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia atalhos de teclado e cliques do meio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправляет сочетания клавиш и средние щелчки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavye kısayollarını ve orta tıklamaları gönderir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于发送快捷键和中键点击。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "發送鍵盤快捷鍵和中鍵單擊。"
          }
        }
      }
    },
    "permission.accessibility.footnote": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح لـ MacTools في إعدادات النظام ← الخصوصية والأمان ← إمكانية الوصول."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben Sie MacTools in den Systemeinstellungen → Datenschutz und Sicherheit → Barrierefreiheit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow MacTools in System Settings → Privacy & Security → Accessibility."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita MacTools en Configuración del sistema → Privacidad y seguridad → Accesibilidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez MacTools dans Paramètres système → Confidentialité et sécurité → Accessibilité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「システム設定」→「プライバシーとセキュリティ」→「アクセシビリティ」で MacTools を許可します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 → 개인정보 보호 및 보안 → 접근성에서 MacTools를 허용하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir MacTools em Configurações do sistema → Privacidade e segurança → Acessibilidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите MacTools в настройках системы → Конфиденциальность и безопасность → Доступность."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Ayarları → Gizlilik ve Güvenlik → Erişilebilirlik bölümünden MacTools'a izin verin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统设置 → 隐私与安全性 → 辅助功能，允许 MacTools。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在系統設定 → 隱私和安全性 → 輔助功能中允許 MacTools。"
          }
        }
      }
    },
