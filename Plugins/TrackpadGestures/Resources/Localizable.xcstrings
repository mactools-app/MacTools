    "gesture.conflict.secondaryClick": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحدد macOS مصدر النقرات الأصلية. أثناء اتصال ماوس آخر أو مؤشر افتراضي، تمر إيماءات لوحة التتبع التي تُنتج نقرات دون تشغيل تعييناتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS identifiziert die Quelle nativer Klicks nicht. Solange eine andere Maus oder ein virtueller Zeiger verbunden ist, werden klickerzeugende Trackpad-Gesten durchgereicht, ohne ihre Zuordnungen auszuführen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS does not identify native-click sources. While another mouse or virtual pointer is connected, click-producing trackpad gestures pass through without running their mappings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS no identifica el origen de los clics nativos. Mientras haya otro ratón o puntero virtual conectado, los gestos del trackpad que producen clics se dejan pasar sin ejecutar sus mapeos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS n’identifie pas la source des clics natifs. Lorsqu’une autre souris ou un pointeur virtuel est connecté, les gestes du trackpad produisant des clics sont transmis sans exécuter leurs mappages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS はネイティブクリックの入力元を識別しません。別のマウスまたは仮想ポインタが接続されている間、クリックを発生させるトラックパッドジェスチャはマッピングを実行せずにそのまま通過します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS는 기본 클릭의 입력 장치를 식별하지 않습니다. 다른 마우스나 가상 포인터가 연결되어 있으면 클릭을 발생시키는 트랙패드 제스처는 매핑을 실행하지 않고 그대로 통과합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS não identifica a origem dos cliques nativos. Enquanto outro mouse ou ponteiro virtual estiver conectado, os gestos do trackpad que produzem cliques passam sem executar seus mapeamentos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS не определяет источник системных щелчков. Пока подключена другая мышь или виртуальный указатель, жесты трекпада, создающие щелчки, пропускаются без выполнения своих сопоставлений."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS, yerel tıklamaların kaynağını belirlemez. Başka bir fare ya da sanal işaretçi bağlıyken tıklama oluşturan Trackpad hareketleri, eşlemeleri çalıştırılmadan doğrudan geçer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 不提供原生点击来源。连接其他鼠标或虚拟指针时，会直接放行可产生点击的触控板手势，而不执行其映射。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 不提供原生點按來源。連接其他滑鼠或虛擬指標時，會直接放行可產生點按的觸控板手勢，而不執行其映射。"
          }
        }
      }
    },
    "gesture.conflict.threeFinger": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يتعارض مع أدوات البحث والبيانات أو السحب بثلاثة أصابع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kann mit Look Up & Data Detectors oder dem Ziehen mit drei Fingern in Konflikt geraten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May conflict with Look Up & Data Detectors or three-finger dragging."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede entrar en conflicto con los detectores de búsqueda y datos o al arrastrar con tres dedos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peut entrer en conflit avec les détecteurs de recherche et de données ou avec le glissement à trois doigts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルックアップとデータ検出機能または 3 本指のドラッグと競合する可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조회 및 데이터 탐지기 또는 세 손가락 드래그와 충돌할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode entrar em conflito com Look Up & Data Detectors ou arrastar com três dedos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Может конфликтовать с поиском и детекторами данных или перетаскиванием тремя пальцами."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sözlükte Ara ve Veri Dedektörleri ya da üç parmakla sürükleme özelliğiyle çakışabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可能与“查询与数据检测器”或三指拖移冲突。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可能與查找和資料偵測器或三指拖曳發生衝突。"
          }
        }
      }
    },
    "gesture.conflict.fourFinger": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يتعارض مع Mission Control أو App Exposé أو تبديل التطبيق بملء الشاشة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möglicherweise Konflikt mit Mission Control, App Exposé oder Vollbild-App-Wechsel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May conflict with Mission Control, App Exposé, or full-screen app switching."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede entrar en conflicto con Mission Control, App Exposé o el cambio de aplicación en pantalla completa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peut entrer en conflit avec Mission Control, App Exposé ou le changement d'application en plein écran."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mission Control、App Exposé、または全画面アプリの切り替えと競合する可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mission Control, App Exposé 또는 전체 화면 앱 전환과 충돌할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode entrar em conflito com o Mission Control, App Exposé ou alternância de aplicativos em tela cheia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Может конфликтовать с Mission Control, App Exposé или полноэкранным переключением приложений."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mission Control, App Exposé veya tam ekran uygulama geçişiyle çakışabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可能与调度中心、App Exposé 或全屏切换手势冲突。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可能與 Mission Control、App Exposé 或全螢幕應用程式切換發生衝突。"
          }
        }
      }
    },
