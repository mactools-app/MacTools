    "gesture.demo.longTouchFormat": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استمر في لمس أصابع %d لمدة نصف ثانية تقريبًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berühren Sie %d Finger etwa eine halbe Sekunde lang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep %d fingers touching for about half a second."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
