    "settings.typing.ignore.title": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجاهل الإيماءات أثناء الكتابة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesten beim Tippen ignorieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignore Gestures While Typing"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignorar gestos al escribir"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignorer les gestes pendant la saisie"
          }
        },
        "ja": {
