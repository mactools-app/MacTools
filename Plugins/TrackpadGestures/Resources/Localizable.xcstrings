    "settings.mappings.tipTapGuide.middle": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند تثبيت إصبعين، يعني «الوسط» النقر بينهما."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei zwei ruhenden Fingern bedeutet „Mitte“, zwischen ihnen zu tippen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With two fixed fingers, “Middle” means tapping between them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con dos dedos fijos, «Centro» significa tocar entre ellos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec deux doigts fixes, « Milieu » signifie toucher entre les deux."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2 本の指を固定する場合、「中央」はその間をタップすることを意味します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 손가락을 고정할 때 ‘가운데’는 두 손가락 사이를 탭한다는 뜻입니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com dois dedos fixos, “Meio” significa tocar entre eles."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При двух неподвижных пальцах «Середина» означает касание между ними."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki sabit parmak kullanıldığında “Orta”, parmakların arasında dokunma anlamına gelir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固定两指时，“中间”表示在两指之间轻点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "固定兩指時，「中間」表示在兩指之間輕點。"
          }
        }
      }
    },
    "settings.mappings.tipTapGuide.test": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم «%@» للتدرّب دون تشغيل الإجراءات المكوّنة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Üben Sie mit „%@“, ohne konfigurierte Aktionen auszuführen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use “%@” to practice without running configured actions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa «%@» para practicar sin ejecutar las acciones configuradas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez « %@ » pour vous entraîner sans exécuter les actions configurées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」で、設定済みのアクションを実行せずに練習できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’를 사용하면 설정된 동작을 실행하지 않고 연습할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Use “%@” para praticar sem executar as ações configuradas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте «%@», чтобы потренироваться без запуска настроенных действий."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapılandırılmış eylemleri çalıştırmadan alıştırma yapmak için “%@” öğesini kullanın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可使用“%@”练习，不会执行已配置的操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可使用「%@」練習，不會執行已設定的操作。"
          }
        }
      }
    },
