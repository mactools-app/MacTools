    "settings.mappings.overlappingTapBehavior": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند تمكين النقر والنقر المزدوج لعدد الأصابع نفسه، ينفذ النقر المزدوج إجراء النقرة المفردة أولاً، ثم إجراء النقرة المزدوجة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Tippen und Doppeltippen mit gleicher Fingerzahl aktiviert sind, führt ein Doppeltippen zuerst die Aktion für Tippen und danach die Aktion für Doppeltippen aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When matching single and double taps are enabled, a double tap runs the single-tap action first, followed by the double-tap action."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando están activados el toque y el doble toque con el mismo número de dedos, un doble toque ejecuta primero la acción del toque y después la del doble toque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque le toucher et le double toucher avec le même nombre de doigts sont activés, un double toucher exécute d’abord l’action du toucher, puis celle du double toucher."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ指の本数のタップとダブルタップを有効にすると、ダブルタップでは最初にタップのアクションが実行され、続いてダブルタップのアクションが実行されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 손가락 수의 탭과 이중 탭을 활성화하면 이중 탭 시 탭 동작이 먼저 실행된 후 이중 탭 동작이 실행됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando o toque e o toque duplo com o mesmo número de dedos estão ativados, um toque duplo executa primeiro a ação de toque e depois a ação de toque duplo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если включены касание и двойное касание с одинаковым числом пальцев, двойное касание сначала выполняет действие обычного касания, а затем действие двойного касания."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşleşen tek ve çift dokunmalar etkinleştirildiğinde, çift dokunma önce tek dokunma eylemini, ardından çift dokunma eylemini çalıştırır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时启用相同手指数量的轻点和双击时，双击会先执行轻点操作，再执行双击操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同時啟用相同手指數量的輕點和雙擊時，雙擊會先執行輕點操作，再執行雙擊操作。"
          }
        }
      }
    },
