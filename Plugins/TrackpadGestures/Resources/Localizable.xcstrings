    "settings.testing.surface.contactPatternFormat": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم اكتشاف نمط اللمس لـ %@. لا يزال التعيين الفعلي يتطلب من macOS إنشاء حدث نقر مطابق وربطه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontaktmuster für %@ erkannt. Die tatsächliche Zuordnung erfordert weiterhin, dass macOS ein passendes Tippklick-Ereignis erzeugt und zuordnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contact pattern detected for %@. A live mapping still requires macOS to produce and correlate a matching tap-to-click event."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se detectó el patrón de contacto de %@. La asignación real aún requiere que macOS produzca y correlacione un evento de toque para hacer clic coincidente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Schéma de contact détecté pour %@. Le mappage réel nécessite encore que macOS produise et associe un événement Toucher pour cliquer correspondant."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の接触パターンを検出しました。実際のマッピングには、macOSが対応するタップでクリックイベントを生成して関連付ける必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 접촉 패턴을 감지했습니다. 실제 매핑에는 macOS가 일치하는 탭하여 클릭 이벤트를 생성하고 연결해야 합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Padrão de contato detectado para %@. O mapeamento real ainda requer que o macOS produza e correlacione um evento correspondente de tocar para clicar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обнаружен контактный шаблон для %@. Для фактического сопоставления macOS должна создать и связать соответствующее событие касания для нажатия."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ için temas deseni algılandı. Eşlemenin çalışması için macOS'un eşleşen bir dokunarak tıklama olayı üretmesi ve ilişkilendirmesi gerekir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已检测到 %@ 的接触动作。实际映射还需要 macOS 产生并关联轻点点击。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已偵測到 %@ 的接觸動作。實際映射還需要 macOS 產生並關聯輕點按一下。"
          }
        }
      }
    },
