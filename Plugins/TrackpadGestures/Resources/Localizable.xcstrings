    "settings.testing.guide.middleRequiresWiderSpan": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأصابع الثابتة متقاربة جدًا؛ باعد بينها قليلًا لإظهار منطقة الوسط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ruhenden Finger liegen zu nah beieinander. Vergrößern Sie den Abstand, damit der mittlere Zielbereich erscheint."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixed fingers are too close together. Spread them slightly to reveal the middle target zone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los dedos fijos están demasiado juntos. Sepáralos un poco para mostrar la zona central."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les doigts fixes sont trop proches. Écartez-les légèrement pour afficher la zone centrale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "固定する指の間隔が狭すぎます。少し広げると中央の対象領域が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고정 손가락 간격이 너무 좁습니다. 조금 벌리면 가운데 대상 영역이 표시됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dedos fixos estão muito próximos. Afaste-os um pouco para mostrar a zona central."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неподвижные пальцы расположены слишком близко. Немного раздвиньте их, чтобы появилась средняя зона."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabit parmaklar birbirine çok yakın. Orta hedef bölgesinin görünmesi için parmaklarınızı hafifçe açın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固定手指间距太窄；稍微分开后，中间目标区域会显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "固定手指間距太窄；稍微分開後，中間目標區域會顯示。"
          }
        }
      }
    },
    "settings.testing.guide.targetOutsideSurface": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأصابع الثابتة قريبة جدًا من الحافة؛ حرّكها نحو وسط لوحة التتبع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ruhenden Finger liegen zu nah am Rand. Bewegen Sie sie zur Mitte des Trackpads."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixed fingers are too close to the edge. Move them toward the center of the trackpad."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los dedos fijos están demasiado cerca del borde. Muévelos hacia el centro del trackpad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les doigts fixes sont trop proches du bord. Déplacez-les vers le centre du trackpad."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "固定する指が端に近すぎます。トラックパッドの中央へ移動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고정 손가락이 가장자리에 너무 가깝습니다. 트랙패드 중앙으로 옮기세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dedos fixos estão muito perto da borda. Mova-os para o centro do trackpad."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неподвижные пальцы слишком близко к краю. Переместите их к центру трекпада."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabit parmaklar kenara çok yakın. Parmaklarınızı Trackpad'in ortasına doğru hareket ettirin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固定手指太靠近边缘；向触控板中央移动后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "固定手指太靠近邊緣；向觸控板中央移動後重試。"
          }
        }
      }
    },
    "settings.testing.guide.waitingForAnchorsFormat": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثبّت الأصابع أولًا (%d/%d)؛ ستظهر المنطقة المستهدفة بعدها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legen Sie zuerst alle ruhenden Finger stabil auf (%d/%d); danach erscheint der Zielbereich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settle the fixed fingers first (%d/%d); the target zone will then appear."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estabiliza primero los dedos fijos (%d/%d); después aparecerá la zona objetivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stabilisez d’abord les doigts fixes (%d/%d) ; la zone cible apparaîtra ensuite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に固定する指を安定させてください（%d/%d）。その後、対象領域が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 고정 손가락을 안정시키세요(%d/%d). 그러면 대상 영역이 표시됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estabilize primeiro os dedos fixos (%d/%d); depois a zona de destino aparecerá."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала зафиксируйте пальцы (%d/%d), после чего появится целевая зона."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce sabit parmakları yerleştirin (%d/%d); hedef bölgesi daha sonra görünecek."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先稳定放下固定手指（%d/%d），目标区域随后显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先穩定放下固定手指（%d/%d），目標區域隨後顯示。"
          }
        }
      }
    },
