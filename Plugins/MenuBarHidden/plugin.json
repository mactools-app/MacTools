    },
    "ja": {
      "displayName": "メニューバーアイコンを隠す",
      "summary": "メニュー バー アイコンを非表示にし、ドラッグして配置し、パネルから非表示のアイコンを開きます。"
    },
    "ko": {
      "displayName": "메뉴 막대 아이콘 숨기기",
      "summary": "메뉴 표시줄 아이콘을 숨기고 드래그하여 정렬하고 패널에서 숨겨진 아이콘을 엽니다."
    },
    "pt": {
      "displayName": "Ocultar ícones da barra de menus",
      "summary": "Oculte os ícones da barra de menu, organize-os arrastando e abra ícones ocultos em um painel."
    },
    "ru": {
      "displayName": "Скрыть значки строки меню",
      "summary": "Скрыть значки строки меню, упорядочить их путем перетаскивания и открыть скрытые значки на панели."
    },
    "tr": {
      "displayName": "Menü Çubuğu Simgelerini Gizleme",
      "summary": "Menü çubuğu simgelerini gizleyin, sürükleyerek düzenleyin ve gizli simgeleri bir panelden açın."
    },
    "zh-Hans": {
      "displayName": "隐藏菜单栏图标",
