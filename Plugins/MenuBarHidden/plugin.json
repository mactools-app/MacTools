    "ar": {
      "displayName": "إخفاء أيقونات شريط القوائم",
      "summary": "إخفاء أيقونات شريط القائمة، وترتيبها عن طريق السحب، وفتح الأيقونات المخفية من اللوحة."
    },
    "de": {
      "displayName": "Menüleistensymbole ausblenden",
