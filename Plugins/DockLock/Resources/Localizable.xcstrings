    "permission.accessibility.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps the pointer away from exposed bottom edges on other displays to prevent the Dock from moving between displays."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Intercepte les bords inférieurs exposés des autres écrans afin d’empêcher le Dock de changer d’écran."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock'un ekranlar arasında atlamasını önlemek için diğer ekranlardaki açıkta kalan alt kenarları yakalar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于拦截其他显示器的外露底边，防止程序坞跳到其他显示器。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُبقي المؤشر بعيدًا عن الحواف السفلية المكشوفة للشاشات الأخرى لمنع انتقال Dock بين الشاشات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fängt Bewegungen an den unteren Bildschirmrändern anderer Bildschirme ab, um zu verhindern, dass das Dock zwischen Bildschirmen springt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intercepta los bordes inferiores expuestos en otras pantallas para evitar que el Dock salte entre pantallas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のディスプレイの露出した下端を遮断し、Dock がディスプレイ間でジャンプするのを防ぎます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 디스플레이의 노출된 하단 가장자리에서 포인터 이동을 막아 Dock이 디스플레이 사이를 이동하지 않도록 합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém o ponteiro afastado das bordas inferiores expostas de outros monitores para impedir que o Dock mude de monitor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перехватывает наведение указателя на открытые нижние края других дисплеев, чтобы Dock не перемещался между дисплеями."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於攔截其他顯示器的外露底邊，防止 Dock 跳到其他顯示器。"
          }
        }
      }
    },
    "permission.accessibility.footnote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow MacTools in System Settings > Privacy & Security > Accessibility."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez MacTools dans Réglages Système > Confidentialité et sécurité > Accessibilité."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Ayarları > Gizlilik ve Güvenlik > Erişilebilirlik bölümünde MacTools'a izin verin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统设置的“隐私与安全性 > 辅助功能”中允许 MacTools。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح لـ MacTools في إعدادات النظام > الخصوصية والأمن > تسهيلات الاستخدام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube MacTools den Zugriff unter Systemeinstellungen > Datenschutz & Sicherheit > Bedienungshilfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite MacTools en Ajustes del Sistema > Privacidad y seguridad > Accesibilidad."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定 > プライバシーとセキュリティ > アクセシビリティでMacToolsを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 > 개인정보 보호 및 보안 > 손쉬운 사용에서 MacTools를 허용하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o MacTools em Ajustes do Sistema > Privacidade e Segurança > Acessibilidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите MacTools в Системных настройках > Конфиденциальность и безопасность > Универсальный доступ."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「系統設定」>「隱私權與安全性」>「輔助使用」中允許 MacTools。"
          }
        }
      }
    },
