{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "metadata.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock Lock"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouillage du Dock"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock Kilidi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁定程序坞"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قفل Dock"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock-Sperre"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueo del Dock"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dockの固定"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock 잠금"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueio do Dock"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокировка Dock"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鎖定 Dock"
          }
        }
      }
    },
    "metadata.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevent the Dock from moving between displays accidentally."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empêche le Dock de passer accidentellement d’un écran à l’autre."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock'un ekranlar arasında yanlışlıkla taşınmasını önleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "防止程序坞在多显示器之间意外移动"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امنع انتقال Dock بين الشاشات عن طريق الخطأ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verhindert, dass das Dock versehentlich zwischen Displays verschoben wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita que el Dock se mueva accidentalmente entre pantallas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dockが誤ってディスプレイ間を移動しないようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock이 실수로 디스플레이 사이를 이동하지 않도록 합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Impeça que o Dock se mova acidentalmente entre monitores."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не позволяет Dock случайно перемещаться между дисплеями."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "防止 Dock 意外移動到其他顯示器。"
          }
        }
      }
    },
