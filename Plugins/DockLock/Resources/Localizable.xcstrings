{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "metadata.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock Lock"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouillage du Dock"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock Kilidi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁定程序坞"
          }
        }
      }
    },
    "metadata.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevent the Dock from moving between displays accidentally."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empêche le Dock de passer accidentellement d’un écran à l’autre."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock'un ekranlar arasında yanlışlıkla taşınmasını önleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "防止程序坞在多显示器之间意外移动"
          }
        }
      }
    },
    "panel.subtitle.enabled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açık"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已开启"
          }
        }
      }
    },
    "panel.subtitle.disabled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapalı"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已关闭"
          }
        }
      }
    },
    "panel.subtitle.needsPermission": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility permission required"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisation Accessibilité requise"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişilebilirlik izni gerekiyor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要辅助功能授权"
          }
        }
      }
    },
    "permission.accessibility.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibilité"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişilebilirlik"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能"
          }
        }
      }
    },
    "permission.accessibility.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Intercepts exposed bottom edges on other displays to stop the Dock jumping between displays."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Intercepte les bords inférieurs exposés des autres écrans afin d’empêcher le Dock de changer d’écran."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock'un ekranlar arasında atlamasını önlemek için diğer ekranlardaki açıkta kalan alt kenarları yakalar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于拦截其他显示器的外露底边，防止程序坞跳到其他显示器。"
          }
        }
      }
    },
    "permission.accessibility.footnote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow MacTools in System Settings > Privacy & Security > Accessibility."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez MacTools dans Réglages Système > Confidentialité et sécurité > Accessibilité."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Ayarları > Gizlilik ve Güvenlik > Erişilebilirlik bölümünde MacTools'a izin verin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统设置的“隐私与安全性 > 辅助功能”中允许 MacTools。"
          }
        }
      }
    },
    "settings.section.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglages"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置"
          }
        }
      }
    },
    "settings.enable.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activer"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkinleştir"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用"
          }
        }
      }
    },
    "settings.enable.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, prevent the Dock from moving between displays accidentally."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois activé, empêche le Dock de passer accidentellement d’un écran à l’autre."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkinleştirildiğinde Dock'un ekranlar arasında yanlışlıkla taşınması önlenir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后防止程序坞在多显示器之间意外移动。"
          }
        }
      }
    },
    "error.accessibilityRequired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock Lock needs Accessibility permission."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le verrouillage du Dock nécessite l’autorisation Accessibilité."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock Kilidi, Erişilebilirlik izni gerektiriyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock 锁定需要辅助功能权限。"
          }
        }
      }
    },
    "error.accessibilityRevoked": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility permission was revoked; Dock Lock is paused."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autorisation Accessibilité a été révoquée ; le verrouillage du Dock est en pause."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişilebilirlik izni kaldırıldı; Dock Kilidi duraklatıldı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能权限已关闭，Dock 锁定已暂停。"
          }
        }
      }
    },
    "error.startFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock Lock could not start. Check Accessibility permission."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de démarrer le verrouillage du Dock. Vérifiez l’autorisation Accessibilité."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock Kilidi başlatılamadı. Erişilebilirlik iznini denetleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法启动 Dock 锁定，请检查辅助功能权限。"
          }
        }
      }
    },
    "action.toggle.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبديل قفل Dock"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock-Sperre umschalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Toggle Dock Lock"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternar bloqueo del Dock"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activer ou désactiver le verrouillage du Dock"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dockロックを切り替える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock 잠금 전환"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternar Bloqueio do Dock"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переключить блокировку Dock"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock Kilidini Aç/Kapat"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换程序坞锁定"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換程式塢鎖定"
          }
        }
      }
    },
    "action.enable.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشغيل قفل Dock"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock-Sperre einschalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn On Dock Lock"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activar bloqueo del Dock"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activer le verrouillage du Dock"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dockロックをオンにする"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock 잠금 켜기"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativar Bloqueio do Dock"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включить блокировку Dock"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock Kilidini Aç"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启程序坞锁定"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟程式塢鎖定"
          }
        }
      }
    },
    "action.disable.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إيقاف قفل Dock"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock-Sperre ausschalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn Off Dock Lock"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivar bloqueo del Dock"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactiver le verrouillage du Dock"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dockロックをオフにする"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock 잠금 끄기"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativar Bloqueio do Dock"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключить блокировку Dock"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock Kilidini Kapat"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭程序坞锁定"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉程式塢鎖定"
          }
        }
      }
    }
  },
  "version": "1.0"
}
