    "panel.subtitle.needsPermission": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility permission required"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisation Accessibilité requise"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişilebilirlik izni gerekiyor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要辅助功能授权"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يلزم منح إذن تسهيلات الاستخدام"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berechtigung für Bedienungshilfen erforderlich"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere permiso de accesibilidad"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティ権限が必要です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손쉬운 사용 권한이 필요합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "É necessária permissão de acessibilidade"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуется разрешение на универсальный доступ"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要輔助使用授權"
          }
        }
      }
    },
