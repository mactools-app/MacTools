    "settings.enable.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, prevent the Dock from moving between displays accidentally."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois activé, empêche le Dock de passer accidentellement d’un écran à l’autre."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkinleştirildiğinde Dock'un ekranlar arasında yanlışlıkla taşınması önlenir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后防止程序坞在多显示器之间意外移动。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند التمكين، يُمنع انتقال Dock بين الشاشات عن طريق الخطأ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Aktivierung wird verhindert, dass das Dock versehentlich zwischen Bildschirmen verschoben wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando está habilitado, evita que el Dock se mueva entre pantallas accidentalmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると、Dock がディスプレイ間を誤って移動するのを防ぎます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성화되면 Dock이 실수로 디스플레이 사이를 이동하는 것을 방지합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ativado, evita que o Dock se mova acidentalmente entre monitores."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если этот параметр включен, предотвращает случайное перемещение Dock между дисплеями."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後防止 Dock 在多顯示器之間意外移動。"
          }
        }
      }
    },
    "error.accessibilityRequired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock Lock needs Accessibility permission."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le verrouillage du Dock nécessite l’autorisation Accessibilité."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock Kilidi, Erişilebilirlik izni gerektiriyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock 锁定需要辅助功能权限。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج قفل Dock إلى إذن تسهيلات الاستخدام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dock-Sperre benötigt die Berechtigung für Bedienungshilfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueo del Dock necesita permiso de Accesibilidad."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock ロックにはアクセシビリティ権限が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock 잠금에는 손쉬운 사용 권한이 필요합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Bloqueio do Dock precisa de permissão de Acessibilidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для блокировки Dock требуется разрешение на универсальный доступ."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「鎖定 Dock」需要輔助使用權限。"
          }
        }
      }
    },
    "error.accessibilityRevoked": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility permission was revoked; Dock Lock is paused."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autorisation Accessibilité a été révoquée ; le verrouillage du Dock est en pause."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişilebilirlik izni kaldırıldı; Dock Kilidi duraklatıldı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能权限已关闭，Dock 锁定已暂停。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إلغاء إذن تسهيلات الاستخدام؛ تم إيقاف قفل Dock مؤقتًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Berechtigung für Bedienungshilfen wurde widerrufen; die Dock-Sperre ist pausiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se revocó el permiso de Accesibilidad; Bloqueo del Dock está en pausa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティ権限が取り消されました。 Dock ロックが一時停止されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손쉬운 사용 권한이 해제되어 Dock 잠금이 일시 중지되었습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A permissão de Acessibilidade foi revogada; o Bloqueio do Dock está pausado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешение на универсальный доступ отозвано; блокировка Dock приостановлена."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輔助使用權限已撤銷；「鎖定 Dock」已暫停。"
          }
        }
      }
    },
    "error.startFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock Lock could not start. Check Accessibility permission."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de démarrer le verrouillage du Dock. Vérifiez l’autorisation Accessibilité."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock Kilidi başlatılamadı. Erişilebilirlik iznini denetleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法启动 Dock 锁定，请检查辅助功能权限。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر بدء تشغيل قفل Dock. تحقق من إذن تسهيلات الاستخدام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dock-Sperre konnte nicht gestartet werden. Überprüfen Sie die Berechtigung für Bedienungshilfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar Bloqueo del Dock. Comprueba el permiso de Accesibilidad."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock ロックを開始できませんでした。アクセシビリティ権限を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock 잠금을 시작할 수 없습니다. 손쉬운 사용 권한을 확인하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Bloqueio do Dock não pôde ser iniciado. Verifique a permissão de Acessibilidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось включить блокировку Dock. Проверьте разрешение на универсальный доступ."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法啟動「鎖定 Dock」，請檢查輔助使用權限。"
          }
        }
      }
    },
