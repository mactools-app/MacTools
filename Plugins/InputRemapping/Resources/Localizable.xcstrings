    "settings.button.record.help": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على أحد أزرار الماوس الجانبية أو أي زر إضافي آخر لتحديده."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücken Sie eine seitliche oder andere zusätzliche Maustaste, um es auszuwählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press a side or other extra mouse button to select it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Presione un botón lateral u otro botón adicional del mouse para seleccionarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur un bouton latéral ou autre bouton supplémentaire de la souris pour le sélectionner."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マウスの横ボタンまたはその他の追加のボタンを押して選択します。"
          }
        },
        "ko": {
