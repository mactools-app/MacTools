    "settings.recording.unavailable": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر التقاط الإدخال الآن. حاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
