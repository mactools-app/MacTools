    "permission.accessibility.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم لإرسال نقرات واختصارات الماوس المعاد تعيينها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird zum Senden neu zugeordneter Mausklicks und Verknüpfungen verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to send remapped mouse clicks and shortcuts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se utiliza para enviar clics del mouse y atajos reasignados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé pour envoyer des clics de souris et des raccourcis remappés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再マッピングされたマウス クリックとショートカットを送信するために使用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 매핑된 마우스 클릭과 바로가기를 보내는 데 사용됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado para enviar cliques e atalhos do mouse remapeados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется для отправки переназначенных щелчков мыши и ярлыков."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden eşlenen fare tıklamalarını ve kısayolları göndermek için kullanılır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于发送重映射后的鼠标点击和快捷键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於發送重新映射的滑鼠點擊和快捷方式。"
          }
        }
      }
    },
    "permission.accessibility.footnote": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعدادات النظام ← الخصوصية والأمان ← إمكانية الوصول: السماح بـ MacTools."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemeinstellungen → Datenschutz und Sicherheit → Barrierefreiheit: MacTools zulassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System Settings → Privacy & Security → Accessibility: allow MacTools."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuración del sistema → Privacidad y seguridad → Accesibilidad: permitir MacTools."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paramètres système → Confidentialité et sécurité → Accessibilité : autorisez MacTools."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定 → プライバシーとセキュリティ → アクセシビリティ: MacTools を許可します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 → 개인 정보 보호 및 보안 → 접근성: MacTools를 허용합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurações do sistema → Privacidade e segurança → Acessibilidade: permitir MacTools."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Системные настройки → Конфиденциальность и безопасность → Доступность: разрешить MacTools."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Ayarları → Gizlilik ve Güvenlik → Erişilebilirlik: MacTools'a izin verin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统设置 → 隐私与安全性 → 辅助功能，允许 MacTools。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統設定 → 隱私和安全性 → 輔助功能：允許 MacTools。"
          }
        }
      }
    },
