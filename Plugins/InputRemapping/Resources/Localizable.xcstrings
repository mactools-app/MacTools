            "value": "아무 키나 마우스 버튼을 누르거나 스크롤하십시오."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione qualquer tecla, botão do mouse ou role"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите любую клавишу, кнопку мыши или прокрутите"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhangi bir tuşa veya fare düğmesine basın ya da kaydırın"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按任意按键、鼠标按钮或滚动"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按任何鍵、滑鼠按鈕或捲動"
          }
        }
      }
    },
    "settings.input.record.help": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يصبح مفتاح لوحة المفاتيح أو زر الماوس أو اتجاه التمرير التالي هو هذا المشغل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die nächste Tastaturtaste, Maustaste oder Bildlaufrichtung wird zu diesem Auslöser."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next keyboard key, mouse button, or scroll direction becomes this trigger."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La siguiente tecla del teclado, botón del mouse o dirección de desplazamiento se convierte en este activador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La prochaine touche du clavier, le bouton de la souris ou la direction de défilement suivante devient ce déclencheur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次のキーボード キー、マウス ボタン、またはスクロール方向がこのトリガーになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 키보드 키, 마우스 버튼 또는 스크롤 방향이 이 트리거가 됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A próxima tecla do teclado, botão do mouse ou direção de rolagem se torna esse acionador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этим триггером становится следующая клавиша клавиатуры, кнопка мыши или направление прокрутки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıradaki klavye tuşu, fare düğmesi veya kaydırma yönü bu tetikleyici olur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下一次键盘、鼠标或滚动输入将成为触发条件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下一個鍵盤鍵、滑鼠按鈕或滾動方向將成為此觸發器。"
          }
        }
      }
    },
