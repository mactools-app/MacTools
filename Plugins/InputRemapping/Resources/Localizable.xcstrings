    "error.accessibilityRequired": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "منح إذن الوصول لتمكين القواعد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erteilen Sie die Berechtigung „Barrierefreiheit“, um Regeln zu aktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grant Accessibility permission to enable rules."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otorgue permiso de Accesibilidad para habilitar reglas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accordez l’autorisation d’accessibilité pour activer les règles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルールを有効にするためのアクセシビリティ権限を付与します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "규칙을 활성화하려면 접근성 권한을 부여하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conceda permissão de acessibilidade para ativar regras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предоставьте разрешение на доступность, чтобы включить правила."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuralları etkinleştirmek için Erişilebilirlik izni verin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先授予辅助功能权限以启用规则。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "授予輔助功能權限以啟用規則。"
          }
        }
      }
    },
    "error.inputMonitoringRequired": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "منح إذن مراقبة الإدخال لتمكين القواعد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erteilen Sie die Berechtigung „Eingabeüberwachung“, um Regeln zu aktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grant Input Monitoring permission to enable rules."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otorgue permiso de Monitoreo de entrada para habilitar reglas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accordez l’autorisation de surveillance des entrées pour activer les règles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルールを有効にするための入力監視アクセス許可を付与します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "규칙을 활성화하려면 입력 모니터링 권한을 부여하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conceda permissão de monitoramento de entrada para ativar regras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предоставьте разрешение на мониторинг ввода, чтобы включить правила."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuralları etkinleştirmek için Girdi İzleme izni verin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先授予输入监控权限以启用规则。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "授予輸入監控權限以啟用規則。"
          }
        }
      }
    },
    "error.tapUnavailable": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر بدء مراقبة الإدخال. تحقق من الأذونات وحاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Eingabeüberwachung konnte nicht gestartet werden. Überprüfen Sie die Berechtigungen und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Input monitoring could not start. Check permissions and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar el monitoreo de entrada. Verifique los permisos y vuelva a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La surveillance des entrées n'a pas pu démarrer. Vérifiez les autorisations et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力監視を開始できませんでした。権限を確認して、再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력 모니터링을 시작할 수 없습니다. 권한을 확인하고 다시 시도하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O monitoramento de entrada não pôde ser iniciado. Verifique as permissões e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось запустить мониторинг входа. Проверьте разрешения и повторите попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Girdi izleme başlatılamadı. İzinleri denetleyin ve yeniden deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法启动输入监听，请检查权限后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入監控無法啟動。檢查權限並重試。"
          }
        }
      }
    },
