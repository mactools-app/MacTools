    "permission.inputMonitoring.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم لمراقبة لوحة المفاتيح والماوس وإدخال التمرير على مستوى النظام. تبقى جميع عمليات المعالجة على جهاز Mac هذا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird zur systemweiten Überwachung von Tastatur-, Maus- und Scroll-Eingaben verwendet. Die gesamte Verarbeitung bleibt auf diesem Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to monitor keyboard, mouse, and scroll input system-wide. All processing stays on this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se utiliza para monitorear el teclado, el mouse y la entrada de desplazamiento en todo el sistema. Todo el procesamiento permanece en esta Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé pour surveiller les entrées du clavier, de la souris et du défilement à l’échelle du système. Tous les traitements restent sur ce Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム全体のキーボード、マウス、スクロール入力を監視するために使用されます。すべての処理はこの Mac 上に留まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 전체에서 키보드, 마우스 및 스크롤 입력을 모니터링하는 데 사용됩니다. 모든 처리는 이 Mac에 유지됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado para monitorar teclado, mouse e entrada de rolagem em todo o sistema. Todo o processamento permanece neste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется для мониторинга ввода с клавиатуры, мыши и прокрутки во всей системе. Вся обработка остается на этом Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavye, fare ve kaydırma girdisini sistem genelinde izlemek için kullanılır. Tüm işlemler bu Mac'te kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于在系统范围内监听键盘、鼠标和滚动输入。所有处理均在本机完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於監視系統範圍內的鍵盤、滑鼠和滾動輸入。所有處理都在這台 Mac 上進行。"
          }
        }
      }
    },
