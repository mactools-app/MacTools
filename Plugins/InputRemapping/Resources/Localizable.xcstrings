    "settings.keyboard.confirmation.message": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعترض هذه القاعدة الإدخال على مستوى النظام. اضغط ⌃⌥⌘Esc في أي وقت لتعطيل الاختصارات غير الآمنة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Regel fängt Eingaben systemweit ab. Drücken Sie jederzeit ⌃⌥⌘Esc, um unsichere Kurzbefehle zu deaktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This rule intercepts input system-wide. Press ⌃⌥⌘Esc at any time to disable unsafe shortcuts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta regla intercepta entradas en todo el sistema. Pulsa ⌃⌥⌘Esc en cualquier momento para desactivar los atajos no seguros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette règle intercepte les entrées à l’échelle du système. Appuyez à tout moment sur ⌃⌥⌘Échap pour désactiver les raccourcis à risque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このルールはシステム全体の入力をインターセプトします。⌃⌥⌘Esc を押すと、危険なショートカットをいつでも無効にできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 규칙은 시스템 전체의 입력을 가로챕니다. 언제든지 ⌃⌥⌘Esc를 눌러 안전하지 않은 단축키를 비활성화할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta regra intercepta entradas em todo o sistema. Pressione ⌃⌥⌘Esc a qualquer momento para desativar atalhos não seguros."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это правило перехватывает ввод во всей системе. Нажмите ⌃⌥⌘Esc в любое время, чтобы отключить небезопасные сочетания клавиш."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kural girdiyi sistem genelinde yakalar. Güvenli olmayan kısayolları devre dışı bırakmak için istediğiniz zaman ⌃⌥⌘Esc tuşlarına basabilirsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此规则会在全系统范围内拦截输入。随时按下 ⌃⌥⌘Esc 即可停用不安全的快捷键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此規則會攔截系統範圍內的輸入。隨時按下 ⌃⌥⌘Esc 即可停用不安全的快速鍵。"
          }
        }
      }
    },
