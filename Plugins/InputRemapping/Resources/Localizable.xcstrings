    "settings.mouseInteraction.warning": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر نقرًا مزدوجًا واضغط لفترة طويلة للحفاظ على النقرة الأصلية متاحة لتجنب تأخير الإدخال أو إعادة تشغيله."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durch Doppelklicken und langes Drücken bleibt der ursprüngliche Klick verfügbar, um eine Verzögerung oder Wiederholung der Eingabe zu vermeiden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-click and long-press keep the original click available to avoid delaying or replaying input."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haga doble clic y mantenga presionado para mantener disponible el clic original para evitar retrasar o reproducir la entrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-cliquez et appuyez longuement pour conserver le clic d'origine disponible pour éviter de retarder ou de relire la saisie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダブルクリックして長押しすると、入力の遅れや再入力を避けるために、元のクリックが利用可能な状態に保たれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 번 클릭하고 길게 누르면 입력이 지연되거나 재생되는 것을 방지하기 위해 원래 클릭을 계속 사용할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique duas vezes e mantenha pressionado para manter o clique original disponível para evitar atraso ou repetição da entrada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Двойной щелчок и долгое нажатие сохраняют исходный щелчок доступным, чтобы избежать задержки или повторного воспроизведения ввода."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Girdinin gecikmesini veya yeniden yürütülmesini önlemek için çift tıklama ve uzun basma, özgün tıklamayı korur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双击和长按会保留原始点击，以避免延迟或重放输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雙擊和長按可保持原始點擊可用，以避免延遲或重播輸入。"
          }
        }
      }
    },
    "settings.keyboard.warning": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي المفتاح الذي لا يحتوي على معدلات إلى تجاوز الكتابة العادية أثناء تمكين القاعدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Taste ohne Modifikatoren überschreibt die normale Eingabe, während die Regel aktiviert ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A key without modifiers overrides normal typing while the rule is enabled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una clave sin modificadores anula la escritura normal mientras la regla está habilitada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une touche sans modificateurs remplace la saisie normale lorsque la règle est activée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルールが有効な場合、修飾子のないキーは通常の入力をオーバーライドします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수정자가 없는 키는 규칙이 활성화된 동안 일반 입력을 재정의합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma tecla sem modificadores substitui a digitação normal enquanto a regra está habilitada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ без модификаторов переопределяет обычный ввод, пока правило включено."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değiştirici tuşu olmayan bir tuş, kural etkinken normal yazmayı geçersiz kılar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，无修饰键会覆盖正常输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用規則時，不帶修飾符的鍵會覆蓋正常鍵入。"
          }
        }
      }
    },
    "settings.keyboard.confirmation.title": {
      "localizations": {
