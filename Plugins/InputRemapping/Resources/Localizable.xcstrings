    "settings.singleKey.preparing": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ تحضير تسجيل المفتاح…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastenaufnahme wird vorbereitet …"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing key recording…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparando la grabación de tecla…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préparation de l’enregistrement…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キー記録を準備中…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 기록 준비 중…"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A preparar gravação da tecla…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подготовка записи клавиши…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuş kaydı hazırlanıyor…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在准备按键录制…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在準備按鍵錄製…"
          }
        }
      }
    },
    "settings.singleKey.preparing.detail": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حرّر زر تسجيل المفتاح؛ سيبدأ الاستماع بعد ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass die Taste „Taste aufnehmen“ los; danach beginnt die Aufnahme."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Release the Record Key button; listening starts next."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suelta el botón Grabar tecla; la escucha comenzará después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relâchez le bouton Enregistrer la touche ; l’écoute commencera ensuite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「キーを記録」ボタンを離すと、待機が始まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 기록 버튼에서 손을 떼면 감지가 시작됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Solte o botão Gravar tecla; a escuta começa a seguir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отпустите кнопку записи — затем начнётся ожидание клавиши."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuşu Kaydet düğmesini bırakın; dinleme hemen başlayacak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "松开“录制按键”按钮后开始监听。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放開「錄製按鍵」按鈕後開始聆聽。"
          }
        }
      }
    },
