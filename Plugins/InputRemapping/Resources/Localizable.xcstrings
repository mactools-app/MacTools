    "settings.input.preparing.detail": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حرر زر تسجيل الإدخال؛ يبدأ الاستماع بعد ذلك."
          }
        },
        "de": {
          "stringUnit": {
