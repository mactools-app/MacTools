---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteNav from "@/components/SiteNav.astro";
import HomeHero from "@/components/HomeHero.astro";
import FeatureShowcase from "@/components/FeatureShowcase.astro";
import SearchIntent from "@/components/SearchIntent.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import StarterPackCards from "@/components/StarterPackCards.astro";
import LocalizedText from "@/components/LocalizedText.astro";
import appRelease from "../../../docs/app-release.json";

const pageTitle = { zh: "MacTools | 免费开源的原生 macOS 菜单栏工具集", en: "MacTools | Free, open-source native macOS menu bar tools" };
const pageDescription = { zh: "MacTools 是免费开源的原生 macOS 菜单栏工具集，集中管理显示器、清理、休眠、启动台、系统状态、电池、风扇和插件市场。", en: "MacTools is a free, open-source native macOS menu bar toolkit for display controls, cleanup, sleep, Launchpad, system status, batteries, fans, and plugins." };
const homeKeywords = [
  "MacTools",
  "macOS menu bar tools",
  "Mac menu bar app",
  "native macOS utility",
  "open source macOS app",
  "free macOS utilities",
  "One Switch alternative",
  "AnySwitch alternative",
  "OnlySwitch alternative",
  "Display Brightness",
  "DDC/CI",
  "Display Resolution",
  "Night Shift",
  "True Tone",
  "Prevent Sleep",
  "Disk Cleanup",
  "Xcode Cleanup",
  "Launchpad replacement",
  "System Status",
  "Device Battery",
  "Fan Control",
  "Battery Charge Limit",
];
const siteURL = Astro.site?.href ?? "https://mactools.ggbond.app/";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const downloadURL = appRelease.downloadURL;
const structuredDataFor = (language: "zh" | "en") => [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "MacTools",
    applicationCategory: "UtilitiesApplication",
    operatingSystem: "macOS 14.0 or later",
    url: siteURL,
    downloadUrl: downloadURL,
    installUrl: "https://github.com/ggbond268/MacTools/releases",
    codeRepository: "https://github.com/ggbond268/MacTools",
    license: "https://github.com/ggbond268/MacTools/blob/main/LICENSE",
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD",
    },
    description: pageDescription[language],
    inLanguage: language === "zh" ? "zh-CN" : "en",
    featureList: language === "zh" ? [
      "显示器亮度和分辨率控制",
      "菜单栏和桌面控制",
      "磁盘清理和 Xcode 清理",
      "系统状态、设备电量、风扇控制和电池充电上限",
      "插件目录和可配置快捷键",
    ] : [
      "Display brightness and resolution controls",
      "Menu bar and desktop controls",
      "Disk cleanup and Xcode cleanup",
      "System status, device battery, fan control, and battery charge limit",
      "Plugin catalog and configurable shortcuts",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "MacTools",
    url: siteURL,
    inLanguage: language === "zh" ? "zh-CN" : "en",
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  keywords={{ zh: ["MacTools", "macOS 菜单栏工具", "Mac 菜单栏应用", "原生 macOS 工具", "开源 macOS 应用", "免费 macOS 工具", "One Switch 替代", "AnySwitch 替代", "OnlySwitch 替代", "显示器亮度", "DDC/CI", "显示器分辨率", "夜览", "原彩显示", "阻止休眠", "磁盘清理", "Xcode 清理", "启动台替代", "系统状态", "设备电量", "风扇控制", "电池充电上限"], en: homeKeywords }}
  image={{ zh: "/assets/screenshots/readme-hero-zh-dark.png", en: "/assets/screenshots/readme-hero-en-dark.png" }}
  structuredData={{ zh: structuredDataFor("zh"), en: structuredDataFor("en") }}
  page="home"
>
  <SiteNav active="home" />
  <main>
    <HomeHero downloadURL={downloadURL} />
    <section class="home-packs" aria-labelledby="home-packs-title">
      <div class="section-heading">
        <h2 id="home-packs-title"><LocalizedText zh="从常用工具开始" en="Start with a few useful tools" /></h2>
        <p><LocalizedText zh="搭配多个工具组合，安装前检查，之后随时自定。" en="Combine starter packs, review before installing, and customize anytime." /></p>
      </div>
      <StarterPackCards limit={3} />
      <a class="button subtle" href={`${base}/packs`}><LocalizedText zh="查看全部七个工具组合" en="Explore all seven packs" /></a>
    </section>
    <FeatureShowcase />
    <SearchIntent />
  </main>
  <SiteFooter />
  <script src="../scripts/hero-simulator.ts"></script>
</BaseLayout>
