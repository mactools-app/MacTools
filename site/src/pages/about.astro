---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteNav from "@/components/SiteNav.astro";
import SiteFooter from "@/components/SiteFooter.astro";

const storyParagraphs = [
  {
    zh: "乾隆二十三年秋，一粒蓝色星光落在紫禁城屋脊上，转了三圈，打开一扇没关严的天门。乾隆把手一挥：“朕只进去看看。”众人都知道，这句话通常意味着要走很远。",
    en: "In the autumn of Qianlong's twenty-third year, a blue spark landed on the roof of the Forbidden City, circled three times, and opened a celestial door that had not been properly shut. “I shall only take a look,” said Qianlong, which everyone knew usually meant a long journey.",
  },
  {
    zh: "门后不是仙宫，而是一座悬在银河边上的小星港。一名银河开发官正在整理星图，身旁亮着一个小小的名字：MacTools。“这里没有长生不老，”开发官说，“只有一些把麻烦变简单的小工具。”",
    en: "Beyond the door was no immortal palace, but a small port hanging at the edge of the galaxy. A Galactic Developer was arranging star maps beside a small glowing name: MacTools. “There is no immortality here,” said the developer, “only a few tools for making trouble simpler.”",
  },
  {
    zh: "话音未落，警钟响了。一支黑甲舰队正朝星港逼近，控制台却亮得刺眼，图标挤成早朝，回宫的星图也不知躲在哪扇窗口后面。乾隆很镇定：“先把灯调暗。朕处理大事，一向从不晃眼开始。”",
    en: "Before he could finish, an alarm rang. A dark-armored fleet was approaching the port, while the controls were painfully bright, icons crowded together like officials at morning court, and the map home had vanished behind some forgotten window. Qianlong remained calm. “Dim the lights first. I prefer my great affairs without glare.”",
  },
  {
    zh: "开发官调低亮度，整理好启动台，又藏好天幕中央那道黑色缺口。随后轻轻一切，完整星图便来到眼前。乾隆问：“能不能把话多的大臣也整理一下？”开发官摇头：“这里只管窗口，不管朝政。”",
    en: "The developer lowered the brightness, organized Launchpad, and hid the dark notch in the sky. One quick switch brought the full star map forward. “Can it also organize overly talkative ministers?” Qianlong asked. “Only windows,” said the developer. “Court politics is outside our remit.”",
  },
  {
    zh: "黑甲舰队发来一长串谁也看不懂的讯号。开发官打开翻译，只得到一句话：“请问中秋赏月大会往哪边走？”再看日历，原来他们和乾隆都迟到了。所谓银河危机，不过是两拨迷路的人互相把对方当成了敌军。",
    en: "The fleet sent a long message that no one could understand. Translator reduced it to one question: “Which way is the Mid-Autumn moon-viewing festival?” Calendar revealed that both the fleet and Qianlong were already late. The galactic crisis was merely two lost parties mistaking each other for an invasion.",
  },
  {
    zh: "开发官把正确航线发给舰队。对方收起武器，回赠三袋陨石瓜子，转身追月亮去了。乾隆想把整座百宝库搬回宫，开发官却说：“需要什么，取什么；全堆在一起，桌面又要挤成早朝。”回宫以后，御案上只多了一枚小图标。事情一乱，它便亮起蓝光，提醒皇帝：先别慌，菜单里总有办法。",
    en: "The developer sent the fleet the correct route. They lowered their weapons, left behind three bags of meteor-seed snacks, and hurried after the moon. Qianlong wanted to move the entire treasury to the palace, but the developer replied, “Take what you need. Pile up everything and your desk becomes morning court again.” Back home, the imperial desk gained only one small icon. Whenever affairs became crowded, it glowed blue with a simple reminder: do not panic; there is probably a tool for this.",
  },
];

const poemLines = [
  {
    zh: "乾隆误入银河港，开发官轻点微光。",
    en: "Qianlong crossed a celestial gate; the developer shaped a spark of light.",
  },
  {
    zh: "亮度收时星图现，图标隐处路开张。",
    en: "The glare grew soft, the star map shone; the crowded icons slipped from sight.",
  },
  {
    zh: "异语翻来非战报，原来舰队也迷航。",
    en: "Strange words became a request for aid; the fearsome fleet had lost its way.",
  },
  {
    zh: "百宝不求金玉换，安安静静驻栏旁。",
    en: "No gold was asked, no tribute grand; the quiet tools stayed close at hand.",
  },
];

const pageTitle = { zh: "关于 MacTools | 免费开源 macOS 菜单栏工具", en: "About MacTools | Free, open-source macOS menu bar tools" };
const pageDescription = { zh: "了解 MacTools 项目故事：一个免费、开源、原生、安静的 macOS 菜单栏工具箱，适合显示器控制、桌面工具、清理维护和插件扩展。", en: "Discover the story of MacTools: a free, open-source, native macOS menu bar toolbox for display controls, desktop tools, cleanup, maintenance, and plugins." };
const aboutKeywords = [
  "MacTools about",
  "open source macOS app",
  "free macOS menu bar app",
  "native macOS utility",
  "SwiftUI AppKit macOS app",
  "macOS menu bar toolbox",
  "One Switch alternative",
  "AnySwitch alternative",
];
const structuredDataFor = (language: "zh" | "en") => ({
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: pageTitle[language],
  description: pageDescription[language],
  inLanguage: language === "zh" ? "zh-CN" : "en",
  url: new URL(Astro.url.pathname, Astro.site).href,
  about: {
    "@type": "SoftwareApplication",
    name: "MacTools",
    applicationCategory: "UtilitiesApplication",
    operatingSystem: "macOS 14.0 or later",
    codeRepository: "https://github.com/ggbond268/MacTools",
  },
});
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  keywords={{ zh: ["关于 MacTools", "开源 macOS 应用", "免费 macOS 菜单栏应用", "原生 macOS 工具", "SwiftUI AppKit macOS 应用", "macOS 菜单栏工具箱", "One Switch 替代", "AnySwitch 替代"], en: aboutKeywords }}
  structuredData={{ zh: structuredDataFor("zh"), en: structuredDataFor("en") }}
  page="about"
>
  <SiteNav active="about" />
  <main class="about-page">
    <section class="about-cinematic" aria-label="MacTools 百宝箱故事" data-aria-label-zh="MacTools 百宝箱故事" data-aria-label-en="The MacTools toolbox story">
      <div class="star-field" aria-hidden="true"></div>
      <button class="skip-animation" type="button"><span data-i18n-zh>跳过</span><span data-i18n-en>Skip</span></button>

      <section class="intro copy-zh" lang="zh-CN" aria-label="故事开场">
        很久很久以前，在一个遥远的<br />星系……
      </section>
      <section class="intro copy-en" lang="en" aria-label="Story opening">
        A long time ago, in a galaxy far,<br /> far away....
      </section>

      <section class="title-flight">
        <h1 class="copy-zh" lang="zh-CN" aria-label="MacTools，连皇帝都想要的菜单栏工具箱">
          <span>MacTools</span>
          <span>连皇帝都想要的菜单栏工具箱。</span>
        </h1>
        <h1 class="copy-en" lang="en" aria-label="MacTools, a menu bar toolbox even an emperor would want">
          <span>MacTools</span>
          <span>A menu bar toolbox even an emperor would want.</span>
        </h1>
      </section>

      <section class="crawl-window">
        <div class="crawl-stage">
          <article class="cinematic-copy copy-zh" data-crawl-track lang="zh-CN">
            <p class="story-label">第一卷 · 银河开发官</p>
            {storyParagraphs.map((paragraph) => <p>{paragraph.zh}</p>)}
            <p>后人诗云：</p>
            <blockquote>
              {poemLines.map((line) => <span class="poem-line">{line.zh}</span>)}
            </blockquote>
            <p class="story-conclusion">MacTools——开源，免费，原生，安静，连皇帝都想要。</p>
            <p class="story-signoff">银河野史 · MACTOOLS 开发官卷</p>
          </article>

          <article class="cinematic-copy copy-en" data-crawl-track lang="en">
            <p class="story-label">CHAPTER I · THE GALACTIC DEVELOPER</p>
            {storyParagraphs.map((paragraph) => <p>{paragraph.en}</p>)}
            <p>Later generations wrote:</p>
            <blockquote>
              {poemLines.map((line) => <span class="poem-line">{line.en}</span>)}
            </blockquote>
            <p class="story-conclusion">MacTools: open source, free, native, quiet, and desirable even to an emperor.</p>
            <p class="story-signoff">THE GALACTIC CHRONICLES · MACTOOLS DEVELOPER</p>
          </article>
        </div>
      </section>
    </section>

    <div class="about-reading">
      <article class="source-story" aria-label="MacTools 故事" data-aria-label-zh="MacTools 故事" data-aria-label-en="MacTools story">
        <header class="story-heading">
          <p class="eyebrow">
            <span data-i18n-zh>关于 MacTools</span>
            <span data-i18n-en>About MacTools</span>
          </p>
          <h1 tabindex="-1" data-reading-title>
            <span data-i18n-zh>乾隆、银河开发官，与 MacTools 百宝箱。</span>
            <span data-i18n-en>Qianlong, the Galactic Developer, and the MacTools Treasury.</span>
          </h1>
          <p class="story-intro">
            <span data-i18n-zh>一段关于误入星港、化解乌龙，以及把复杂事情收拾简单的银河野史。</span>
            <span data-i18n-en>An unofficial galactic tale about a wrong turn, a false alarm, and making complicated things simple.</span>
          </p>
        </header>
        <div class="source-prose">
          {storyParagraphs.map((paragraph) => (
            <p>
              <span data-i18n-zh>{paragraph.zh}</span>
              <span data-i18n-en>{paragraph.en}</span>
            </p>
          ))}
          <p>
            <span data-i18n-zh>后人诗云：</span>
            <span data-i18n-en>Later generations wrote:</span>
          </p>
          <blockquote>
            {poemLines.map((line) => (
              <span class="poem-line">
                <span data-i18n-zh>{line.zh}</span>
                <span data-i18n-en>{line.en}</span>
              </span>
            ))}
          </blockquote>
          <p>
            <strong>
              <span data-i18n-zh>MacTools——开源，免费，原生，安静，连皇帝都想要。</span>
              <span data-i18n-en>MacTools: open source, free, native, quiet, and desirable even to an emperor.</span>
            </strong>
          </p>
        </div>
      </article>
    </div>
  </main>
  <SiteFooter />

  <script>
    const skip = document.querySelector<HTMLButtonElement>(".skip-animation");
    const storyTracks = document.querySelectorAll<HTMLElement>("[data-crawl-track]");
    const readingTitle = document.querySelector<HTMLElement>("[data-reading-title]");

    const revealStory = (moveFocus = false) => {
      if (document.body.classList.contains("story-ready")) return;

      document.documentElement.classList.add("story-ready");
      document.body.classList.add("story-ready");
      window.scrollTo(0, 0);

      if (moveFocus) readingTitle?.focus({ preventScroll: true });
    };

    skip?.addEventListener("click", () => {
      revealStory(true);
    });

    storyTracks.forEach((track) => {
      track.addEventListener("animationend", (event) => {
        if (event.animationName === "story-crawl") revealStory();
      });
    });

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      revealStory();
    }
  </script>
</BaseLayout>

<style>
  :global(body[data-page="about"]) {
    --about-space: #eef3f8;
    --about-space-deep: #dfe8f2;
    --about-ink: #1d1d1f;
    --about-muted: #6e6e73;
    --about-blue: var(--blue);
    --about-blue-soft: color-mix(in srgb, var(--blue) 74%, var(--about-ink));
    --about-vignette: rgb(29 29 31 / 14%);
    --about-star-opacity: 0.34;
    --story-ink: #333336;
    --font-story: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", Georgia, serif;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  :global(html[data-theme="dark"] body[data-page="about"]) {
    --about-space: #050506;
    --about-space-deep: #010102;
    --about-ink: #f5f5f7;
    --about-muted: #a1a1a6;
    --about-blue: var(--blue-on-dark);
    --about-blue-soft: color-mix(in srgb, var(--blue-on-dark) 68%, white);
    --about-vignette: rgb(0 0 0 / 72%);
    --about-star-opacity: 0.48;
    --story-ink: #d2d2d7;
  }

  .about-page {
    position: relative;
    min-height: 0;
    flex: 1 1 auto;
    overflow: hidden;
  }

  .about-cinematic {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 66%, color-mix(in srgb, var(--about-blue) 11%, transparent), transparent 38%),
      linear-gradient(to bottom, var(--about-space), var(--about-space-deep) 68%);
    transition: background-color 260ms ease;
  }

  .about-cinematic::after {
    content: "";
    position: absolute;
    z-index: 3;
    inset: 0;
    pointer-events: none;
    box-shadow: inset 0 0 13vw var(--about-vignette);
    transition: box-shadow 260ms ease;
  }

  .star-field {
    position: absolute;
    z-index: 0;
    inset: 0;
    pointer-events: none;
    opacity: var(--about-star-opacity);
    background-image:
      radial-gradient(circle at 7% 18%, color-mix(in srgb, var(--about-ink) 78%, transparent) 0 0.06rem, transparent 0.08rem),
      radial-gradient(circle at 19% 72%, color-mix(in srgb, var(--about-blue) 72%, transparent) 0 0.05rem, transparent 0.075rem),
      radial-gradient(circle at 28% 34%, color-mix(in srgb, var(--about-ink) 50%, transparent) 0 0.045rem, transparent 0.07rem),
      radial-gradient(circle at 43% 14%, color-mix(in srgb, var(--about-ink) 72%, transparent) 0 0.055rem, transparent 0.08rem),
      radial-gradient(circle at 56% 82%, color-mix(in srgb, var(--about-blue-soft) 58%, transparent) 0 0.05rem, transparent 0.075rem),
      radial-gradient(circle at 66% 29%, color-mix(in srgb, var(--about-ink) 64%, transparent) 0 0.045rem, transparent 0.07rem),
      radial-gradient(circle at 79% 62%, color-mix(in srgb, var(--about-blue) 68%, transparent) 0 0.055rem, transparent 0.08rem),
      radial-gradient(circle at 91% 21%, color-mix(in srgb, var(--about-ink) 62%, transparent) 0 0.05rem, transparent 0.075rem),
      radial-gradient(circle at 94% 87%, color-mix(in srgb, var(--about-ink) 44%, transparent) 0 0.045rem, transparent 0.07rem);
    transition: opacity 260ms ease;
  }

  .skip-animation {
    position: absolute;
    z-index: 5;
    top: clamp(1rem, 2.4vw, 2rem);
    right: clamp(1.25rem, 4vw, 4rem);
    min-height: 2.75rem;
    border: 0;
    padding: 0.25rem 0.4rem;
    background: transparent;
    color: color-mix(in srgb, var(--about-ink) 62%, transparent);
    cursor: pointer;
    font-size: 0.68rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.08em;
    transition: color 180ms ease;
  }

  .skip-animation:hover,
  .skip-animation:focus-visible {
    color: var(--about-ink);
  }

  .intro,
  .title-flight {
    position: absolute;
    z-index: 2;
    top: 50%;
    left: 50%;
    pointer-events: none;
  }

  .copy-en {
    visibility: hidden;
  }

  :global(html[data-lang="en"]) .copy-zh {
    visibility: hidden;
  }

  :global(html[data-lang="en"]) .copy-en {
    visibility: visible;
  }

  .intro {
    width: min(31rem, calc(100vw - 3rem));
    color: var(--about-blue);
    font-size: clamp(1.08rem, 1.9vw, 1.55rem);
    font-weight: 450;
    line-height: 1.55;
    letter-spacing: 0;
    text-align: left;
    text-wrap: balance;
    opacity: 0;
    transform: translate(-50%, -50%);
    animation: intro-arrival 5.8s cubic-bezier(0.25, 1, 0.5, 1) 0.7s both;
  }

  .title-flight {
    width: min(58rem, calc(100vw - 2rem));
    display: grid;
    place-items: center;
    text-align: center;
    opacity: 0;
    transform: translate(-50%, -50%) scale(2.2);
    animation: title-flight 7s cubic-bezier(0.16, 1, 0.3, 1) 6.35s both;
  }

  .title-flight h1 {
    width: 100%;
    grid-area: 1 / 1;
    margin: 0;
    color: var(--about-ink);
    font-family: "SF Pro Display", "SF Pro Text", system-ui, -apple-system, sans-serif;
    font-size: clamp(2.4rem, 6.4vw, 5.5rem);
    font-weight: 720;
    line-height: 1.05;
    letter-spacing: 0;
    animation: none;
  }

  .title-flight h1 span {
    display: block;
  }

  .title-flight h1 span:first-child {
    white-space: nowrap;
  }

  .title-flight h1 span:last-child {
    max-width: min(52rem, calc(100vw - 2rem));
    margin: 0.3em auto 0;
    color: var(--about-blue-soft);
    font-family: var(--font-story);
    font-size: 0.42em;
    font-weight: 650;
    line-height: 1.35;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .title-flight h1.copy-en span:last-child {
    font-size: 0.34em;
  }

  .crawl-window {
    position: absolute;
    z-index: 2;
    top: clamp(6.5rem, 13vh, 8rem);
    right: clamp(1rem, 4vw, 4rem);
    bottom: clamp(4.75rem, 10vh, 6.25rem);
    left: clamp(1rem, 4vw, 4rem);
    overflow: hidden;
    perspective: 520px;
    perspective-origin: 50% 14%;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 10%, #000 88%, transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0%, #000 10%, #000 88%, transparent 100%);
  }

  .crawl-stage {
    position: absolute;
    inset: 0;
    transform: rotateX(23deg);
    transform-origin: 50% 100%;
    transform-style: preserve-3d;
  }

  .cinematic-copy {
    position: absolute;
    top: 0;
    left: 50%;
    width: min(39rem, 84vw);
    margin: 0;
    color: var(--story-ink);
    font-family: var(--font-story);
    font-kerning: normal;
    font-synthesis: none;
    text-align: justify;
    text-justify: inter-ideograph;
    text-shadow: 0 0 1.1rem color-mix(in srgb, var(--about-blue) 9%, transparent);
    opacity: 0;
    transform: translate3d(-50%, 62vh, 0);
    animation: story-crawl 68s linear 13.25s both;
    backface-visibility: hidden;
  }

  .cinematic-copy.copy-en {
    hyphens: auto;
  }

  .cinematic-copy p,
  .cinematic-copy blockquote {
    max-width: 38rem;
    margin: 0 auto 2.15rem;
    color: var(--story-ink);
    font-size: 1.05rem;
    font-weight: 470;
    line-height: 2;
    letter-spacing: 0;
    text-wrap: pretty;
  }

  .cinematic-copy .story-label,
  .cinematic-copy .story-signoff {
    color: var(--about-blue);
    font-family: "SF Pro Text", system-ui, -apple-system, sans-serif;
    font-size: clamp(0.72rem, 1vw, 0.84rem);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-align: center;
  }

  .cinematic-copy .story-label {
    margin-bottom: 3.4rem;
  }

  .cinematic-copy .story-signoff {
    margin-top: 3.5rem;
    color: color-mix(in srgb, var(--story-ink) 70%, transparent);
  }

  .cinematic-copy blockquote,
  .cinematic-copy .story-conclusion {
    margin-top: 3.8rem;
    margin-bottom: 3.8rem;
    padding: 0;
    color: var(--about-ink);
    font-size: clamp(1.2rem, 2vw, 1.55rem);
    font-weight: 680;
    line-height: 1.75;
    text-align: center;
    text-wrap: balance;
  }

  .poem-line {
    display: block;
  }

  .about-reading {
    display: none;
  }

  .source-story {
    max-width: 900px;
    display: block;
    padding-block: clamp(84px, 12vw, 132px) clamp(72px, 10vw, 128px);
  }

  .story-heading {
    max-width: 820px;
    margin: 0 auto clamp(52px, 8vw, 80px);
    text-align: center;
  }

  .story-heading .eyebrow {
    margin-bottom: 16px;
  }

  .story-heading h1 {
    margin: 0;
    font-family: "SF Pro Display", "SF Pro Text", system-ui, -apple-system, sans-serif;
    font-size: 56px;
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .story-intro {
    max-width: 680px;
    margin: 22px auto 0;
    color: var(--ink-soft);
    font-size: 21px;
    line-height: 1.55;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .source-prose {
    margin-inline: auto;
  }

  :global(body[data-page="about"]:not(.story-ready) .site-footer) {
    display: none;
  }

  :global(html.story-ready) {
    overflow-x: hidden;
    overflow-y: auto;
  }

  :global(body.story-ready) {
    height: auto;
    display: block;
    overflow-x: hidden;
    overflow-y: auto;
  }

  :global(body.story-ready) .about-page {
    min-height: auto;
    overflow: visible;
  }

  :global(body.story-ready) .about-cinematic {
    display: none;
  }

  :global(body.story-ready) .about-reading {
    display: block;
  }

  @keyframes intro-arrival {
    0%,
    8% {
      opacity: 0;
    }

    24%,
    82% {
      opacity: 1;
    }

    100% {
      opacity: 0;
    }
  }

  @keyframes title-flight {
    0% {
      opacity: 0;
      transform: translate(-50%, -50%) scale(2.2);
    }

    9%,
    72% {
      opacity: 1;
    }

    100% {
      opacity: 0;
      transform: translate(-50%, -54%) scale(0.075);
    }
  }

  @keyframes story-crawl {
    0% {
      opacity: 0;
      transform: translate3d(-50%, 62vh, 0);
    }

    3%,
    98% {
      opacity: 1;
    }

    100% {
      opacity: 0;
