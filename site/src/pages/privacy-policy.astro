---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteNav from "@/components/SiteNav.astro";
import SiteFooter from "@/components/SiteFooter.astro";

const pageTitle = { zh: "隐私政策 | MacTools", en: "Privacy Policy | MacTools" };
const pageDescription = { zh: "MacTools 隐私政策：了解这款本地优先、开源的 macOS 工具如何处理本地数据、系统权限和按需联网功能。", en: "MacTools privacy policy: how this local-first, open-source macOS toolkit handles local data, system permissions, and network-dependent features." };
const structuredDataFor = (language: "zh" | "en") => ({
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: pageTitle[language],
  description: pageDescription[language],
  inLanguage: language === "zh" ? "zh-CN" : "en",
  url: new URL(Astro.url.pathname, Astro.site).href,
  dateModified: "2026-08-25",
});
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  keywords={{ zh: ["MacTools 隐私", "macOS 隐私", "本地优先应用", "开源 macOS 隐私"], en: ["MacTools privacy", "macOS privacy", "local-first app", "open-source macOS privacy"] }}
  structuredData={{ zh: structuredDataFor("zh"), en: structuredDataFor("en") }}
  page="privacy"
>
  <SiteNav active="privacy" />
  <main>
    <article class="privacy-policy">
      <header class="privacy-header">
        <p class="eyebrow">
          <span data-i18n-zh>隐私政策</span>
          <span data-i18n-en>Privacy Policy</span>
        </p>
        <h1>
          <span data-i18n-zh>本地优先，联网透明。</span>
          <span data-i18n-en>Local first. Network use made clear.</span>
        </h1>
        <p class="privacy-lead">
          <span data-i18n-zh>MacTools 是一款本地优先的开源应用。我们不要求账户，不内置广告或行为分析，也不会出售个人信息。除非你主动使用需要联网的功能，应用数据不会发送到 MacTools 项目维护者运营的服务器。</span>
          <span data-i18n-en>MacTools is a local-first, open-source app. It requires no account, includes no advertising or behavioral analytics, and does not sell personal information. Unless you choose to use a network-dependent feature, app data is not sent to servers operated by the MacTools maintainers.</span>
        </p>
        <p class="privacy-updated">
          <span data-i18n-zh>生效及最后更新：2026 年 8 月 25 日</span>
          <span data-i18n-en>Effective and last updated: August 25, 2026</span>
        </p>
      </header>

      <div class="privacy-summary" aria-label="隐私摘要" data-aria-label-zh="隐私摘要" data-aria-label-en="Privacy summary">
        <div>
          <strong><span data-i18n-zh>无需账户</span><span data-i18n-en>No account</span></strong>
          <span><span data-i18n-zh>没有注册、用户画像或广告标识符。</span><span data-i18n-en>No registration, user profile, or advertising identifier.</span></span>
        </div>
        <div>
          <strong><span data-i18n-zh>本地优先</span><span data-i18n-en>Local first</span></strong>
          <span><span data-i18n-zh>设置、快捷键和功能数据默认保存在设备上。</span><span data-i18n-en>Preferences, shortcuts, and feature data stay on your device by default.</span></span>
        </div>
        <div>
          <strong><span data-i18n-zh>联网透明</span><span data-i18n-en>Transparent networking</span></strong>
          <span><span data-i18n-zh>仅按功能需要连接更新源或你选择的第三方服务。</span><span data-i18n-en>Connections occur only when a feature needs an update source or a service you choose.</span></span>
        </div>
      </div>

      <div class="privacy-content">
        <section>
          <h2><span data-i18n-zh>1. 适用范围</span><span data-i18n-en>1. Scope</span></h2>
          <p>
            <span data-i18n-zh>本政策适用于 MacTools macOS 应用、随项目发布的官方插件以及本网站。第三方插件、外部网站和服务由其各自的条款与隐私政策约束。</span>
            <span data-i18n-en>This policy covers the MacTools macOS app, official plugins distributed with the project, and this website. Third-party plugins, external websites, and services are governed by their own terms and privacy policies.</span>
          </p>
        </section>

        <section>
          <h2><span data-i18n-zh>2. 我们不收集什么</span><span data-i18n-en>2. What we do not collect</span></h2>
          <ul>
            <li><span data-i18n-zh>MacTools 不提供账户系统，也不建立用户档案。</span><span data-i18n-en>MacTools has no account system and does not build user profiles.</span></li>
            <li><span data-i18n-zh>当前版本未集成由项目维护者运营的遥测、崩溃上报、广告或跨应用追踪服务。</span><span data-i18n-en>The current version includes no maintainer-operated telemetry, crash reporting, advertising, or cross-app tracking service.</span></li>
            <li><span data-i18n-zh>我们不会出售、出租或以广告为目的共享个人信息。</span><span data-i18n-en>We do not sell, rent, or share personal information for advertising.</span></li>
            <li><span data-i18n-zh>我们不会在自己的服务器上保存你的剪贴板内容、选中文本、日历事件、输入内容或文件内容。</span><span data-i18n-en>We do not store your clipboard contents, selected text, calendar events, typed content, or file contents on our own servers.</span></li>
          </ul>
        </section>

        <section>
          <h2><span data-i18n-zh>3. 保存在本地的数据</span><span data-i18n-en>3. Data stored locally</span></h2>
          <p>
            <span data-i18n-zh>为了让功能正常工作，MacTools 会在你的 Mac 上保存必要数据，包括应用与插件偏好、插件顺序和显示状态、快捷键、下载的插件包与图标缓存。由你主动导出的设置备份只会写入你选择的位置。</span>
            <span data-i18n-en>To provide its features, MacTools stores necessary data on your Mac, including app and plugin preferences, plugin order and visibility, shortcuts, downloaded plugin packages, and icon caches. Preference backups are written only to a location you choose when you export them.</span>
          </p>
          <p>
            <span data-i18n-zh>启用“活动统计”后，应用会在本地记录按键、鼠标、滚动次数、前台应用使用时长和已配置的编程工具活动。它不记录按键内容。翻译服务的 API 密钥保存在 macOS 钥匙串中；诊断信息使用 macOS 统一日志，并避免记录请求正文和密钥。</span>
            <span data-i18n-en>When Activity Stats is enabled, the app locally records keyboard, mouse, and scroll counts, foreground-app duration, and activity from configured coding tools. It does not record what you type. Translation API keys are stored in the macOS Keychain; diagnostics use the macOS unified log and avoid logging request bodies and secrets.</span>
          </p>
          <p>
            <span data-i18n-zh>启用“剪贴板历史”插件后，文本、富文本、内嵌图像、PDF、媒体、链接、颜色、文件引用、复制时间和复制时观察到的前台应用会保存在插件专用的本机加密数据库中；加密密钥保存在 macOS 钥匙串中。你主动保存的片段与剪贴项目会独立保存，其中可包含名称、标签、关键词、模板和最近使用时间；清除或过期历史不会删除这些项目。显式创建的顺序粘贴队列会保存项目标识、进度和创建队列时的加密剪贴板内容快照；即使来源项目随后被删除，快照也会保留到队列完成或取消。文件项目仅保存路径引用，不复制文件内容。剪贴板正文和文件路径不会写入日志、诊断导出、设置备份或全局搜索索引。你可以暂停收集、排除应用、忽略下一次复制，并分别清除历史或已保存项目。</span>
            <span data-i18n-en>When the Clipboard History plugin is enabled, text, rich text, embedded images, PDFs, media, links, colors, file references, copy times, and the frontmost app observed at capture time are stored in a plugin-private encrypted database on your Mac; its encryption key is stored in macOS Keychain. Snippets and clips you explicitly save are retained independently and may include names, tags, keywords, templates, and last-used times; clearing or expiring History does not remove them. An explicit sequential-paste queue stores item identifiers, progress, and encrypted snapshots of the clipboard payloads selected when the queue is created. Those snapshots remain available after a source item is deleted, until the queue finishes or is canceled. File items store path references rather than copying file contents. Clipboard payloads and file paths are not written to logs, diagnostic exports, preference backups, or the global search index. You can pause collection, exclude apps, ignore the next copy, and clear History or Saved items separately.</span>
          </p>
          <p>
            <span data-i18n-zh>启用片段关键词展开后，MacTools 会使用辅助功能权限在本机观察当前可编辑控件中的按键和光标位置，以识别你配置的关键词；安全文本框会被忽略，内容不会上传或写入历史。包含 <code>&#123;&#123;clipboard&#125;&#125;</code> 的片段只会在展开时读取当前剪贴板。使用系统“共享”菜单时，你选择的内容可能会由所选共享服务按其隐私政策处理。</span>
            <span data-i18n-en>When snippet keyword expansion is enabled, MacTools uses Accessibility permission to observe keystrokes and cursor position in the current editable control locally so it can recognize keywords you configured; secure text fields are ignored, and this input is neither uploaded nor added to History. A snippet containing <code>&#123;&#123;clipboard&#125;&#125;</code> reads the current clipboard only when expanded. If you use the system Share menu, the content you select may be processed by the sharing service under its own privacy policy.</span>
          </p>
        </section>

        <section>
          <h2><span data-i18n-zh>4. 系统权限与设备访问</span><span data-i18n-en>4. System permissions and device access</span></h2>
          <p>
            <span data-i18n-zh>不同功能可能请求辅助功能、输入监控、屏幕录制或日历权限，或访问剪贴板、选中文本、Finder 项目、显示器、音频、电池及其他本机系统状态。MacTools 仅在对应功能需要时使用这些能力，你可以不启用相关功能，也可以随时在 macOS“系统设置”中撤销权限。</span>
            <span data-i18n-en>Depending on the features you use, MacTools may request Accessibility, Input Monitoring, Screen Recording, or Calendar access, or access the clipboard, selected text, Finder items, displays, audio, battery, and other local system state. These capabilities are used only for the relevant feature. You can leave that feature disabled or revoke permission at any time in macOS System Settings.</span>
          </p>
          <p>
            <span data-i18n-zh>此类访问本身不会把数据上传给 MacTools 项目维护者。macOS 或你配置的系统服务（例如日历同步）可能按照 Apple 及相应服务提供方的政策处理数据。</span>
            <span data-i18n-en>This access does not by itself upload data to the MacTools maintainers. macOS or a system service you configure, such as calendar synchronization, may process data under Apple’s and the relevant provider’s policies.</span>
          </p>
        </section>

        <section>
          <h2><span data-i18n-zh>5. 需要联网的功能</span><span data-i18n-en>5. Network-dependent features</span></h2>
          <p>
            <span data-i18n-zh>MacTools 不是完全离线应用。以下操作会在你启用或使用相关功能时连接网络：</span>
            <span data-i18n-en>MacTools is not fully offline. The following actions connect to the network when you enable or use the relevant feature:</span>
          </p>
          <ul>
            <li><span data-i18n-zh>检查应用更新，以及获取、安装或更新插件与菜单栏图标资源。</span><span data-i18n-en>Checking for app updates and fetching, installing, or updating plugins and menu bar icon assets.</span></li>
            <li><span data-i18n-zh>翻译会把选中文本，或从选区截图识别出的文本，连同必要的认证信息发送给你配置的 OpenAI 兼容服务。服务提供方可能按其政策记录或保留请求。</span><span data-i18n-en>Translation sends selected text, or text recognized from a selected screen region, together with required authentication information to the OpenAI-compatible provider you configure. That provider may log or retain requests under its own policy.</span></li>
            <li><span data-i18n-zh>IP 检测、网络质量与泄漏测试会联系公网 IP、地理位置、DNS、STUN 或测速服务。对方会自然看到发起请求的 IP 地址，并可能收到你查询的 IP 或测试标识。</span><span data-i18n-en>IP checks, network quality tests, and leak tests contact public IP, geolocation, DNS, STUN, or measurement services. Those services naturally receive the requesting IP address and may receive an IP being queried or a test identifier.</span></li>
            <li><span data-i18n-zh>Homebrew 和其他外部命令会连接 Homebrew、软件包来源或你指定的地址；具体处理方式由这些服务决定。</span><span data-i18n-en>Homebrew and other external commands may contact Homebrew, package sources, or an address you specify; those services determine how they process requests.</span></li>
          </ul>
          <p>
            <span data-i18n-zh>MacTools 项目维护者无法控制第三方服务收集哪些网络元数据、如何使用或保留这些数据。使用前请查看相应服务的隐私政策。</span>
            <span data-i18n-en>The MacTools maintainers do not control what network metadata third-party services collect or how they use or retain it. Review the relevant service’s privacy policy before use.</span>
          </p>
        </section>

        <section>
          <h2><span data-i18n-zh>6. 本网站</span><span data-i18n-en>6. This website</span></h2>
          <p>
            <span data-i18n-zh>本网站是静态站点，不使用项目自建的分析或广告服务。主题与语言选择保存在浏览器的 localStorage 中，不会由网站代码上传。网站托管商、GitHub 以及你打开的其他外部链接可能按照各自政策处理常规网络日志、Cookie 或其他数据。</span>
            <span data-i18n-en>This is a static website with no project-operated analytics or advertising service. Theme and language choices are stored in your browser’s localStorage and are not uploaded by the site code. The hosting provider, GitHub, and other external links you open may process standard network logs, cookies, or other data under their own policies.</span>
          </p>
        </section>

        <section>
          <h2><span data-i18n-zh>7. 保留、删除与安全</span><span data-i18n-en>7. Retention, deletion, and security</span></h2>
          <p>
            <span data-i18n-zh>本地数据会保留到你在应用中清理或重置、卸载相关插件，或手动移除相应文件和钥匙串项目。仅把应用移到废纸篓不一定会删除 macOS 偏好、应用支持目录或钥匙串内容。撤销系统权限不会自动删除此前保存在本地的数据。</span>
            <span data-i18n-en>Local data remains until you clear or reset it in the app, uninstall the relevant plugin, or manually remove the corresponding files and Keychain items. Moving the app to Trash may not remove macOS preferences, Application Support data, or Keychain items. Revoking a system permission does not automatically delete previously stored local data.</span>
          </p>
          <p>
            <span data-i18n-zh>项目使用 macOS 安全能力，并对官方插件目录与软件包进行签名校验。MacTools 的源代码可在 GitHub 审查，但任何软件都无法承诺绝对安全；第三方插件与服务也不一定遵循相同做法。</span>
            <span data-i18n-en>The project uses macOS security capabilities and verifies signatures for official plugin catalogs and packages. MacTools source code can be audited on GitHub, but no software can guarantee absolute security, and third-party plugins or services may follow different practices.</span>
          </p>
        </section>

        <section>
          <h2><span data-i18n-zh>8. 儿童隐私</span><span data-i18n-en>8. Children’s privacy</span></h2>
          <p>
            <span data-i18n-zh>MacTools 是通用 macOS 工具，并非专门面向儿童。我们不会有意收集儿童的个人信息。</span>
            <span data-i18n-en>MacTools is a general-purpose macOS utility and is not directed specifically to children. We do not knowingly collect personal information from children.</span>
          </p>
        </section>

        <section>
          <h2><span data-i18n-zh>9. 政策更新</span><span data-i18n-en>9. Changes to this policy</span></h2>
          <p>
            <span data-i18n-zh>如果功能、数据处理方式或适用要求发生变化，我们会更新本页面，并在页面顶部标明新的更新日期。重大变化也可能通过项目发布说明告知。</span>
            <span data-i18n-en>If features, data practices, or applicable requirements change, we will update this page and revise the date above. Material changes may also be announced in project release notes.</span>
          </p>
        </section>

        <section>
          <h2><span data-i18n-zh>10. 联系我们</span><span data-i18n-en>10. Contact</span></h2>
          <p>
            <span data-i18n-zh>如对本政策或 MacTools 的数据处理有疑问，请在 </span>
            <span data-i18n-en>For questions about this policy or MacTools data practices, open an issue in </span>
            <a href="https://github.com/ggbond268/MacTools/issues" target="_blank" rel="noopener noreferrer">
              <span data-i18n-zh>GitHub Issues</span><span data-i18n-en>GitHub Issues</span>
            </a>
            <span data-i18n-zh> 提交问题。请不要在公开 issue 中附上 API 密钥、日志中的敏感内容或其他个人信息。</span>
            <span data-i18n-en>. Do not include API keys, sensitive log contents, or other personal information in a public issue.</span>
          </p>
        </section>
      </div>
    </article>
  </main>
  <SiteFooter />
</BaseLayout>
