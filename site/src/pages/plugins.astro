          description: t("打开面板时检查 formula 和 cask 更新。", "Check formula and cask updates when the panel opens."),
          control: "toggle",
          enabled: true,
        },
        {
          title: t("更新间隔", "Update interval"),
          description: t("控制后台刷新频率。", "Control how often information is refreshed."),
          control: "select",
          value: "daily",
          options: [option("hourly", "每小时", "Hourly"), option("daily", "每天", "Daily"), option("manual", "手动", "Manual")],
        },
      ],
    },
  ],
  "ip-overview": [
    {
      title: t("网络检测", "Network checks"),
      icon: "network.png",
      rows: [
        {
          title: t("显示出口 IP", "Show public IP"),
          description: t("获取当前网络对外显示的 IPv4 或 IPv6 地址。", "Fetch the public IPv4 or IPv6 address for the active network."),
          control: "toggle",
          enabled: true,
        },
        {
          title: t("显示归属地", "Show location"),
          description: t("显示 IP 所属国家、地区和网络运营商。", "Show the country, region, and provider for the IP address."),
          control: "toggle",
          enabled: true,
        },
        {
          title: t("测速服务器", "Speed test server"),
          description: t("选择延迟和下载测试使用的节点。", "Choose the endpoint used for latency and download tests."),
          control: "select",
          value: "auto",
          options: [option("auto", "自动选择", "Automatic"), option("china", "中国大陆", "China mainland"), option("global", "全球", "Global")],
        },
      ],
    },
  ],
  "launch-control": [
    {
      title: t("启动项", "Launch items"),
      icon: "power.png",
      rows: [
        {
          title: t("显示用户启动项", "Show user agents"),
          description: t("包含当前用户 Library 中的 LaunchAgents。", "Include LaunchAgents in the current user's Library."),
          control: "toggle",
          enabled: true,
        },
        {
          title: t("显示系统启动项", "Show system items"),
          description: t("包含系统级 LaunchAgents 与 LaunchDaemons。", "Include system LaunchAgents and LaunchDaemons."),
          control: "toggle",
          enabled: true,
        },
      ],
    },
  ],
  "zsh-config": [
    {
      title: t("配置文件", "Configuration file"),
      icon: "terminal.png",
      rows: [
        {
          title: t("默认文件", "Default file"),
          description: t("打开编辑器时默认加载的 zsh 配置文件。", "The zsh configuration loaded when the editor opens."),
          control: "select",
          value: "zshrc",
          options: [option("zshrc", "~/.zshrc", "~/.zshrc"), option("zprofile", "~/.zprofile", "~/.zprofile"), option("zshenv", "~/.zshenv", "~/.zshenv")],
        },
        {
          title: t("保存前创建备份", "Back up before saving"),
          description: t("写入前在原文件旁保留一个时间戳副本。", "Keep a timestamped copy beside the original before writing."),
          control: "toggle",
          enabled: true,
        },
      ],
    },
  ],
};

void iconByPlugin;
void settingsModels;

const catalog = await loadPluginCatalog();
const pluginSearch = buildPluginSearch(catalog.plugins, actionData.actions);
const plugins = [...catalog.plugins].sort((a, b) =>
  localizedPluginText(a).zh.displayName.localeCompare(localizedPluginText(b).zh.displayName, "zh-CN")
);
const settingsPlugins = plugins.filter(hasPluginSettings);

const categoryOrder = ["display", "audio", "system", "storage", "productivity", "monitoring", "other"];
const counts = new Map<string, number>();
for (const plugin of plugins) {
  const key = plugin.category ?? "other";
  counts.set(key, (counts.get(key) ?? 0) + 1);
}
const categoryFilters = categoryOrder
  .filter((key) => counts.has(key))
  .map((key) => ({
    key,
    count: counts.get(key) ?? 0,
    label: categoryLabel(key === "other" ? null : key),
  }));

const fallbackSections = (name: LocalizedText): SettingSection[] => [
  {
    title: t("基本设置", "General"),
    icon: "slider.horizontal.3.png",
    rows: [
      {
        title: t(`启用${name.zh}`, `Enable ${name.en}`),
        description: t("控制此插件在 MacTools 中的主要功能。", "Control this plugin's primary behavior in MacTools."),
        control: "toggle",
        enabled: true,
      },
    ],
  },
];

const pageTitle = t("MacTools 插件与设置 | macOS 菜单栏工具", "MacTools Plugins and Settings | macOS menu bar tools");
const pageDescription = t(`在仿 macOS 设置窗口中浏览 ${plugins.length} 个 MacTools 插件，搜索分类，并交互预览窗口切换、风扇、系统状态、启动台、电池等插件设置。`,
  `Browse ${plugins.length} MacTools plugins in a macOS-style settings window, search by category, and preview settings for windows, fans, system status, Launchpad, batteries, and more.`
);
const structuredDataFor = (language: "zh" | "en") => ({
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: pageTitle[language],
  description: pageDescription[language],
  inLanguage: language === "zh" ? "zh-CN" : "en",
  url: new URL(Astro.url.pathname, Astro.site).href,
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: plugins.length,
    itemListElement: plugins.map((plugin, index) => {
      const text = localizedPluginText(plugin);
      return {
        "@type": "ListItem",
        position: index + 1,
        name: text[language].displayName,
        description: text[language].summary,
      };
    }),
  },
});
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  image={{ zh: "/assets/screenshots/settings-plugins-zh-dark.png", en: "/assets/screenshots/settings-plugins-en-dark.png" }}
  structuredData={{ zh: structuredDataFor("zh"), en: structuredDataFor("en") }}
  page="plugins"
>
  <SiteNav active="plugins" />
  <main>
    <section class="page-hero plugins-hero">
      <p class="eyebrow">
        <span data-i18n-zh>MacTools 插件生态</span>
        <span data-i18n-en>MacTools Plugin Ecosystem</span>
      </p>
      <h1>
        <span data-i18n-zh>丰富插件，灵活设置。</span>
        <span data-i18n-en>More plugins. Your settings.</span>
      </h1>
      <p class="plugins-hero-lead">
        <span data-i18n-zh>{plugins.length} 个原生插件覆盖显示、音频、系统、清理、效率与监控。按需组合，每个插件都有清晰独立的设置。</span>
        <span data-i18n-en>{plugins.length} native plugins for displays, audio, system controls, cleanup, productivity, and monitoring. Mix what you need and fine-tune each one.</span>
      </p>
    </section>

    <section
      class="plugins-workspace"
      aria-label="MacTools 插件设置交互预览"
      data-aria-label-zh="MacTools 插件设置交互预览"
      data-aria-label-en="MacTools plugin settings interactive preview"
    >
      <div class="settings-window" data-settings-window>
        <div class="settings-titlebar" aria-hidden="true">
          <div class="traffic-lights">
            <span></span>
            <span></span>
            <span></span>
          </div>
        </div>

        <div class="settings-window-body">
          <aside
            class="settings-sidebar"
            aria-label="插件设置页面"
            data-aria-label-zh="插件设置页面"
            data-aria-label-en="Plugin settings pages"
          >
            <div class="settings-sidebar-scroll">
              <p class="settings-sidebar-label">
                <span data-i18n-zh>插件</span>
                <span data-i18n-en>Plugins</span>
              </p>
              <button class="settings-sidebar-item is-selected" type="button" data-settings-tab="market" aria-selected="true">
                <span
                  class="sidebar-icon sidebar-icon-market"
                  style={`--sidebar-icon: url("${symbol("shippingbox.fill")}"); --sidebar-icon-color: #0a84ff;`}
                ></span>
                <span>
                  <span data-i18n-zh>插件市场</span>
                  <span data-i18n-en>Plugin Marketplace</span>
                </span>
              </button>

              <p class="settings-sidebar-label settings-sidebar-plugin-label">
                <span data-i18n-zh>插件设置</span>
                <span data-i18n-en>Plugin Settings</span>
              </p>
              {settingsPlugins.map((plugin) => {
                const text = localizedPluginText(plugin);
                return (
                  <button
                    type="button"
                    class="settings-sidebar-item"
                    data-settings-tab={plugin.id}
                    data-plugin-name-zh={text.zh.displayName}
                    data-plugin-name-en={text.en.displayName}
                    data-plugin-id={plugin.id}
                    aria-selected="false"
                  >
                    <span
                      class="sidebar-icon"
                      style={`--sidebar-icon: url("${symbol(categoryIcons[plugin.category ?? "other"])}"); --sidebar-icon-color: ${categoryColors[plugin.category ?? "other"]};`}
                    ></span>
                    <span>
                      <span data-i18n-zh>{text.zh.displayName}</span>
                      <span data-i18n-en>{text.en.displayName}</span>
                    </span>
                  </button>
                );
              })}
            </div>
          </aside>

          <div class="settings-content">
            <section class="settings-panel marketplace-panel" data-settings-panel="market">
              <header class="settings-page-header">
                <h2>
                  <span data-i18n-zh>市场</span>
                  <span data-i18n-en>Marketplace</span>
                </h2>
              </header>

              <label class="market-search">
                <img src={symbol("magnifyingglass")} alt="" />
                <span class="sr-only">
                  <span data-i18n-zh>搜索插件与操作</span>
                  <span data-i18n-en>Search plugins and actions</span>
                </span>
                <input
                  type="search"
                  data-market-search
                  placeholder="搜索插件、操作或用途"
                  data-placeholder-zh="搜索插件、操作或用途"
                  data-placeholder-en="Search plugins, actions, or tasks"
                />
              </label>

              <div
                class="market-categories"
                aria-label="插件分类"
                data-aria-label-zh="插件分类"
                data-aria-label-en="Plugin categories"
              >
                <button class="is-selected" type="button" data-market-filter="all" aria-pressed="true">
                  <img src={symbol(categoryIcons.all)} alt="" />
                  <span data-i18n-zh>全部</span>
                  <span data-i18n-en>All</span>
                  <strong>{plugins.length}</strong>
                </button>
                {categoryFilters.map((filter) => (
                  <button type="button" data-market-filter={filter.key} aria-pressed="false" data-category={filter.key}>
                    <img src={symbol(categoryIcons[filter.key])} alt="" />
                    <span data-i18n-zh>{filter.label.zh}</span>
                    <span data-i18n-en>{filter.label.en}</span>
                    <strong>{filter.count}</strong>
                  </button>
                ))}
              </div>

              <p class="market-result-summary" aria-live="polite">
                <span data-i18n-zh>显示 <strong data-result-count>{plugins.length}</strong> 个插件</span>
                <span data-i18n-en><strong data-result-count>{plugins.length}</strong> plugins</span>
                <span data-action-result-summary hidden>
                  <span data-i18n-zh> · <strong data-action-result-count>0</strong> 个匹配操作</span>
                  <span data-i18n-en> · <strong data-action-result-count>0</strong> matching actions</span>
                </span>
              </p>

              <div class="market-list">
                {plugins.map((plugin) => {
                  const text = localizedPluginText(plugin);
                  const category = plugin.category ?? "other";
                  const isInitiallyInstalled = hasPluginSettings(plugin);
                  const capability = hasPluginSettings(plugin)
                    ? t("功能面板 · 可配置", "Feature panel · Configurable")
                    : plugin.capabilities.componentPanel
                      ? t("仪表盘组件", "Dashboard widget")
                      : t("快捷操作", "Quick action");
                  const search = pluginSearch.get(plugin.id)!;
                  return (
                    <article
                      class="market-plugin-row"
                      data-market-plugin
                      data-category={category}
                      data-search={search.terms}
                      data-plugin-name-zh={text.zh.displayName}
                      data-plugin-name-en={text.en.displayName}
                      data-plugin-id={plugin.id}
                      data-installed={String(isInitiallyInstalled)}
                    >
                      <span
                        class="market-plugin-status"
                        aria-label={isInitiallyInstalled ? "已安装" : "未安装"}
                        data-aria-label-zh={isInitiallyInstalled ? "已安装" : "未安装"}
                        data-aria-label-en={isInitiallyInstalled ? "Installed" : "Not installed"}
                      ></span>
                      <div class="market-plugin-copy">
                        <h3>
                          <span data-i18n-zh>{text.zh.displayName}</span>
                          <span data-i18n-en>{text.en.displayName}</span>
                          <small>{plugin.version}</small>
                        </h3>
                        <p>
                          <span data-i18n-zh>{text.zh.summary} · {capability.zh}</span>
                          <span data-i18n-en>{text.en.summary} · {capability.en}</span>
                        </p>
                        <div class="market-plugin-links">
                          <a class="market-plugin-detail-link" href={plugin.route ?? `/plugins/${plugin.id}`}>
                            <span data-i18n-zh>查看详情</span>
                            <span data-i18n-en>View details</span>
                          </a>
                          <a class="market-plugin-open-link" href={plugin.openInMacToolsURL}>
                            <span data-i18n-zh>在 MacTools 中打开</span>
                            <span data-i18n-en>Open in MacTools</span>
                          </a>
                        </div>
                        <PluginSearchActions actions={search.actions} />
                      </div>
                      <div class="market-plugin-actions">
                        <button type="button" class="market-plugin-action" data-plugin-action>
                          <span class="market-action-install">
                            <span data-i18n-zh>安装</span>
                            <span data-i18n-en>Install</span>
                          </span>
                          <span class="market-action-uninstall">
                            <span data-i18n-zh>卸载</span>
                            <span data-i18n-en>Uninstall</span>
                          </span>
                        </button>
                      </div>
                    </article>
                  );
                })}
                <div class="market-empty" data-market-empty hidden>
                  <img src={symbol("magnifyingglass")} alt="" />
                  <h3>
                    <span data-i18n-zh>未找到匹配的插件或操作</span>
                    <span data-i18n-en>No matching plugins or actions</span>
                  </h3>
                  <p>
                    <span data-i18n-zh>尝试调整关键字或切换分类。</span>
                    <span data-i18n-en>Try another keyword or category.</span>
                  </p>
                </div>
              </div>
            </section>

            {settingsPlugins.map((plugin) => {
              const text = localizedPluginText(plugin);
              const sections = settingsModels[plugin.id] ?? fallbackSections({
                zh: text.zh.displayName,
                en: text.en.displayName,
              });
              return (
                <section class="settings-panel plugin-settings-panel" data-settings-panel={plugin.id} hidden>
                  <header class="plugin-settings-header">
                    <span
                      class="plugin-settings-icon"
                      style={`--plugin-icon: url("${symbol(categoryIcons[plugin.category ?? "other"])}"); --plugin-icon-color: ${categoryColors[plugin.category ?? "other"]};`}
                    ></span>
                    <div>
                      <h2>
                        <span data-i18n-zh>{text.zh.displayName}</span>
                        <span data-i18n-en>{text.en.displayName}</span>
                        <small>{plugin.version}</small>
                      </h2>
                      <p>
                        <span data-i18n-zh>{text.zh.summary}</span>
                        <span data-i18n-en>{text.en.summary}</span>
                      </p>
                      <div class="plugin-settings-catalog-links">
                        <a href={plugin.route ?? `/plugins/${plugin.id}`}>
                          <span data-i18n-zh>查看插件详情</span>
                          <span data-i18n-en>View plugin details</span>
                        </a>
                        <a href={plugin.openInMacToolsURL}>
                          <span data-i18n-zh>在 MacTools 中打开</span>
                          <span data-i18n-en>Open in MacTools</span>
                        </a>
                      </div>
                    </div>
                  </header>

                  <div class="plugin-settings-sections">
                    {sections.map((section) => (
                      <section class="settings-form-section">
                        <h3>
                          <span
                            class="settings-section-icon"
                            style={`--section-icon: url("${symbol(section.icon)}");`}
                          ></span>
                          <span data-i18n-zh>{section.title.zh}</span>
                          <span data-i18n-en>{section.title.en}</span>
                        </h3>
                        <div class="settings-card">
                          {section.rows.map((row) => (
                            <div class={`settings-row settings-row--${row.control}`}>
                              <div class="settings-row-copy">
                                <h4>
                                  <span data-i18n-zh>{row.title.zh}</span>
                                  <span data-i18n-en>{row.title.en}</span>
                                </h4>
                                <p>
                                  <span data-i18n-zh>{row.description.zh}</span>
                                  <span data-i18n-en>{row.description.en}</span>
                                </p>
                              </div>
                              <div class="settings-control">
                                {row.control === "toggle" ? (
                                  <button
                                    class="mac-switch"
                                    type="button"
                                    role="switch"
                                    aria-checked={row.enabled ?? false}
                                    data-setting-switch
                                  >
                                    <span></span>
                                  </button>
                                ) : null}
                                {row.control === "segmented" ? (
                                  <div class="segmented-control" data-segmented-control>
                                    {row.options?.map((item) => (
                                      <button
                                        type="button"
                                        class={item.value === row.value ? "is-selected" : ""}
                                        aria-pressed={item.value === row.value}
                                      >
                                        <span data-i18n-zh>{item.zh}</span>
                                        <span data-i18n-en>{item.en}</span>
                                      </button>
                                    ))}
                                  </div>
                                ) : null}
                                {row.control === "choice" ? (
                                  <div class="choice-control" data-segmented-control>
                                    {row.options?.map((item) => (
                                      <button
                                        type="button"
                                        class={item.value === row.value ? "is-selected" : ""}
                                        aria-pressed={item.value === row.value}
                                      >
                                        <span class="choice-symbol" aria-hidden="true"></span>
                                        <span data-i18n-zh>{item.zh}</span>
                                        <span data-i18n-en>{item.en}</span>
                                      </button>
                                    ))}
                                  </div>
                                ) : null}
                                {row.control === "select" ? (
                                  <select
                                    aria-label={row.title.zh}
                                    data-aria-label-zh={row.title.zh}
                                    data-aria-label-en={row.title.en}
                                    value={String(row.value ?? "")}
                                  >
                                    {row.options?.map((item) => (
                                      <option
                                        value={item.value}
                                        selected={item.value === row.value}
                                        data-option-zh={item.zh}
                                        data-option-en={item.en}
                                      >
                                        {item.zh}
                                      </option>
                                    ))}
                                  </select>
                                ) : null}
                                {row.control === "slider" ? (
                                  <div class="range-control">
                                    <input
                                      type="range"
                                      min={row.min}
                                      max={row.max}
                                      step={row.step}
                                      value={row.value}
                                      data-range-control
                                      aria-label={row.title.zh}
                                      data-aria-label-zh={row.title.zh}
                                      data-aria-label-en={row.title.en}
                                    />
                                    <output>{row.value}{row.unit}</output>
                                  </div>
                                ) : null}
                                {row.control === "shortcut" ? <kbd class="shortcut-key">{row.value}</kbd> : null}
                                {row.control === "button" ? (
                                  <button type="button" class="settings-action-button" data-demo-action>
                                    <span data-i18n-zh>{localizedControlValues[String(row.value)]?.zh ?? row.value}</span>
                                    <span data-i18n-en>{localizedControlValues[String(row.value)]?.en ?? row.value}</span>
                                  </button>
                                ) : null}
                                {row.control === "status" ? (
                                  <span class:list={["settings-status", row.tone === "success" && "is-success"]}>
                                    <span data-i18n-zh>{localizedControlValues[String(row.value)]?.zh ?? row.value}</span>
                                    <span data-i18n-en>{localizedControlValues[String(row.value)]?.en ?? row.value}</span>
                                  </span>
                                ) : null}
                                {row.control === "text" ? (
                                  <input
                                    class="settings-text-input"
                                    type="text"
                                    value={String(row.value ?? "")}
                                    aria-label={row.title.zh}
                                    data-aria-label-zh={row.title.zh}
                                    data-aria-label-en={row.title.en}
                                  />
                                ) : null}
                              </div>
                            </div>
                          ))}
                        </div>
                      </section>
                    ))}
                  </div>
                </section>
              );
            })}
          </div>
        </div>
      </div>
      <p class="settings-demo-note">
        <span data-i18n-zh>此页面仅作界面与交互演示，实际功能及可用选项以 MacTools 软件为准。</span>
        <span data-i18n-en>This page is a UI and interaction preview. Actual features and options may differ in MacTools.</span>
      </p>
    </section>
  </main>
  <SiteFooter />
  <script src="../scripts/plugin-settings.ts"></script>
</BaseLayout>
