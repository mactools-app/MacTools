} from "@/lib/plugins";

type LocalizedText = {
  zh: string;
  en: string;
};

type SettingOption = LocalizedText & {
  value: string;
};

type SettingRow = {
  title: LocalizedText;
  description: LocalizedText;
  control: "toggle" | "segmented" | "choice" | "select" | "slider" | "shortcut" | "button" | "status" | "text";
  enabled?: boolean;
  tone?: "success";
  value?: string | number;
  min?: number;
  max?: number;
  step?: number;
  unit?: string;
  options?: SettingOption[];
};

type SettingSection = {
  title: LocalizedText;
  icon: string;
  rows: SettingRow[];
};

const t = (zh: string, en: string): LocalizedText => ({ zh, en });
const option = (value: string, zh: string, en: string): SettingOption => ({ value, zh, en });
const symbol = (name: string) => `/assets/sf-symbols/${name.endsWith(".png") ? name : `${name}.png`}`;

