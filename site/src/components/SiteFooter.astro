---
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const withBase = (path: string) => `${base}${path.replace(/^\//, "")}`;
---

<footer class="site-footer">
  <a href="https://github.com/ggbond268/MacTools/blob/main/LICENSE" target="_blank" rel="noopener noreferrer">GPL-3.0-only</a>
  <a href={withBase("/privacy-policy")}>
    <span data-i18n-zh>隐私政策</span>
    <span data-i18n-en>Privacy</span>
  </a>
  <a href="https://github.com/ggbond268/MacTools" target="_blank" rel="noopener noreferrer">GitHub</a>
  <a href="https://github.com/ggbond268/MacTools/releases" target="_blank" rel="noopener noreferrer"><span data-i18n-zh>更新记录</span><span data-i18n-en>Releases</span></a>
</footer>
