---
import LocalizedText from "./LocalizedText.astro";
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const withBase = (path: string) => `${base}${path.replace(/^\//, "")}`;

const featureGroups = [
  {
    title: "菜单栏和桌面",
    titleEn: "Menu bar and desktop",
    items: [
      { zh: "自动隐藏菜单栏", en: "Auto Hide Menu Bar" },
      { zh: "自动隐藏程序坞", en: "Auto Hide Dock" },
      { zh: "台前调度", en: "Stage Manager" },
      { zh: "隐藏刘海", en: "Hide Notch" },
      { zh: "启动台", en: "Launchpad" },
    ],
  },
  {
    title: "显示器和系统开关",
    titleEn: "Display and system toggles",
    items: [
      { zh: "显示器亮度", en: "Display Brightness" },
      { zh: "DDC/CI", en: "DDC/CI" },
      { zh: "显示器分辨率", en: "Display Resolution" },
      { zh: "原彩显示", en: "True Tone" },
      { zh: "夜览", en: "Night Shift" },
      { zh: "阻止休眠", en: "Prevent Sleep" },
    ],
  },
  {
    title: "维护和状态",
    titleEn: "Maintenance and status",
    items: [
      { zh: "磁盘清理", en: "Disk Cleanup" },
      { zh: "Xcode 清理", en: "Xcode Cleanup" },
      { zh: "系统状态", en: "System Status" },
      { zh: "设备电量", en: "Device Battery" },
      { zh: "风扇控制", en: "Fan Control" },
      { zh: "电池充电上限", en: "Battery Charge Limit" },
    ],
  },
] as const;
---

<section class="search-intent" aria-labelledby="search-intent-title">
  <div class="section-heading">
    <h2 id="search-intent-title">
      <span data-i18n-zh>寻找 macOS 菜单栏工具时，MacTools 覆盖更多系统场景。</span>
      <span data-i18n-en>When you search for macOS menu bar tools, MacTools covers more system tasks.</span>
    </h2>
    <p>
      <span data-i18n-zh>MacTools 更偏向免费开源、原生 SwiftUI + AppKit、插件化和可审计的系统工具集合，覆盖桌面控制、系统开关、显示器控制、清理维护和状态监控。</span>
      <span data-i18n-en>MacTools focuses on a free, open-source, native SwiftUI + AppKit, plugin-based system toolbox for desktop controls, system toggles, display controls, cleanup, maintenance, and status monitoring.</span>
    </p>
  </div>

  <div class="intent-grid">
    <article class="intent-copy">
      <h3>
        <span data-i18n-zh>不止系统开关，也覆盖显示器、清理与状态管理。</span>
        <span data-i18n-en>More than system toggles, with display, cleanup, and status tools too.</span>
      </h3>
      <p>
        <span data-i18n-zh>MacTools 把显示器亮度、分辨率切换、DDC/CI 外接屏控制、夜览、深色模式、休眠控制、磁盘清理、Xcode 清理、电池保护、风扇控制和系统状态放在同一个轻量入口里。</span>
        <span data-i18n-en>MacTools brings display brightness, resolution switching, DDC/CI external monitor control, Night Shift, Dark Mode, sleep control, disk cleanup, Xcode cleanup, battery health, fan control, and system status into one lightweight entry point.</span>
      </p>
      <a href={withBase("/plugins")}>
        <span data-i18n-zh>查看插件目录</span>
        <span data-i18n-en>View plugin catalog</span>
      </a>
    </article>

    <div class="intent-keywords" aria-label="MacTools 功能关键词" data-aria-label-zh="MacTools 功能关键词" data-aria-label-en="MacTools feature keywords">
      {featureGroups.map((group) => (
        <article>
          <h3>
            <span data-i18n-zh>{group.title}</span>
            <span data-i18n-en>{group.titleEn}</span>
          </h3>
          <div>
            {group.items.map((item) => (
              <span><LocalizedText {...item} /></span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
