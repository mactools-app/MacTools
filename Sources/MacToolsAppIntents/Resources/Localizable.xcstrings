    "运行当前可用且适合自动化的 MacTools 或插件操作。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشغيل إجراء متاح من MacTools أو مكون إضافي ومناسب للأتمتة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führt eine verfügbare, für Automationen geeignete MacTools- oder Plugin-Aktion aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run an available MacTools or plugin action that is suitable for automation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecuta una acción disponible de MacTools o de un plugin apta para la automatización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécute une action MacTools ou de module disponible et adaptée à l’automatisation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在利用可能でオートメーションに適したMacToolsまたはプラグインの操作を実行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 사용할 수 있고 자동화에 적합한 MacTools 또는 플러그인 동작을 실행합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Executa uma ação disponível do MacTools ou de um plugin adequada para automatização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполняет доступное действие MacTools или плагина, подходящее для автоматизации."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomasyon için uygun, kullanılabilir bir MacTools veya eklenti eylemi çalıştırır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行当前可用且适合自动化的 MacTools 或插件操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "執行目前可用且適合自動化的 MacTools 或外掛程式操作。"
          }
        }
      }
    },
