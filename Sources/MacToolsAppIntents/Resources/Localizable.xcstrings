    "app-intents.error.runtime-unavailable": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools غير جاهز لتشغيل هذا الإجراء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools ist noch nicht bereit, diese Aktion auszuführen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools is not ready to run this action."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools aún no está listo para ejecutar esta acción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools n’est pas prêt à exécuter cette action."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacToolsはまだこの操作を実行する準備ができていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools가 아직 이 동작을 실행할 준비가 되지 않았습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O MacTools ainda não está pronto para executar esta ação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools ещё не готов выполнить это действие."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools bu eylemi çalıştırmaya hazır değil."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools 尚未准备好运行此操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools 尚未準備好執行此操作。"
          }
        }
      }
    },
    "app-intents.error.cancelled": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إلغاء الإجراء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aktion wurde abgebrochen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The action was cancelled."
          }
        },
        "es": {
