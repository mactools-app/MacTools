            "value": "La acción se ha cancelado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’action a été annulée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "操作はキャンセルされました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동작이 취소되었습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A ação foi cancelada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Действие отменено."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eylem iptal edildi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作已取消。"
          }
        },
        "zh-Hant": {
