    "cli.install.error.metadata": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بيانات تثبيت CLI مفقودة أو غير صالحة. حدّث MacTools وأعد المحاولة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI-Installationsdaten fehlen oder sind ungültig. Aktualisiere MacTools und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI installation metadata is missing or invalid. Update MacTools and retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Faltan datos válidos de instalación de la CLI. Actualiza MacTools y reintenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données d’installation de la CLI sont absentes ou invalides. Mettez MacTools à jour et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI のインストール情報がないか無効です。MacTools を更新して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI 설치 정보가 없거나 유효하지 않습니다. MacTools를 업데이트하고 다시 시도하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados de instalação da CLI estão ausentes ou inválidos. Atualize o MacTools e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные установки CLI отсутствуют или недействительны. Обновите MacTools и повторите попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI yükleme metaverileri eksik ya da geçersiz. MacTools'u güncelleyip yeniden deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本缺少有效的 CLI 安装信息，请更新 MacTools 后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本缺少有效的 CLI 安裝資訊，請更新 MacTools 後重試。"
          }
        }
      }
    },
    "cli.install.error.download": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل تنزيل CLI أو تجاوز الحد الأقصى للحجم. تحقق من الشبكة وأعد المحاولة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI-Download fehlgeschlagen oder zu groß. Prüfe das Netzwerk und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI download failed or exceeded the size limit. Check your network and retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La descarga de CLI falló o superó el límite de tamaño. Revisa la red y reintenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléchargement de la CLI a échoué ou dépasse la taille limite. Vérifiez le réseau et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI のダウンロードが失敗したか、サイズ制限を超えました。ネットワークを確認して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI 다운로드가 실패했거나 크기 제한을 초과했습니다. 네트워크를 확인하고 다시 시도하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O download da CLI falhou ou excedeu o limite de tamanho. Verifique a rede e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузка CLI не удалась или превышен размер. Проверьте сеть и повторите попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI indirmesi başarısız oldu ya da boyut sınırını aştı. Ağ bağlantınızı denetleyip yeniden deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI 下载失败或超过大小限制，请检查网络后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI 下載失敗或超過大小限制，請檢查網路後重試。"
          }
        }
      }
    },
    "cli.install.error.archive": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل التحقق من أرشيف CLI. لم يتغير التثبيت الحالي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI-Archivprüfung fehlgeschlagen. Die bestehende Installation bleibt unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
