    "panelTheme.picker.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Themes update menu bar panel colors live. Layout, typography, calendar event colors, and brand colors stay unchanged."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temalar, menü çubuğu panel renklerini canlı olarak günceller. Düzen, tipografi, takvim etkinliği renkleri ve marka renkleri değişmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主题会实时调整菜单栏面板的界面色彩；布局、字体、日历事件色和品牌色保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主題會即時調整選單列面板的介面色彩；佈局、字體、行事曆事件色和品牌色保持不變。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحدّث السمات ألوان لوحات شريط القوائم فورًا. يبقى التخطيط وتنسيق النص وألوان أحداث التقويم وألوان العلامات التجارية دون تغيير."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Designs aktualisieren die Farben der Menüleisten-Panels in Echtzeit. Layout, Typografie, Kalenderereignisfarben und Markenfarben bleiben unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los temas actualizan al instante los colores de los paneles de la barra de menús. El diseño, la tipografía, los colores de los eventos del calendario y los colores de marca se mantienen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les thèmes mettent à jour les couleurs du panneau de la barre de menus en direct. La mise en page, la typographie, les couleurs des événements du calendrier et les couleurs de la marque restent inchangées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマはメニュー バー パネルの色をライブで更新します。レイアウト、タイポグラフィー、カレンダーのイベントカラー、ブランドカラーは変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마는 메뉴 막대 패널의 색상을 실시간으로 변경합니다. 레이아웃, 텍스트 스타일, 캘린더 이벤트 색상 및 브랜드 색상은 변경되지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os temas atualizam as cores dos painéis da barra de menus em tempo real. Layout, tipografia, cores dos eventos do calendário e cores da marca permanecem inalterados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Темы сразу обновляют цвета панелей строки меню. Расположение элементов, типографика, цвета событий календаря и фирменные цвета не изменяются."
          }
        }
      }
    },
