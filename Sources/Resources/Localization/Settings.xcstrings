    "panelTheme.error.insufficientContrast": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The contrast between the theme’s foreground and background is %.2f:1; at least 4.5:1 is required."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temanın ön plan karşıtlığı %.2f:1; en az 4.5:1 olmalı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主题前景与背景对比度只有 %.2f:1，至少需要 4.5:1。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主題前景與背景對比度只有 %.2f:1，至少需要 4.5:1。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نسبة التباين بين لون المقدمة والخلفية في السمة هي %.2f:1؛ يلزم 4.5:1 على الأقل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kontrast zwischen Vorder- und Hintergrund des Designs beträgt %.2f:1; erforderlich sind mindestens 4,5:1."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contraste del primer plano del tema es %.2f:1; se requiere al menos 4,5:1."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contraste entre le premier plan et l’arrière-plan du thème est de %.2f:1 ; au moins 4,5:1 est requis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマの前景色と背景色のコントラスト比は %.2f:1 です。少なくとも 4.5:1 が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마의 전경과 배경 대비는 %.2f:1입니다. 최소 4.5:1이 필요합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O contraste entre o primeiro plano e o fundo do tema é %.2f:1; é necessário pelo menos 4,5:1."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Контраст между передним планом и фоном темы составляет %.2f:1; требуется как минимум 4,5:1."
          }
        }
      }
    },
