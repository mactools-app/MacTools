    "cli.install.integrationOn": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح لـ CLI بالاتصال بهذا التطبيق. قد يطلب macOS الموافقة على التشغيل في الخلفية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die CLI darf sich mit dieser App verbinden. macOS kann eine Genehmigung für Hintergrundobjekte verlangen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow the CLI to connect to this app. macOS may require background-item approval."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que la CLI se conecte a esta app. macOS puede requerir autorización para ejecutarse en segundo plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser la CLI à se connecter à cette app. macOS peut demander une autorisation en arrière-plan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI にこのアプリへの接続を許可します。macOS でバックグラウンド実行の承認が必要な場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI가 이 앱에 연결하도록 허용합니다. macOS에서 백그라운드 항목 승인이 필요할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita que a CLI se conecte a este app. O macOS pode exigir aprovação para execução em segundo plano."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить CLI подключаться к приложению. macOS может запросить разрешение на фоновую работу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI'nin bu uygulamaya bağlanmasına izin verin. macOS, arka plan öğesi onayı isteyebilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 CLI 连接此应用；macOS 可能要求批准后台运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許 CLI 連接此 App；macOS 可能要求核准背景執行。"
          }
        }
      }
