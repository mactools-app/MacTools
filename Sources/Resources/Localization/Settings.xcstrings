            "state": "translated",
            "value": "CLI の発行元がこの MacTools と一致しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI 게시자가 이 MacTools 빌드와 일치하지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O publicador da CLI não corresponde a esta versão MacTools."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Издатель CLI не соответствует этой сборке MacTools."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI yayıncısı bu MacTools yapısıyla eşleşmiyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI 与此 MacTools 的发布身份不匹配。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI 與此 MacTools 的發行身分不符。"
          }
        }
      }
    },
    "cli.install.error.version": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إصدار CLI لا يطابق التطبيق. أعد المحاولة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI-Version und App passen nicht zusammen. Versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The CLI version does not match the app. Retry the operation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión de CLI no coincide con la app. Reintenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version CLI ne correspond pas à l’app. Réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI のバージョンがアプリと一致しません。再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI 버전이 앱과 일치하지 않습니다. 다시 시도하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão da CLI não corresponde ao app. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Версия CLI не соответствует приложению. Повторите попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI sürümü uygulamayla eşleşmiyor. İşlemi yeniden deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI 版本与应用不匹配，请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI 版本與 App 不符，請重試。"
          }
        }
      }
    },
    "cli.install.error.incompatible": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بروتوكول CLI غير متوافق. حدّث CLI لاستخدام إجراءات التطبيق؛ يظل أمر version متاحًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das CLI-Protokoll ist inkompatibel. Aktualisiere die CLI für App-Aktionen; version bleibt verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The CLI protocol is incompatible. Update the CLI to use app actions; version remains available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El protocolo CLI es incompatible. Actualiza la CLI para usar acciones de la app; version sigue disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le protocole CLI est incompatible. Mettez la CLI à jour pour les actions de l’app ; version reste disponible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI プロトコルに互換性がありません。アプリを操作するには CLI を更新してください。version は利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI 프로토콜이 호환되지 않습니다. 앱 작업을 사용하려면 CLI를 업데이트하세요. version은 계속 사용할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O protocolo CLI é incompatível. Atualize a CLI para usar ações do app; version continua disponível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Протокол CLI несовместим. Для действий приложения обновите CLI; команда version доступна."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI protokolü uyumsuz. Uygulama eylemlerini kullanmak için CLI'yı güncelleyin; version komutu kullanılabilir kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI 协议不兼容，应用操作已被阻止。请更新 CLI；version 命令仍可使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI 通訊協定不相容，App 操作已被封鎖。請更新 CLI；version 指令仍可使用。"
          }
        }
      }
    },
    "cli.install.error.ownership": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر التحقق من ملكية CLI. أُوقفت التغييرات. احتفظ بالملفات وتحقق من مسار التثبيت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI-Eigentum konnte nicht geprüft werden. Änderungen gestoppt. Behalte die Dateien und prüfe den Installationspfad."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI ownership could not be verified. Changes stopped. Preserve the files and check the installation path."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar la propiedad de CLI. Se detuvieron los cambios. Conserva los archivos y revisa la ruta de instalación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vérifier l’appartenance de la CLI. Modifications arrêtées. Conservez les fichiers et vérifiez le chemin d’installation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI の所有を確認できないため変更を停止しました。ファイルを保持し、インストール先を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI 소유권을 확인할 수 없어 변경을 중지했습니다. 파일을 보존하고 설치 경로를 확인하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar a propriedade da CLI. Alterações interrompidas. Preserve os arquivos e verifique o caminho de instalação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подтвердить принадлежность CLI. Изменения остановлены. Сохраните файлы и проверьте путь установки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI sahipliği doğrulanamadı. Değişiklikler durduruldu. Dosyaları koruyun ve yükleme yolunu denetleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认 CLI 安装归属，已停止更改。请保留文件并检查安装路径。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認 CLI 安裝歸屬，已停止更改。請保留檔案並檢查安裝路徑。"
          }
        }
      }
    },
    "cli.install.error.collision": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مسار أمر CLI مستخدم. انقل الأمر الحالي بنفسك ثم أعد المحاولة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der CLI-Befehlspfad ist belegt. Verschiebe den vorhandenen Befehl selbst und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The CLI command path is occupied. Move the existing command yourself, then retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ruta del comando CLI está ocupada. Mueve el comando existente y reintenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chemin de la commande CLI est occupé. Déplacez la commande existante, puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI コマンドのパスは使用中です。既存のコマンドを移動してから再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI 명령 경로가 사용 중입니다. 기존 명령을 직접 이동한 후 다시 시도하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O caminho do comando CLI está ocupado. Mova o comando existente e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Путь команды CLI занят. Переместите существующую команду и повторите попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI komut yolu kullanımda. Mevcut komutu kendiniz taşıyın, ardından yeniden deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI 命令路径已被占用，请自行移动现有命令后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI 命令路徑已被佔用，請自行移動現有命令後重試。"
          }
        }
      }
    },
    "cli.install.error.filesystem": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إكمال عمليات ملفات CLI بأمان. تحقق من المساحة المتاحة وأذونات المجلد، ثم أعد المحاولة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI-Dateivorgänge konnten nicht sicher abgeschlossen werden. Prüfe Speicherplatz und Ordnerrechte und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI file operations could not finish safely. Check free space and directory permissions, then retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las operaciones de archivos CLI no pudieron finalizar de forma segura. Revisa el espacio y los permisos del directorio y reintenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les opérations sur les fichiers CLI n’ont pas pu se terminer en toute sécurité. Vérifiez l’espace libre et les droits du dossier, puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI のファイル操作を安全に完了できませんでした。空き容量とフォルダの権限を確認して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI 파일 작업을 안전하게 완료하지 못했습니다. 여유 공간과 디렉터리 권한을 확인하고 다시 시도하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As operações de arquivos CLI não terminaram com segurança. Verifique o espaço livre e as permissões do diretório e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось безопасно завершить файловые операции CLI. Проверьте свободное место и права папки, затем повторите попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI dosya işlemleri güvenle tamamlanamadı. Boş alanı ve dizin izinlerini denetleyip yeniden deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法安全完成 CLI 文件操作，请检查可用空间和目录权限后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法安全完成 CLI 檔案操作，請檢查可用空間和目錄權限後重試。"
          }
        }
      }
    },
    "cli.install.error.busy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هناك عملية CLI أخرى قيد التنفيذ. أعد المحاولة بعد قليل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderer CLI-Vorgang läuft. Versuche es gleich erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another CLI operation is in progress. Retry shortly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay otra operación CLI en curso. Reintenta en breve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autre opération CLI est en cours. Réessayez dans un instant."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の CLI 操作が実行中です。しばらくしてから再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 CLI 작업이 진행 중입니다. 잠시 후 다시 시도하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra operação CLI está em andamento. Tente novamente em breve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполняется другая операция CLI. Повторите попытку чуть позже."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir CLI işlemi sürüyor. Kısa süre sonra yeniden deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一项 CLI 操作正在进行，请稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一項 CLI 操作正在進行，請稍後重試。"
          }
        }
      }
    },
    "cli.install.error.validation": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل التحقق من اتصال CLI؛ جرت محاولة استعادة. تحقق من التكامل والموافقة على التشغيل في الخلفية، ثم أعد المحاولة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI-Verbindungsprüfung fehlgeschlagen; Wiederherstellung wurde versucht. Prüfe Integration und Hintergrundfreigabe und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI connection validation failed; recovery was attempted. Check integration and background approval, then retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falló la validación de conexión CLI; se intentó recuperar. Revisa la integración y la autorización en segundo plano y reintenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La validation de connexion CLI a échoué ; une restauration a été tentée. Vérifiez l’intégration et l’autorisation en arrière-plan, puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI の接続検証に失敗し、復元を試みました。連携とバックグラウンド実行の許可を確認して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI 연결 검증에 실패하여 복구를 시도했습니다. 연동 및 백그라운드 승인을 확인하고 다시 시도하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A validação da conexão CLI falhou; a recuperação foi tentada. Verifique a integração e a aprovação em segundo plano e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверка подключения CLI не удалась; предпринята попытка восстановления. Проверьте интеграцию и разрешение фоновой работы, затем повторите попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI bağlantı doğrulaması başarısız oldu; kurtarma işlemi denendi. Entegrasyonu ve arka plan onayını denetleyip yeniden deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI 连接验证失败，已尝试恢复上一版本。请检查命令行集成和后台运行权限后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI 連線驗證失敗，已嘗試回復上一版本。請檢查命令列整合和背景執行權限後重試。"
          }
        }
      }
    },
    "cli.install.error.notarization": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تأكيد توثيق CLI لدى Apple. تحقق من اتصال الشبكة وحاول مجددًا، أو حدّث MacTools."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Apple-Notarisierung der CLI konnte nicht bestätigt werden. Prüfe die Netzwerkverbindung und versuche es erneut oder aktualisiere MacTools."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI notarization could not be confirmed. Check your network and retry, or update MacTools."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo confirmar la notarización de la CLI. Comprueba la conexión de red y vuelve a intentarlo, o actualiza MacTools."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La notarisation de la CLI n’a pas pu être confirmée. Vérifiez votre connexion réseau et réessayez, ou mettez MacTools à jour."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI の公証を確認できませんでした。ネットワーク接続を確認して再試行するか、MacTools をアップデートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI 공증을 확인할 수 없습니다. 네트워크 연결을 확인하고 다시 시도하거나 MacTools를 업데이트하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível confirmar a notarização da CLI. Verifique a conexão de rede e tente novamente ou atualize o MacTools."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подтвердить нотариализацию CLI. Проверьте подключение к сети и повторите попытку или обновите MacTools."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI notarizasyonu onaylanamadı. Ağ bağlantınızı denetleyip yeniden deneyin ya da MacTools'u güncelleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认 CLI 的公证状态，请检查网络后重试，或更新 MacTools。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認 CLI 的公證狀態，請檢查網路後重試，或更新 MacTools。"
          }
        }
      }
    },
