    "shortcuts.commonConflictWarning.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا اختصار عام وقد يتجاوز العمليات الشائعة في التطبيقات الأخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist ein globaler Kurzbefehl und kann häufige Aktionen in anderen Apps überschreiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a global shortcut and may override common actions in other apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este es un atajo global y puede anular acciones habituales en otras apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce raccourci global peut remplacer des actions courantes dans d’autres apps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはグローバルショートカットで、ほかのアプリのよく使う操作を上書きする場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 전역 단축키는 다른 앱의 일반적인 동작을 덮어쓸 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este é um atalho global e pode substituir ações comuns em outros apps."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это глобальное сочетание клавиш может переопределять обычные действия в других приложениях."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu genel bir kısayoldur ve diğer uygulamalardaki genel eylemlerin yerine geçebilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是全局快捷键，可能覆盖其他应用的常用操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是全域快速鍵，可能覆蓋其他 App 的常用操作。"
          }
        }
      }
    },
    "shortcuts.commonConflictWarning.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد استخدام «%@» على أي حال؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ trotzdem verwenden?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use “%@” Anyway?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Usar «%@» de todos modos?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser « %@ » quand même ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」をこのまま使用しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”을(를) 그래도 사용하시겠습니까?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar “%@” mesmo assim?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё равно использовать «%@»?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” yine de kullanılsın mı?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍要使用“%@”？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "仍要使用「%@」？"
          }
        }
      }
    },
    "shortcuts.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتكوين الاختصارات العامة للإجراءات الشائعة. تسري التغييرات على الفور، ولا يمكن إزالة العناصر المطلوبة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurieren Sie globale Verknüpfungen für allgemeine Aktionen. Änderungen werden sofort wirksam und erforderliche Elemente können nicht entfernt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure global shortcuts for common actions. Changes take effect immediately, and required items cannot be removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurar atajos globales para acciones comunes. Los cambios entran en vigor inmediatamente y los elementos requeridos no se pueden eliminar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurez des raccourcis globaux pour les actions courantes. Les modifications prennent effet immédiatement et les éléments requis ne peuvent pas être supprimés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一般的なアクションのグローバル ショートカットを構成します。変更はすぐに有効になり、必須アイテムは削除できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일반적인 작업에 대한 전역 바로가기를 구성합니다. 변경 사항은 즉시 적용되며 필수 항목은 제거할 수 없습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure atalhos globais para ações comuns. As alterações entram em vigor imediatamente e os itens obrigatórios não podem ser removidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте глобальные ярлыки для общих действий. Изменения вступают в силу немедленно, а необходимые элементы нельзя удалить."
          }
        },
        "tr": {
          "stringUnit": {
