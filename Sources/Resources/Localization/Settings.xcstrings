    "menuBarIcon.importError.requiresTransparency": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر أيقونة أو رسمًا متحركًا بخلفية شفافة ومحتوى مرئي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Symbol oder eine Animation mit transparentem Hintergrund und sichtbarem Motiv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an icon or animation with a transparent background and visible artwork."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un icono o una animación con fondo transparente y un dibujo visible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une icône ou une animation avec un fond transparent et un motif visible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背景が透明で、絵柄が見えるアイコンまたはアニメーションを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배경이 투명하고 그림이 보이는 아이콘이나 애니메이션을 선택하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um ícone ou uma animação com fundo transparente e conteúdo visível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите значок или анимацию с прозрачным фоном и видимым рисунком."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saydam arka planlı ve görünür bir çizimi olan simge ya da animasyon seçin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
