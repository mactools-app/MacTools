    "commandLine.enabled": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لـ mactools-cli المثبّت بشكل منفصل الاتصال بـ MacTools."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das separat installierte mactools-cli darf sich mit MacTools verbinden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The separately installed mactools-cli may connect to MacTools."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mactools-cli instalado por separado puede conectarse a MacTools."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mactools-cli installé séparément peut se connecter à MacTools."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別途インストールした mactools-cli から MacTools に接続できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "별도로 설치한 mactools-cli가 MacTools에 연결할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O mactools-cli instalado separadamente pode se conectar ao MacTools."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отдельно установленный mactools-cli может подключаться к MacTools."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayrı olarak yüklenen mactools-cli, MacTools'a bağlanabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已允许单独安装的 mactools-cli 连接到 MacTools。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已允許單獨安裝的 mactools-cli 連接到 MacTools。"
          }
        }
      }
    },
    "commandLine.requiresApproval": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح لوسيط سطر أوامر MacTools بالعمل في الخلفية من إعدادات النظام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube dem MacTools-Befehlszeilen-Broker in den Systemeinstellungen die Ausführung im Hintergrund."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow the MacTools command-line broker to run in the background in System Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que el intermediario de línea de comandos de MacTools se ejecute en segundo plano desde Ajustes del Sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez le courtier de ligne de commande MacTools à s’exécuter en arrière-plan dans Réglages Système."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定で MacTools コマンドラインブローカーのバックグラウンド実行を許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정에서 MacTools 명령줄 브로커의 백그라운드 실행을 허용하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita que o intermediário de linha de comando do MacTools seja executado em segundo plano nos Ajustes do Sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите брокеру командной строки MacTools работать в фоновом режиме в Системных настройках."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Ayarları'nda, MacTools komut satırı aracısının arka planda çalışmasına izin verin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统设置中允许 MacTools 命令行代理后台运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在系統設定中允許 MacTools 命令列代理程式在背景執行。"
          }
        }
      }
    },
    "commandLine.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد تثبيت mactools-cli بشكل منفصل، فعّل تكامل سطر الأوامر المحلي هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere hier nach der separaten Installation von mactools-cli die lokale Befehlszeilenintegration."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After installing mactools-cli separately, enable local command-line integration here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras instalar mactools-cli por separado, activa aquí la integración local de línea de comandos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après avoir installé mactools-cli séparément, activez ici l’intégration locale en ligne de commande."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "mactools-cli を別途インストールした後、ここでローカルのコマンドライン連携を有効にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "mactools-cli를 별도로 설치한 후 여기에서 로컬 명령줄 연동을 활성화하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Após instalar o mactools-cli separadamente, ative aqui a integração local de linha de comando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После отдельной установки mactools-cli включите здесь локальную интеграцию с командной строкой."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "mactools-cli'yı ayrı olarak yükledikten sonra buradan yerel komut satırı entegrasyonunu etkinleştirin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单独安装 mactools-cli 后，在此启用本机命令行集成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "單獨安裝 mactools-cli 後，在此啟用本機命令列整合。"
          }
        }
      }
    },
