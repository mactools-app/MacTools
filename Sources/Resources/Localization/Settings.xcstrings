    "menuBarIcon.sourceDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استورد أيقونات أو رسومًا متحركة قصيرة بخلفيات شفافة، أو اختر من المعرض عبر الإنترنت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importiere Symbole oder kurze Animationen mit transparentem Hintergrund oder wähle aus der Online-Galerie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import icons or short animations with transparent backgrounds, or choose from the online gallery."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa iconos o animaciones cortas con fondo transparente, o elige de la galería en línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importez des icônes ou de courtes animations sur fond transparent, ou choisissez dans la galerie en ligne."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背景が透明なアイコンや短いアニメーションを読み込むか、オンラインギャラリーから選択できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배경이 투명한 아이콘이나 짧은 애니메이션을 가져오거나 온라인 갤러리에서 선택하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe ícones ou animações curtas com fundo transparente, ou escolha na galeria online."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импортируйте значки или короткие анимации с прозрачным фоном либо выберите их в онлайн-галерее."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saydam arka planlı simgeleri ya da kısa animasyonları içe aktarın ya da çevrimiçi galeriden seçin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持透明背景的图标和轻量动画，也可从在线图库选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支援透明背景的圖示和輕量動畫，也可從線上圖庫選擇。"
          }
        }
      }
    },
