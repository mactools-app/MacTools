    "menuBarIcon.importError.unsupportedAnimation": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنسيق الرسوم المتحركة هذا غير مدعوم حتى الآن. اختر GIF أو MP4."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Animationsformat wird noch nicht unterstützt. Wählen Sie einen GIF oder MP4."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This animation format is not supported yet. Choose a GIF or MP4."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este formato de animación aún no es compatible. Elija un GIF o MP4."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce format d'animation n'est pas encore pris en charge. Choisissez un GIF ou un MP4."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアニメーション形式はまだサポートされていません。 GIF または MP4 を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
