    "floatingPanelAppearance.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow macOS transparency or use an opaque solid background. When Reduce Transparency is enabled, Solid is always used."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS şeffaflığına uyum sağlayın ya da opak bir düz arka plan kullanın. Şeffaflığı Azalt açıkken her zaman Düz kullanılır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟随 macOS 的透明效果，或使用不透明的实色背景；启用“降低透明度”时始终使用实色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "跟隨 macOS 的透明效果，或使用不透明的實色背景；減少透明度一律使用實色。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتبع شفافية macOS أو استخدم خلفية معتمة بلون واحد. عند تفعيل «تقليل الشفافية»، يُستخدم المظهر «معتم» دائمًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS-Transparenz übernehmen oder undurchsichtigen Hintergrund verwenden. „Transparenz reduzieren“ verwendet immer einen undurchsichtigen Hintergrund."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Respeta la transparencia de macOS o usa un fondo sólido opaco. Si está activado Reducir transparencia, siempre se usa Sólido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Respecter la transparence de macOS ou utiliser un fond uni opaque. L’option Réduire la transparence impose toujours le réglage Uni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS の透明効果に合わせるか、不透明な単色の背景を使用します。「透明度を下げる」が有効な場合は、常に「単色」を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS의 투명 효과를 따르거나 불투명한 단색 배경을 사용할 수 있습니다. ‘투명도 줄이기’가 켜져 있으면 항상 단색을 사용합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Siga a transparência do macOS ou use um fundo sólido opaco. Reduzir Transparência sempre usa Sólido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использовать прозрачность macOS или непрозрачный сплошной фон. При включенном уменьшении прозрачности всегда используется вариант «Сплошной»."
          }
        }
      }
    },
