    "permissions.empty.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستظهر هنا الإضافات المثبتة التي تتطلب أذونات macOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installierte Plugins, die macOS-Berechtigungen benötigen, werden hier angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installed plugins that need macOS permissions will appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los plugins instalados que necesiten permisos de macOS aparecerán aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les plugins installés qui nécessitent des autorisations macOS apparaîtront ici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS のアクセス権が必要なインストール済みプラグインがここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 권한이 필요한 설치된 플러그인이 여기에 표시됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Plugins instalados que precisam de permissões do macOS aparecerão aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь появятся установленные плагины, которым нужны разрешения macOS."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS izni gerektiren eklentiler yüklendiğinde burada görünür."
          }
        },
        "zh-Hans": {
          "stringUnit": {
