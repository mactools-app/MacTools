    "permissions.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجع أذونات macOS التي تستخدمها الميزات المثبتة في مكان واحد. يمكن لـ MacTools طلب الوصول أو فتح إعدادات النظام، لكنه لا يستطيع منح الإذن نيابةً عنك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe die von installierten Funktionen verwendeten macOS-Berechtigungen an einem Ort. MacTools kann Zugriff anfordern oder die Systemeinstellungen öffnen, aber keine Berechtigung selbst erteilen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review the macOS permissions used by installed features in one place. MacTools can request access or open System Settings, but cannot grant permission for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa en un solo lugar los permisos de macOS que usan las funciones instaladas. MacTools puede solicitar acceso o abrir Ajustes del Sistema, pero no puede conceder permisos por ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez au même endroit les autorisations macOS utilisées par les fonctionnalités installées. MacTools peut demander l’accès ou ouvrir Réglages Système, mais ne peut pas accorder une autorisation à votre place."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール済み機能が使用する macOS のアクセス権をまとめて確認します。MacTools はアクセスを要求したりシステム設定を開いたりできますが、代わりに許可することはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치된 기능이 사용하는 macOS 권한을 한곳에서 확인합니다. MacTools는 접근을 요청하거나 시스템 설정을 열 수 있지만 사용자를 대신해 권한을 부여할 수는 없습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reveja em um só lugar as permissões do macOS usadas pelos recursos instalados. O MacTools pode solicitar acesso ou abrir os Ajustes do Sistema, mas não pode conceder permissões por você."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просматривайте в одном месте разрешения macOS, используемые установленными функциями. MacTools может запросить доступ или открыть Системные настройки, но не может выдать разрешение за вас."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüklü özelliklerin kullandığı macOS izinlerini tek yerden inceleyin. MacTools, erişim isteyebilir ya da Sistem Ayarları'nı açabilir; ancak sizin yerinize izin veremez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "集中查看已安装功能使用的 macOS 权限。MacTools 只能发起请求或打开系统设置，不能代替你授予权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "集中查看已安裝功能使用的 macOS 權限。MacTools 只能發起要求或開啟系統設定，不能代替你授予權限。"
          }
        }
      }
    },
