    "actionInput.alias.invalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a phrase without leading/trailing spaces or line breaks, up to 64 characters."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En fazla 64 karakterden oluşan, başında ve sonunda boşluk ya da satır sonu bulunmayan bir ifade girin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入不含首尾空格或换行的短语，最多 64 个字符。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل عبارة بدون مسافات بادئة/لاحقة أو فواصل أسطر، حتى 64 حرفًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie eine Phrase mit bis zu 64 Zeichen ein (ohne führende/nachgestellte Leerzeichen oder Zeilenumbrüche)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingrese una frase sin espacios iniciales/finales ni saltos de línea, hasta 64 caracteres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez une phrase sans espaces de début/fin ni sauts de ligne, jusqu'à 64 caractères."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前後にスペースがなく、改行を含まない 64 文字以内のフレーズを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞뒤 공백이나 줄바꿈 없이 최대 64자까지 문구를 입력하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira uma frase sem espaços iniciais/finais ou quebras de linha, com até 64 caracteres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите фразу длиной до 64 символов без начальных/конечных пробелов и разрывов строк."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入開頭及結尾不含空格、且不含換行的短語，最多 64 個字元。"
          }
        }
      }
    },
    "actionInput.alias.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This action changed. Reopen settings."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu eylem değişti. Ayarları yeniden açın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作已更改，请重新打开设置。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تغيير هذا الإجراء. أعد فتح الإعدادات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aktion wurde geändert. Öffnen Sie die Einstellungen erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta acción cambió. Vuelva a abrir la configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action a changé. Rouvrez les paramètres."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアクションが変更されました。設定を再度開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 동작이 변경되었습니다. 설정을 다시 여세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ação foi alterada. Reabra as configurações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это действие изменено. Снова откройте настройки."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "操作已更改，請重新開啟設定。"
          }
        }
      }
    },
    "actionInput.alias.conflict": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conflicts with the trigger phrase for “%@”."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” tetikleyici ifadesiyle çakışıyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与“%@”的触发短语冲突。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتعارض مع عبارة التشغيل لـ \"%@\"."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konflikt mit der Auslösephrase für „%@“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entra en conflicto con la frase de activación de «%@»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conflit avec la phrase de déclenchement de « %@ »."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」のトリガーフレーズと競合します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\"의 트리거 문구와 충돌합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conflita com a frase de acionamento de “%@”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Конфликтует с триггерной фразой для «%@»."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與「%@」的觸發短語衝突。"
          }
        }
      }
    },
