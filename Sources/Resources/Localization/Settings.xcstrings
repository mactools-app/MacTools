    "permissions.fullDiskAccess.restartNote": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد تغيير الوصول الكامل إلى القرص، قد تحتاج إلى إعادة فتح MacTools لتحديث نطاق الوصول الكامل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach einer Änderung des Festplattenvollzugriffs muss MacTools möglicherweise neu geöffnet werden, damit der vollständige Zugriffsumfang aktualisiert wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After changing Full Disk Access, you may need to reopen MacTools to refresh the complete access scope."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de cambiar el acceso total al disco, puede que tengas que volver a abrir MacTools para actualizar todo el alcance del acceso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après avoir modifié l’accès complet au disque, vous devrez peut-être rouvrir MacTools pour actualiser toute l’étendue de l’accès."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルディスクアクセスを変更した後、完全なアクセス範囲を更新するには MacTools を開き直す必要がある場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 디스크 접근을 변경한 후 전체 접근 범위를 갱신하려면 MacTools를 다시 열어야 할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de alterar o acesso total ao disco, talvez seja necessário reabrir o MacTools para atualizar todo o alcance do acesso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После изменения полного доступа к диску может потребоваться заново открыть MacTools, чтобы обновить весь объём доступа."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam Disk Erişimi'ni değiştirdikten sonra, tam erişim kapsamını yenilemek için MacTools'u yeniden açmanız gerekebilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改完全磁盘访问后，可能需要重新打开 MacTools 才能刷新完整访问范围。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更改完整磁碟存取後，可能需要重新開啟 MacTools 才能重新整理完整存取範圍。"
          }
        }
      }
    },
    "permissions.automation.onDemandNote": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطلب macOS إذن الأتمتة عند تحكم الميزة في التطبيق المستهدف لأول مرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS fragt die Automationsberechtigung an, wenn eine Funktion erstmals eine Ziel-App steuert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS requests Automation permission when a feature first controls its target app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS solicita el permiso de Automatización cuando una función controla por primera vez su app de destino."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS demande l’autorisation Automatisation lorsqu’une fonctionnalité contrôle pour la première fois son app cible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "機能が対象の App を初めて操作するときに、macOS がオートメーションの許可を要求します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기능이 대상 앱을 처음 제어할 때 macOS가 자동화 권한을 요청합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS solicita a permissão de Automação quando um recurso controla seu app de destino pela primeira vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS запрашивает разрешение на автоматизацию, когда функция впервые управляет целевым приложением."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS, bir özellik hedef uygulamayı ilk kez denetlediğinde Otomasyon iznini ister."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动化权限由 macOS 在功能首次控制目标 App 时按需请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動化權限由 macOS 在功能首次控制目標 App 時按需要求。"
          }
        }
      }
    },
    "permissions.systemAudio.onDemandNote": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُطلب تسجيل صوت النظام عند التقاط الميزة المعنية للصوت لأول مرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Systemaudioaufnahme wird angefragt, wenn eine zugehörige Funktion erstmals Audio aufnimmt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System Audio Recording is requested when a related feature first captures audio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación de audio del sistema se solicita cuando una función relacionada captura audio por primera vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement audio du système est demandé lorsqu’une fonctionnalité concernée capture du son pour la première fois."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "関連機能が初めてオーディオを取り込むときに、システムオーディオ録音が要求されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관련 기능이 오디오를 처음 캡처할 때 시스템 오디오 녹음 권한을 요청합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação de áudio do sistema é solicitada quando um recurso relacionado captura áudio pela primeira vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешение на запись системного аудио запрашивается, когда связанная функция впервые захватывает звук."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Sesi Kaydı, ilgili bir özellik sesi ilk kez yakaladığında istenir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统音频录制由相关功能首次捕获音频时按需请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統音訊錄製由相關功能首次擷取音訊時按需要求。"
          }
        }
      }
    },
