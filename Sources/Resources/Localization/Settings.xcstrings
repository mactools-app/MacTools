    "panelTheme.import.darkMismatch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The theme was imported, but it is a dark theme. Switch the app appearance to select it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema içe aktarıldı, ancak karanlık bir tema. Seçmek için uygulama görünümünü değiştirin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主题已导入，但它属于深色主题。请切换应用外观后选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主題已匯入，但它屬於深色主題。請切換 App 外觀後選擇。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم استيراد السمة، لكنها سمة داكنة. بدّل مظهر التطبيق لتحديدها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Design wurde importiert, ist jedoch ein dunkles Design. Ändern Sie das Erscheinungsbild der App, um es auszuwählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tema se ha importado, pero es oscuro. Cambia la apariencia de la app para seleccionarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le thème a été importé, mais c’est un thème sombre. Changez l’apparence de l’app pour le sélectionner."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダークテーマをインポートしました。選択するには、アプリの外観をダークに切り替えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마를 가져왔지만 다크 테마입니다. 앱의 화면 모드를 전환한 후 선택하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O tema foi importado, mas é um tema escuro. Mude a aparência do aplicativo para selecioná-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тема импортирована, но она темная. Переключите оформление приложения, чтобы выбрать ее."
          }
        }
      }
    },
