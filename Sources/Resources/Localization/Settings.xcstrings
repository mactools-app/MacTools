    "panelTheme.findMore.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview and download themes from iTerm2 Color Schemes. Supports .itermcolors files (including those saved as .txt) and Base16/Base24 YAML/JSON."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iTerm2 Color Schemes'teki temaları önizleyip indirin. .itermcolors (.txt dahil) ve Base16/Base24 YAML/JSON desteklenir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可从 iTerm2 Color Schemes 预览并下载主题。支持 .itermcolors（含 .txt）和 Base16/Base24 YAML/JSON。"
          }
        },
        "zh-Hant": {
