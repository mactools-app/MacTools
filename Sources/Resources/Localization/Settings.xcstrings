    "menuBarIcon.activeOwnerFormat": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأيقونة مقدمة حاليًا من «%@». تُطبَّق هذه الإعدادات عند إيقاف الاستبدال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Derzeit von „%@“ bereitgestellt. Diese Einstellungen gelten, sobald die Ersetzung deaktiviert ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Currently provided by “%@”. These settings apply when replacement is turned off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El icono lo proporciona «%@». Estos ajustes se aplican al desactivar el reemplazo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’icône est fournie par « %@ ». Ces réglages s’appliquent lorsque le remplacement est désactivé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在は「%@」が提供しています。以下の設定は置き換えを解除すると適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 ‘%@’에서 제공합니다. 아래 설정은 아이콘 대체를 해제하면 적용됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O ícone é fornecido por «%@». Estas definições aplicam-se ao desativar a substituição."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значок предоставлен «%@». Эти настройки применятся после отключения замены."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu anda “%@” tarafından sağlanıyor. Bu ayarlar, değiştirme kapatıldığında uygulanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前由「%@」提供。以下设置在取消替换后生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前由「%@」提供。取消取代後，以下設定才會生效。"
          }
        }
      }
    },
    "menuBarIcon.pendingOwnerFormat": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُستعاد «%@» بعد إعادة التشغيل. تظهر حاليًا الأيقونة المحددة أدناه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ wird nach dem Neustart wieder verwendet. Bis dahin gilt das unten eingestellte Symbol."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” resumes after restart. The icon configured below is shown for now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» se restaurará tras reiniciar. Mientras tanto, se muestra el icono configurado abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » sera rétabli après le redémarrage. L’icône configurée ci-dessous s’affiche en attendant."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は再起動後に復元されます。それまでは以下の設定のアイコンが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’ 아이콘은 재시작 후 복원됩니다. 그동안 아래에서 설정한 아이콘이 표시됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» será restaurado após reiniciar. Entretanto, é apresentado o ícone configurado abaixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» будет восстановлен после перезапуска. Пока отображается значок, настроенный ниже."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”, yeniden başlatmanın ardından geri dönecek. Şimdilik aşağıda yapılandırılan simge gösteriliyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」将在重启后恢复，当前使用下方设置的图标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」將在重新啟動後恢復，目前使用下方設定的圖示。"
          }
        }
      }
    },
    "menuBarIcon.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم أيقونة واحدة لشريط القائمة تتكيف تلقائيًا مع المظهرين الفاتح والداكن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende ein Menüleistensymbol, das sich automatisch an die helle und dunkle Darstellung anpasst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use one menu bar icon that automatically adapts to light and dark appearances."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un único icono de la barra de menús que se adapte automáticamente al aspecto claro y oscuro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez une seule icône de barre des menus qui s’adapte automatiquement aux apparences claire et sombre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライトとダークの外観に自動で適応するメニューバーアイコンを設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "밝은 모드와 어두운 모드에 자동으로 맞춰지는 메뉴 막대 아이콘 하나를 설정합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Use um único ícone da barra de menus que se adapta automaticamente às aparências clara e escura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте один значок строки меню, который автоматически адаптируется к светлому и тёмному оформлению."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aydınlık ve karanlık görünümlere otomatik uyum sağlayan tek bir menü çubuğu simgesi kullanın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "统一设置菜单栏图标，自动适应浅色和深色外观。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "統一設定選單列圖示，自動適應淺色和深色外觀。"
          }
        }
      }
    },
