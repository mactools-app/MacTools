        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema dosyasında ad ya da şema eksik."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主题文件缺少名称（name 或 scheme）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主題檔案缺少 name 或 scheme 名稱。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحتوي ملف السمة على اسم في أي من الحقلين name وscheme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Design-Datei fehlt eine Namensangabe („name“ oder „scheme“)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo del tema no contiene un nombre (campo «name» o «scheme»)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier de thème ne contient pas de nom (champ « name » ou « scheme »)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマファイルに name または scheme がありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마 파일에 name 또는 scheme으로 지정된 이름이 없습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo de tema não tem um nome (campo name ou scheme)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В файле темы отсутствует название (поле name или scheme)."
          }
        }
      }
    },
