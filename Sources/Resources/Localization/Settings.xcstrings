    "cli.install.pathHelp": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا لم يعثر الطرفية على الأمر، أضف ~/.local/bin إلى PATH. لا يغيّر MacTools إعدادات الصدفة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Falls Terminal den Befehl nicht findet, füge ~/.local/bin zu PATH hinzu. MacTools ändert keine Shell-Konfiguration."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If Terminal cannot find the command, add ~/.local/bin to PATH. MacTools does not edit shell configuration."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si Terminal no encuentra el comando, añade ~/.local/bin a PATH. MacTools no modifica la configuración del shell."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si Terminal ne trouve pas la commande, ajoutez ~/.local/bin au PATH. MacTools ne modifie pas la configuration du shell."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルでコマンドが見つからない場合は、PATH に ~/.local/bin を追加してください。MacTools はシェル設定を変更しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널에서 명령을 찾을 수 없으면 PATH에 ~/.local/bin을 추가하세요. MacTools는 셸 설정을 변경하지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o Terminal não encontrar o comando, adicione ~/.local/bin ao PATH. O MacTools não altera a configuração do shell."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если Терминал не находит команду, добавьте ~/.local/bin в PATH. MacTools не меняет настройки оболочки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal komutu bulamıyorsa ~/.local/bin dizinini PATH'e ekleyin. MacTools, shell yapılandırmasını düzenlemez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若终端找不到命令，请将 ~/.local/bin 添加到 PATH。MacTools 不会修改 shell 配置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若終端機找不到指令，請將 ~/.local/bin 加入 PATH。MacTools 不會修改 shell 設定。"
          }
        }
      }
    },
