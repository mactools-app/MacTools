    "cli.install.ownershipHelp": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ التثبيتات اليدوية وتثبيتات Homebrew والقنوات الأخرى. لا حاجة إلى كلمة سر المسؤول."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Manuelle, Homebrew- und andere Kanalinstallationen bleiben erhalten. Kein Administratorpasswort erforderlich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manual, Homebrew, and other channel installations are preserved. No administrator password is needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se conservan las instalaciones manuales, de Homebrew y de otros canales. No se necesita contraseña de administrador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les installations manuelles, Homebrew et des autres canaux sont préservées. Aucun mot de passe administrateur n’est requis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手動、Homebrew、他のチャネルのインストールは保持されます。管理者パスワードは不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수동, Homebrew 및 다른 채널의 설치를 유지합니다. 관리자 암호는 필요하지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalações manuais, do Homebrew e de outros canais são preservadas. Não é necessária senha de administrador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ручные установки, Homebrew и другие каналы сохраняются. Пароль администратора не требуется."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "El ile, Homebrew ve diğer kanallardan yapılan yüklemeler korunur. Yönetici parolası gerekmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会覆盖手动、Homebrew 或其他渠道安装。无需管理员密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不會覆蓋手動、Homebrew 或其他管道的安裝。無需管理員密碼。"
          }
        }
      }
    },
