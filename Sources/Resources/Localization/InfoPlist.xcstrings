{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "NSAppleEventsUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم MacTools أحداث Apple لفتح التواريخ في التقويم، وقراءة أيقونات الاختصارات وألوانها وحالة تشغيلها، وإظهار تأكيد تسجيل الخروج وإعادة التشغيل وإيقاف التشغيل في macOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools verwendet Apple Events, um Daten im Kalender zu öffnen, Symbole, Farben und Ausführungsstatus von Kurzbefehlen zu lesen und macOS-Bestätigungen zum Abmelden, Neustarten und Ausschalten anzuzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools uses Apple Events to open dates in Calendar, read Shortcuts icons, colors, and run status, and show macOS log out, restart, and shut down confirmations."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools usa Apple Events para abrir fechas en Calendario, leer iconos, colores y el estado de ejecución de Atajos, y mostrar confirmaciones de cierre de sesión, reinicio y apagado de macOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools utilise Apple Events pour ouvrir des dates dans Calendrier, lire les icônes, les couleurs et l’état d’exécution des raccourcis, et afficher les confirmations macOS de déconnexion, de redémarrage et d’extinction."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools は Apple Events を使用してカレンダーで日付を開き、ショートカットのアイコン、カラー、実行状態を読み取り、macOS のログアウト、再起動、システム終了の確認を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools는 Apple Events를 사용하여 캘린더에서 날짜를 열고 단축어의 아이콘, 색상 및 실행 상태를 읽으며 macOS 로그아웃, 재시동 및 종료 확인을 표시합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O MacTools usa Apple Events para abrir datas no Calendário, ler ícones, cores e o estado de execução dos Atalhos e mostrar confirmações de fim de sessão, reinício e encerramento do macOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools использует Apple Events, чтобы открывать даты в Календаре, читать значки, цвета и состояние выполнения Команд, а также показывать подтверждения macOS при выходе из системы, перезагрузке и выключении."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools, tarihleri Takvim'de açmak, Shortcuts simgelerini, renklerini ve çalışma durumunu okumak ve macOS oturumu kapatma, yeniden başlatma ve kapatma onaylarını göstermek için Apple Events kullanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools 使用 Apple Events 在系统日历中打开日期、读取 Apple“快捷指令”的图标、颜色和运行状态，并显示 macOS 退出登录、重新启动和关机确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools 使用 Apple Events 在系統行事曆中開啟日期、讀取 Apple「捷徑」的圖示、顏色和執行狀態，並顯示 macOS 登出、重新啟動和關機確認。"
          }
        }
      }
    },
    "NSAudioCaptureUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعالج MacTools صوت التطبيقات محليًا وفي الوقت الفعلي فقط عند ضبط مستوى صوت كل تطبيق، ولا يسجل الصوت أو يحفظه أو يرفعه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools verarbeitet App-Audio nur beim Anpassen der Lautstärke einzelner Apps lokal in Echtzeit und zeichnet, speichert oder lädt keinen Ton hoch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools processes app audio locally in real time only when you adjust per-app volume, and never records, saves, or uploads audio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools procesa el audio de las aplicaciones localmente y en tiempo real solo al ajustar el volumen de cada aplicación; nunca graba, guarda ni sube audio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools traite localement et en temps réel le son des apps uniquement lors du réglage de leur volume, sans jamais l’enregistrer, le sauvegarder ni le téléverser."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools はアプリごとの音量を調整するときだけ、アプリの音声をローカルでリアルタイム処理し、録音、保存、アップロードは行いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools는 앱별 음량을 조절할 때만 앱 오디오를 기기에서 실시간으로 처리하며 녹음, 저장 또는 업로드하지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O MacTools processa o áudio dos apps localmente e em tempo real apenas ao ajustar o volume de cada app, sem gravar, salvar ou enviar áudio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools обрабатывает звук приложений локально в реальном времени только при настройке их громкости и не записывает, не сохраняет и не загружает аудио."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools, uygulama sesini yalnızca uygulamaya özel ses düzeyini ayarlarken yerel olarak ve gerçek zamanlı olarak işler; sesi hiçbir zaman kaydetmez, saklamaz veya karşıya yüklemez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在调节应用独立音量时于本机实时处理系统音频，不会录制、保存或上传声音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在調整應用程式獨立音量時於本機即時處理系統音訊，不會錄製、儲存或上傳聲音。"
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools يقرأ مستويات بطارية ملحق Bluetooth لإظهار حالة الماوس ولوحة المفاتيح وسماعات الرأس في مكون بطارية الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools liest den Batteriestand des Bluetooth-Zubehörs, um den Maus-, Tastatur- und Headset-Status in der Batteriekomponente des Geräts anzuzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools reads Bluetooth accessory battery levels to show mouse, keyboard, and headset status in the device battery component."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools lee los niveles de batería de los accesorios Bluetooth para mostrar el estado del mouse, el teclado y los auriculares en el componente de batería del dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools lit les niveaux de batterie des accessoires Bluetooth pour afficher l'état de la souris, du clavier et du casque dans le composant de batterie de l'appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools は Bluetooth アクセサリのバッテリー レベルを読み取り、デバイスのバッテリー コンポーネントのマウス、キーボード、ヘッドセットのステータスを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools은 Bluetooth 액세서리 배터리 수준을 읽어 장치 배터리 구성 요소에 마우스, 키보드 및 헤드셋 상태를 표시합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools lê os níveis de bateria dos acessórios Bluetooth para mostrar o status do mouse, teclado e fone de ouvido no componente da bateria do dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools считывает уровень заряда батареи аксессуара Bluetooth, чтобы показать состояние мыши, клавиатуры и гарнитуры в компоненте батареи устройства."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools, aygıt pili bileşeninde fare, klavye ve kulaklık durumunu göstermek için Bluetooth aksesuarlarının pil düzeylerini okur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取蓝牙外设电量，用于在设备电量组件中显示鼠标、键盘和耳机状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀取藍牙外設電量，用於在設備電量組件中顯示滑鼠、鍵盤和耳機狀態。"
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools بقراءة أحداث التقويم لإظهار الجدول الزمني الخاص بك في مكون التقويم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools liest Kalenderereignisse, um Ihren Zeitplan in der Kalenderkomponente anzuzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools reads calendar events to show your schedule in the calendar component."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools lee eventos del calendario para mostrar su programación en el componente de calendario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools lit les événements du calendrier pour afficher votre emploi du temps dans le composant Calendrier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools はカレンダー イベントを読み取り、カレンダー コンポーネントにスケジュールを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools은 캘린더 이벤트를 읽어 캘린더 구성요소에 일정을 표시합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools lê eventos da agenda para mostrar sua programação no componente da agenda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools считывает события календаря, чтобы отобразить ваше расписание в компоненте календаря."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools, takvim bileşeninde programınızı göstermek için takvim etkinliklerini okur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取系统日历事件，用于在右键日历组件中显示当天日程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀取系統日曆事件，用於在右鍵日曆組件中顯示當天行程。"
          }
        }
      }
    },
    "NSCalendarsUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools يقرأ أحداث التقويم لعرض الجدول الزمني الخاص بك في مكون التقويم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools liest Kalenderereignisse, um Ihren Zeitplan in der Kalenderkomponente anzuzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools reads calendar events to show your schedule in the calendar component."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools lee eventos del calendario para mostrar su programación en el componente de calendario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools lit les événements du calendrier pour afficher votre emploi du temps dans le composant Calendrier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools はカレンダー イベントを読み取り、カレンダー コンポーネントにスケジュールを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools은 캘린더 이벤트를 읽어 캘린더 구성요소에 일정을 표시합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools lê eventos da agenda para mostrar sua programação no componente da agenda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools считывает события календаря, чтобы отобразить ваше расписание в компоненте календаря."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools, takvim bileşeninde programınızı göstermek için takvim etkinliklerini okur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取系统日历事件，用于在右键日历组件中显示当天日程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀取系統日曆事件，用於在右鍵日曆組件中顯示當天行程。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
