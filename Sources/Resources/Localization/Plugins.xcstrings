            "value": "%@ im Dashboard ausblenden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide %@ from Dashboard"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar %@ del panel"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer %@ du tableau de bord"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@をダッシュボードから隠す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 대시보드에서 가리기"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar %@ do painel"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрыть %@ с панели управления"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Öğesini Gösterge Panelinden Gizle"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从仪表盘隐藏%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從儀表板隱藏%@"
          }
        }
      }
    },
