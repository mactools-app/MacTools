    "plugin.error.catalog.migrationCompletionPersistenceFailed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تحديث المكونات الإضافية، ولكن تعذر حفظ حالة اكتمال الترحيل. ستستمر الاستعادة عند التشغيل التالي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Plugins wurden aktualisiert, aber der abgeschlossene Migrationsstatus konnte nicht gespeichert werden. Die Wiederherstellung wird beim nächsten Start fortgesetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The plugins were updated, but the completed migration state could not be saved. Recovery will continue at the next launch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los complementos se actualizaron, pero no se pudo guardar el estado de migración completada. La recuperación continuará en el próximo inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les plugins ont été mis à jour, mais l’état de migration terminée n’a pas pu être enregistré. La récupération se poursuivra au prochain lancement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プラグインは更新されましたが、移行完了状態を保存できませんでした。次回起動時に復旧を続行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플러그인은 업데이트되었지만 마이그레이션 완료 상태를 저장할 수 없습니다. 다음 실행 시 복구를 계속합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os plug-ins foram atualizados, mas não foi possível salvar o estado de migração concluída. A recuperação continuará na próxima inicialização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плагины обновлены, но не удалось сохранить состояние завершённой миграции. Восстановление продолжится при следующем запуске."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eklentiler güncellendi, ancak tamamlanan geçiş durumu kaydedilemedi. Kurtarma işlemi bir sonraki açılışta devam edecek."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "插件已更新，但无法保存迁移完成状态；下次启动时将继续恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "外掛已更新，但無法儲存遷移完成狀態；下次啟動時將繼續復原。"
          }
        }
      }
    },
