    "plugin.error.store.installedSDKIncompatibleFormat": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إصدار SDK للمكون الإضافي غير متوافق. الإصدار المثبت: %d، الإصدار المدعوم: %d. قم بتحديث البرنامج المساعد."
