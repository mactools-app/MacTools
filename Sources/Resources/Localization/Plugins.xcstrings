    "plugin.marketplace.sort.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يغيّر ترتيب قائمة المتجر. لا يؤثر على ترتيب شريط القوائم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändert die Reihenfolge der Marktliste. Beeinflusst nicht die Menüleisten-Reihenfolge."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change marketplace list order. Does not affect menu bar feature order."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia el orden de la lista del mercado. No afecta el orden de la barra de menús."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifie l’ordre de la liste du marketplace. N’affecte pas l’ordre de la barre de menus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マーケットプレイス一覧の順序を変更します。メニューバーの機能順には影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마켓플레이스 목록 순서를 변경합니다. 메뉴 막대 기능 순서에는 영향이 없습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Altera a ordem da lista do marketplace. Não afeta a ordem da barra de menus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменяет порядок списка магазина. Не влияет на порядок функций в строке меню."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pazar yeri liste sırasını değiştirir; menü çubuğundaki özellik sırasını etkilemez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整市场列表排序，不影响菜单栏功能顺序。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調整市場列表排序，不影響選單列功能順序。"
          }
        }
      }
    },
