{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "plugin.requirement.macOS": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requires macOS %@ or later."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS %@ veya üzerini gerektirir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要 macOS %@ 或更高版本。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب macOS %@ أو أحدث."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfordert macOS %@ oder neuer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Requiere macOS %@ o posterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessite macOS %@ ou une version ultérieure."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS %@ 以降が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS %@ 이상이 필요합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Requer macOS %@ ou posterior."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуется macOS %@ или новее."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要 macOS %@ 或更新版本。"
          }
        }
      }
    },
