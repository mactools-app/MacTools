    "当前没有自动规则。手动运行不受规则条件影响。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد قواعد تلقائية حاليًا. لا تتأثر عمليات التشغيل اليدوية بشروط القاعدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Derzeit gibt es keine automatisierten Regeln. Manuelle Läufe werden von den Regelbedingungen nicht beeinflusst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are no Automation Rules. Manual runs ignore rule conditions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualmente no existen reglas automatizadas. Las ejecuciones manuales no se ven afectadas por las condiciones de las reglas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'existe actuellement aucune règle automatisée. Les exécutions manuelles ne sont pas affectées par les conditions des règles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、自動化されたルールはありません。手動実行はルール条件の影響を受けません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 자동 규칙이 없습니다. 수동 실행은 규칙 조건의 영향을 받지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualmente não existem regras automatizadas. As execuções manuais não são afetadas pelas condições das regras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В настоящее время автоматизированных правил нет. Условия правил не влияют на запуск вручную."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomasyon Kuralı yok. El ile çalıştırmalar kural koşullarından etkilenmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前没有自动规则。手动运行不受规则条件影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前沒有自動規則。手動運轉不受規則條件影響。"
          }
        }
      }
    },
