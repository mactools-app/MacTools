    "此快捷键已分配给“%@”。替换后，原操作将不再使用它。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تخصيص مفتاح الاختصار هذا لـ \"%@\". بعد الاستبدال، لن يتم استخدامه من خلال العملية الأصلية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Tastenkombination wurde „%@“ zugewiesen. Nach dem Austausch wird es vom ursprünglichen Betrieb nicht mehr verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This shortcut key has been assigned to \"%@\". After replacement, it will no longer be used by the original operation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta tecla de acceso directo se ha asignado a \"%@\". Después del reemplazo, ya no será utilizado por la operación original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette touche de raccourci a été attribuée à \"%@\". Après remplacement, il ne sera plus utilisé par l'opération d'origine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このショートカットキーは「%@」に割り当てられています。交換後は元の動作では使用できなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 단축키는 \"%@\"에 할당되었습니다. 교체 후에는 더 이상 원래 작업에 사용되지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta tecla de atalho foi atribuída a \"%@\". Após a substituição, ele não será mais utilizado pela operação original."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта клавиша быстрого доступа назначена «%@». После замены он больше не будет использоваться в исходной операции."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kısayol tuşu \"%@\" öğesine atanmış. Değiştirildiğinde özgün eylem artık bu kısayolu kullanamaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此快捷键已分配给“%@”。替换后，原操作将不再使用它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此快速鍵已指派給「%@」。替換後，原始操作將不再使用它。"
          }
        }
      }
    },
