          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique etapas, disponibilidade e confirmações antes de executar."
          }
        }
      }
    },
    "工作流会按顺序更改系统状态；已完成的步骤无法自动撤销。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يغيّر سير العمل حالة النظام بالترتيب؛ ولا يمكن التراجع تلقائيًا عن الخطوات المكتملة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Workflow ändert den Systemzustand der Reihe nach; abgeschlossene Schritte können nicht automatisch rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The workflow changes system state in order; completed steps cannot be undone automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El flujo de trabajo cambia el estado del sistema en orden; los pasos completados no se pueden deshacer automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le flux de travail modifie l’état du système dans l’ordre ; les étapes terminées ne peuvent pas être annulées automatiquement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークフローは順番にシステム状態を変更します。完了したステップは自動的に取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "워크플로는 순서대로 시스템 상태를 변경하며 완료된 단계는 자동으로 취소할 수 없습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O fluxo de trabalho altera o estado do sistema em ordem; etapas concluídas não podem ser desfeitas automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рабочий процесс изменяет состояние системы по порядку; выполненные шаги нельзя отменить автоматически."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İş akışı sistem durumunu sırayla değiştirir; tamamlanan adımlar otomatik olarak geri alınamaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作流会按顺序更改系统状态；已完成的步骤无法自动撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作流程會依序變更系統狀態；已完成的步驟無法自動還原。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il flusso di lavoro modifica lo stato del sistema in sequenza; i passaggi completati non possono essere annullati automaticamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O fluxo de trabalho altera o estado do sistema em ordem; etapas concluídas não podem ser desfeitas automaticamente."
          }
        }
      }
    },
