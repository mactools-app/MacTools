          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendre avant l’étape"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステップ前に待機"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단계 전에 대기"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguardar antes da etapa"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ждать перед шагом"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adımdan önce bekleme"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "步骤前等待"
          }
        },
        "zh-Hant": {
