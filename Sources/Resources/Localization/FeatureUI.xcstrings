    "电池电量低于规则范围。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طاقة البطارية أقل من النطاق المحدد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Batterieleistung liegt unter dem angegebenen Bereich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The battery power is lower than the specified range."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carga de la batería es inferior al rango especificado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La puissance de la batterie est inférieure à la plage spécifiée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリー残量が指定範囲を下回っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배터리 전원이 지정된 범위보다 낮습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A carga da bateria está abaixo da faixa especificada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заряд аккумулятора ниже указанного диапазона."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pil seviyesi kural aralığının altında."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电池电量低于规则范围。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "電池電量低於規則範圍。"
          }
        }
      }
    },
