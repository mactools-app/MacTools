          "stringUnit": {
            "state": "translated",
            "value": "Les opérations contenant des paramètres sensibles ne peuvent pas créer de liens en cours d'exécution."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "機密パラメータを含む操作では、実行中のリンクを作成できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "민감한 매개변수가 포함된 작업은 실행 중인 링크를 생성할 수 없습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Operações contendo parâmetros confidenciais não podem criar links em execução."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операции, содержащие конфиденциальные параметры, не могут создавать работающие ссылки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hassas parametre içeren eylemler için Çalıştırma Bağlantısı oluşturulamaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
