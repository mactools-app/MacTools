    "操作不可用，请返回后重试。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This action is unavailable. Go back and try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu eylem kullanılamıyor. Geri dönüp yeniden deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作不可用，请返回后重试。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الإجراء غير متاح. ارجع وحاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aktion ist nicht verfügbar. Gehen Sie zurück und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta acción no está disponible. Vuelve e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action n'est pas disponible. Revenez en arrière et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアクションは使用できません。戻ってもう一度試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업을 사용할 수 없습니다. 돌아가서 다시 시도해 보세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ação não está disponível. Volte e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это действие недоступно. Вернитесь и попробуйте еще раз."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "操作不可用，請返回後重試。"
          }
        }
      }
    },
    "消息过长，请缩短后重试。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This message is too long. Shorten it and try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu mesaj çok uzun. Kısaltıp yeniden deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "消息过长，请缩短后重试。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الرسالة طويلة جدًا. اختصرها وحاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Nachricht ist zu lang. Kürzen Sie sie und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este mensaje es demasiado largo. Acórtelo y vuelva a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce message est trop long. Raccourcissez-le et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメッセージは長すぎます。短くして再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지가 너무 깁니다. 길이를 줄이고 다시 시도해 보세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta mensagem é muito longa. Encurte e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это сообщение слишком длинное. Сократите его и попробуйте еще раз."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訊息過長，請縮短後重試。"
          }
        }
      }
    },
    "支持面板的已安装插件会显示在这里。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installed plugins that support panels appear here."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel sunan yüklü eklentiler burada görüntülenir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持面板的已安装插件会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支援面板的已安裝外掛會顯示在這裡。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر هنا الإضافات المثبّتة التي تدعم لوحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier werden installierte Plugins mit einem Panel angezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los complementos instalados con un panel aparecen aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les plugins installés avec un panneau apparaissent ici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パネル付きのインストール済みプラグインがここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패널을 지원하는 설치된 플러그인이 여기에 표시됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Plugins instalados com painel aparecem aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь отображаются установленные плагины с панелью."
          }
        }
      }
    },
