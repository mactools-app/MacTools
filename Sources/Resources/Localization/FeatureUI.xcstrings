    "包含敏感参数的预设不能通过运行链接调用。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن تشغيل الإعدادات المسبقة التي تحتوي على معلمات حساسة عبر رابط تشغيل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Voreinstellungen mit sensiblen Parametern können nicht über einen Ausführungslink aufgerufen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Presets containing sensitive parameters can’t be invoked by Run Link."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los preajustes con parámetros confidenciales no se pueden ejecutar mediante un enlace de ejecución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les préréglages contenant des paramètres sensibles ne peuvent pas être exécutés via un lien d’exécution."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "機密パラメータを含むプリセットは実行リンクから呼び出せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "민감한 매개변수가 포함된 프리셋은 실행 링크로 호출할 수 없습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Predefinições com parâmetros sensíveis não podem ser executadas por um link de execução."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предустановки с конфиденциальными параметрами нельзя запускать по ссылке запуска."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hassas parametreler içeren hazır ayarlar Çalıştırma Bağlantısı ile çağrılamaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包含敏感参数的预设不能通过运行链接调用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "包含敏感參數的預設無法透過執行連結呼叫。"
          }
        }
      }
    },
