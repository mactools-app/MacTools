    "查找 MacTools 与插件操作，并在同一个冲突空间中管理全局快捷键。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابحث عن MacTools وإجراءات المكونات الإضافية وإدارة الاختصارات العامة في نفس مساحة الصراع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finden Sie MacTools und Plug-in-Aktionen und verwalten Sie globale Verknüpfungen im selben Konfliktbereich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find MacTools and plugin actions, and manage global shortcuts in one shared conflict space."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentre MacTools y acciones de complementos y administre accesos directos globales en el mismo espacio de conflicto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouvez MacTools et les actions de plug-in et gérez les raccourcis globaux dans le même espace de conflit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools とプラグイン アクションを検索し、同じ競合スペースでグローバル ショートカットを管理します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools 및 플러그인 작업을 찾고 동일한 충돌 공간에서 전역 바로가기를 관리합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontre MacTools e ações de plug-ins e gerencie atalhos globais no mesmo espaço de conflito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Находите MacTools и действия плагинов и управляйте глобальными ярлыками в одном конфликтном пространстве."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools ve eklenti eylemlerini bulun; genel kısayolları tek bir ortak çakışma alanında yönetin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查找 MacTools 与插件操作，并在同一个冲突空间中管理全局快捷键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尋找 MacTools 與外掛程式操作，並在同一個衝突空間中管理全域快捷鍵。"
          }
        }
      }
    },
