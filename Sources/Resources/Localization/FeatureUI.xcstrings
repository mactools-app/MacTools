    "运行前检查步骤、可用性和确认要求。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من الخطوات والتوفر ومتطلبات التأكيد قبل التشغيل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schritte, Verfügbarkeit und Bestätigungen vor der Ausführung prüfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check steps, availability, and confirmation requirements before running."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba los pasos, la disponibilidad y las confirmaciones antes de ejecutar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez les étapes, la disponibilité et les confirmations avant l’exécution."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行前にステップ、利用可能性、確認要件を確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행 전에 단계, 사용 가능 여부 및 확인 요구 사항을 검사합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique etapas, disponibilidade e confirmações antes de executar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверять шаги, доступность и подтверждения перед запуском."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalıştırmadan önce adımları, kullanılabilirliği ve onay gereksinimlerini denetleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行前检查步骤、可用性和确认要求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "執行前檢查步驟、可用性與確認要求。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
