    "此面板中的内容将回到各自的默认面板。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Items in this panel will be kept and moved to another panel."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu paneldeki öğeler özgün varsayılan panellerine geri döner."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此面板中的内容将保留并移至其他面板。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم الاحتفاظ بعناصر هذه اللوحة ونقلها إلى لوحة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Elemente in diesem Panel bleiben erhalten und werden in ein anderes Panel verschoben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos de este panel se conservarán y se moverán a otro panel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments de ce panneau seront conservés et déplacés vers un autre panneau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このパネルの項目は保持され、別のパネルに移動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 패널의 항목은 유지되며 다른 패널로 이동합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os itens deste painel serão mantidos e movidos para outro painel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Элементы этой панели сохранятся и будут перемещены на другую панель."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此面板中的內容將保留並移至其他面板。"
          }
        }
      }
    },
