    "search.command.appearance.system.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اجعل مظهر MacTools يتبع النظام تلقائيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Darstellung von MacTools automatisch an das System anpassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make MacTools follow the system appearance automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacer que la apariencia de MacTools siga automáticamente la del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adapter automatiquement l’apparence de MacTools au système."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacToolsの外観をシステムに自動的に合わせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools 화면 모드를 시스템에 자동으로 맞춥니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fazer o MacTools seguir automaticamente a aparência do sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически подстраивать оформление MacTools под систему."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools'un görünümünü otomatik olarak sistem görünümüne uydurur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让 MacTools 外观自动跟随系统。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓 MacTools 外觀自動跟隨系統。"
          }
        }
      }
    },
