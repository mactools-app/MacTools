    "preferencesBackup.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُخزَّن النسخ الاحتياطية التلقائية محليًا وتشمل إعدادات التطبيق والإضافات القابلة للنقل؛ وتُستبعد الأذونات وذاكرات التخزين المؤقت وبيانات الاعتماد والبيانات الخاصة الأخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatische Backups werden lokal gespeichert und enthalten übertragbare App- und Plug-in-Einstellungen; Berechtigungen, Caches, Zugangsdaten und andere private Daten sind ausgeschlossen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic backups are stored locally and include portable app and plugin settings; permissions, caches, credentials, and other private data are excluded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las copias de seguridad automáticas se guardan localmente e incluyen ajustes portátiles de la app y los plugins; se excluyen permisos, cachés, credenciales y otros datos privados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sauvegardes automatiques sont stockées localement et incluent les réglages transférables de l’app et des extensions ; les autorisations, caches, identifiants et autres données privées sont exclus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動バックアップはローカルに保存され、移行可能なアプリとプラグインの設定が含まれます。権限、キャッシュ、認証情報、その他の個人データは含まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 백업은 로컬에 저장되며 이동 가능한 앱 및 플러그인 설정을 포함합니다. 권한, 캐시, 자격 증명 및 기타 개인 데이터는 제외됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os backups automáticos são armazenados localmente e incluem ajustes portáteis do app e dos plugins; permissões, caches, credenciais e outros dados privados são excluídos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматические резервные копии хранятся локально и включают переносимые настройки приложения и плагинов; разрешения, кэш, учётные данные и другие личные данные исключены."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik yedekler yerel olarak saklanır ve taşınabilir uygulama ile eklenti ayarlarını içerir; izinler, önbellekler, kimlik bilgileri ve diğer özel veriler hariç tutulur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动备份保存在本机，包含可移植的应用与插件设置；不包含权限、缓存、凭证或其他私密数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動備份儲存在本機，包含可攜式的應用程式與插件設定；不包含權限、快取、憑證或其他私密資料。"
          }
        }
      }
    },
