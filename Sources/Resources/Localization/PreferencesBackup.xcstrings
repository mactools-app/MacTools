          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用共享設定"
          }
        }
      }
    },
    "preferencesBackup.cloudSync.status.pending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting to Sync"
          }
        },
        "tr": {
