    "preferencesBackup.preview.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجع هذه التغييرات. لا يثبّت الاستيراد الإضافات ولا يغيّر الأذونات أو ذاكرة التخزين المؤقت أو أسرار Keychain أو بيانات الإضافات الخاصة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätigen Sie diese Änderungen. Der Import installiert keine Plugins und ändert weder Berechtigungen, Caches, Keychain-Geheimnisse noch private Plug-in-Daten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review these changes. Import does not install plugins or change permissions, caches, Keychain secrets, or plugin-private data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa estos cambios. La importación no instala plugins ni modifica permisos, cachés, secretos del llavero ni datos privados de plugins."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez ces modifications. L’importation n’installe pas d’extensions et ne modifie ni les autorisations, ni les caches, ni les secrets du trousseau, ni les données privées d’extension."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更内容を確認してください。インポートによってプラグインがインストールされたり、権限、キャッシュ、キーチェーンの秘密情報、プラグイン固有データが変更されたりすることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항을 확인하세요. 가져오기는 플러그인을 설치하거나 권한, 캐시, 키체인 비밀 정보 또는 플러그인 전용 데이터를 변경하지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise estas alterações. A importação não instala plugins nem altera permissões, caches, segredos do Chaves ou dados privados de plugins."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте эти изменения. Импорт не устанавливает плагины и не изменяет разрешения, кэш, секреты Keychain или приватные данные плагинов."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu değişiklikleri gözden geçirin. İçe aktarma, eklenti yüklemez; izinleri, önbellekleri, Keychain'deki gizli bilgileri veya eklentilere özel verileri değiştirmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确认以下更改。导入不会安装插件，也不会修改权限、缓存、Keychain 密钥或插件私有数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請確認以下變更。匯入不會安裝插件，也不會修改權限、快取、Keychain 密鑰或插件私有資料。"
          }
        }
      }
    },
