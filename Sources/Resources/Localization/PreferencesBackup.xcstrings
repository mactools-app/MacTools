    "preferencesBackup.selection.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تصدير الفئات المحددة فقط. يمكنك اختيار ما تريد استعادته مرة أخرى عند الاستيراد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ausgewählte Kategorien werden exportiert. Beim Import kannst du erneut auswählen, was wiederhergestellt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only selected categories are exported. You can choose what to restore again when importing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se exportan las categorías seleccionadas. Al importar podrás volver a elegir qué restaurar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les catégories sélectionnées sont exportées. Vous pourrez à nouveau choisir quoi restaurer lors de l’importation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したカテゴリのみを書き出します。読み込み時に復元する内容を再度選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 범주만 내보냅니다. 가져올 때 복원할 항목을 다시 선택할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente as categorias selecionadas são exportadas. Ao importar, você poderá escolher novamente o que restaurar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспортируются только выбранные категории. При импорте можно снова выбрать, что восстановить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca seçili kategoriler dışa aktarılır. İçe aktarırken geri yükleyeceklerinizi yeniden seçebilirsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅导出所选类别。导入时还可以再次选择要恢复的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
