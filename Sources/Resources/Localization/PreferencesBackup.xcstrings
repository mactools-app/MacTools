    "preferencesBackup.import.pluginRestoreDeferred": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تثبيت \"%@\". أعد تشغيل MacTools، ثم استورد هذه النسخة الاحتياطية مرة أخرى لاستعادة إعداداته."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ wurde installiert. Starte MacTools neu und importiere dieses Backup erneut, um die Einstellungen wiederherzustellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” was installed. Restart MacTools, then import this backup again to restore its settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se instaló «%@». Reinicia MacTools y vuelve a importar esta copia de seguridad para restaurar sus ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » a été installé. Redémarrez MacTools, puis importez à nouveau cette sauvegarde pour restaurer ses réglages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」をインストールしました。MacTools を再起動してから、このバックアップをもう一度読み込んで設定を復元してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’이(가) 설치되었습니다. MacTools를 다시 시작한 다음 이 백업을 다시 가져와 설정을 복원하십시오."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” foi instalado. Reinicie o MacTools e importe este backup novamente para restaurar os ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плагин «%@» установлен. Перезапустите MacTools, затем снова импортируйте эту резервную копию, чтобы восстановить его настройки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” yüklendi. Ayarlarını geri yüklemek için MacTools'u yeniden başlatıp bu yedeği yeniden içe aktarın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已安装“%@”。请重新启动 MacTools，然后再次导入此备份以恢复其设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已安裝「%@」。請重新啟動 MacTools，然後再次匯入此備份以回復其設定。"
          }
        }
      }
    },
