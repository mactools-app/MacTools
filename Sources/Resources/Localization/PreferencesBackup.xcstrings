            "state": "translated",
            "value": "Eşitleme Bekleniyor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待同步"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等待同步"
          }
        }
      }
    },
    "preferencesBackup.cloudSync.status.conflict": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Settings Version"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayar Sürümü Seçin"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要选择设置版本"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要選擇設定版本"
          }
        }
      }
    },
    "preferencesBackup.cloudSync.status.snapshotMissing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shared file is unavailable. Check your cloud drive and retry; local settings are preserved."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşılan dosya kullanılamıyor. Bulut diskinizi kontrol edip yeniden deneyin; yerel ayarlar korunur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享文件暂不可用。请检查云盘后重试；本机设置已保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "共享檔案暫不可用。請檢查雲端硬碟後重試；本機設定已保留。"
          }
        }
      }
    },
