    "preferencesBackup.selection.application.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المظهر واللغة وسلوك النقر على شريط القوائم؛ لا يشمل الأذونات أو عناصر تسجيل الدخول أو بيانات الاعتماد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erscheinungsbild, Sprache und Klickverhalten der Menüleiste; ohne Berechtigungen, Anmeldeobjekte oder Zugangsdaten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appearance, language, and menu bar click behavior; excludes permissions, login items, and credentials."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apariencia, idioma y comportamiento de clic de la barra de menús; no incluye permisos, ítems de inicio ni credenciales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apparence, langue et comportement de clic de la barre des menus ; sans autorisations, éléments d’ouverture ni identifiants."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外観、言語、メニューバーのクリック動作。権限、ログイン項目、認証情報は含みません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모양, 언어 및 메뉴 막대 클릭 동작입니다. 권한, 로그인 항목 및 자격 증명은 제외됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparência, idioma e comportamento de clique da barra de menus; não inclui permissões, itens de início ou credenciais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оформление, язык и поведение щелчка по строке меню; без разрешений, объектов входа и учётных данных."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görünüm, dil ve menü çubuğu tıklama davranışı; izinleri, oturum öğelerini ve kimlik bilgilerini içermez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外观、语言和菜单栏点击方式；不包含权限、登录项或凭证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "外觀、語言和選單列點按方式；不包含權限、登入項目或憑證。"
          }
        }
      }
    },
    "preferencesBackup.selection.pluginLayout.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستعيد ترتيب الإضافات وظهورها في لوحة المعلومات ولوحة الميزات؛ يجب تثبيت الإضافات المفقودة بشكل منفصل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellt Reihenfolge und Sichtbarkeit in Dashboard und Funktionsbereich wieder her; fehlende Plugins müssen separat installiert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restores plugin order and visibility in Dashboard and Feature Panel; missing plugins must be installed separately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura el orden y la visibilidad en el Dashboard y el Panel de funciones; los plugins ausentes deben instalarse aparte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaure l’ordre et la visibilité dans le tableau de bord et le panneau de fonctions ; les modules absents doivent être installés séparément."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダッシュボードと機能パネルのプラグインの順序と表示を復元します。不足するプラグインは別途インストールが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대시보드와 기능 패널의 플러그인 순서 및 표시 여부를 복원합니다. 누락된 플러그인은 별도로 설치해야 합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura a ordem e a visibilidade no Painel e no Painel de recursos; plugins ausentes precisam ser instalados separadamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстанавливает порядок и видимость в панели и панели функций; отсутствующие плагины устанавливаются отдельно."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dashboard ve Özellik Paneli'ndeki eklenti sırasını ve görünürlüğünü geri yükler; eksik eklentilerin ayrıca yüklenmesi gerekir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复仪表盘和功能面板中的插件顺序与可见性；缺失插件需要另外安装。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回復儀表板和功能面板中的外掛順序與可見性；缺少的外掛需要另外安裝。"
          }
        }
      }
    },
    "preferencesBackup.selection.shortcuts.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستعيد اختصارات التطبيق والإجراءات؛ تتطلب إجراءات الإضافات الإضافة وإعداداتها المقابلة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellt App- und Aktionskurzbefehle wieder her; Plugin-Aktionen benötigen das jeweilige Plugin und seine Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restores app and action shortcuts; plugin actions also require their plugin and corresponding settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura atajos de la app y de acciones; las acciones de plugins también requieren su plugin y ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaure les raccourcis de l’app et des actions ; les actions de modules exigent aussi leur module et ses réglages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリとアクションのショートカットを復元します。プラグインのアクションには対応するプラグインと設定も必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 및 동작 단축키를 복원합니다. 플러그인 동작에는 해당 플러그인과 설정도 필요합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura atalhos do app e de ações; ações de plugins também exigem o plugin e as configurações correspondentes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстанавливает сочетания клавиш приложения и действий; действиям плагинов также нужны соответствующие плагины и настройки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama ve eylem kısayollarını geri yükler; eklenti eylemleri ayrıca ilgili eklentiyi ve bunun ayarlarını gerektirir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复应用和操作快捷键；插件操作还需要对应插件及其设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回復應用程式和動作快速鍵；外掛動作還需要對應外掛及其設定。"
          }
        }
      }
    },
    "preferencesBackup.selection.automation.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحافظ على معرّفات سير العمل وروابط التشغيل المباشرة؛ ما زالت الخطوات تتطلب الإضافات وإعداداتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behält Workflow-IDs und direkte Run Links bei; Schritte benötigen weiterhin ihre Plugins und Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preserves workflow IDs and direct Run Links; workflow steps still require their plugins and settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva los ID de flujo y sus Run Links directos; los pasos siguen necesitando sus plugins y ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserve les identifiants de workflow et les Run Links directs ; les étapes nécessitent toujours leurs modules et réglages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークフローIDと直接のRun Linkを保持します。各ステップには対応するプラグインと設定が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "워크플로 ID와 직접 Run Link를 유지합니다. 단계에는 해당 플러그인과 설정이 계속 필요합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Preserva IDs de fluxos e Run Links diretos; as etapas ainda exigem seus plugins e configurações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняет идентификаторы процессов и прямые Run Link; шагам по-прежнему нужны плагины и их настройки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İş akışı kimliklerini ve doğrudan Run Link'leri korur; iş akışı adımları yine ilgili eklentileri ve ayarları gerektirir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留工作流标识和直接 Run Link；工作流步骤仍需要对应插件及其设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留工作流程識別碼和直接 Run Link；工作流程步驟仍需要對應外掛及其設定。"
          }
        }
      }
    },
    "preferencesBackup.selection.runLinks.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "روابط محفوظة للإجراءات ذات المعلمات؛ تُستعاد روابط سير العمل مع «مهام سير العمل وقواعد الأتمتة»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeicherte Links für parametrisierte Aktionen; Workflow-Links werden mit „Workflows und Automationsregeln“ wiederhergestellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved links for parameterized actions; workflow links are restored with Workflows and Automation Rules."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enlaces guardados para acciones con parámetros; los enlaces de flujos se restauran con Flujos y reglas de automatización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Liens enregistrés pour les actions paramétrées ; les liens de workflow sont restaurés avec les workflows et règles d’automatisation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パラメータ付きアクションの保存済みリンクです。ワークフローのリンクは「ワークフローと自動化ルール」で復元されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매개변수가 있는 동작의 저장된 링크입니다. 워크플로 링크는 워크플로 및 자동화 규칙과 함께 복원됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Links salvos para ações parametrizadas; links de fluxos são restaurados com Fluxos e regras de automação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранённые ссылки параметризованных действий; ссылки процессов восстанавливаются вместе с процессами и правилами автоматизации."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parametreli eylemler için kaydedilmiş bağlantılar; iş akışı bağlantıları İş Akışları ve Otomasyon Kuralları ile birlikte geri yüklenir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "参数化操作的已保存链接；工作流链接随“工作流与自动化规则”一起恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "參數化動作的已儲存連結；工作流程連結會隨「工作流程與自動化規則」一起回復。"
          }
        }
      }
    },
    "preferencesBackup.selection.plugins.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتضمن فقط الإعدادات التي تعلن الإضافة أنها قابلة للنقل. تتطلب المحتويات الحساسة مثل نصوص البرامج النصية إذنًا منفصلًا داخل الإضافة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Enthält nur vom Plugin als portabel deklarierte Einstellungen. Sensible Inhalte wie Skripttext müssen im Plugin separat freigegeben werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Includes only settings the plugin declares portable. Sensitive content such as script source still requires separate opt-in inside that plugin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo incluye ajustes que el plugin declara portátiles. El contenido sensible, como el código de scripts, requiere permiso aparte en el plugin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclut seulement les réglages déclarés portables par le module. Le contenu sensible, comme le texte des scripts, exige une autorisation dans le module."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プラグインが移行可能とする設定のみを含みます。スクリプト本文などの機密内容はプラグイン内で個別に許可する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플러그인이 이동 가능하다고 선언한 설정만 포함합니다. 스크립트 원문 같은 민감한 내용은 플러그인에서 별도로 허용해야 합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclui apenas configurações declaradas portáteis pelo plugin. Conteúdo sensível, como o código de scripts, exige permissão separada no plugin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включает только настройки, объявленные плагином переносимыми. Для чувствительных данных, например текста скриптов, нужно отдельное разрешение в плагине."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca eklentinin taşınabilir olarak bildirdiği ayarları içerir. Betik kaynağı gibi hassas içerikler için ilgili eklenti içinde ayrıca izin vermeniz gerekir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅包含插件声明为可移植的设置。脚本文本等敏感内容仍需在对应插件中单独允许备份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅包含外掛宣告為可攜式的設定。指令碼文字等敏感內容仍需在對應外掛中另外允許備份。"
          }
        }
      }
    },
    "preferencesBackup.preview.replaceNotice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُستبدل الفئات المعروضة من التفضيلات؛ وتعود الإعدادات غير الموجودة في النسخة الاحتياطية إلى قيمها الافتراضية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die angezeigten Einstellungskategorien werden ersetzt; Einstellungen, die nicht in der Sicherung enthalten sind, werden auf ihre Standardwerte zurückgesetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The listed preference categories are replaced; settings absent from the backup return to their defaults."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se reemplazan las categorías de preferencias indicadas; los ajustes que no están en la copia vuelven a sus valores predeterminados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les catégories de préférences indiquées sont remplacées ; les réglages absents de la sauvegarde reviennent à leurs valeurs par défaut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示された環境設定のカテゴリが置き換えられます。バックアップにない設定はデフォルト値に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표시된 환경설정 범주가 대체되며 백업에 없는 설정은 기본값으로 돌아갑니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As categorias de preferências listadas são substituídas; as configurações ausentes do backup voltam aos valores padrão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перечисленные категории настроек заменяются; параметры, отсутствующие в резервной копии, возвращаются к значениям по умолчанию."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Listelenen tercih kategorileri değiştirilir; yedekte bulunmayan ayarlar varsayılan değerlerine döner."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将替换以上偏好类别；备份中未包含的设置会恢复为默认值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將取代以上偏好類別；備份中未包含的設定會回復為預設值。"
          }
        }
      }
    },
