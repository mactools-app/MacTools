          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용할 수 없는 플러그인 설정 %d개, 단축키 %d개 및 사용할 수 없거나 이식할 수 없는 동작 %d개는 건너뜁니다."
