{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "preferencesBackup.cloudSync.error.sharedFileChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shared settings are still changing. Retry shortly; local settings are preserved."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşılan ayarlar hâlâ değişiyor. Kısa süre sonra yeniden deneyin; yerel ayarlar korunur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享设置仍在更改。请稍后重试；本机设置已保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "共享設定仍在變更。請稍後重試；本機設定已保留。"
          }
        }
      }
    },
    "preferencesBackup.cloudSync.conflict.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local and shared settings have both changed. Both versions are saved. Choose which version to sync; settings specific to this Mac will be preserved."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hem yerel hem de paylaşılan ayarlar değişti. Her iki sürüm de kaydedildi. Eşitlemek istediğiniz sürümü seçin; bu Mac'e özel ayarlar korunur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机和共享设置均已更改。两个版本已保留，请选择要同步的版本。此 Mac 的专属设置会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本機和共享設定均已變更。兩個版本已保留，請選擇要同步的版本。此 Mac 的專屬設定會保留。"
          }
        }
      }
    },
    "preferencesBackup.cloudSync.conflict.local": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Local Settings"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel Ayarları Kullan"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用本机设置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用本機設定"
          }
        }
      }
    },
