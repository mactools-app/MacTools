          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки для %d недоступных плагинов, %d недоступных сочетаний клавиш и %d недоступных или непереносимых действий будут пропущены."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanılamayan %d eklentinin ayarları, kullanılamayan %d kısayol ve kullanılamayan ya da taşınabilir olmayan %d eylem atlanacak."
