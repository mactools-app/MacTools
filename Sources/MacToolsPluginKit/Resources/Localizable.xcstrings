            "state": "translated",
            "value": "送信するキーをリストから選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록에서 보낼 키를 선택하십시오."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha na lista a tecla a enviar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите в списке клавишу для отправки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderilecek tuşu listeden seçin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从列表中选择要发送的按键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從列表中選擇要傳送的按鍵。"
          }
        }
      }
    },
    "keyboardKeyTap.unsupportedHelp": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفتاح Caps Lock ومفاتيح الوسائط غير مدعومة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feststelltaste und Medientasten werden nicht unterstützt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Caps Lock and media keys are not supported."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloq Mayús y las teclas multimedia no son compatibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verr. Maj. et les touches multimédias ne sont pas prises en charge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Caps Lockとメディアキーには対応していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Caps Lock 및 미디어 키는 지원되지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Caps Lock e teclas multimédia não são suportadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Caps Lock и мультимедийные клавиши не поддерживаются."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Caps Lock ve medya tuşları desteklenmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持大写锁定和媒体键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不支援大寫鎖定和媒體鍵。"
          }
        }
      }
    },
