    "keyboardKeyTap.pickerHelp": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر المفتاح المراد إرساله من القائمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle die zu sendende Taste aus der Liste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the key to send from the list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige en la lista la tecla que se enviará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez dans la liste la touche à envoyer."
